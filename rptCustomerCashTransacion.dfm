  object ADOQuery1: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    AfterOpen = qryCashTransItemAfterOpen
    AfterCancel = qryCashTransItemAfterOpen
    Parameters = <
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '0'
      end
      item
        Name = 'DateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '99/12/29'
      end
      item
        Name = 'CustId'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 1002
      end
      item
        Name = 'YearIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'YearIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     *'
      
        'FROM         (SELECT     Forms.CustomerID1, Forms.FormID, Forms.' +
        'ServerID, Forms.YearID, Forms.FormNumber, Forms.FormDate, FormTy' +
        'pes.Formtype,'
      
        '                                              FormTypes.FormCapt' +
        'ion, Forms.FomNote, 0 AS CheckNumber, '#39#39' AS CheckDate, '#39#39' AS Acc' +
        'ountNumber, '#39#39' AS BankName, 0 AS bed,'
      
        '                                              Forms.Amount AS be' +
        's, 1 AS kind, Forms.CustomerID1 AS CustForShowForm ,Forms.AidInf' +
        'oNo,Forms.AidInfoDate'
      '                        FROM         Forms INNER JOIN'
      
        '                                              FormTypes ON Forms' +
        '.FormType = FormTypes.FormType'
      
        '                        WHERE     (FormTypes.BedBes = 0) AND (Fo' +
        'rmTypes.Customer1DocType = 10) AND (FormTypes.DisplayFormType = ' +
        '0)'
      '                        UNION ALL'
      
        '                        SELECT     Forms.CustomerID1, Forms.Form' +
        'ID, Forms.ServerID, Forms.YearID,  Forms.FormNumber, Forms.FormD' +
        'ate, FormTypes.Formtype,'
      
        '                                              FormTypes.FormCapt' +
        'ion, Forms.FomNote, 0 AS CheckNumber, '#39#39' AS CheckDate, '#39#39' AS Acc' +
        'ountNumber, '#39#39' AS BankName,'
      
        '                                              Forms.Amount AS be' +
        'd, 0 AS bes, 1 AS kind, Forms.CustomerID1 AS CustForShowForm ,Fo' +
        'rms.AidInfoNo,Forms.AidInfoDate'
      '                        FROM         Forms INNER JOIN'
      
        '                                              FormTypes ON Forms' +
        '.FormType = FormTypes.FormType'
      
        '                        WHERE     (FormTypes.BedBes = 1) AND (Fo' +
        'rmTypes.Customer1DocType = 10) AND (FormTypes.DisplayFormType = ' +
        '0)'
      '                        UNION ALL'
      
        '                        SELECT     Forms.CustomerID2, Forms.Form' +
        'ID, Forms.ServerID, Forms.YearID,  Forms.FormNumber, Forms.FormD' +
        'ate, FormTypes.Formtype,'
      
        '                                              FormTypes.FormCapt' +
        'ion, Forms.FomNote, 0 AS CheckNumber, '#39#39' AS CheckDate, '#39#39' AS Acc' +
        'ountNumber, '#39#39' AS BankName,'
      
        '                                              Forms.Amount AS be' +
        'd, 0 AS bes, 1 AS kind, Forms.CustomerID1 AS CustForShowForm ,Fo' +
        'rms.AidInfoNo,Forms.AidInfoDate'
      '                        FROM         Forms INNER JOIN'
      
        '                                              FormTypes ON Forms' +
        '.FormType = FormTypes.FormType'
      
        '                        WHERE     (FormTypes.BedBes = 0) AND (Fo' +
        'rmTypes.DisplayFormType = 0) AND (FormTypes.Customer2DocType = 1' +
        '0)'
      '                        UNION ALL'
      
        '                        SELECT     Forms.CustomerID2, Forms.Form' +
        'ID, Forms.ServerID, Forms.YearID,  Forms.FormNumber, Forms.FormD' +
        'ate, FormTypes.Formtype,'
      
        '                                              FormTypes.FormCapt' +
        'ion, Forms.FomNote, 0 AS CheckNumber, '#39#39' AS CheckDate, '#39#39' AS Acc' +
        'ountNumber, '#39#39' AS BankName, 0 AS bed,'
      
        '                                              Forms.Amount AS be' +
        's, 1 AS kind, Forms.CustomerID1 AS CustForShowForm ,Forms.AidInf' +
        'oNo,Forms.AidInfoDate'
      '                        FROM         Forms INNER JOIN'
      
        '                                              FormTypes ON Forms' +
        '.FormType = FormTypes.FormType'
      
        '                        WHERE     (FormTypes.BedBes = 1) AND (Fo' +
        'rmTypes.DisplayFormType = 0) AND (FormTypes.Customer2DocType = 1' +
        '0)'
      '                        UNION ALL'
      
        '                        SELECT     Forms.CustomerID1, Forms.Form' +
        'ID, Forms.ServerID, Forms.YearID,  Forms.FormNumber, Forms.FormD' +
        'ate, FormTypes.Formtype,'
      
        '                                              FormTypes.FormCapt' +
        'ion, FormItems.ItemNote, FormItems.CheckNumber, FormItems.CheckD' +
        'ate,'
      
        '                                              FormItems.AccountN' +
        'umber, FormItems.BankName, 0 AS bed, FormItems.ItemAmount AS bes' +
        ', 2 AS kind,'
      
        '                                              Forms.CustomerID1 ' +
        'AS CustForShowForm ,Forms.AidInfoNo,Forms.AidInfoDate'
      '                        FROM         Forms INNER JOIN'
      
        '                                              FormTypes ON Forms' +
        '.FormType = FormTypes.FormType INNER JOIN'
      
        '                                              FormItems ON Forms' +
        '.FormID = FormItems.FormID AND Forms.ServerID = FormItems.Server' +
        'ID AND Forms.YearID = FormItems.YearID'
      
        '                        WHERE     (FormTypes.BedBes = 1) AND (Fo' +
        'rmTypes.Customer1DocType = 10)'
      '                        UNION ALL'
      
        '                        SELECT     Forms.CustomerID1, Forms.Form' +
        'ID, Forms.ServerID, Forms.YearID,  Forms.FormNumber, Forms.FormD' +
        'ate, FormTypes.Formtype,'
      
        '                                              FormTypes.FormCapt' +
        'ion, FormItems.ItemNote, FormItems.CheckNumber, FormItems.CheckD' +
        'ate,'
      
        '                                              FormItems.AccountN' +
        'umber, FormItems.BankName, FormItems.ItemAmount AS bed, 0 AS bes' +
        ', 2 AS kind,'
      
        '                                              Forms.CustomerID1 ' +
        'AS CustForShowForm ,Forms.AidInfoNo,Forms.AidInfoDate'
      '                        FROM         Forms INNER JOIN'
      
        '                                              FormTypes ON Forms' +
        '.FormType = FormTypes.FormType INNER JOIN'
      
        '                                              FormItems ON Forms' +
        '.FormID = FormItems.FormID AND Forms.ServerID = FormItems.Server' +
        'ID AND Forms.YearID = FormItems.YearID'
      
        '                        WHERE     (FormTypes.BedBes = 0) AND (Fo' +
        'rmTypes.Customer1DocType = 10)'
      '                        UNION ALL'
      
        '                        SELECT     FormItems.CustomerID2, Forms.' +
        'FormID, Forms.ServerID, Forms.YearID,  Forms.FormNumber, Forms.F' +
        'ormDate, FormTypes.Formtype,'
      
        '                                              FormTypes.FormCapt' +
        'ion, FormItems.ItemNote, FormItems.CheckNumber, FormItems.CheckD' +
        'ate,'
      
        '                                              FormItems.AccountN' +
        'umber, FormItems.BankName, 0 AS bed, FormItems.ItemAmount AS bes' +
        ', 2 AS kind,'
      
        '                                              Forms.CustomerID1 ' +
        'AS CustForShowForm ,Forms.AidInfoNo,Forms.AidInfoDate'
      '                        FROM         Forms INNER JOIN'
      
        '                                              FormTypes ON Forms' +
        '.FormType = FormTypes.FormType INNER JOIN'
      
        '                                              FormItems ON Forms' +
        '.FormID = FormItems.FormID AND Forms.ServerID = FormItems.Server' +
        'ID AND Forms.YearID = FormItems.YearID'
      
        '                        WHERE     (FormTypes.BedBes = 1) AND (Fo' +
        'rmTypes.Customer2DocType = 10)'
      '                        UNION ALL'
      
        '                        SELECT     Forms.CustomerID2, Forms.Form' +
        'ID, Forms.ServerID, Forms.YearID,  Forms.FormNumber, Forms.FormD' +
        'ate, FormTypes.Formtype,'
      
        '                                              FormTypes.FormCapt' +
        'ion, FormItems.ItemNote, FormItems.CheckNumber, FormItems.CheckD' +
        'ate,'
      
        '                                              FormItems.AccountN' +
        'umber, FormItems.BankName,  FormItems.ItemAmount AS bed, 0  AS b' +
        'es, 2 AS kind,'
      
        '                                              Forms.CustomerID1 ' +
        'AS CustForShowForm ,Forms.AidInfoNo,Forms.AidInfoDate'
      '                        FROM         Forms INNER JOIN'
      
        '                                              FormTypes ON Forms' +
        '.FormType = FormTypes.FormType INNER JOIN'
      
        '                                              FormItems ON Forms' +
        '.FormID = FormItems.FormID AND Forms.ServerID = FormItems.Server' +
        'ID AND Forms.YearID = FormItems.YearID'
      
        '                        WHERE     (FormTypes.BedBes = 0) AND (Fo' +
        'rmTypes.Customer2DocType = 10)) cashtransactionCust'
      
        'WHERE     (FormDate BETWEEN :DateFrom AND :DateTo) AND (Customer' +
        'ID1 = :CustId)'
      ' AND (YearID BETWEEN :YearIDFrom AND :YearIDTo )'
      ''
      'order by FormDate'
      ''
      ''
      '')
    Left = 616
    Top = 224
  end
end
