  object qryCustomer: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qryCustomerAfterScroll
    Parameters = <
      item
        Name = 'custIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 1002
      end
      item
        Name = 'CustIdTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 1002
      end>
    SQL.Strings = (
      'SELECT     CustID,CustName'
