        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'YearIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT    customerid1 , formid ,serverid , yearid , formnumber ,' +
        ' formdate , formtype , formcaption ,'
      
        'fomnote  ,checknumber , checkdate , accountnumber , bankname  ,b' +
        'ed , bes , kind , custidforshow   as CustForShowForm  , aidinfon' +
        'o , aidinfodate'
      ''
      
        'FROM         CashAccount(-1,-1,10,-1,:CustIDFrom,:CustIDTo,:Date' +
        'From,:DateTo ,:YearIDFrom,:YearIDTo ,0,999,0,999 , DEFAULT ) Cas' +
        'hAccount'
      ''
      'order by FormDate'
      ''
      ''
      ''
      '')
