  object qryCashTransItem: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    AfterOpen = qryCashTransItemAfterOpen
    AfterCancel = qryCashTransItemAfterOpen
    Parameters = <
      item
        Name = 'CustIDFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CustIDTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
