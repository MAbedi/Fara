  object qryCustItem: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryCustItemAfterOpen
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'PersonIDFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PersonIDTo'
        DataType = ftString
        Size = 1
