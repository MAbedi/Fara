    SQL.Strings = (
      
        'SELECT        Fitful.DetailCode AS _checked, Recipts.ReciptNumbe' +
        'r, Recipts.ReciptDate, ReciptItems.StuffCode, StuffCoding.c_Stuf' +
        'fName, StuffCoding.sd1, StuffCoding.sd2, '
      
        '                         StuffCoding.sd3, StuffCoding.sd4, Stuff' +
        'Coding.sd5, StuffCoding.sd6, StuffCoding.sd7, StuffCoding.sd8, S' +
        'tuffCoding.sd9, ReciptItems.ControlCode, '
      
        '                        ISNULL( ReciptItems.PersonID1 ,0) AS Per' +
        'sonID1 , Customers.CustName, LookUps.Name, ISNULL(ReciptItems.Se' +
        'condTypeItem, 0) AS SecondTypeItem, ReciptItems.ReciptItemID, '
      
        '                         ReciptItems.ReciptID, ReciptItems.Serve' +
        'rID, ReciptItems.YearID, ReciptItems.ItemNote'
      ', ReciptItems.AidDate, ReciptTypes.ReciptCaption'
      ''
      
        '  ,(SELECT TOP 1  ltrim(STR(max(Recipts.ReciptNumber))) + max(Re' +
        'ciptTypes.ReciptCaption) + max(Recipts.ReciptDate)'
      
        '            +'#39' = '#39'+ltrim(STR(sum(Items.InputEntity+Items.OutputE' +
        'ntity)))  AS ParentForm'
      '      FROM ReciptItems AS Items INNER JOIN'
      
        '           Recipts ON Items.ReciptID = Recipts.ReciptID AND Item' +
        's.ServerID = Recipts.ServerID AND Items.YearID = Recipts.YearID ' +
        'INNER JOIN'
      
        '           ReciptTypes ON Recipts.ReciptType = ReciptTypes.Recip' +
        'tType'
      
        '      WHERE ((Items.ReciptItemID = ReciptItems.preReciptItemID)O' +
        'R(Items.preReciptItemID = ReciptItems.ReciptItemID))'
      
        #9'    AND((Items.StuffCode = ReciptItems.StuffCode)) ) AS ParentF' +
        'orm'
      ''
      'FROM            Recipts INNER JOIN'
      
        '                         ReciptItems ON Recipts.ReciptID = Recip' +
        'tItems.ReciptID AND Recipts.ServerID = ReciptItems.ServerID AND ' +
        'Recipts.YearID = ReciptItems.YearID INNER JOIN'
      
        '                         StuffCoding ON ReciptItems.StuffCode = ' +
        'StuffCoding.c_StuffCode INNER JOIN'
      
        '                         ReciptTypes ON Recipts.ReciptType = Rec' +
        'iptTypes.ReciptType LEFT OUTER JOIN'
      
        '                         Customers ON ReciptItems.PersonID1 = Cu' +
        'stomers.CustID LEFT OUTER JOIN'
      
        '                         LookUps ON ReciptItems.SecondTypeItem =' +
        ' LookUps.LookUpID CROSS JOIN'
      '                         Fitful'
      'WHERE     (Recipts.ReciptType in ( :ReciptType ) ) '
      ' AND (Recipts.ReciptState < 3)'
      
        ' AND (Recipts.ReciptNumber BETWEEN :ReciptNumberFrom AND :Recipt' +
        'NumberTo ) '
      
        ' AND (Recipts.ReciptDate BETWEEN :ReciptDateFrom AND :ReciptDate' +
        'To )'
      
        ' AND (isnull(ReciptItems.PersonID1,0)   BETWEEN :PersonID1From A' +
        'ND :PersonID1To )'
      
        ' AND (ISNULL(ReciptItems.SecondTypeItem, 0) BETWEEN :SecondTypeI' +
        'temFrom AND :SecondTypeItemTo ) '
      
        ' AND (ISNULL(ReciptItems.ControlCode, 0) BETWEEN  :ControlCodeFr' +
        'om AND :ControlCodeTo )'
      
        ' AND (ReciptItems.StuffCode BETWEEN :StuffCodeFrom AND :StuffCod' +
        'eTo) '
      ' AND (ReciptItems.InputEntity<>0)'
      '')
    Left = 210
    Top = 296
