  object qryCustomersGroup: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'GroupType'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT      CustomerGrpID, CustomerGrpName + '#39'            '#1575#1586' '#1603#1583' ' +
        #39' + ltrim(str(StartCode))+'
      
        '   + '#39' '#1578#1575' '#1603#1583' '#39' + ltrim(str(FinishCode)) AS  CustomerGrpName , Fi' +
        'nishCode, StartCode, acc_TopicCode,*'
      'FROM       CustomersGroup'
      'WHERE     (GroupType = :GroupType )'
      '')
    Left = 584
    Top = 146
  end
  object qryCustomers: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    AfterOpen = qryCustomersAfterOpen
    AfterInsert = qryCustomersAfterInsert
    AfterEdit = qryCustomersAfterEdit
    BeforePost = qryCustomersBeforePost
    AfterPost = qryCustomersAfterPost
    BeforeDelete = qryCustomersBeforeDelete
    AfterScroll = qryCustomersAfterScroll
    Parameters = <
      item
        Name = 'GrpIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'GrpIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 9999999
      end
      item
        Name = 'GroupType'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     *'
      'FROM     Customers'
      'WHERE   (CustomerGrpID BETWEEN :GrpIDFrom and :GrpIDTo) AND'
      '        (CustID <> 0) AND'
      
        '        (CustomerGrpID in (SELECT CustomerGrpID FROM CustomersGr' +
        'oup WHERE GroupType= :GroupType ))'
      '')
    Left = 672
    Top = 224
