      item
        Name = 'LastArchiveID'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      'SELECT LMD.AccTopicCode, LMD.AccDetailCode'
      ', LMD.AccCTopicCode, LMD.AccCTopicCode2, LMD.AccCTopicCode3,'
      'SUM(LMD.debt) AS debt, SUM(LMD.credit) AS credit,'
      'CAST('#39'0'#39' AS varchar(200)) AS InfoName_L1, 0 AS PersonelNO,'
      'CAST('#39'0'#39' AS varchar(200)) AS PeronName,'
      'CAST( (CASE WHEN MIN(InfoName_L1) <> MAX(InfoName_L1)'
      'THEN :Note1 + MIN(InfoName_L1) + '#39' ... '#39' + MAX(InfoName_L1)'
      'ELSE :Note2 +'
      
        'MIN(InfoName_L1) END) AS varchar(1500)) AS Dec, Fitful.FitfulNot' +
        'e AS _Dec'
      'FROM Pay.LabelMakeDocuments( :PersonalFrom , :PersonalTo ,'
      
        ' :OfficeFrom, :FirstLabelID ,:CurentLabelID , :OlderLabelID, :Mo' +
        'nth_,'
      ':YearMounth , :PersonelStateFrom, :PersonelStateTo,'
      
        ':EmployTypeIDFrom, :EmployTypeIDTo, :subcompanyCode, :ProjectIDF' +
        'rom, :ProjectIDTo'
      
        ', :InsuranceIDs , :FirstArchiveID ,:LastArchiveID ) AS LMD CROSS' +
        ' JOIN'
      'dbo.Fitful'
      
        'GROUP BY LMD.AccTopicCode, LMD.AccDetailCode, LMD.AccCTopicCode,' +
        ' LMD.AccCTopicCode2,'
      'LMD.AccCTopicCode3,LMD.BedBes, Fitful.FitfulNote')
