      item
        Name = 'LabelIDTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      ''
      ''
      'SELECT Docs.AccTopicCode, Docs.AccDetailCode,'
      'Docs.AccCTopicCode, Docs.AccCTopicCode2,'
      'Docs.AccCTopicCode3, SUM(Docs.debt) AS debt, '
      'SUM(Docs.credit) AS credit,'
      'CAST( '#39'0'#39' AS varchar(200)) AS InfoName_L1, 0 AS PersonelNO,'
      'CAST( '#39'0'#39' AS varchar(200)) AS PeronName,'
      'CAST( (CASE WHEN MIN(InfoName_L1) <> MAX(InfoName_L1) '
      'THEN '#39#1587#1606#1583' '#1581#1602#1608#1602' _ '#39' + MIN(InfoName_L1) + '#39' ...'
      #39' + MAX(InfoName_L1) ELSE '#39#1587#1606#1583' '#1581#1602#1608#1602' _ '#39' + MIN(InfoName_L1) END)'
      '+case when EmployerShare=0 then '#39'_'#1587#1607#1605' '#1705#1575#1585#1601#1585#1605#1575#39' else '#39#39' end'
      'AS varchar(1500)) AS Dec'
      ', Fitful.FitfulNote AS _Dec'
      'FROM Pay.MakeDocuments(:PersonalFrom,:PersonalTo, :OfficeFrom'
      ', :FirstArchiveID , :LastArchiveID , :Month_'
      ',:YearMounth,:PersonelStateFrom , :PersonelStateTo ,'
      
        ':EmployTypeIDFrom , :EmployTypeIDTo , :subcompanyCode , :Project' +
        'IDFrom ,'
      ':ProjectIDTo , :InsuranceIDs  ,:LabelIDFrom  , :LabelIDTo )'
      'AS Docs CROSS JOIN'
      'dbo.Fitful'
      
        'GROUP BY Docs.AccTopicCode, Docs.AccDetailCode, Docs.AccCTopicCo' +
        'de,'
      'Docs.AccCTopicCode2,'
      
        'Docs.AccCTopicCode3, Docs.bedbes, Fitful.FitfulNote,EmployerShar' +
        'e'
      'HAVING (SUM(Docs.debt) > 0) OR'
      '(SUM(Docs.credit) > 0)'
      'ORDER BY CASE WHEN SUM(debt) > 0 THEN 0 ELSE 1 END')
    Left = 286
    Top = 278
