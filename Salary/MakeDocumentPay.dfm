        Name = 'LabelIDTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      
        'SELECT        RetardMakeDocuments.AccTopicCode, RetardMakeDocume' +
        'nts.AccDetailCode,'
      
        ' RetardMakeDocuments.AccCTopicCode, RetardMakeDocuments.AccCTopi' +
        'cCode2'
      ', RetardMakeDocuments.AccCTopicCode3,'
      
        '                         SUM(RetardMakeDocuments.debt) AS debt, ' +
        'SUM(RetardMakeDocuments.credit) AS credit,'
      
        '                          CAST('#39'0'#39' AS varchar(200)) AS InfoName_' +
        'L1, 0 AS PersonelNO,'
      
        '                          CAST('#39'0'#39' AS varchar(200)) AS PeronName' +
        ','
      
        '                         CAST( (CASE WHEN MIN(InfoName_L1) <> MA' +
        'X(InfoName_L1)'
      
        '                         THEN '#39#1587#1606#1583' '#1605#1593#1608#1602#1607' '#1581#1602#1608#1602' _'#39' + MIN(InfoName_' +
        'L1) + '#39' ... '#39' + MAX(InfoName_L1)'
      '                         ELSE '#39#1587#1606#1583' '#1605#1593#1608#1602#1607' '#1581#1602#1608#1602' _ '#39' +'
      
        '                         MIN(InfoName_L1) END) AS varchar(1500))' +
        '  AS Dec, Fitful.FitfulNote AS _Dec'
      
        'FROM Pay.RetardMakeDocuments(:PersonalFrom, :PersonalTo, :Office' +
        'From, :FirstArchiveID,'
      ':CurentArchiveID, :OlderArchiveID, :Month_,'
      ' :YearMounth , :PersonelStateFrom, :PersonelStateTo,'
      
        '                         :EmployTypeIDFrom, :EmployTypeIDTo, :su' +
        'bcompanyCode, :ProjectIDFrom, :ProjectIDTo'
      
        '                         , :InsuranceIDs  , :LabelIDFrom  , :Lab' +
        'elIDTo  ) AS RetardMakeDocuments CROSS JOIN'
      '                         dbo.Fitful'
      
        'GROUP BY RetardMakeDocuments.AccTopicCode, RetardMakeDocuments.A' +
        'ccDetailCode, RetardMakeDocuments.AccCTopicCode'
      
        ', RetardMakeDocuments.AccCTopicCode2, RetardMakeDocuments.AccCTo' +
        'picCode3,'
      
        '                         RetardMakeDocuments.BedBes, Fitful.Fitf' +
        'ulNote'
      '')
    Left = 414
    Top = 318
