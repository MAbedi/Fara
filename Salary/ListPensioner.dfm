  object SrcListPensioner: TDataSource
    DataSet = qryListPensioner
    Left = 112
    Top = 205
  end
  object qryListPensioner: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qryListPensionerAfterOpen
    Parameters = <
      item
        Name = 'insuranceIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'insuranceIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'ArchiveID'
        Size = -1
        Value = Null
      end
      item
        Name = 'MonthNo'
        Size = -1
        Value = Null
      end
      item
        Name = 'FormType'
        Size = -1
        Value = Null
      end
      item
        Name = 'MonthNo2'
        Size = -1
        Value = Null
      end
      item
        Name = 'ArchiveID2'
        Size = -1
        Value = Null
      end
      item
        Name = 'insuranceIDFrom2'
        Size = -1
        Value = Null
      end
      item
        Name = 'insuranceIDTo2'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     InfoName_L1, InfoName_L2, 0 AS ShowListKind,'
      
        '                          (SELECT     isnull(SUM(FixedCalculated' +
        '.Price), 0) AS WageValue'
      
        '                             FROM Pay.PersonelInfo LEFT OUTER JO' +
        'IN'
      
        '                      Pay.InsuranceCONSTinfo ON PersonelInfo.ins' +
        'uranceID = InsuranceCONSTinfo.insuranceNo LEFT OUTER JOIN'
      
        '                      Pay.FixedCalculated ON PersonelInfo.Person' +
        'elNo = FixedCalculated.PersonelNO'
      
        '                             WHERE    (PersonelInfo.insuranceID ' +
        'between :insuranceIDFrom and :insuranceIDTo) AND (ArchiveID = :A' +
        'rchiveID) AND (SalaryID IN'
      
        '                                      (SELECT pay.SalaryRange.Sa' +
        'laryID'
      
        '                                        FROM Pay.FormsInfo INNER' +
        ' JOIN'
      
        '                                         pay.SalaryRange ON pay.' +
        'FormsInfo.FormInfoID = pay.SalaryRange.FormInfoID'
      
        '                                          WHERE     (pay.FormsIn' +
        'fo.FormType = a.FormType) AND'
      
        '                                                    (pay.FormsIn' +
        'fo.InfoID = a.InfoID))) AND'
      
        '                                                   (Mounth = :Mo' +
        'nthNo)) AS Pensioner,'
      '                      '#39#39' AS OldPensioner, '#39#39' AS PayPensioner'
      'FROM         Pay.FormsInfo a'
      'WHERE     (FormType = :FormType)'
      'UNION ALL'
      'SELECT'
      '  CASE Pay.FixedCalculated.ShowListKind'
      
        '      WHEN 4 THEN ltrim(CAST(pay.InsuranceCONSTinfo.Employershar' +
        'e as varchar(10))+'#39' '#1583#1585#1589#1583' '#39'+ pay.InsuranceCONSTinfo.insurancename' +
        ')'
      
        '      WHEN 2 THEN ltrim(CAST(pay.InsuranceCONSTinfo.Employeeshar' +
        'e  as varchar(10))+'#39' '#1583#1585#1589#1583' '#39'+pay.InsuranceCONSTinfo.insurancename' +
        ')'
      ''
      
        '      ELSE '#39#1605#1588#1605#1608#1604' '#39' + pay.InsuranceCONSTinfo.insurancename END A' +
        'S InfoName_L1, pay.InsuranceCONSTinfo.insurancename AS InfoName_' +
        'L2,'
      
        '      Pay.FixedCalculated.ShowListKind, SUM(Pay.FixedCalculated.' +
        'Price) AS Pensioner, '#39#39' AS OldPensioner, '#39#39' AS PayPensioner'
      'FROM         Pay.FixedCalculated LEFT OUTER JOIN'
      '                      pay.InsuranceCONSTinfo INNER JOIN'
      
        '                      Pay.PersonelInfo ON pay.InsuranceCONSTinfo' +
        '.insuranceNo = Pay.PersonelInfo.insuranceID ON '
      
        '                      Pay.FixedCalculated.SalaryID = pay.Insuran' +
        'ceCONSTinfo.FormInfoID AND Pay.FixedCalculated.PersonelNO = pay.' +
        'PersonelInfo.PersonelNo'
      'WHERE     (Pay.FixedCalculated.Mounth = :MonthNo2)'
      'AND (Pay.FixedCalculated.ArchiveID = :ArchiveID2)'
      
        'AND (Pay.PersonelInfo.insuranceID between :insuranceIDFrom2 and ' +
        ':insuranceIDTo2)'
      'AND      (Pay.FixedCalculated.ShowListKind IN (2, 3, 4))'
      
        'GROUP BY Pay.FixedCalculated.ShowListKind, pay.InsuranceCONSTinf' +
        'o.insurancename, pay.InsuranceCONSTinfo.Employershare,'
      '                      pay.InsuranceCONSTinfo.Employeeshare'
      '')
    Left = 120
    Top = 141
    object qryListPensionerInfoName_L1: TStringField
      Tag = 3
      DisplayLabel = #1593#1606#1608#1575#1606
      FieldName = 'InfoName_L1'
      Size = 255
    end
