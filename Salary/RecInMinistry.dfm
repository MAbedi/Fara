  object qryPersonelInfo: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     PersonelNo, name_L1 + '#39' '#39' + lastName_L1 AS PersonelNa' +
