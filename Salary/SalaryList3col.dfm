  object qrysalary: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'ArchiveID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'Mounth'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 6
      end
      item
        Name = 'YearID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'FromPersonelNo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'ToPersonelNo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 999999
      end>
    SQL.Strings = (
      
        'SELECT     FixedCalculated.PersonelNO, PersonelInfo.name_L1 + '#39' ' +
        #39' + PersonelInfo.lastName_L1 AS PersonName, '
      
        '                      SUM(CASE ShowlistKind WHEN 1 THEN price EL' +
        'SE 0 END) AS SumWage, '
      ''
      ' sum( case ShowlistKind when 2  then price else 0 end ) +'
      
        '       Sum( case  when ShowlistKind=11 and bedbes = 2 then price' +
        ' else 0 end ) as SumDec ,'
      ''
      'SUM(CASE ShowlistKind WHEN 1 THEN price ELSE 0 END) '
      
        '                      - (SUM(CASE ShowlistKind WHEN 2 THEN price' +
        ' ELSE 0 END) + SUM(CASE WHEN ShowlistKind = 11 AND bedbes = 2 TH' +
        'EN price ELSE 0 END)) '
      '                      AS PayableSalary,PersonelInfo.Mobile'
      'FROM Pay.FixedCalculated LEFT OUTER JOIN'
      
        '                      Pay.PersonelInfo ON FixedCalculated.Person' +
        'elNO = PersonelInfo.PersonelNo'
      'WHERE (FixedCalculated.ArchiveID = :ArchiveID) '
      'AND (FixedCalculated.Mounth = :mounth) '
      'AND (FixedCalculated.YearID= :YearID) '
      
        'AND (FixedCalculated.PersonelNO BETWEEN :FromPersonelNo AND :ToP' +
        'ersonelNo)'
      
        'GROUP BY FixedCalculated.PersonelNO, PersonelInfo.name_L1 + '#39' '#39' ' +
        '+ PersonelInfo.lastName_L1,PersonelInfo.Mobile'
      ''
      'ORDER BY FixedCalculated.PersonelNO'
      '')
    Left = 56
    Top = 160
    object qrysalaryPersonelNO: TIntegerField
      Tag = 3
      DisplayLabel = #1588' '#1662#1585#1587#1606#1604
      DisplayWidth = 14
      FieldName = 'PersonelNO'
