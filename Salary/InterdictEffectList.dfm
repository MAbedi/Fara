  object qrySalary: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qrySalaryAfterOpen
    Parameters = <>
    SQL.Strings = (
      
        'SELECT      Pay.FormTypes.FormCaption_L1, Pay.FormTypes.FormCapt' +
        'ion_L2, Pay.FormsInfo.FormType, Pay.FormsInfo.InfoID, '
      
        '                      Pay.FormsInfo.InfoName_L1, Pay.FormsInfo.I' +
        'nfoName_L2, Pay.FormsInfo.FormInfoID, allfunction.*'
      'FROM         Pay.FormsInfo INNER JOIN'
      
        '                      Pay.FormTypes ON Pay.FormsInfo.FormType = ' +
        'Pay.FormTypes.FormType INNER JOIN'
      
        '                          (SELECT     FormInfoID, SalaryID, Amou' +
        'nt'
      
        '                             FROM         Pay.FormInfoItems) all' +
        'function ON Pay.FormsInfo.FormInfoID = allfunction.FormInfoID'
      'WHERE     (Pay.FormTypes.KargozinyEffectKind <> 0)'
      'ORDER BY Pay.FormsInfo.FormType')
    Left = 40
    Top = 64
  end
  object srcSalary: TDataSource
    DataSet = qrySalary
    Left = 104
    Top = 64
  end
  object qryWage: TADOQuery
    Connection = DmF.adcsalary
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     Pay.FormsInfo.FormInfoID, Pay.FormsInfo.InfoName_L1, ' +
        'Pay.FormsInfo.InfoName_L2, Pay.FormTypes.FormType'
      'FROM         Pay.FormsInfo INNER JOIN'
      
        '                      Pay.FormTypes ON Pay.FormsInfo.FormType = ' +
        'Pay.FormTypes.FormType'
      'WHERE     (Pay.FormTypes.FormType = 22)')
    Left = 560
    Top = 8
  end
