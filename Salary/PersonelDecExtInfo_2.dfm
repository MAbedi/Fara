  object qry_Items: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    AfterOpen = qry_ItemsAfterOpen
    AfterInsert = qry_ItemsAfterInsert
    BeforeEdit = qry_ItemsBeforeEdit
    AfterEdit = qry_ItemsAfterEdit
    BeforePost = qry_ItemsBeforePost
    AfterPost = qry_ItemsAfterPost
    BeforeDelete = qry_ItemsBeforeDelete
    OnCalcFields = qry_ItemsCalcFields
    Parameters = <
      item
        Name = 'Mounth'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'YearIDFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'YearIDTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'FormInfo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'OfficeFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'OfficeTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'YearID'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      'SELECT *'
      
        '   ,  Pay.Fn_GetCOUNTFun( :Mounth  , PersonelDecExt.PersonelNo ,' +
        ' :YearIDFrom , :YearIDTo ) as HasFun'
      'FROM Pay.PersonelDecExt'
      ''
      'where   (FormInfoID =:FormInfo)'
      'AND (PersonelNo IN'
      '  (SELECT     PersonelInfo.PersonelNo'
      '    FROM Pay.Interdicts INNER JOIN'
      
        '    Pay.PersonelInfo ON Pay.Interdicts.PersonelNo = PersonelInfo' +
        '.PersonelNo LEFT OUTER JOIN'
      
        '    Pay.FormsInfo ON PersonelInfo.PersonelState = FormsInfo.Form' +
        'InfoID LEFT OUTER JOIN'
      
        '   Pay.FormsInfo AS FormsInfoOffice ON Pay.Interdicts.OfficeCode' +
        ' = FormsInfoOffice.FormInfoID'
      '                             WHERE     (Interdicts.State < 49) '
      'AND (FormsInfoOffice.InfoID BETWEEN :OfficeFrom AND :OfficeTo)))'
      'AND YearID = :YearID '
      ''
      '')
    Left = 520
    Top = 197
