  object qrysalary: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    AfterOpen = qrysalaryAfterOpen
    Parameters = <
      item
        Name = 'Mounth'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end
      item
        Name = 'FromInfoID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'ToInfoID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'YearID'
        Size = -1
        Value = Null
      end
      item
        Name = 'Years'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     *'
      'FROM Pay.SalaryListProjectGroup'
      
        'WHERE     (Mounth = :mounth) AND (InfoID BETWEEN :FromInfoID AND' +
        ' :ToInfoID)'
      'AND (YearID = :YearID)'
      'AND (Years = :Years)')
    Left = 112
    Top = 224
  end
  object srcSalary: TDataSource
    DataSet = qrysalary
    Left = 192
    Top = 160
  end
  object qryWage: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'ProjectIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'ProjectIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'Mounth'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end
      item
        Name = 'YearID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'Years'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     FixedCalculated.SalaryID, FormsInfo.InfoName_L1, Form' +
        'sInfo.FormInfoID'
      'FROM Pay.FixedCalculated LEFT OUTER JOIN'
      
        '                      Pay.FormsInfo FormsInfo_1 ON FixedCalculat' +
        'ed.ProjectID = FormsInfo_1.FormInfoID LEFT OUTER JOIN'
      
        '                      Pay.FormsInfo ON FixedCalculated.SalaryID ' +
        '= FormsInfo.FormInfoID'
      'WHERE     (FixedCalculated.ShowListKind = 1) '
      
        'AND (FormsInfo_1.InfoID BETWEEN :ProjectIDFrom  AND :ProjectIDTo' +
        ' )'
      'AND (FixedCalculated.Mounth > :Mounth)'
      'AND (FixedCalculated.YearID = :YearID)'
      'AND (FixedCalculated.Years = :Years)'
      
        'GROUP BY FixedCalculated.SalaryID, FormsInfo.InfoName_L1, FormsI' +
        'nfo.FormInfoID'
      'ORDER BY FixedCalculated.SalaryID')
    Left = 369
    Top = 167
  end
  object qryDec: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'Mounth'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end
      item
        Name = 'YearID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'Years'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT      FixedCalculated.SalaryID, MAX(CASE WHEN InsuranceCON' +
        'STinfo.InsuranceLabel_L1 IS NULL '
      
        '                      THEN FormsInfo.InfoName_L1 ELSE InsuranceC' +
        'ONSTinfo.InsuranceLabel_L1 END) AS InfoName_L1, FormsInfo.FormIn' +
        'foID'
      'FROM Pay.FormsInfo FormsInfo_1 RIGHT OUTER JOIN'
      
        '                      Pay.FixedCalculated ON FormsInfo_1.FormInf' +
        'oID = FixedCalculated.ProjectID LEFT OUTER JOIN'
      '                      Pay.InsuranceCONSTinfo RIGHT OUTER JOIN'
      
        '                      Pay.FormsInfo ON InsuranceCONSTinfo.FormIn' +
        'foID = FormsInfo.FormInfoID ON'
      
        '                      FixedCalculated.SalaryID = FormsInfo.FormI' +
        'nfoID'
      'WHERE     (FixedCalculated.ShowListKind = 2)'
      'AND (FixedCalculated.Mounth >:Mounth)'
      'AND (FixedCalculated.YearID = :YearID)'
      'AND (FixedCalculated.Years = :Years)'
      
        'GROUP BY FixedCalculated.SalaryID, FormsInfo.InfoName_L1, FormsI' +
        'nfo.FormInfoID'
      'ORDER BY FixedCalculated.SalaryID')
    Left = 352
    Top = 276
  end
