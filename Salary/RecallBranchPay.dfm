  object qryTypes: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qryTypesAfterOpen
    AfterScroll = qryTypesAfterScroll
    Parameters = <>
    SQL.Strings = (
      
        'SELECT DISTINCT FormsInfo.FormInfoID, FormTypes.FormCaption_L1 +' +
        ' '#39'-'#39' + FormsInfo.InfoName_L1 AS Caption'
      ', FormTypes.AidInfo1Caption, FormTypes.AidInfo2Caption'
      'FROM Pay.PersonelDecExt INNER JOIN'
      
        '                         Pay.FormsInfo ON PersonelDecExt.FormInf' +
        'oID = FormsInfo.FormInfoID INNER JOIN'
      
        '                         Pay.FormTypes ON FormsInfo.FormType = F' +
        'ormTypes.FormType'
      '')
    Left = 680
    Top = 124
    object qryTypesFormInfoID: TIntegerField
      FieldName = 'FormInfoID'
    end
    object qryTypesCaption: TStringField
      DisplayLabel = #1593#1606#1608#1575#1606' '#1601#1585#1605
      FieldName = 'Caption'
      ReadOnly = True
      Size = 406
    end
    object qryTypesAidInfo1Caption: TStringField
      FieldName = 'AidInfo1Caption'
      Size = 50
    end
    object qryTypesAidInfo2Caption: TStringField
      FieldName = 'AidInfo2Caption'
      Size = 50
    end
  end
  object qryTypesItems: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryTypesItemsAfterOpen
    Parameters = <>
    SQL.Strings = (
      '-------    '#1583#1585' '#1582#1608#1583' '#1601#1585#1605' '#1578#1594#1740#1740#1585#1575#1578' '#1575#1593#1605#1575#1604' '#1605#1740' '#1588#1608#1583
      
        'SELECT        Fitful.FitfulID AS _checked, EmployeeInfo.Personel' +
        'Name_L1, PersonelDecExt.*'
      'FROM Pay.PersonelDecExt INNER JOIN'
      
        '                         Pay.FormsInfo ON PersonelDecExt.FormInf' +
        'oID = FormsInfo.FormInfoID INNER JOIN'
      
        '                         Pay.FormTypes ON FormsInfo.FormType = F' +
        'ormTypes.FormType INNER JOIN'
      
        '                         EmployeeInfo ON PersonelDecExt.Personel' +
        'No = EmployeeInfo.PersonelNo CROSS JOIN'
      '                         Fitful'
      'WHERE        (FormsInfo.FormInfoID = 114)'
      ' AND (FirstMounth BETWEEN 0 AND 9)')
    Left = 176
    Top = 113
  end
