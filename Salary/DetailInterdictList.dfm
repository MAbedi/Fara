  object qrySalary: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    AfterOpen = qrySalaryAfterOpen
    Parameters = <>
    SQL.Strings = (
      
        'SELECT FormsInfo.InfoID AS InfoID , FormsInfo.InfoName_L1 AS Inf' +
        'oName_L1,'
      'count(Interdicts.InterdictID) as countID'
      
        ', sum(Wage600) AS SumWage600, sum(Wage601) AS SumWage601, sum(Wa' +
        'ge602) AS SumWage602, sum(Wage603) AS SumWage603, sum(Wage604) A' +
        'S SumWage604, sum(Wage606) AS SumWage606, sum(Wage607) AS SumWag' +
        'e607, sum(Wage608) AS SumWage608, sum(Wage609) AS SumWage609, su' +
        'm(Wage626) AS SumWage626, sum(Wage627) AS SumWage627, sum(Wage62' +
        '8) AS SumWage628, sum(Wage629) AS SumWage629, sum(Wage631) AS Su' +
        'mWage631, sum(Wage632) AS SumWage632, sum(Wage634) AS SumWage634' +
        ', sum(Wage635) AS SumWage635, sum(Wage636) AS SumWage636, sum(Wa' +
        'ge637) AS SumWage637, sum(Wage638) AS SumWage638, sum(Wage639) A' +
        'S SumWage639, sum(Wage640) AS SumWage640, sum(Wage641) AS SumWag' +
        'e641, sum(Wage642) AS SumWage642, sum(Wage699) AS SumWage699, su' +
        'm(Wage700) AS SumWage700, sum(Wage767) AS SumWage767, sum(Wage76' +
        '8) AS SumWage768'
      ',sum(sum) as allssum '
      'FROM Pay.Interdicts LEFT OUTER JOIN'
      '(SELECT  InterdictItems.InterdictID '
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=600 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage600'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=601 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage601'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=602 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage602'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=603 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage603'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=604 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage604'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=606 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage606'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=607 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage607'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=608 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage608'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=609 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage609'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=626 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage626'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=627 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage627'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=628 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage628'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=629 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage629'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=631 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage631'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=632 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage632'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=634 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage634'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=635 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage635'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=636 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage636'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=637 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage637'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=638 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage638'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=639 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage639'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=640 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage640'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=641 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage641'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=642 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage642'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=699 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage699'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=700 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage700'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=767 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage767'
      
        ', isnull(SUM(CASE WHEN InterdictItems.SalaryID=768 THEN Interdic' +
        'tItems.Amount END), 0) AS Wage768'
      ', isnull(SUM(InterdictItems.Amount) , 0) AS sum'
      'FROM Pay.InterdictItems LEFT OUTER JOIN'
      
        'Interdicts ON InterdictItems.InterdictID = Interdicts.InterdictI' +
        'D'
      'WHERE (Interdicts.PersonelNo BETWEEN 0 AND 999999)'
      'GROUP BY InterdictItems.InterdictID)wage'
      ''
      'ON Pay.Interdicts.InterdictID = wage.InterdictID LEFT OUTER JOIN'
      
        'FormsInfo Pay.FormsInfo ON Pay.Interdicts.OfficeCode = FormsInfo' +
        '.FormInfoID INNER JOIN'
      
        'EmployeeInfo ON Pay.Interdicts.PersonelNo = EmployeeInfo.Persone' +
        'lNo'
      
        'group by FormsInfo.InfoID , FormsInfo.InfoName_L1 , FormsInfo.In' +
        'foName_l2')
    Left = 40
    Top = 64
  end
  object srcSalary: TDataSource
    DataSet = qrySalary
    Left = 104
    Top = 64
  end
  object qryWage: TADOQuery
    Connection = DmF.adcsalary
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     Pay.FormsInfo.FormInfoID, Pay.FormsInfo.InfoName_L1, ' +
        'Pay.FormsInfo.InfoName_L2, Pay.FormTypes.FormType'
      'FROM         Pay.FormsInfo INNER JOIN'
      
        '                      Pay.FormTypes ON Pay.FormsInfo.FormType = ' +
        'Pay.FormTypes.FormType'
      'WHERE     (Pay.FormTypes.FormType = 22)')
    Left = 560
    Top = 8
  end
