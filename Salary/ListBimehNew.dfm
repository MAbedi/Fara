  object qryPersonelsBackup: TADOQuery
    AutoCalcFields = False
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'FDaily'
        Size = -1
        Value = Null
      end
      item
        Name = 'FHours'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearMounth'
        DataType = ftString
        Size = 5
        Value = '86/02'
      end
      item
        Name = 'PersonelNoFrom'
        DataType = ftString
        Size = 1
        Value = '1'
      end
      item
        Name = 'PersonelNoTo'
        DataType = ftString
        Size = 6
        Value = '1'
      end
      item
        Name = 'FirstArchiveId'
        DataType = ftWideString
        Size = 2
        Value = '-5'
      end
      item
        Name = 'LastArchiveId'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'Mounth'
        DataType = ftString
        Size = 1
        Value = '2'
      end
      item
        Name = 'StateFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'StateTo'
        DataType = ftString
        Size = 3
        Value = '999'
      end
      item
        Name = 'PrvInfoID'
        DataType = ftInteger
        Size = 3
        Value = Null
      end
      item
        Name = 'EmployTypeFROM'
        DataType = ftInteger
        Size = -1
        Value = Null
      end
      item
        Name = 'EmployTypeTo'
        DataType = ftInteger
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        PersonelNo, :FDaily * FDaily AS FDaily, :FHours * ' +
        'FHours AS FHours , PersonStateNo, personelstate_L1, PersonelName' +
        '_L1, fatherName_L1, Nationality_L1, BirthDate, SodurDate, BirthP' +
        'lace_L1, NationalID, '
      
        '                         IDNumber, Sex_L1, licence_L1, employDat' +
        'e, finishEmployDate, InsuranceNumber, lastName_L1, name_L1, Sodu' +
        'rPlace_L1, JobName, PercentWound, '
      
        '                         AccountNumber, SumWage, PostalCode, con' +
        'tainpay, ContainWage, ContainPayAndWage, PayAndWage, AidContainI' +
        'nsourance, InsouranceEmploye, '
      
        '                         InsouranceEmployer, InsouranceInaction,' +
        ' InsouranceHardWork, InsouranceAll, ContainTax, TaxValue, SumDec' +
        ', PayableSalary, insuranceID, insurancename, '
      
        '                         DSW_JOB, DaySalary, PeopleExempt, daily' +
        'wage, Mobile, PayAndWage - SumDec AS PayAndWage_SumDec, '
      
        '                         SumDec - InsouranceEmploye AS SumDec_In' +
        'souranceEmploye, PayAndWage - SumDec AS '#39#1602#1575#1576#1604' '#1662#1585#1583#1575#1582#1578'2'#39', CASE WHE' +
        'N (DaySalary < dailywage) AND '
      
        '                         (DaySalary > 0) THEN 1 ELSE 0 END AS Da' +
        'ySalary_dailywage'
      ''
      
        'FROM Pay.InsouranceForBime(:CompanyCodeFrom , :CompanyCodeTo , :' +
        'YearMounth,  0,  2 , :PersonelNoFrom,'
      
        '      :PersonelNoTo,   :FirstArchiveId  , :LastArchiveId , :Moun' +
        'th, :StateFrom, :StateTo , :PrvInfoID  ,  :EmployTypeFROM  , :Em' +
        'ployTypeTo ) InsouranceForBime'
      ''
      ''
      ''
      ''
      ' ')
    Left = 223
    Top = 150
  end
  object ADOQuery1: TADOQuery
    AutoCalcFields = False
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qryPersonelsAfterOpen
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'FHours'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'YearMounth'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PersonelNoFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PersonelNoTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'FirstArchiveId'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'LastArchiveId'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'Mounth'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'StateFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'StateTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PrvInfoID'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      
        'SELECT        PersonelNo, FDaily AS FDaily, :FHours * FHours AS ' +
        'FHours , PersonStateNo, personelstate_L1, PersonelName_L1, fathe' +
        'rName_L1, Nationality_L1, BirthDate, SodurDate, BirthPlace_L1, N' +
        'ationalID,'
      
        '                         IDNumber, Sex_L1, licence_L1, employDat' +
        'e, finishEmployDate, InsuranceNumber, lastName_L1, name_L1, Sodu' +
        'rPlace_L1, JobName, PercentWound,'
      '                         AccountNumber, SumWage, PostalCode,'
      '            case when  containpay  =0 then 0 else'
      
        '              case when containpay + (case when (select MinBenef' +
        'itsInsuranceList from Pay.config )> 0 then (select MinBenefitsIn' +
        'suranceList from Pay.config ) else benprice end ) >=  insuranceU' +
        'pPrice'
      
        #9'  '#9#9#9#9'          then containpay  - (case when (select MinBenefi' +
        'tsInsuranceList from Pay.config )> 0 then (select MinBenefitsIns' +
        'uranceList from Pay.config ) else benprice end )'
      '                    else   containpay'
      '              end'
      '            end  as containpay,'
      ''
      '            ContainPayAndWage -'
      '                             ('
      
        '                                case when  containpay  =0 then 0' +
