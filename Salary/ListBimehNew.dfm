        Name = 'LabelIDTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      
        'SELECT       :FHours * FHours AS FHours , YearMounth, PersonelNo' +
        ', OfficeCode, EmployID, marriageCode, FDaily, FHours AS Expr1, S' +
        'tandardDays, PersonStateNo, personelstate_L1, PersonelName_L1, f' +
        'atherName_L1, '
      
        '                         Nationality_L1, BirthDate, SodurDate, B' +
        'irthPlace_L1, NationalID, IDNumber, Sex_L1, licence_L1, employDa' +
        'te, finishEmployDate, InsuranceNumber, lastName_L1, name_L1, Sod' +
        'urPlace_L1, JobName, PercentWound, '
      
        '                         AccountNumber, SumWage, PostalCode, Day' +
        'Salary, DaySalary_DSW_INC, containpay, DSW_INC, containpay_DSW_I' +
        'NC, ContainWage, DSW_SPOUSE, ContainWage_DSW_SPOUSE, ContainPayA' +
        'ndWage, PayAndWage, '
      
        '                         PayAndWage_SumDec, SumDec_InsouranceEmp' +
        'loye, AidContainInsourance, InsouranceEmploye, InsouranceEmploye' +
        'r, InsouranceInaction, InsouranceHardWork, InsouranceAll, Contai' +
        'nTax, TaxValue, SumDec, PayableSalary, '
      
        '                         insuranceID, insurancename, DSW_JOB, Pe' +
        'opleExempt, dailywage, Mobile, insuranceUpPrice, SickDay, benpri' +
        'ce, EmployTypeID, NationalityID, EydiAmount, SanavatOnlyAmount'
      ',Day_DSW_INC,Job_Desc ,NotIncluded'
      ''
      
        'FROM Pay.InsouranceForBime( :CompanyCodeFrom , :CompanyCodeTo , ' +
        ':YearMounth,  0,  2 , :PersonelNoFrom,'
      
        '      :PersonelNoTo,   :FirstArchiveId  , :LastArchiveId , :Moun' +
        'th, :StateFrom, :StateTo ,'
      
        '      :PrvInfoID , :MounthRetard  , :LabelIDFrom  , :LabelIDTo  ' +
        ') InsouranceForBime')
    Left = 319
    Top = 222
