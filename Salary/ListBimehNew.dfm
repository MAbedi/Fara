  object qryBimeh: TADOQuery
    AutoCalcFields = False
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'YearID'
        Size = -1
        Value = Null
      end
      item
        Name = 'Mounth'
        Size = -1
        Value = Null
      end
      item
        Name = 'FormInfoID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        InsuranceCONSTinfo.insuranceNo, InsuranceCONSTinfo' +
        '.FormInfoID, InsuranceCONSTinfo.insurancename, InsuranceCONSTinf' +
        'o.EmployerName, '
      
        '                         InsuranceCONSTinfo.workShop, InsuranceC' +
        'ONSTinfo.InsuranceLabel_L1, InsuranceCONSTinfo.InsuranceLabel_L2' +
        ', InsuranceCONSTinfo.Employeeshare, '
      
        '                         InsuranceCONSTinfo.Employershare, Insur' +
        'anceCONSTinfo.InactionInsuranceShare, InsuranceCONSTinfo.insuran' +
        'ceUp, InsuranceCONSTinfo.dailywage, '
      
        '                         InsuranceCONSTinfo.AccTopicCode, Insura' +
        'nceCONSTinfo.AccDetailCode, InsuranceCONSTinfo.AccCTopicCode, In' +
        'suranceCONSTinfo.AccCTopicCode2, '
      
        '                         InsuranceCONSTinfo.AccCTopicCode3, Insu' +
        'ranceCONSTinfo.tel, InsuranceCONSTinfo.address, InsuranceCONSTin' +
        'fo.HardShipPercent, '
      
        '                         InsuranceCONSTinfo.PeopleExempt, Insura' +
        'nceCONSTinfo.OffShootName_L1, InsuranceCONSTinfo.PostalCode, Ins' +
        'uranceCONSTinfo.PoorsantRate, '
      
        '                         InsuranceCONSTinfo.TaxCode, InsuranceCO' +
        'NSTinfo.MON_PYM, FormsInfo.FormType, FormsInfo.InfoID, FormsInfo' +
        '.InfoName_L1, FormsInfo.InfoName_L2, '
      
        '                         FormsInfo.PrvInfoID, FormsInfo.Amount, ' +
        'FormsInfo.Amount2, FormsInfo.Coefficient, FormsInfo.StandardDays' +
        ', FormsInfo.StandardTimes, FormsInfo.CalCulateType, '
      
        '                         FormsInfo.RecallFormInfoID1, FormsInfo.' +
        'RecallFormInfoID2, FormsInfo.WordDocuments, FormsInfo.RecalKindC' +
        'lock, FormsInfo.FirstAmount, FormsInfo.MaxDay, '
      
        '                         FormsInfo.MaxTime, FormsInfo.MuliplyInD' +
        'ay, FormsInfo.PayMentActive, FormsInfo.WageCalcKind, FormsInfo.F' +
        'ormInfoID2'
      ''
      ''
      ''
      
        'FROM Pay.InsuranceCONSTinfo_f ( :YearID, :Mounth) InsuranceCONST' +
        'info INNER JOIN'
      
        '                      Pay.FormsInfo ON InsuranceCONSTinfo.FormIn' +
        'foID = FormsInfo.FormInfoID'
      ''
      'WHERE     (InsuranceCONSTinfo.FormInfoID = :FormInfoID )'
      'AND (InsuranceCONSTinfo.workShop <> '#39'0'#39')')
    Left = 687
    Top = 224
