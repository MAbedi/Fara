  object qryPersonel: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qryPersonelAfterScroll
    Parameters = <
      item
        Name = 'Mounth'
        DataType = ftString
        Size = 1
        Value = '8'
      end
      item
        Name = 'Years'
        Size = -1
        Value = Null
      end
      item
        Name = 'Date'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'OfficeCodeFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'OfficeCodeTo'
        DataType = ftString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'PersonelNoFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PersonelNoTo'
        DataType = ftString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'EmployTypeIDFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'EmployTypeIDTo'
        DataType = ftString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'ProjectIDFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ProjectIDTo'
        DataType = ftWideString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'SubFunctionIDFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SubFunctionIDTo'
        DataType = ftWideString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'companyCodeFrom'
        DataType = ftSmallint
        Size = -1
        Value = 0
      end
      item
        Name = 'companyCodeTo'
        DataType = ftSmallint
        Size = -1
        Value = 99
      end>
    SQL.Strings = (
      
        'SELECT      Pay.PersonelInfo.PersonelNo, Pay.PersonelInfo.lastNa' +
        'me_L1 + '#39'  '#39' + Pay.PersonelInfo.name_L1 AS PersonName_L1,'
      
        '            Pay.PersonelInfo.lastName_L1  as lastName_L1, Pay.Pe' +
        'rsonelInfo.name_L1 AS FirstName_L1,'
      
        '            Pay.PersonelInfo.lastName_L2 + '#39'  '#39' + Pay.PersonelIn' +
        'fo.name_L2 AS PersonName_L2, PersonelInfo.fatherName_L1, Pay.For' +
        'msInfo.InfoID, Pay.FormsInfo.InfoName_L1,'
      
        '            Pay.FormsInfo.InfoName_L2, Pay.Interdicts.jobCode, I' +
        'SNULL(FunctionUsed.PersonelNo, 0) AS HasFunction, Pay.Interdicts' +
        '.OfficeCode,'
      
        '            FormsInfo_1.InfoName_L1, FormsInfo_1.InfoName_L2, In' +
        'terdicts.EmployTypeID,Pay.Interdicts.StandardEmployAmount,'
      
        '            ISNULL(FunctionUsed.FunCount, 0) AS FunCount , ISNUL' +
        'L(FunctionUsed.Situation, 99) AS Situation ,'
      
        '            Pay.Interdicts.InterdicEndDate , Pay.Interdicts.Inte' +
        'rdicStartDate'
      'FROM Pay.PersonelInfo INNER JOIN'
      
        '                         Pay.FormsInfo ON PersonelInfo.PersonelS' +
        'tate = FormsInfo.FormInfoID LEFT OUTER JOIN'
      
        '                         Pay.Interdicts ON PersonelInfo.Personel' +
        'No = Interdicts.PersonelNo LEFT OUTER JOIN'
      
        '                         Pay.FormsInfo AS FormsInfo_1 ON Pay.Int' +
        'erdicts.OfficeCode = FormsInfo_1.FormInfoID LEFT OUTER JOIN'
      
        '                             (SELECT        PersonelNo, COUNT(Pe' +
        'rsonelNo) AS FunCount , MAX(Situation) AS Situation'
      '                                FROM Pay.Functions'
      
        '                                WHERE        (Mounth = :Mounth )' +
        ' AND    ( Years = :Years  ) '
      
        '                                GROUP BY PersonelNo) AS Function' +
        'Used ON PersonelInfo.PersonelNo = FunctionUsed.PersonelNo LEFT O' +
        'UTER JOIN'
      
        '                         Pay.FormsInfo AS FormsInfoEmployTypeID ' +
        'ON Interdicts.EmployTypeID = FormsInfoEmployTypeID.FormInfoID LE' +
        'FT OUTER JOIN'
      
        '                         Pay.FormsInfo AS FormsInfo_Project ON I' +
        'nterdicts.ProjectID = FormsInfo_Project.FormInfoID LEFT OUTER JO' +
        'IN'
      
        '                         Pay.FormsInfo AS FormsInfo_SubFunctionI' +
        'D ON Interdicts.SubFunctionID = FormsInfo_SubFunctionID.FormInfo' +
        'ID'
      ''
      ''
      ''
      'WHERE'
      
        '  ((Pay.FormsInfo.InfoID < 50)  OR  :Date BETWEEN SUBSTRING(Inte' +
        'rdicts.InterdicStartDate, 1, 7) AND  SUBSTRING(Interdicts.Interd' +
        'icEndDate, 1, 7))'
      '   AND (Interdicts.State < 11) AND (Interdicts.InterdicType = 0)'
      ''
      
        '  AND (FormsInfo_1.InfoID BETWEEN :OfficeCodeFrom AND :OfficeCod' +
        'eTo)'
      
        '  AND (Pay.PersonelInfo.PersonelNo BETWEEN :PersonelNoFrom AND :' +
        'PersonelNoTo)'
      
        'AND (FormsInfoEmployTypeID.InfoID  BETWEEN :EmployTypeIDFrom  AN' +
        'D :EmployTypeIDTo )'
      
        'AND (FormsInfo_Project.InfoID  BETWEEN :ProjectIDFrom  AND :Proj' +
        'ectIDTo )'
      
        'AND (( Interdicts.SubFunctionID = 0 )OR(FormsInfo_SubFunctionID.' +
        'InfoID  BETWEEN :SubFunctionIDFrom  AND :SubFunctionIDTo ))'
      
        'AND((Interdicts.subcompanyCode = 0)OR(Interdicts.subcompanyCode ' +
        'BETWEEN :companyCodeFrom AND :companyCodeTo ))'
      ''
      'ORDER BY Pay.PersonelInfo.PersonelNo'
      '')
    Left = 698
    Top = 176
