    SQL.Strings = (
      
        'SELECT     Pay.FormsInfo.FormInfoID, Pay.FormsInfo.InfoID, Pay.F' +
        'ormsInfo.InfoName_L1, Pay.FormsInfo.InfoName_L2, Pay.FormsInfo.C' +
        'oefficient AS Fday,'
      
        '                      Pay.FormsInfo.Coefficient AS FTime, Pay.Fo' +
        'rmsInfo.AccTopicCode, Pay.FormsInfo.AccDetailCode, Pay.FormsInfo' +
        '.AccCTopicCode, '
      
        '                      Pay.FormsInfo.AccCTopicCode2, Pay.FormsInf' +
        'o.MaxDay, Pay.FormsInfo.MaxTime'
      
        ', Pay.FormsInfo.Coefficient AS FTimeH, Pay.FormsInfo.Coefficient' +
        ' AS FTimeM'
      'FROM         Pay.FormsInfo INNER JOIN'
      
        '                      Pay.FormTypes ON Pay.FormsInfo.FormType = ' +
        'Pay.FormTypes.FormType'
      'WHERE     (Pay.FormTypes.FunctionShow= 1)'
      'and Pay.FormsInfo.FormInfoID in ('
      'SELECT     SalaryID'
      'FROM Pay.F_SalaryRange(:FormInfoID, 0) F_SalaryRange'
      ')'
