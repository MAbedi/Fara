  object qryMissionType: TADOQuery
    AutoCalcFields = False
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryMissionTypeAfterOpen
    AfterInsert = qryMissionTypeAfterInsert
    Parameters = <
      item
        Name = 'Month'
        Attributes = [paSigned, paNullable]
        DataType = ftFloat
        NumericScale = 255
        Precision = 15
        Size = 10
        Value = 3.000000000000000000
      end
      item
        Name = 'PersonalFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PersonalTo'
        DataType = ftString
        Size = 9
        Value = '999999999'
      end>
    SQL.Strings = (
      
        'SELECT        abcd.AccTopicCode, abcd.AccDetailCode, abcd.AccCTo' +
        'picCode, abcd.AccCTopicCode2, abcd.AccCTopicCode3, abcd.debt AS ' +
        'debt1, abcd.credit, abcd._Dec, '
      '                         Fitful.FitfulID AS debt'
      ''
      ' FROM      (   '
      
        'SELECT     AccTopicCode, AccDetailCode, AccCTopicCode, AccCTopic' +
        'Code2, AccCTopicCode3, debt, credit, _Dec'
      
        'FROM         Pay.MakeDocuments_Mission( :Month , :PersonalFrom, ' +
        ':PersonalTo) AS MakeDocuments_Mission_1'
      ''
      ')abcd'
      ' CROSS JOIN'
      '                         dbo.Fitful')
    Left = 206
    Top = 222
  end
