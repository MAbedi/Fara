  object qryLoanSalary: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'FormInfoIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'FormInfoIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonelFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonelTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'Mounth'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end
      item
        Name = 'YearID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'Years'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'SELECT PersonelDecExt.PersonelNo'
      
        #9',PersonelInfo.name_L1 + '#39' '#39' + PersonelInfo.lastName_L1 AS Perso' +
        'neName_L1'
      
        #9',PersonelInfo.name_L2 + '#39' '#39' + PersonelInfo.lastName_L2 AS Perso' +
        'neName_L2'
      #9',FormsInfo.InfoName_L1 AS SalaryName_L1'
      #9',FormsInfo.InfoName_L2 AS SalaryName_L2'
      #9',PersonelDecExt.AidNo2'
      #9',PersonelDecExt.AidDate2'
      #9',FixedCalculated.Price'
      'FROM Pay.FixedCalculated'
      'INNER JOIN Pay.FormsInfo'
      
        'INNER JOIN Pay.PersonelDecExt ON FormsInfo.FormInfoID = Personel' +
        'DecExt.FormInfoID ON FixedCalculated.FormInfoID = PersonelDecExt' +
        '.FormInfoID'
      #9'AND FixedCalculated.SalaryID = PersonelDecExt.FormInfoID'
      #9'AND FixedCalculated.PersonelNO = PersonelDecExt.PersonelNo'
      #9'--AND   FixedCalculated.Price <= PersonelDecExt.EmployeeAmount'
      
        #9'AND FixedCalculated.FunctionID = PersonelDecExt.DecExtID INNER ' +
        'JOIN Pay.FixedCalActive() AS FixedCalActive ON FixedCalculated.M' +
        'ounth = FixedCalActive.Mounth'
      #9'AND FixedCalculated.ArchiveID = FixedCalActive.F_ArchiveID'
      #9'AND FixedCalculated.PersonelNO = FixedCalActive.PersonelNO'
      #9'AND FixedCalculated.YearID = FixedCalActive.YearID'
      
        #9'AND FixedCalculated.Years = FixedCalActive.Years INNER JOIN Pay' +
        '.PersonelInfo ON PersonelDecExt.PersonelNo = PersonelInfo.Person' +
        'elNo INNER JOIN Pay.FormTypes ON FormsInfo.FormType = FormTypes.' +
        'FormType WHERE ('
      #9#9'FormTypes.SalaryKind IN ('
      #9#9#9'9'
      #9#9#9',14'
      #9#9#9')'
      #9#9')'
      #9'AND ('
      #9#9'FormsInfo.InfoID BETWEEN :FormInfoIDFrom'
      #9#9#9'AND :FormInfoIDTo'
      #9#9')'
      #9'AND ('
      #9#9'PersonelDecExt.PersonelNo BETWEEN :PersonelFrom'
      #9#9#9'AND :PersonelTo'
      #9#9')'
      #9'AND (FixedCalculated.Mounth = :Mounth)'
      #9'AND (FixedCalculated.YearID = :YearID)'
      #9'AND (FixedCalculated.Years = :Years)'
      #9'AND (FixedCalculated.BedBes = 2)'
      'ORDER BY PersonelDecExt.PersonelNo'
      '')
    Left = 224
    Top = 152
