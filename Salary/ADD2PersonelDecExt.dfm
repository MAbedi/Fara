  object qryPersonelInfo: TADOQuery
    Connection = DMF.adcSalary
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'DecExtID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        PersonelDecExt.PersonelNo, PersonelInfo.lastName_L' +
        '1 + '#39' '#39' + PersonelInfo.name_L1 AS PersonelName_L1, PersonelDecEx' +
        't.FormInfoID'
      'FROM            Pay.PersonelDecExt INNER JOIN'
      
        '                         Pay.PersonelInfo ON PersonelDecExt.Pers' +
        'onelNo = PersonelInfo.PersonelNo'
      'WHERE        (PersonelDecExt.DecExtID = :DecExtID)')
    Left = 64
    Top = 56
    object qryPersonelInfoPersonelNo: TIntegerField
      FieldName = 'PersonelNo'
    end
    object qryPersonelInfoPersonelName_L1: TStringField
      FieldName = 'PersonelName_L1'
      ReadOnly = True
      Size = 56
    end
    object qryPersonelInfoFormInfoID: TIntegerField
      FieldName = 'FormInfoID'
    end
  end
