    SQL.Strings = (
      
        'SELECT FormInfoID, InfoID, InfoName_L1, InfoName_L2 FROM Pay.For' +
        'msInfo '
      'WHERE  FormType = :FormInfo4Function'
      '')
    Left = 267
    Top = 209
  end
