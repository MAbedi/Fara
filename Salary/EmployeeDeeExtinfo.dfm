  object qryEmployeeDecExt: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    AfterScroll = qryEmployeeDecExtAfterScroll
    Parameters = <
      item
        Name = 'Mounth'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'YearID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'Type'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = 0
      end
      item
        Name = 'Date'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 8000
        Value = '0'
      end>
    SQL.Strings = (
      'SELECT'
      #9' Pay.PersonelDecExt.PersonelNo,'
      
        #9' Pay.PersonelInfo.lastName_L1 + '#39' '#39' + Pay.PersonelInfo.name_L1 ' +
        'AS Employeename_L1,'
      
        '    Pay.PersonelInfo.lastName_L2 + '#39' - '#39' + PersonelInfo.name_L2 ' +
        'AS Employeename_L2,'
      #9' FormsInfo_Office.InfoName_L1 AS OfficeName'
      ''
      'FROM  Pay.PersonelDecExt INNER JOIN'
      
        '    Pay.FormsInfo ON Pay.PersonelDecExt.FormInfoID = Pay.FormsIn' +
        'fo.FormInfoID INNER JOIN'
      
        '    Pay.PersonelInfo ON Pay.PersonelDecExt.PersonelNo = Pay.Pers' +
        'onelInfo.PersonelNo LEFT OUTER JOIN'
      
        #9' Pay.Interdicts ON PersonelInfo.PersonelNo = Interdicts.Persone' +
        'lNo LEFT OUTER JOIN'
      
        #9' Pay.FormsInfo AS FormsInfo_Office ON Interdicts.OfficeCode = F' +
        'ormsInfo_Office.FormInfoID'
      'WHERE'
      #9' (Pay.PersonelDecExt.FirstMounth = :Mounth) AND'
      #9' yearid = :YearID And'
      #9' (Pay.FormsInfo.FormType = :Type) AND'
      
        #9' (:Date BETWEEN SUBSTRING(Interdicts.InterdicStartDate, 1, 7) A' +
        'ND  SUBSTRING(Interdicts.InterdicEndDate, 1, 7)) AND'
      #9' (Interdicts.InterdicType = 0)'
      'GROUP BY'
      #9' Pay.PersonelDecExt.PersonelNo,'
      #9' Pay.PersonelInfo.lastName_L1 + '#39' '#39' + Pay.PersonelInfo.name_L1,'
      #9' Pay.PersonelInfo.lastName_L2 + '#39' - '#39' + PersonelInfo.name_L2,'
      #9' FormsInfo_Office.InfoName_L1'
      'order by'
      #9' Pay.PersonelDecExt.PersonelNo')
    Left = 650
    Top = 171
    object qryEmployeeDecExtPersonelNo: TIntegerField
      Tag = 3
      DisplayLabel = #1588'.'#1662#1585#1587#1606#1604
      FieldName = 'PersonelNo'
    end
