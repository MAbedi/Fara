        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = 0
      end>
    SQL.Strings = (
      'SELECT     PersonelDecExt.*,'
      '                          (SELECT     InfoName_L1'
      '                             FROM Pay.FormsInfo'
      
        '                             WHERE     (FormInfoID = PersonelDec' +
        'Ext.FormInfoID)) AS InfoName_L1,'
      '                          (SELECT     InfoName_L2'
      '                             FROM Pay.FormsInfo'
      
        '                             WHERE     (FormInfoID = PersonelDec' +
        'Ext.FormInfoID)) AS InfoName_L2'
      'FROM Pay.PersonelDecExt'
      'WHERE   FirstMounth = :Mounth'
      #9' '#9' And yearid = :YearID'
      #9' '#9' AND (PersonelNo= :PersonNo)'
      #9' '#9' AND (FormInfoID IN'
      #9' '#9' '#9' '#9' '#9' '#9' ( SELECT     FormInfoID'
      '                             FROM Pay.FormsInfo'
      '                             WHERE     (FormType = :Type))'
      #9' '#9' '#9' '#9' '#9' '#9' )'
      '')
    Left = 482
    Top = 139
