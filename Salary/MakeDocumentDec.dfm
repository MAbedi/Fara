        ' , :DetailCodeKind ,'
      
        '    :CTopicCodeKind , :CTopicCode2Kind , :CTopicCode3Kind) AS Ma' +
        'keDoc_PersonDecExt_1 INNER JOIN'
      
        '                      Pay.PersonelInfo ON MakeDoc_PersonDecExt_1' +
        '.PersonelNo = Pay.PersonelInfo.PersonelNo'
      ' CROSS JOIN'
