        DataType = ftString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      'SELECT  *'
      ', Fitful.FitfulNote AS _Dec'
      'FROM ('
      ''
      
        'SELECT MakeDoc_PersonDecExt_1.AccTopicCode, MakeDoc_PersonDecExt' +
        '_1.AccDetailCode, MakeDoc_PersonDecExt_1.AccCTopicCode,'
      
        'MakeDoc_PersonDecExt_1.AccCTopicCode2, MakeDoc_PersonDecExt_1.Ac' +
        'cCTopicCode3,'
      
        'CAST('#39#1576#1575#1576#1578' '#1579#1576#1578' '#1587#1606#1583' '#1581#1602#1608#1602' '#1608' '#1583#1587#1578#1605#1586#1583#39' AS varchar(600)) AS _Dec,'#39#39' as' +
        ' InfoName_L1'
      
        ',cast(0 as money) AS debt ,sum(MakeDoc_PersonDecExt_1.EmployeeAm' +
        'ount) AS credit '
      
        'FROM Pay.MakeDoc_PersonDecExt(:Mounth , :Year , :YearMounth , :Z' +
        'arib ,'
      
        ':PersonelNoFrom ,:PersonelNoTo , :SallaryID , :TopicCodeKind , :' +
        'DetailCodeKind ,'
      
        ':CTopicCodeKind , :CTopicCode2Kind , :CTopicCode3Kind) AS MakeDo' +
        'c_PersonDecExt_1 INNER JOIN'
      
        'Pay.PersonelInfo ON MakeDoc_PersonDecExt_1.PersonelNo = Pay.Pers' +
        'onelInfo.PersonelNo'
      
        'GROUP BY MakeDoc_PersonDecExt_1.AccTopicCode, MakeDoc_PersonDecE' +
        'xt_1.AccDetailCode, MakeDoc_PersonDecExt_1.AccCTopicCode,'
      
        'MakeDoc_PersonDecExt_1.AccCTopicCode2, MakeDoc_PersonDecExt_1.Ac' +
        'cCTopicCode3'
      'union all '
      'SELECT '
      '0         AS AccTopicCode, '
      '0         AS AccDetailCode,'
      '0         AS AccCTopicCode, '
      '0         AS AccCTopicCode2,'
      '0 AS AccCTopicCode3, '#39' '#39' AS _Dec '
      
        ',SUM(MakeDoc_PersonDecExt_1.EmployeeAmount) AS debt ,cast(0 as m' +
        'oney) AS credit '
      
        'FROM Pay.MakeDoc_PersonDecExt(:Mounth1 , :Year1 , :YearMounth1 ,' +
        ' :Zarib1 ,'
      
        '    :PersonelNoFrom1 ,:PersonelNoTo1 , :SallaryID1 , :TopicCodeK' +
        'ind1 , :DetailCodeKind1 ,'
      '    :CTopicCodeKind1 , :CTopicCode2Kind1 , :CTopicCode3Kind1'
      ') AS MakeDoc_PersonDecExt_1 '
      ')abcd   CROSS JOIN'
      '                         dbo.Fitful'
      ''
      ' '
      ' '
      ' ')
    Left = 378
    Top = 237
