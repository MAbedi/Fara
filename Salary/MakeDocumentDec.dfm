    SQL.Strings = (
      
        'SELECT     MakeDoc_PersonDecExt_1.*, Pay.PersonelInfo.name_L1 + ' +
        #39' '#39' + Pay.PersonelInfo.lastName_L1 AS PeronName ,'
      ' CAST('#39#1576#1575#1576#1578' '#1579#1576#1578' '#1587#1606#1583' '#1581#1602#1608#1602' '#1608' '#1583#1587#1578#1605#1586#1583#39' AS varchar(600)) AS Dec'
      
        ', cast(0 as money) AS debt ,MakeDoc_PersonDecExt_1.EmployeeAmoun' +
        't AS credit '
