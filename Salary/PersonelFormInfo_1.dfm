  object qry_Items: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    AfterOpen = qry_ItemsAfterOpen
    AfterInsert = qry_ItemsAfterInsert
    BeforeEdit = qry_ItemsBeforeEdit
    AfterEdit = qry_ItemsAfterEdit
    BeforePost = qry_ItemsBeforePost
    AfterPost = qry_ItemsAfterPost
    BeforeDelete = qry_ItemsBeforeDelete
    OnCalcFields = qry_ItemsCalcFields
    Parameters = <
      item
        Name = 'Mounth'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'YearID'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'StartYear'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'FormInfo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'Mounthno'
        Attributes = [paNullable]
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end
      item
        Name = 'OfficeFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'OfficeTo'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'EmployTypeIDFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'EmployTypeIDTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      'SELECT     *,'
      '                          (SELECT     COUNT(*) AS Expr1'
      '                             FROM Pay.Functions'
      
        '                             WHERE     (Mounth = :Mounth ) AND (' +
        'PersonelNo = PersonelDecExt.PersonelNo)) AS HasFun,'
      
        '                          (SELECT     TOP 1 FormsInfoOffice.Info' +
        'Name_L1'
      '                             FROM Pay.Interdicts LEFT OUTER JOIN'
      
        '                                                   Pay.FormsInfo' +
        ' AS FormsInfoOffice ON Pay.Interdicts.OfficeCode = FormsInfoOffi' +
        'ce.FormInfoID'
      
        '                             WHERE     (Interdicts.PersonelNo = ' +
        'PersonelDecExt.PersonelNo)'
      
        '                             ORDER BY Interdicts.InterdictID DES' +
        'C) AS OfficeName,'
      
        '                          (SELECT     lastName_L1 + '#39' - '#39' + name' +
        '_L1 AS EmployeeName_L1'
      '                             FROM Pay.PersonelInfo'
      
        '                             WHERE     (PersonelNo = PersonelDec' +
        'Ext.PersonelNo)) AS EmployeeName_L1'
      ''
      'FROM Pay.PersonelDecExt'
      
        'WHERE   ( YearID  = :YearID  ) AND   (StartYear = :StartYear  ) ' +
        'AND'
      
        ' (FormInfoID = :FormInfo ) AND (FirstMounth = :Mounthno ) AND (P' +
        'ersonelNo IN'
      '                          (SELECT     PersonelInfo.PersonelNo'
      
        '                             FROM Pay.Interdicts AS Interdicts_1' +
        ' INNER JOIN'
      
        '                                                   Pay.PersonelI' +
        'nfo ON Interdicts_1.PersonelNo = PersonelInfo.PersonelNo LEFT OU' +
        'TER JOIN'
      
        '                                                   Pay.FormsInfo' +
        ' ON PersonelInfo.PersonelState = FormsInfo.FormInfoID LEFT OUTER' +
        ' JOIN'
      
        '                                                   Pay.FormsInfo' +
        ' AS FormsInfoOffice ON Interdicts_1.OfficeCode = FormsInfoOffice' +
        '.FormInfoID'
      ''
      
        'LEFT OUTER JOIN Pay.FormsInfo AS FormsInfoEmployTypeID ON Interd' +
        'icts_1.EmployTypeID = FormsInfoEmployTypeID.FormInfoID'
      ''
      
        '                             WHERE     (Interdicts_1.State < 49)' +
        ' AND (FormsInfoOffice.InfoID BETWEEN :OfficeFrom AND :OfficeTo )'
      
        '                             AND (FormsInfoEmployTypeID.InfoID  ' +
        'BETWEEN :EmployTypeIDFrom  AND :EmployTypeIDTo )'
      ''
      '                             ))'
      'ORDER BY DecExtID, PersonelNo'
      ' ')
    Left = 488
    Top = 205
