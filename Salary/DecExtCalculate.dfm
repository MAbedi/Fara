  object qryPersonelDec: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'Person'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'FormInfo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'Mounth'
        Attributes = [paNullable]
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     Pay.PersonelDecExt.*, Pay.PersonelInfo.PersonelState'
      'FROM         Pay.PersonelDecExt INNER JOIN'
      
        '                      Pay.PersonelInfo ON Pay.PersonelDecExt.Per' +
        'sonelNo = Pay.PersonelInfo.PersonelNo'
      ''
      'WHERE     (Pay.PersonelDecExt.PersonelNo = :Person)  AND'
      ' (Pay.PersonelDecExt.FormInfoID = :FormInfo) And'
      '  (Pay.PersonelDecExt.FirstMounth = :Mounth)')
    Left = 296
    Top = 409
