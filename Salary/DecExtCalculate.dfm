  object qryDecExtCal: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    AfterOpen = qryDecExtCalAfterOpen
    Parameters = <
      item
        Name = 'YearMonth'
        DataType = ftString
        Size = 5
        Value = '84/01'
      end
      item
        Name = 'PersonelStateFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PersonelNoForm'
        Size = -1
        Value = Null
      end
      item
        Name = 'PersonelNoTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'InterTypeFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'InterTypeTo'
        DataType = ftWideString
        Size = 2
        Value = '0'
      end>
    SQL.Strings = (
      
        'SELECT     InterdictForCalcu.PersonelNo, InterdictForCalcu.Price' +
        ' AS BasePrice, PersonelInfo.name_L1 + '#39' '#39' + PersonelInfo.lastNam' +
        'e_L1 AS name_L1,'
      
        '    PersonelInfo.name_L2 + '#39' '#39' + PersonelInfo.lastName_L2 AS nam' +
        'e_L2, PersonelInfo.fatherName_L1, PersonelInfo.fatherName_L2,'
      
        '    PersonelInfo.NationalID, PersonelInfo.IDNumber, PersonelInfo' +
        '.SupPepNumber'
      
        '    , InterdictForCalcu.OfficeCode,FormsInfo_OfficeCode.InfoID A' +
        'S OfficeInfoID'
      ''
      
        'FROM         (SELECT     PersonelNo, SUM(Amount) AS Price ,Max(O' +
        'fficeCode) AS OfficeCode'
      
        '                        FROM         Pay.InterdictForUse(:YearMo' +
        'nth, 1,1,0,999999999,1) InterdictForUse'
      
        '                        GROUP BY PersonelNo) InterdictForCalcu I' +
        'NNER JOIN'
      
        '                      Pay.PersonelInfo ON InterdictForCalcu.Pers' +
        'onelNo = PersonelInfo.PersonelNo'
      '                      LEFT OUTER JOIN'
      
        'Pay.FormsInfo AS FormsInfo_OfficeCode ON InterdictForCalcu.Offic' +
        'eCode = FormsInfo_OfficeCode.FormInfoID'
      ''
      ' where (PersonelInfo.PersonelState in ( :PersonelStateFrom ))'
      
        ' AND (PersonelInfo.PersonelNO BETWEEN :PersonelNoForm AND :Perso' +
        'nelNoTo )'
      
        'And InterdictForCalcu.PersonelNo in (SELECT     Interdicts.Perso' +
        'nelNo'
      'FROM Pay.Interdicts LEFT OUTER JOIN'
      
        '                      Pay.FormsInfo ON Pay.Interdicts.EmployType' +
        'ID = FormsInfo.FormInfoID'
      ''
      
        'WHERE     (Interdicts.State < 50) AND (Interdicts.InterdicType =' +
        ' 0)'
      'AND (FormsInfo.InfoID BETWEEN :InterTypeFrom AND :InterTypeTo ))')
    Left = 72
    Top = 121
  end
