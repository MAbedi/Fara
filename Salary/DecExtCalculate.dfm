  object qryCalc: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'YearMounth1'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 5
        Value = Null
      end
      item
        Name = 'YearMounth2'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 5
        Value = Null
      end
      item
        Name = 'PersonelNo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     ROUND(SUM(InterdictItems.Amount * CalculateWage.Amoun' +
        't / 100), 0) AS Amount'
      'FROM Pay.Interdicts INNER JOIN'
      
        '                      Pay.InterdictItems ON Pay.Interdicts.Inter' +
        'dictID = InterdictItems.InterdictID INNER JOIN'
      
        '                      CalculateWage ON InterdictItems.SalaryID =' +
        ' CalculateWage.SalaryID'
      
        'WHERE     (LEFT(Interdicts.InterdicStartDate, 7) <= :YearMounth1' +
        ' ) AND (LEFT(Interdicts.InterdicEndDate, 7) >= :YearMounth2 ) '
      ' AND (Interdicts.PersonelNo = :PersonelNo )')
    Left = 448
    Top = 368
  end
