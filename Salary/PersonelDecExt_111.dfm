        'msInfo '
      ''
      '')
    Left = 267
    Top = 249
  end
  object qrySumFunction: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterInsert = qryPersonelDecExtAfterInsert
    AfterPost = qryPersonelDecExtAfterPost
    BeforeCancel = qryPersonelDecExtBeforeCancel
    BeforeDelete = qryPersonelDecExtBeforeDelete
    AfterDelete = qryPersonelDecExtAfterDelete
    Parameters = <
      item
        Name = 'YearID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonelNoFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonelNoTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonelStateFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'PersonelStateTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'OfficeCodeFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'OfficeCodeTo'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     Functions.PersonelNo, SUM(Functions.FunctionDay)+isnu' +
        'll(SUM(Functions.SickDay),0) AS SumFunDay, Functions.ProjectID,'
      ' Functions.OfficeCode, FormsInfo.InfoID AS ProjectInfoID, '
      
        '                      FormsInfo_Office.InfoID AS OfficeInfoID, F' +
        'unctions.ProcCode'
      ''
      'FROM Pay.Functions INNER JOIN'
      
        '                      Pay.PersonelInfo ON Functions.PersonelNo =' +
        ' PersonelInfo.PersonelNo LEFT OUTER JOIN'
      
        '                      Pay.FormsInfo ON Functions.ProjectID = For' +
        'msInfo.FormInfoID LEFT OUTER JOIN'
      
        '                      Pay.FormsInfo AS FormsInfo_Office ON Funct' +
        'ions.OfficeCode = FormsInfo_Office.FormInfoID LEFT OUTER JOIN'
      
        '                      Pay.FormsInfo AS FormsInfo_State ON Person' +
        'elInfo.PersonelState = FormsInfo_State.FormInfoID'
      ''
      ''
      'WHERE     (Functions.YearID = :YearID )'
      ''
      
        'AND ( Functions.PersonelNo BETWEEN :PersonelNoFrom AND :Personel' +
        'NoTo)'
      'AND  Functions.PersonelNo not in'
      '(SELECT     PersonelNo'
      'FROM Pay.PersonelDecExt'
      
        'WHERE     (FirstMounth = 13) AND (EndMounth = 13) AND (LTRIM(End' +
        'Date) <> '#39#39'))'
      
        'AND (FormsInfo_State.InfoID BETWEEN :PersonelStateFrom AND :Pers' +
        'onelStateTo)'
      
        'AND (FormsInfo_Office.InfoID BETWEEN :OfficeCodeFrom AND :Office' +
        'CodeTo)'
      ''
      ''
      ''
      
        'GROUP BY Functions.PersonelNo, Functions.ProjectID, Functions.Of' +
        'ficeCode, FormsInfo.InfoID, FormsInfo_Office.InfoID , Functions.' +
        'ProcCode'
      ''
      'HAVING      (SUM(Functions.FunctionDay) <> 0)')
    Left = 538
    Top = 264
    object qrySumFunctionPersonelNo: TIntegerField
      FieldName = 'PersonelNo'
    end
    object qrySumFunctionProjectID: TIntegerField
      FieldName = 'ProjectID'
    end
    object qrySumFunctionOfficeCode: TIntegerField
      FieldName = 'OfficeCode'
    end
    object qrySumFunctionProjectInfoID: TIntegerField
      FieldName = 'ProjectInfoID'
    end
    object qrySumFunctionOfficeInfoID: TIntegerField
      FieldName = 'OfficeInfoID'
    end
    object qrySumFunctionProcCode: TIntegerField
      FieldName = 'ProcCode'
    end
    object qrySumFunctionSumFunDay: TFloatField
      FieldName = 'SumFunDay'
      ReadOnly = True
    end
  end
