    SQL.Strings = (
      
        'SELECT     *,EmployeeAmount - PaymentLoan AS EmployeeAmount_Paym' +
        'entLoan ,'
      
        '                          (SELECT     lastName_L1 + '#39' '#39' + name_L' +
        '1 '
      '                             FROM Pay.PersonelInfo'
      
        '                             WHERE     (PersonelNo = PersonelDec' +
        'Ext.PersonelNo)) AS Name'
      ''
      'FROM Pay.PersonelDecExt'
      
        'WHERE     (FirstMounth = :FirstMounth ) AND (EndMounth = :EndMou' +
        'nth ) and forminfoid=:forminfoid'
      'AND  YearID Between :YearIDFrom and  :YearIDTo'
      ' AND   (StartYear = :StartYear  ) ')
