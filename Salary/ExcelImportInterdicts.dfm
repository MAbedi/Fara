  object qrySalaryID: TADOQuery
    Connection = DmF.adcsalary
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      'SELECT        FormsInfo.FormInfoID, FormsInfo.InfoName_L1'
      'FROM Pay.FormsInfo INNER JOIN'
      
        '                         Pay.FormTypes ON FormsInfo.FormType = F' +
        'ormTypes.FormType'
      'WHERE        (FormTypes.SalaryKind BETWEEN 1 AND 4)')
    Left = 480
    Top = 224
    object qrySalaryIDFormInfoID: TIntegerField
      FieldName = 'FormInfoID'
    end
    object qrySalaryIDInfoName_L1: TStringField
      FieldName = 'InfoName_L1'
      Size = 255
    end
  end
