  object qryPersonelWage: TADOQuery
    Connection = DMF.adcSalary
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'Code'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'MonthNo'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end
      item
        Name = 'pid'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end>
    SQL.Strings = (
      'SELECT     SUM(Price ) AS WageValue'
      
        'FROM         Pay.RetardFixedCalculated(DEFAULT, DEFAULT, DEFAULT' +
        ') RetardFixedCalculated'
      'WHERE   (  SalaryID in ('
      ' SELECT      Pay.SalaryRange.SalaryID'
      'FROM         Pay.FormsInfo INNER JOIN'
      
        '                      Pay.SalaryRange ON Pay.FormsInfo.FormInfoI' +
        'D = Pay.SalaryRange.FormInfoID'
      
        'WHERE     (Pay.FormsInfo.FormType = 55) AND (Pay.FormsInfo.InfoI' +
        'D = :Code)  '
      '))'
      ''
      ''
      'and  (Mounth = :MonthNo) '
      ''
      'GROUP BY PersonelNo'
      'HAVING      (PersonelNo = :pid)'
      ' '
      ' ')
    Left = 56
    Top = 112
  end
  object qryPersonels: TADOQuery
    Connection = DMF.adcSalary
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qryPersonelsAfterOpen
    Parameters = <
      item
        Name = 'MonthNo2'
        Size = -1
        Value = Null
      end
      item
        Name = 'StateFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'StateTo'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'pidFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'pidTo'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'MonthNo'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'EmployTypeIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'EmployTypeIDTo'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     Interdicts.PersonelNo, EmployeeInfo.PersonStateNo, Em' +
        'ployeeInfo.personelstate_L1, EmployeeInfo.PersonelName_L1, Emplo' +
        'yeeInfo.fatherName_L1,'
      
        '                      EmployeeInfo.Nationality_L1, EmployeeInfo.' +
        'BirthDate, EmployeeInfo.SodurDate, EmployeeInfo.BirthPlace_L1, E' +
        'mployeeInfo.NationalID, '
      
        '                      EmployeeInfo.IDNumber, EmployeeInfo.Sex_L1' +
        ', EmployeeInfo.licence_L1, EmployeeInfo.employDate, EmployeeInfo' +
        '.finishEmployDate, '
      
        '                      EmployeeInfo.InsuranceNumber, EmployeeInfo' +
        '.lastName_L1, EmployeeInfo.name_L1, EmployeeInfo.SodurPlace_L1,'
      
        '                      FormsInfo.InfoName_L1 AS JobName ,Employee' +
        'Info.PercentWound,EmployeeInfo.AccountNumber ,EmployeeInfo.DSW_J' +
        'OB'
      ''
      ''
      'FROM Pay.Interdicts INNER JOIN'
      
        '                      Pay.FormsInfo ON Pay.Interdicts.jobCode = FormsInf' +
        'o.FormInfoID INNER JOIN'
      '                          (SELECT     PersonelNO'
      
        '                             FROM         Pay.RetardFixedCalcula' +
        'ted(DEFAULT, DEFAULT) AS RetardFixedCalculated_1'
      '                             WHERE     (Mounth = :MonthNo2 )'
      
        '                             GROUP BY PersonelNO) AS derivedtbl_' +
        '1 ON Pay.Interdicts.PersonelNo = derivedtbl_1.PersonelNO LEFT OUTER ' +
        'JOIN'
      
        '                      EmployeeInfo ON Pay.Interdicts.PersonelNo = Em' +
        'ployeeInfo.PersonelNo'
      ''
      
        'LEFT OUTER JOIN Pay.FormsInfo AS FormsInfoEmployTypeID ON Interdicts' +
        '.EmployTypeID = FormsInfoEmployTypeID.FormInfoID'
      ''
      ''
      
        'WHERE     (Interdicts.State < 50) AND    (EmployeeInfo.PersonSta' +
        'teNo BETWEEN :StateFrom AND :StateTo) AND'
      
        '                      (EmployeeInfo.InsuranceNumber <> '#39#39')  AND ' +
        '(EmployeeInfo.PersonelNo IN'
      '                          (SELECT PersonelNo FROM Pay.Functions'
      
        '                             WHERE     ((PersonelNo BETWEEN :pid' +
        'From AND :pidTo) AND (Mounth = :MonthNo))'
      '                             GROUP BY PersonelNo))'
      ''
      
        'AND (FormsInfoEmployTypeID.InfoID  BETWEEN :EmployTypeIDFrom  AN' +
        'D :EmployTypeIDTo )                             '
      ''
      '  '
      ''
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    Left = 200
    Top = 157
    object qryPersonelsPersonelNo: TIntegerField
      Tag = 3
      DisplayLabel = #1588'.'#1662#1585#1587#1606#1604
      FieldName = 'PersonelNo'
    end
