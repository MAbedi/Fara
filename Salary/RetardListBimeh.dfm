  object qryEmployeeBime: TADOQuery
    Connection = DMF.adcSalary
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'MonthNo'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     PersonelNO, SUM(Price) AS WageValue,'
      
        '           SUM(CASE WHEN calculatekind = 10 THEN price ELSE 0 EN' +
        'D) AS Bimeh,'
      
        '           SUM(CASE WHEN calculatekind <> 10 THEN price ELSE 0 E' +
        'ND) AS Others'
      
        'FROM         Pay.RetardFixedCalculated(DEFAULT, DEFAULT, DEFAULT' +
        ') RetardFixedCalculated'
      
        'WHERE     ( ( ShowlistKind=2 or (ShowlistKind=11 and bedbes=2)))' +
        ' AND (Mounth = :MonthNo)'
      'GROUP BY PersonelNO'
      '')
    Left = 72
    Top = 176
  end
  object qryEmployerBime: TADOQuery
    Connection = DMF.adcSalary
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'MonthNo'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end>
    SQL.Strings = (
      'SELECT     PersonelNO,'
      ''
      
        'SUM(CASE WHEN (ShowlistKind IN (2,4, 15, 14) AND bedbes = 1) THE' +
        'N price ELSE 0 END)+'
      
        '0*SUM(CASE WHEN (ShowlistKind = 4  AND CalCulateKind = 10) THEN ' +
        'price ELSE 0 END) AS ClientShare,'
      
        'SUM(CASE WHEN (ShowlistKind = 14 AND CalCulateKind = 10) THEN pr' +
        'ice ELSE 0 END) AS InAction'
      ''
      ''
      ''
      
        'FROM         Pay.RetardFixedCalculated(DEFAULT, DEFAULT, DEFAULT' +
        ') RetardFixedCalculated'
      'WHERE      (Mounth = :MonthNo)'
      ''
      ''
      ''
      'GROUP BY PersonelNO'
      ''
      ''
      ''
      ' '
      ' '
      ' ')
    Left = 80
    Top = 229
  end
