  object qryListDetail: TADOQuery
    Connection = DMF.adcSalary
    CursorType = ctStatic
    LockType = ltReadOnly
    OnCalcFields = qryListDetailCalcFields
    DataSource = srcPersonels
    Parameters = <
      item
        Name = 'PersonelNo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Value = 0
      end
      item
        Name = 'MonthNo'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT     PersonelNo, SUM(FunctionDay) AS FDaily, SUM(FunctionT' +
        'ime) AS FHours'
      'FROM Pay.Functions'
      'WHERE     (PersonelNo = :PersonelNo) AND (Mounth= :MonthNo) '
      'GROUP BY PersonelNo')
    Left = 224
    Top = 269
    object qryListDetailPersonelNo: TIntegerField
      DisplayLabel = #1588'.'#1662#1585#1587#1606#1604
      FieldName = 'PersonelNo'
    end
