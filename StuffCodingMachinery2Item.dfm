  object qryMachinery3: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    AfterScroll = qryMachinery3AfterScroll
    Parameters = <
      item
        Name = 'StuffId'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT    Machin.Machinery.StuffId,Machin.Machinery.MachineId, M' +
        'achin.Machinery.Id, StuffCoding.c_StuffName, StuffCoding.c_Stuff' +
        'TecInfo, Machin.Machinery.ParentId'
      'FROM         Machin.Machinery INNER JOIN'
      
        '                      StuffCoding ON Machin.Machinery.MachineId ' +
        '= StuffCoding.c_StuffCode'
      
        'WHERE     (Machin.Machinery.StuffId = :StuffId) AND (Machin.Mach' +
        'inery.MachinType = 3)')
    Left = 600
    Top = 152
    object atncfldMachinery3Id: TAutoIncField
      FieldName = 'Id'
      ReadOnly = True
    end
    object strngfldMachinery3c_StuffName: TStringField
      DisplayLabel = #1606#1575#1605' '#1578#1580#1607#1740#1586
      FieldName = 'c_StuffName'
      Size = 150
    end
    object strngfldMachinery3c_StuffTecInfo: TStringField
      DisplayLabel = #1605#1588#1582#1589#1575#1578' '#1601#1606#1740
      FieldName = 'c_StuffTecInfo'
      Size = 30
    end
    object qryMachinery3ParentId: TIntegerField
      FieldName = 'ParentId'
    end
    object qryMachinery3StuffId: TLargeintField
      FieldName = 'StuffId'
      ReadOnly = True
    end
    object qryMachinery3MachineId: TLargeintField
      FieldName = 'MachineId'
    end
  end
