  object qrySelectTopicId: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT        Projects.ProjectID, Projects.ProjectCaption_L1, Pr' +
        'ojects.ProjectCaption_L2'
      'FROM            Acc.Projects AS Projects LEFT OUTER JOIN'
      
        '                             (SELECT        Projects_1.ProjectID' +
        ', LEFT(RTRIM(LTRIM(STR(Projects_1.ProjectID))), BudgetTopicLevel' +
        's_1.CodeLength) AS PrvProjectID'
      
        '                                FROM            Acc.Projects AS ' +
        'Projects_1 INNER JOIN'
      
        '                                                         Acc.Bud' +
        'getTopicLevels ON Projects_1.LevelID = Acc.BudgetTopicLevels.Lev' +
        'elID LEFT OUTER JOIN'
      
        '                                                         Acc.Bud' +
        'getTopicLevels AS BudgetTopicLevels_1 ON Acc.BudgetTopicLevels.p' +
        'rvLevelID = BudgetTopicLevels_1.LevelID) AS ProjectsForUse ON '
      
        '                         Projects.ProjectID = ProjectsForUse.Prv' +
        'ProjectID'
      'WHERE        (ProjectsForUse.PrvProjectID IS NULL)')
    Left = 48
    Top = 408
    object qrySelectTopicIdProjectID: TIntegerField
      FieldName = 'ProjectID'
    end
    object qrySelectTopicIdProjectCaption: TStringField
      FieldName = 'ProjectCaption_L1'
      Size = 100
    end
    object qrySelectTopicIdProjectCaption_L2: TStringField
      FieldName = 'ProjectCaption_L2'
      Size = 100
    end
  end
