  object qrytBalanceCoffer: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'CustFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Size = 12
        Value = 2
      end
      item
        Name = 'CustTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Size = 12
        Value = 16001
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        Size = 10
        Value = '0001/01/01'
      end
      item
        Name = 'DateTo'
        DataType = ftString
        Size = 10
        Value = '84/05/13'
      end
      item
        Name = 'DateFromRemain'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'YearIDFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'YearIDTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SellsMethodFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SellsMethodTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SellsEmporiumFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SellsEmporiumTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'GroupType'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ArzTypeIDFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ArzTypeIDTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      'select customerid1 as CustID , Vu_CustomersGroups.CustName ,'
      ''
      
        'sum(case when kind = 0 then bed - bes else 0 end ) as FirstBalan' +
        'ce ,'
      'sum(case when kind <> 0 then bed else 0 end ) as bed  ,'
      'sum(case when kind <> 0 then bes else 0 end ) as bes ,'
      'sum(bed  - bes ) as Balance,Vu_CustomersGroups.AccountNumber'
      ',Vu_CustomersGroups.BankId,Vu_CustomersGroups.BankName,'
      ''
      
        'sum(case when kind = 0 then Arzbed - Arzbes else 0 end ) as ArzF' +
        'irstBalance ,'
      'sum(case when kind <> 0 then Arzbed else 0 end ) as Arzbed  ,'
      'sum(case when kind <> 0 then Arzbes else 0 end ) as Arzbes ,'
      'sum(Arzbed  - Arzbes ) as ArzBalance'
      ''
      ''
      ''
      'FROM'#9'Vu_CustomersGroups INNER JOIN'
      
        #9#9'dbo.allaccount(1,2,10,-1,  :CustFrom , :CustTo , :DateFrom, :D' +
        'ateTo , :DateFromRemain , :YearIDFrom   , :YearIDTo'
      
        '    , :SellsMethodFrom , :SellsMethodTo , :SellsEmporiumFrom ,  ' +
        ':SellsEmporiumTo , DEFAULT )allaccount  ON Vu_CustomersGroups.Cu' +
        'stID = allaccount.customerid1'
      ''
      'WHERE     (Vu_CustomersGroups.GroupType IN (  :GroupType ))'
      
        ' AND ( ISNULL(allaccount.ArzTypeID,0) BetWeen :ArzTypeIDFrom AND' +
        ' :ArzTypeIDTo)'
      ''
      
        'group by customerid1  , Vu_CustomersGroups.CustName,Vu_Customers' +
        'Groups.AccountNumber'
      ',Vu_CustomersGroups.BankId,Vu_CustomersGroups.BankName'
      ''
      'Order by customerid1'
      '')
    Left = 280
    Top = 143
