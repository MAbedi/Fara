  object qryInsert: TADOQuery
    Connection = DmF.adcBSell
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'NewFormItemID'
        Size = -1
        Value = Null
      end
      item
        Name = 'NewFormID'
        Size = -1
        Value = Null
      end
      item
        Name = 'NewRow'
        Size = -1
        Value = Null
      end
      item
        Name = 'OldFormItemID'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearID'
        Size = -1
        Value = Null
      end
      item
        Name = 'ServerID'
        Size = -1
        Value = Null
      end
      item
        Name = 'OldFormItemID1'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'INSERT INTO FormItems'
      
        '                      (FormItemID, FormID, Row, CheckNumber, Che' +
        'ckDate, CheckType, ItemAmount, ItemNote, BankName, AccountNumber' +
        ', City, CustomerID2, '
      '                      preFormItemID  , YearID , ServerID )'
      
        'SELECT     :NewFormItemID , :NewFormID , :NewRow, CheckNumber, C' +
        'heckDate, CheckType, ItemAmount, ItemNote, BankName, AccountNumb' +
        'er, City,'
      
        '                      CustomerID2, :OldFormItemID'#10'  , :YearID , ' +
        ':ServerID'
      ''
      ''
      'FROM         FormItems'
      'WHERE     (FormItemID = :OldFormItemID1 )')
    Left = 194
    Top = 279
  end
