  object qryChecks: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryChecksAfterOpen
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     FormItems.FormItemID, FormItems.CheckNumber, FormItem' +
        's.CheckDate, FormItems.BankName, FormItems.AccountNumber, '
      
        '                      FormItems.ItemAmount, FormItems.ItemNote, ' +
        'Forms.FormNumber, Forms.FormDate, FormItems.CustomerID2,'
      
        '                      Customers.CustName, Forms.FormType, FormTy' +
        'pes.FormCaption, Forms.CustomerID1, FormItems_1.preFormItemID'
      'FROM         FormItems INNER JOIN'
      
        '                      Forms ON FormItems.FormID = Forms.FormID I' +
        'NNER JOIN'
      
        '                      FormTypes ON Forms.FormType = FormTypes.Fo' +
        'rmType LEFT OUTER JOIN'
      
        '                      Customers ON FormItems.CustomerID2 = Custo' +
        'mers.CustID LEFT OUTER JOIN'
      
        '                      FormItems FormItems_1 ON FormItems.FormIte' +
        'mID = FormItems_1.preFormItemID'
      'WHERE     (FormItems_1.preFormItemID IS NULL) ')
    Left = 176
    Top = 112
  end
