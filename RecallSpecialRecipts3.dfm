  object qrySpecialRecall: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'ReciptType'
        DataType = ftInteger
        Size = 1
        Value = 0
      end
      item
        Name = 'YearID1From'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'YearID1To'
        DataType = ftInteger
        Size = -1
        Value = 99999
      end
      item
        Name = 'YearID2From'
        DataType = ftInteger
        Size = -1
        Value = Null
      end
      item
        Name = 'YearID2To'
        DataType = ftInteger
        Size = -1
        Value = Null
      end
      item
        Name = 'RcpNumberFrom'
        DataType = ftInteger
        Size = -1
        Value = 0
      end
      item
        Name = 'RcpNumberTo'
        DataType = ftInteger
        Size = -1
        Value = 9999
      end
      item
        Name = 'DateFrom'
        DataType = ftWideString
        Size = 10
        Value = '0000/00/00'
      end
      item
        Name = 'DateTo'
        DataType = ftWideString
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'YearID3From'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearID3To'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCodeFrom'
        DataType = ftLargeint
        Size = -1
        Value = '0'
      end
      item
        Name = 'StuffCodeTo'
        DataType = ftLargeint
        Size = -1
        Value = '9999'
      end
      item
        Name = 'StoreIDFrom'
        DataType = ftInteger
        Size = -1
        Value = 0
      end
      item
        Name = 'StoreIDTo'
        DataType = ftInteger
        Size = -1
        Value = 99999
      end>
    SQL.Strings = (
      
        'SELECT Fitful.FitfulID AS _Checked, ReciptItems.YearID, ReciptIt' +
        'ems.StuffCode, StuffCoding.c_StuffName, Units.UnitName, '
      
        '       SUM(ROUND(ReciptItems.InputEntity + ReciptItems.OutputEnt' +
        'ity , 3))- ISNULL(derivedtbl_1.Entity, 0) AS Entity, '
      
        '       SUM(ROUND(ReciptItems.InputWeight + ReciptItems.OutputWei' +
        'ght , 3))- ISNULL(derivedtbl_1.Weight, 0) AS Weight, '
      
        #9'   Recipts.StoreID, Stores.c_StoreName,ReciptItems.StuffSize,MA' +
        'X(ReciptItems.UnitSellPrice) UnitSellPrice'
      'FROM            ReciptItems INNER JOIN'
      
        '                         Recipts ON ReciptItems.ReciptID = Recip' +
        'ts.ReciptID AND ReciptItems.ServerID = Recipts.ServerID AND Reci' +
        'ptItems.YearID = Recipts.YearID INNER JOIN'
      
        '                         ReciptTypes ON Recipts.ReciptType = Rec' +
        'iptTypes.ReciptType INNER JOIN'
      
        '                         Stores ON Recipts.StoreID = Stores.n_St' +
        'oreID INNER JOIN'
      '                         Units INNER JOIN'
      
        '                         StuffCoding ON Units.UnitCode = StuffCo' +
        'ding.n_UnitCode ON ReciptItems.StuffCode = StuffCoding.c_StuffCo' +
        'de LEFT OUTER JOIN'
      
        '                             (SELECT Recipts_1.YearID, ReciptIte' +
        'ms_1.StuffCode, '
      
        #9#9#9#9#9#9#9'         ROUND(SUM(ReciptItems_1.InputEntity + ReciptItem' +
        's_1.OutputEntity) , 3) AS Entity, '
      
        '                                     ROUND(SUM(ReciptItems_1.Inp' +
        'utWeight + ReciptItems_1.OutputWeight) , 3) AS Weight'
      
        '                                FROM            ReciptItems AS R' +
        'eciptItems_1 INNER JOIN'
      
        '                                                         Recipts' +
        ' AS Recipts_1 ON ReciptItems_1.ReciptID = Recipts_1.ReciptID AND' +
        ' ReciptItems_1.ServerID = Recipts_1.ServerID AND '
      
        '                                                         ReciptI' +
        'tems_1.YearID = Recipts_1.YearID INNER JOIN'
      
        '                                                         ReciptT' +
        'ypes AS ReciptTypes_1 ON Recipts_1.ReciptType = ReciptTypes_1.Re' +
        'ciptType'
      
        '                                WHERE        (Recipts_1.ReciptTy' +
        'pe = :ReciptType) AND (Recipts_1.ReciptState < 3)'
      
        '                                AND (Recipts_1.YearID BETWEEN :Y' +
        'earID1From AND :YearID1To)'
      
        '                                AND (Recipts_1.PrvYearID BETWEEN' +
        ' :YearID2From AND :YearID2To)'
      
        '                                GROUP BY Recipts_1.YearID, Recip' +
        'tItems_1.StuffCode) AS derivedtbl_1 ON ReciptItems.StuffCode = d' +
        'erivedtbl_1.StuffCode CROSS JOIN'
      '                         Fitful'
      
        'WHERE        (Recipts.ReciptNumber BETWEEN :RcpNumberFrom AND :R' +
        'cpNumberTo) AND (Recipts.ReciptDate BETWEEN :DateFrom AND :DateT' +
        'o) AND '
      
        '                         (Recipts.YearID BETWEEN :YearID3From AN' +
        'D :YearID3To) AND (ReciptItems.StuffCode BETWEEN :StuffCodeFrom ' +
        'AND :StuffCodeTo) AND'
      
        '                         (Recipts.StoreID BETWEEN :StoreIDFrom A' +
        'ND :StoreIDTo) '
      '')
    Left = 225
    Top = 217
