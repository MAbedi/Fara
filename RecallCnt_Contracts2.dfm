      end
      item
        Name = 'FromType'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'ContractNoForm'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 30
        Value = Null
      end
      item
        Name = 'ContractNoTO'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 30
        Value = Null
      end
      item
        Name = 'EmployerIdForm'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'EmployerIdTO'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'YearIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'YearIDTO'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'CaseNoFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'CaseNoTO'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'SELECT        Cnt.Contracts.*, Customers.CustName'
      'FROM            Cnt.Contracts INNER JOIN'
      
        '                         Customers ON Cnt.Contracts.EmployerId =' +
        ' Customers.CustID'
      ''
      
        'WHERE ( Cnt.Contracts.ContractDate between :ContractDateForm and' +
        ' :ContractDateTO)'
      'and (  Cnt.Contracts.FromType = :FromType )'
      
        'and ( Cnt.Contracts.ContractNo between :ContractNoForm and :Cont' +
        'ractNoTO)'
      
        'and ( Cnt.Contracts.EmployerId between :EmployerIdForm and :Empl' +
        'oyerIdTO)'
      ''
      'and ( Cnt.Contracts.YearID between :YearIDFrom and :YearIDTO)'
      'and ( Cnt.Contracts.CaseNo between :CaseNoFrom and :CaseNoTO)'
      ''
      ''
      'ORDER BY Cnt.Contracts.CaseNo'
      ''
      '')
    Left = 361
    Top = 113
