  object qryOpt_Families: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'EmployerId'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        Cnt.ContractOperationFamilies.ContractOperationId,' +
        '  Cnt.ContractOperationFamilies.FStuffCode, '
      '                          Cnt.Contracts.EmployerId'
      'FROM            Cnt.ContractOperationFamilies INNER JOIN'
      
        '                         Cnt.ContractOperations ON Cnt.ContractO' +
        'perationFamilies.ContractOperationId = Cnt.ContractOperations.Co' +
        'ntractOperationId INNER JOIN'
      
        '                         Cnt.Contracts ON Cnt.ContractOperations' +
        '.CaseNo = Cnt.Contracts.CaseNo AND Cnt.ContractOperations.CaseNo' +
        ' = Cnt.Contracts.CaseNo AND Cnt.ContractOperations.CaseNo = Cnt.' +
        'Contracts.CaseNo'
      ''
      'WHERE        (Cnt.Contracts.EmployerId = :EmployerId)'
      ''
      '')
    Left = 121
    Top = 257
  end
