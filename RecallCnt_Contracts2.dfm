  object qryOperations_: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterScroll = qryOperations_AfterScroll
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'CaseNo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'OperationIdForm'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end
      item
        Name = 'OperationIdTO'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        Cnt.ContractOperations.OperationId, Cnt.ContractOp' +
        'erations.Amount, Cnt.ContractOperations.BasePrice, Cnt.ContractO' +
        'perations.OverheadPrice, Cnt.ContractOperations.TotalPrice, Cnt.' +
        'ContractOperations.FarmId, '
      
        '                         Cnt.ContractOperations.PieceId, Cnt.Con' +
        'tractOperations.ContractOperationNote, Cnt.ContractOperations.Pe' +
        'rcent1, Cnt.ContractOperations.Percent2, Cnt.ContractOperations.' +
        'DiscountPercent, '
      
        '                         Cnt.ContractOperations.StuffCode, Cnt.C' +
        'ontractOperations.StuffCount, Cnt.ContractOperations.LeadTime, C' +
        'nt.ContractOperations.UnitCode, Cnt.ContractOperations.NumberOfU' +
        'nit, Cnt.ContractOperations.Percent3, '
      
        '                         Cnt.ContractOperations.Basis4Calculatio' +
        'nFormRow, Fitful.FitfulID, StuffCoding.c_StuffName AS StuffName,' +
        ' Units.UnitName, Fitful.FitfulID AS _Checked, Cnt.ContractOperat' +
        'ions.ContractOperationId, '
      
        '                         LookUps.Name AS StName1,StuffCoding.car' +
        'ton '
      'FROM            Cnt.ContractOperations INNER JOIN'
      
        '                         StuffCoding ON Cnt.ContractOperations.O' +
        'perationId = StuffCoding.c_StuffCode INNER JOIN'
      
        '                         Units ON StuffCoding.n_UnitCode = Units' +
        '.UnitCode LEFT OUTER JOIN'
      
        '                         LookUps ON StuffCoding.st1 = LookUps.co' +
        'de CROSS JOIN'
      '                         Fitful'
      
        'WHERE   (LookUps.Kind = 301) AND    (Cnt.ContractOperations.Case' +
        'No = :CaseNo)'
      
        ' AND (Cnt.ContractOperations.OperationId BETWEEN :OperationIdFor' +
        'm AND :OperationIdTO)')
    Left = 473
    Top = 185
