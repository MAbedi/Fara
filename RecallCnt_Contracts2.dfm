  object qryOperations_Items: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'EmployerId'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        Cnt.ContractOperationItems.ContractOperationId, Cn' +
        't.ContractOperationItems.ItemKind, Cnt.ContractOperationItems.IS' +
        'tuffCount, Cnt.ContractOperationItems.IStuffCode, Cnt.ContractOp' +
        'erationItems.IAmount, '
      
        '                         Cnt.ContractOperationItems.INote, Cnt.C' +
        'ontractOperationItems.IBuyEffect, Cnt.ContractOperationItems.ISe' +
        'llEffect, Cnt.ContractOperationItems.IUnitCode, Cnt.Contracts.Em' +
        'ployerId'
      'FROM            Cnt.ContractOperationItems INNER JOIN'
      
        '                         Cnt.ContractOperations ON Cnt.ContractO' +
        'perationItems.ContractOperationId = Cnt.ContractOperations.Contr' +
        'actOperationId INNER JOIN'
      
        '                         Cnt.Contracts ON Cnt.ContractOperations' +
        '.CaseNo = Cnt.Contracts.CaseNo AND Cnt.ContractOperations.CaseNo' +
        ' = Cnt.Contracts.CaseNo AND Cnt.ContractOperations.CaseNo = Cnt.' +
        'Contracts.CaseNo'
      'WHERE        (Cnt.Contracts.EmployerId = :EmployerId)'
      ''
      '')
    Left = 337
    Top = 249
  end
  object qryMaster: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qryMasterAfterScroll
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'ContractDateForm'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'ContractDateTO'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
