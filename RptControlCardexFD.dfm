  object FDQuery1: TFDQuery
    AfterOpen = qryRptTransactionsAfterOpen
    FieldOptions.UpdatePersistent = True
    CachedUpdates = True
    Connection = DmF.fdcBSell
    UpdateOptions.AssignedValues = [uvUpdateMode, uvLockMode]
    UpdateOptions.UpdateMode = upWhereChanged
    UpdateOptions.LockMode = lmOptimistic
    SQL.Strings = (
      
        'SELECT      Fitful.FitfulIDc AS UnitSellPriceBackLog , 0 AS Row,' +
        '  *'
      
        ', Fitful.FitfulID  AS CalcuBackLogEntity, Fitful.FitfulID  AS Ca' +
        'lcuBackLogWeight, Fitful.FitfulIDc AS CalcuBacklogPrice ,  Fitfu' +
        'l.FitfulIDc  AS CalcuBacklogSellPrice'
      
        '   , LookUps.Name AS SecondTypeItemName,ScF.KeepPlace, ScF.Cabin' +
        'et Cabinets'
      
        'FROM dbo.Cardex (:StoreIdFrom ,:StoreIdTo , :StuffCode , :StuffC' +
        'ode1 , :ControlCodeFrom , :ControlCodeTo ,'
      
        #9'      '#9':DateFrom , :DateTo ,:DateFromRemain   , :YearIDFrom , :' +
        'YearIDTo ,  :DiameterFrom , :DiameterTo'
      
        '          ,  :PersonID1DFrom , :PersonID1DTo ,  :PersonID4From ,' +
        ' :PersonID4To'
      
        '          ,  :PersonID1From , :PersonID1To  ,  :PersonID2From , ' +
        ':PersonID2To'
      ''
      ') as cardex'
      '  LEFT OUTER JOIN'
      '   LookUps ON Cardex.SecondTypeItem = LookUps.LookUpID'
      
        #9#9#9#9#9#9'LEFT OUTER JOIN StuffCodingFacilities ScF ON ScF.StuffCode' +
        ' = cardex.StuffCode AND ScF.StoreID = cardex.StoreID'
      ''
      ' CROSS JOIN'
      '     Fitful'
      
        'where SellsEmporium between :SellsEmporiumFrom and :SellsEmporiu' +
        'mTo'
      
        'ORDER BY cardex.StuffCode,ReciptDate,  case when n_ValuationType' +
        '=6 then ReciptID  else 0 end , EffectType, ReciptNumber,ReciptTy' +
        'pe,ControlCode')
    Left = 400
    Top = 368
    ParamData = <
      item
        Name = 'STOREIDFROM'
        DataType = ftInteger
        ParamType = ptInput
        Value = 0
      end
      item
        Name = 'STOREIDTO'
