  object qrySpecialRecall: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qrySpecialRecallAfterOpen
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'StuffCodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 8
        Value = '0'
      end
      item
        Name = 'StuffCodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 8
        Value = '0'
      end
      item
        Name = 'StoreIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = 0
      end
      item
        Name = 'StoreIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = 0
      end
      item
        Name = 'RcpNumberFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'RcpNumberTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '0'
      end
      item
        Name = 'DateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '0'
      end
      item
        Name = 'YearIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'YearIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SecondTypeItemFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SecondTypeItemTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT        T.YearID, T.TozinID, T.StuffCode, StuffCoding.c_St' +
        'uffName, T.PersonID1, Customers.CustName, ROUND(ISNULL(T.Machine' +
        'FullWeight - T.MachineWeight, 0), 3) AS Entity, T.StoreID, Store' +
        's.c_StoreName, Units.UnitName,'
      
        '                         T.TozinNumber, T.TozinDate, ReciptTypes' +
        '.ReciptCaption, T.TozinNote, T.AidNumber, T.AidDate, T.UseUnitID' +
        ', T.SecondType, LookUps.Name AS SecondTypeName, T.MachineNo, T.M' +
        'achineName, StuffCoding.c_StuffTecInfo,'
      
        '                         StuffCoding.sd1, StuffCoding.sd2, Stuff' +
        'Coding.sd3, StuffCoding.sd4, StuffCoding.sd5, StuffCoding.sd6, S' +
        'tuffCoding.sd7, StuffCoding.sd8, StuffCoding.sd9'
      ', Fitful.FitfulID AS _Checked'
      'FROM            ReciptItems AS Ri RIGHT OUTER JOIN'
      
        '                         Tozin AS T ON Ri.TozinID = T.TozinID LE' +
        'FT OUTER JOIN'
      
        '                         LookUps ON T.SecondType = LookUps.LookU' +
        'pID INNER JOIN'
      
        '                         Stores ON T.StoreID = Stores.n_StoreID ' +
        'INNER JOIN'
      '                         Units INNER JOIN'
      
        '                         StuffCoding ON Units.UnitCode = StuffCo' +
        'ding.n_UnitCode ON T.StuffCode = StuffCoding.c_StuffCode LEFT OU' +
        'TER JOIN'
      
        '                         Customers ON T.PersonID1 = Customers.Cu' +
        'stID INNER JOIN'
      
        '                         ReciptTypes ON T.ReciptType = ReciptTyp' +
        'es.ReciptType'
      'CROSS JOIN Fitful'
      ''
      'WHERE  (Ri.ReciptItemID IS NULL)'
      'AND (T.StuffCode BETWEEN :StuffCodeFrom AND :StuffCodeTo)'
      'AND (T.StoreID  BETWEEN :StoreIDFrom AND :StoreIDTo)'
      'AND (T.TozinNumber BETWEEN :RcpNumberFrom AND :RcpNumberTo)'
      'AND (T.TozinDate BETWEEN :DateFrom AND :DateTo )'
      'AND(T.YearID BETWEEN :YearIDFrom AND :YearIDTo)'
      
        'AND(LookUps.Code BETWEEN :SecondTypeItemFrom AND :SecondTypeItem' +
        'To  OR T.SecondType  IS NULL  )'
      ''
      '')
    Left = 313
    Top = 209
