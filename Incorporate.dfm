  object qryStuff_Unit_TecInf: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      'SELECT       Manif.SellPrice1, A.*'
      'FROM            Aid_StuffCoding AS A LEFT OUTER JOIN'
      
        '                             (SELECT        ManifestoItems.Stuff' +
        'Code AS c_StuffCode, ManifestoItems.SellPrice1'
      
        '                                FROM            Manifesto LEFT O' +
        'UTER JOIN'
      
        '                                                         Custome' +
        'rs ON Manifesto.CustomerGrpIDFrom <= Customers.CustomerGrpID AND' +
        ' Manifesto.CustomerGrpIDTo >= Customers.CustomerGrpID AND Manife' +
        'sto.CustIDFrom <= Customers.CustID AND '
      
        '                                                         Manifes' +
        'to.CustIDTo >= Customers.CustID LEFT OUTER JOIN'
      
        '                                                         Manifes' +
        'toItems ON Manifesto.ManifestoID = ManifestoItems.ManifestoID'
      
        '                                WHERE        (ManifestoItems.Stu' +
        'ffCode <> 0) AND (Manifesto.SellOrBuy = 0) AND (Manifesto.Manife' +
        'stoRunDate ='
      
        '                                                             (SE' +
        'LECT        MAX(ManifestoRunDate) AS Expr1'
      
        '                                                                ' +
        'FROM            Manifesto AS Manifesto_1))) AS Manif ON A.c_Stuf' +
        'fCode = Manif.c_StuffCode'
      'WHERE        (A.State = 0)')
    Left = 611
    Top = 153
  end
