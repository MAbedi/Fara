  object qryUpDate: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'TotalInputPrice'
        Size = -1
        Value = Null
      end
      item
        Name = 'TotalStandardRate'
        Size = -1
        Value = Null
      end
      item
        Name = 'StoreID'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptType'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptNumberFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ReciptNumberTo'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ReciptDateFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ReciptDateTo'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'YearIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'CustIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'CustIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'SellsEmporiumFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'SellsEmporiumTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCode'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'UPDATE ReciptItems SET TotalPrice = :TotalInputPrice , TotalStan' +
        'dardRate = :TotalStandardRate'
      ''
      'FROM         Recipts INNER JOIN'
      
        '                      ReciptItems ON Recipts.ReciptID = ReciptIt' +
        'ems.ReciptID AND Recipts.ServerID = ReciptItems.ServerID AND Rec' +
        'ipts.YearID = ReciptItems.YearID INNER JOIN'
      
        '                      ReciptTypes ON Recipts.ReciptType = Recipt' +
        'Types.ReciptType'
      ''
      '  AND ReciptItems.YearID = Recipts.YearID'
      'WHERE (Recipts.StoreID = :StoreID )'
      'AND (Recipts.ReciptType  = :ReciptType )'
      
        'AND (Recipts.ReciptNumber  BETWEEN :ReciptNumberFrom AND :Recipt' +
        'NumberTo )'
      
        'AND (Recipts.ReciptDate    BETWEEN :ReciptDateFrom   AND :Recipt' +
        'DateTo )'
      'AND (Recipts.ReciptState < 3) '
      'AND ( Recipts.DocNo = 0 )'
      'AND (Recipts.YearID BETWEEN   :YearIDFrom AND :YearIDTo)'
      
        'AND (Recipts.PersonID1 BETWEEN   :CustIDFrom AND :CustIDTo  OR R' +
        'ecipts.PersonID1=0 )'
      
        'AND (Recipts.SellsEmporium BETWEEN :SellsEmporiumFrom AND :Sells' +
        'EmporiumTo)'
      'AND (ReciptItems.StuffCode = :StuffCode )')
    Left = 168
    Top = 289
  end
