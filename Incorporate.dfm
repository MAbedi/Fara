  object qryStuffCode: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     ManifestoItems.StuffCode AS c_StuffCode, ManifestoIte' +
        'ms.SellPrice1, StuffCoding.StuffpublicPercent'
      'FROM            Manifesto INNER JOIN'
      
        '                         ManifestoItems ON Manifesto.ManifestoID' +
        ' = ManifestoItems.ManifestoID INNER JOIN'
      
        '                         StuffCoding ON ManifestoItems.StuffCode' +
        ' = StuffCoding.c_StuffCode INNER JOIN'
      
        '                         Customers ON Manifesto.CustomerGrpIDFro' +
        'm <= Customers.CustomerGrpID AND Manifesto.CustomerGrpIDTo >= Cu' +
        'stomers.CustomerGrpID AND Manifesto.CustIDFrom <= Customers.Cust' +
        'ID AND '
      '                         Manifesto.CustIDTo >= Customers.CustID'
      
        'WHERE        (ManifestoItems.StuffCode <> 0) AND (Manifesto.Sell' +
        'OrBuy = 0) AND (Manifesto.ManifestoRunDate = (SELECT MAX(Manifes' +
        'toRunDate)FROM Manifesto) )')
    Left = 496
    Top = 200
    object qryStuffCodec_StuffCode: TLargeintField
      FieldName = 'c_StuffCode'
    end
    object qryStuffCodeSellPrice1: TBCDField
      FieldName = 'SellPrice1'
      Precision = 19
    end
    object qryStuffCodeStuffpublicPercent: TFloatField
      FieldName = 'StuffpublicPercent'
    end
  end
  object qryRecal: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    BeforeEdit = qryIncorporateBeforeEdit
    BeforePost = qryIncorporateBeforePost
    AfterPost = qryIncorporateAfterPost
    BeforeDelete = qryIncorporateBeforeDelete
    AfterDelete = qryIncorporateAfterDelete
    Parameters = <
      item
        Name = 'StoreID'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptType'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptNumberFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptNumberTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptDateFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptDateTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'CustIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'CustIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'SellsEmporiumFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'SellsEmporiumTo'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'SELECT DISTINCT ReciptItems.StuffCode'
      ',Sum(ReciptItems.InputEntity+ReciptItems.OutputEntity) AS Entity'
      ',Sum(ReciptItems.InputWeight+ReciptItems.OutputWeight) AS Weight'
      ',Sum(ReciptItems.Wage) AS Wage'
      ',Sum(ReciptItems.Scoria) AS Scoria'
      ''
      'FROM Recipts INNER JOIN'
      
        'ReciptItems ON Recipts.ReciptID = ReciptItems.ReciptID AND Recip' +
        'ts.ServerID = ReciptItems.ServerID AND'
      'Recipts.YearID = ReciptItems.YearID INNER JOIN'
      'ReciptTypes ON Recipts.ReciptType = ReciptTypes.ReciptType'
      ''
      'AND ReciptItems.YearID = Recipts.YearID'
      'WHERE (Recipts.StoreID = :StoreID )'
      'AND (Recipts.ReciptType = :ReciptType )'
      
        'AND (Recipts.ReciptNumber BETWEEN :ReciptNumberFrom AND :ReciptN' +
        'umberTo )'
      
        'AND (Recipts.ReciptDate BETWEEN :ReciptDateFrom AND :ReciptDateT' +
        'o )'
      'AND (Recipts.ReciptState < 3)'
      'AND ( Recipts.DocNo = 0 )'
      'AND (Recipts.YearID BETWEEN :YearIDFrom AND :YearIDTo)'
      
        'AND (Recipts.PersonID1 BETWEEN :CustIDFrom AND :CustIDTo OR Reci' +
        'pts.PersonID1=0 )'
      
        'AND (Recipts.SellsEmporium BETWEEN :SellsEmporiumFrom AND :Sells' +
        'EmporiumTo)'
      ''
      'GROUP BY ReciptItems.StuffCode')
    Left = 64
    Top = 304
  end
