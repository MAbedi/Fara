    SQL.Strings = (
      
        'SELECT  Recipts.ReciptNumber, Recipts.ReciptDate, ReciptItems.St' +
        'uffCode, StuffCoding.c_StuffName, Units.UnitName, Recipts.AidNum' +
        'ber, Recipts.AidDate,'
      
        '        ReciptItems.InputEntity + ReciptItems.OutputEntity AS En' +
        'tity, ReciptItems.InputWeight + ReciptItems.OutputWeight AS Weig' +
        'ht,'
      ''
      '        ReciptItems.UnitSellPrice,'
      
        '        ReciptItems.TotalInputPrice + ReciptItems.TotalOutputPri' +
        'ce AS TotalPrice,'
      '   ReciptItems.TotallSellPrice,'
      
        '        ReciptItems.TotalInputPrice + ReciptItems.TotalOutputPri' +
        'ce-isnull(DeficitValue,0) AS Price,'
      '         Recipts.StoreID, Stores.c_StoreName,'
      
        '        Recipts.ReciptID, ReciptItems.ReciptItemID, Recipts.Reci' +
        'ptType, Recipts.PersonID1 AS PersonID1, Customers.CustName, Cust' +
        'omers.CustomerGrpID,'
      
        '        CustomersGroup.CustomerGrpName, ReciptItems.ServerID, Re' +
        'ciptItems.YearID'
      ', ReciptItems.WaterCo, Units.UnitCode'
      
        ', ISNULL(ReciptItems.DeficitValue, 0) + ReciptItems.DeficitValue' +
        '2 + ReciptItems.DeficitValue3 AS DeficitValue , ReciptItems.Item' +
        'Note, ReciptItems.ControlCode'
      ''
      'FROM    Stores RIGHT OUTER JOIN'
      
        '        Recipts ON Stores.n_StoreID = Recipts.StoreID  RIGHT OUT' +
        'ER JOIN'
      '        ReciptItems LEFT OUTER JOIN'
      '        Units RIGHT OUTER JOIN'
      
        '        StuffCoding ON Units.UnitCode = StuffCoding.n_UnitCode O' +
        'N ReciptItems.StuffCode = StuffCoding.c_StuffCode ON'
      
        '        Recipts.ReciptID = ReciptItems.ReciptID AND Recipts.Serv' +
        'erID = ReciptItems.ServerID AND Recipts.YearID = ReciptItems.Yea' +
        'rID'
      ''
      'LEFT OUTER JOIN'
      '        CustomersGroup RIGHT OUTER JOIN'
      
        '        Customers ON CustomersGroup.CustomerGrpID = Customers.Cu' +
        'stomerGrpID ON ReciptItems.PersonID1 = Customers.CustID'
      ''
      ' INNER JOIN'
      
        '                      LookUps ON Recipts.SecondType = LookUps.Lo' +
        'okUpID'
      ''
      
        'WHERE     (LookUps.Code BETWEEN :SecondTypeCodeFrom AND :SecondT' +
        'ypeCodeTo ) AND '
      ''
      ''
      
        '       (Recipts.ReciptNumber BETWEEN :ReciptNumberFrom AND :Reci' +
        'ptNumberTo) AND'
      
        '       (ReciptItems.StuffCode BETWEEN :StuffCodeFrom AND :StuffC' +
        'odeTo) AND'
      
        '       (Recipts.StoreID BETWEEN :StoreIDFrom AND  :StoreIDTo) AN' +
        'D'
      
        '       (Recipts.ReciptDate BETWEEN :ReciptDateFrom AND :ReciptDa' +
        'teTo) AND'
      
        '       (Customers.CustomerGrpID BETWEEN :CustomerGrpIDFrom AND :' +
        'CustomerGrpIDTo) AND'
      
        '       (Recipts.PersonID1 BETWEEN :PersonID1From AND :PersonID1T' +
        'o) and'
      '       ( Recipts.ReciptType in (:ReciptType) )'
      ' AND (Recipts.ReciptState < 3)'
      'AND (Recipts.YearID BETWEEN   :YearIDFrom AND :YearIDTo)'
      
        '     AND (Recipts.SellsEmporium BETWEEN :SellsEmporiumFrom AND :' +
        'SellsEmporiumTo)'
      
        'AND (Recipts.SellsMethod BETWEEN :SellsMethodFrom AND :SellsMeth' +
        'odTo)'
      
        '       AND (Recipts.PersonID2 BETWEEN :PersonID2From AND :Person' +
        'ID2To)'
      
        'And (Recipts.StoreID not in (Select part From dbo.SplitString(:N' +
        'otStoreID,'#39','#39')))'
      ' ')
    Left = 216
    Top = 233
