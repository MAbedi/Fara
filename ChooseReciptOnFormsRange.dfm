  object qryChecks: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryChecksAfterOpen
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     dbo.Forms.FormID, dbo.Forms.FormNumber, dbo.Forms.For' +
        'mDate, dbo.Forms.CustomerID1, Customers_1.CustName AS CustName1,' +
        ' '
      
        '                      (CASE WHEN (dbo.Forms.CustomerID2 IS NULL ' +
        'OR'
      
        '                      dbo.Forms.CustomerID2 = 0) THEN dbo.FormIt' +
        'ems.CustomerID2 ELSE dbo.Forms.CustomerID2 END) AS CustomerID2, '
      
        '                      Customers_2.CustName AS CustName2, FormTyp' +
        'es.FormCaption, dbo.FormItemsAmount(Forms.FormID,Forms.ServerID,' +
        ' Forms.YearID) AS FormItemsAmount, '
      
        '                      dbo.FormItems.ItemAmount AS Price, dbo.For' +
        'mItems.CheckNumber, dbo.FormItems.BankName, dbo.FormItems.Accoun' +
        'tNumber, '
      
        '                      dbo.FormItems.CheckDate, dbo.FormItems.Acc' +
        'ountNumberNew, dbo.FormItems.ItemNote, dbo.Forms.FormType'
      'FROM         Forms INNER JOIN'
      
        '                      FormTypes ON Forms.FormType = FormTypes.Fo' +
        'rmType LEFT OUTER JOIN'
      
        '                      FormItems ON Forms.FormID = FormItems.Form' +
        'ID LEFT OUTER JOIN'
      
        '                      Customers Customers_2 ON (CASE WHEN (dbo.F' +
        'orms.CustomerID2 IS NULL OR'
      
        '                      dbo.Forms.CustomerID2 = 0) THEN dbo.FormIt' +
        'ems.CustomerID2 ELSE dbo.Forms.CustomerID2 END) = Customers_2.Cu' +
        'stID LEFT OUTER JOIN'
      
        '                      Customers Customers_1 ON Forms.CustomerID1' +
        ' = Customers_1.CustID'
      'WHERE     (dbo.Forms.FormType > - 999999)'
      ' ')
    Left = 72
    Top = 136
  end
