  object qryInsert: TADOQuery
    Connection = DmF.adcBSell
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'ReciptID'
        Size = -1
        Value = Null
      end
      item
        Name = 'FormID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'INSERT INTO ReciptOnFormsRange'
      '                      (FormID, ReciptID)'
      'SELECT     FormID,:ReciptID'
      'FROM         Forms'
      'WHERE     (FormID IN (:FormID))')
    Left = 122
    Top = 271
