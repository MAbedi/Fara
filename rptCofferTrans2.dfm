      end
      item
        Name = 'TypeDoc4'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CustIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CustIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 999999
      end
      item
        Name = 'DateFrom'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '0'
      end
      item
        Name = 'DateTo'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'DateFrom1'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '0'
      end
      item
        Name = 'YearIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'YearIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SellsMethodFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SellsMethodTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SellsEmporiumFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SellsEmporiumTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'AidDateFrom'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 8000
        Value = '0000/00/00'
      end
      item
        Name = 'AidDateTo'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 8000
        Value = '9999/99/99'
      end
      item
        Name = 'DefaultDateFrom'
        DataType = ftWideString
        Size = 10
        Value = '0000/00/00'
      end
      item
        Name = 'DefaultDateTo'
        DataType = ftWideString
        Size = 10
        Value = '9999/99/99'
      end>
    SQL.Strings = (
      
        'SELECT   CofferTrasaction.*, bed- bes AS balance, Fitful.FitfulI' +
        'D  AS calcuBalance'
      
        ',Arzbed- Arzbes AS Arzbalance, Fitful.FitfulID  AS calcuArzBalan' +
        'ce ,'
      
        '      case CustomerID2 when 0 then CofferTrasaction.CustomerName' +
        '2 else'
      
        '        case when len(isnull(customers.custfirstname,'#39#39')) = 0 th' +
        'en customers.custname  else  customers.custfirstname+'#39' '#39' +custom' +
        'ers.custname END'
      ''
      '       end as CustName2 '
      'FROM    ('
      'SELECT     AllAccount_1.*'
      
        'FROM         dbo.AllAccount( :TypeDoc1 , :TypeDoc2, :TypeDoc3 , ' +
        ':TypeDoc4 , :CustIDFrom , :CustIDTo ,  :DateFrom , :DateTo, :Dat' +
        'eFrom1'
      '  , :YearIDFrom   , :YearIDTo '
      
        ', :SellsMethodFrom , :SellsMethodTo , :SellsEmporiumFrom ,  :Sel' +
        'lsEmporiumTo , DEFAULT ) AS AllAccount_1'
      ''
      ') CofferTrasaction LEFT OUTER JOIN'
      
        '  dbo.Customers ON CofferTrasaction.CustomerID2 =  dbo.Customers' +
        '.CustID'
      'CROSS JOIN Fitful'
      
        'where  ((ISNULL(AidInfoDate, '#39#39') = '#39#39') OR (AidInfoDate = '#39'/  /'#39')' +
        ' OR (AidInfoDate = '#39'0'#39') OR (AidInfoDate BETWEEN :AidDateFrom AND' +
        ' :AidDateTo))'
      
        '   AND ((ISNULL(DefaultDate, '#39#39') = '#39#39') OR (DefaultDate BETWEEN :' +
        'DefaultDateFrom AND :DefaultDateTo))'
      ''
      ''
      
        '  order by CofferTrasaction.FormDate, BedOrderBes,CofferTrasacti' +
        'on.FormType,CofferTrasaction.FormNumber'
      ''
      ''
      ' '
      ' '
      '')
