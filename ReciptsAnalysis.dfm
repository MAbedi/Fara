      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT * ,  (SELECT ReciptCaption FROM  ReciptTypes WHERE       ' +
        ' (ReciptType = Recipts.ReciptType )) AS ReciptCaption '
      '  FROM    Recipts'
