    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        #13'SELECT     dbo.Customers.CustID, dbo.Customers.CustName, dbo.Cu' +
