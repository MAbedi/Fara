        '                      dbo.Stores ON dbo.Recipts.StoreID = dbo.St' +
        'ores.n_StoreID LEFT OUTER JOIN'
      
        '                      dbo.Customers ON dbo.Recipts.PersonID1 = d' +
        'bo.Customers.CustID'
      
        'WHERE     (dbo.Recipts.ReciptType = 2) AND (Recipts_1.ParentReci' +
        'ptID IS NULL)')
