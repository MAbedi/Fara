  object qryDetail_Item: TADOQuery
    Connection = DMF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    DataSource = srcMater_Recipt
    Parameters = <
      item
        Name = 'ReciptID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 6
      end>
    SQL.Strings = (
      
        'SELECT     dbo.ReciptItems.ReciptItemID, dbo.ReciptItems.ReciptI' +
        'D, dbo.ReciptItems.StuffCode, dbo.StuffCoding.c_StuffName, dbo.U' +
        'nits.UnitName, '
      
        '                      dbo.ReciptItems.StuffSize, dbo.ReciptItems' +
        '.StuffDiameter, dbo.ReciptItems.StuffAlloy, '
      
        '                      dbo.ReciptItems.InputEntity + dbo.ReciptIt' +
        'ems.OutputEntity AS Entity, dbo.ReciptItems.InputWeight + dbo.Re' +
        'ciptItems.OutputWeight AS Weight, '
      
        '                      dbo.ReciptItems.ControlCode, dbo.ReciptIte' +
        'ms.StuffGrade, dbo.ReciptItems.TotalInputPrice + dbo.ReciptItems' +
        '.TotalOutputPrice AS Price, '
      
        '                      dbo.ReciptItems.UnitSellPrice, dbo.ReciptI' +
        'tems.ItemNote, dbo.ReciptItems.preReciptItemID'
      'FROM         dbo.ReciptItems INNER JOIN'
      
        '                      dbo.StuffCoding ON dbo.ReciptItems.StuffCo' +
        'de = dbo.StuffCoding.c_StuffCode INNER JOIN'
      
        '                      dbo.Units ON dbo.StuffCoding.n_UnitCode = ' +
        'dbo.Units.UnitCode'
      'WHERE     ReciptID = :ReciptID;')
