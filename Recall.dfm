        'State, dbo.Recipts.ReciptType, dbo.ReciptTypes.ReciptCaption, Re' +
        'cipts_1.ParentReciptID,dbo.Recipts.PersonID2'
      'FROM         dbo.Recipts INNER JOIN'
      
        '                      dbo.ReciptTypes ON dbo.Recipts.ReciptType ' +
        '= dbo.ReciptTypes.ReciptType LEFT OUTER JOIN'
      
        '                      dbo.Recipts Recipts_1 ON dbo.Recipts.Recip' +
