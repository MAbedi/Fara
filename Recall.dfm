    SQL.Strings = (
      
        'SELECT     dbo.Recipts.ReciptID, dbo.Recipts.ReciptNumber, dbo.R' +
        'ecipts.ReciptDate, dbo.Recipts.PersonID1, dbo.Customers.CustName' +
