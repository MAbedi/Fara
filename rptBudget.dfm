  object qryBudget: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qryBudgetAfterOpen
    Parameters = <
      item
        Name = 'BudgetCodeFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'BudgetCodeTo'
        DataType = ftString
        Size = 6
        Value = '999999'
      end
      item
        Name = 'FormDateFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'FormDateTo'
        DataType = ftString
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'AidInfoDateFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'AidInfoDateTo'
        DataType = ftString
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'CustomerID1From'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CustomerID1To'
        DataType = ftString
        Size = 7
        Value = '9999999'
      end
      item
        Name = 'UserAdmin'
        Size = -1
        Value = Null
      end
      item
        Name = 'UserID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'select  *,bed+bed2 as bed3 , bes+bes2 as bes3,BudgetCaption_L1 _' +
        'BudgetName'
      'from'
      
        '(SELECT       isnull( case dbo.FormTypes.DisplayFormType when 0 ' +
        'then  dbo.Forms.BudgetCode else dbo.FormItems.BudgetCode end ,0 ' +
        ')  as BudgetCode ,'
      
        '      sum( CASE dbo.FormTypes.BudgetEffect  WHEN  1  THEN ( case' +
        ' dbo.FormTypes.DisplayFormType when 0 then  dbo.Forms.Amount els' +
        'e dbo.FormItems.ItemAmount end )  ELSE 0  END) as Bed,'
      
        '      sum( CASE dbo.FormTypes.BudgetEffect  WHEN  2  THEN ( case' +
        ' dbo.FormTypes.DisplayFormType when 0 then  dbo.Forms.Amount  el' +
        'se  dbo.FormItems.ItemAmount  end )  ELSE 0  END) as Bes,'
      
        '      sum( CASE dbo.FormTypes.BudgetEffect  WHEN  3  THEN ( case' +
        ' dbo.FormTypes.DisplayFormType when 0 then  dbo.Forms.Amount els' +
        'e  dbo.FormItems.ItemAmount  end )  ELSE 0  END) as Bed2,'
      
        '      sum( CASE dbo.FormTypes.BudgetEffect  WHEN  4  THEN ( case' +
        ' dbo.FormTypes.DisplayFormType when 0 then  dbo.Forms.Amount els' +
        'e  dbo.FormItems.ItemAmount  end ) ELSE 0  END) as Bes2'
      ',BT.BudgetCaption_L1'
      'FROM         dbo.FormTypes INNER JOIN'
      
        '                      dbo.Forms ON dbo.FormTypes.FormType = dbo.' +
        'Forms.FormType LEFT OUTER JOIN'
      
        '                      dbo.FormItems ON dbo.Forms.FormID = dbo.Fo' +
        'rmItems.FormID'
      
        '                      LEFT OUTER JOIN Acc.BudgetTopics BT ON dbo' +
        '.Forms.BudgetCode = BT.BudgetTopicID'
      
        '                      LEFT OUTER JOIN Acc.Budgets B ON BT.Budget' +
        'TopicID = B.BudgetTopicID'
      ''
      
        'where dbo.FormTypes.BudgetEffect<>0 and (dbo.Forms.BudgetCode be' +
        'tween :BudgetCodeFrom and :BudgetCodeTo)'
      
        'AND(dbo.Forms.FormDate between :FormDateFrom and :FormDateTo)AND' +
        '(dbo.Forms.AidInfoDate between :AidInfoDateFrom and :AidInfoDate' +
        'To)'
      
        'AND(dbo.Forms.CustomerID1 between :CustomerID1From and :Customer' +
        'ID1To)'
      
        'AND ((:UserAdmin = 1) OR (B.CompanyCode in(select n_subcompany f' +
        'rom farasystems.dbo.operatorcompanies where (userid = :UserID)))' +
        ')'
      ''
      
        'GROUP BY    isnull( case dbo.FormTypes.DisplayFormType when 0 th' +
        'en  dbo.Forms.BudgetCode else dbo.FormItems.BudgetCode end , 0 )'
      '  ,BT.BudgetCaption_L1'
      ')BudgetBalance'
      ''
      'ORDER BY BudgetCode'
      ''
      '')
    Left = 240
    Top = 152
