  object qryStore: TADOQuery
    Connection = DmF.adcBSell
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'DateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'StoreIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'StoreIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'UserID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'UserIDAdmin'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'DECLARE @ReciptDateFrom CHAR(10) = :DateFrom'
      'DECLARE @ReciptDateTo CHAR(10) = :DateTo'
      'DECLARE @StoreIDFrom INT = :StoreIDFrom'
      'DECLARE @StoreIDTo INT = :StoreIDTo'
      ''
      'SELECT DISTINCT R.StoreID, c_StoreName'
      'FROM (SELECT DISTINCT r.StoreID'
      'FROM            Recipts AS r INNER JOIN'
      
        '                         ReciptTypes1 AS t ON r.ReciptType = t.R' +
        'eciptType'
      'WHERE        (t.EffectType IN (2, 4, 6, 7, 8)'
      'AND (r.ReciptDate BETWEEN  @ReciptDateFrom AND @ReciptDateTo )'
      'AND (r.StoreID BETWEEN @StoreIDFrom AND @StoreIDTo )'
      ') UNION'
      'SELECT DISTINCT r.StoreID2'
      'FROM            Recipts AS r INNER JOIN'
      
        '                         ReciptTypes1 AS t ON r.ReciptType = t.R' +
        'eciptType'
      'WHERE        (t.EffectType IN (2, 4, 6, 7, 8))'
      'AND (r.ReciptDate BETWEEN  @ReciptDateFrom AND @ReciptDateTo )'
      'AND (r.StoreID2 BETWEEN @StoreIDFrom AND @StoreIDTo )'
      ''
      ') R INNER JOIN Stores ON R.StoreID = Stores.n_StoreID'
      ' LEFT OUTER JOIN  UsersStore ON R.StoreID = UsersStore.n_StoreID'
      
        'WHERE ( (UsersStore.n_UserID = :UserID )or ( :UserIDAdmin = 127)' +
        ')'
      ''
      'ORDER BY R.StoreID'
      ''
      ''
      '')
    Left = 296
    Top = 6
  end
  object qryStuffs: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterScroll = qryStuffsAfterScroll
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'DateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'StoreID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'StuffCodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 8
        Value = Null
      end
      item
        Name = 'StuffCodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 8
        Value = Null
      end>
    SQL.Strings = (
      'SELECT DISTINCT '
      
        '                          Rs.StuffCode, Sc.c_StuffName, Units.Un' +
        'itName, Sc.c_StuffTecInfo, Sc.n_minOrder, Sc.n_maxOrder, Sc.n_or' +
        'derPoint, '
      
        '                         Sc.c_KeepPlace,ScF.KeepPlace, Sc.sd1, S' +
        'c.sd2, Sc.sd3, Sc.sd4, Sc.sd5, Sc.sd6, Sc.sd7, Sc.sd8, Sc.sd9'
      
        ', Sc.Cabinet, ScF.Cabinet Cabinets, LookUps.Name AS St1Name, Uni' +
        'ts2.UnitName AS UnitName2, Sc.StuffNote'
      'FROM            StuffCoding Sc INNER JOIN'
      
        '                         ReciptItems_Stock Rs ON Sc.c_StuffCode ' +
        '= Rs.StuffCode LEFT OUTER JOIN'
      
        '                         LookUps ON Sc.st1 = LookUps.Code LEFT O' +
        'UTER JOIN'
      
        '                         Units ON Sc.n_UnitCode = Units.UnitCode' +
        ' LEFT OUTER JOIN'
      
        '                         Units AS Units2 ON Sc.UnitCode2 = Units' +
        '2.UnitCode'
      
        #9#9#9#9#9#9' LEFT OUTER JOIN StuffCodingFacilities ScF ON ScF.StuffCod' +
        'e = Sc.c_StuffCode AND ScF.StoreID = Rs.StoreID'
      'WHERE       /*  (isnull(LookUps.Kind,301) = 301) AND*/'
      '  (Rs.ReciptDate BETWEEN :DateFrom AND :DateTo)'
      'AND (   :StoreID in ( Rs.StoreID , Rs.StoreID2 ) )'
      'AND (Rs.StuffCode BETWEEN :StuffCodeFrom  AND :StuffCodeTo)'
      ''
      'ORDER BY  Rs.StuffCode')
    Left = 448
    Top = 6
  end
