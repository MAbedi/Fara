      end>
    SQL.Strings = (
      
        'SELECT    Fitful.FitfulID AS UnitSellPriceBackLog , 0 AS Row, Ca' +
        'rdex .* , LookUps .*'
      
        ', Fitful.FitfulID  AS CalcuBackLogEntity, Fitful.FitfulID  AS Ca' +
        'lcuBackLogWeight'
      
        ', Fitful.FitfulID AS CalcuBacklogPrice ,  Fitful.FitfulID  AS Ca' +
        'lcuBacklogSellPrice'
      ', LookUps.Name AS SecondTypeItemName'
      ''
      
        'FROM dbo.Cardex(:StoreIdFrom ,:StoreIdTo , :StuffCode , :StuffCo' +
        'de1 , :ControlCodeFrom , :ControlCodeTo'
      
        #9'      '#9',:DateFrom , :DateTo ,:DateFromRemain   , :YearIDFrom , ' +
        ':YearIDTo ,  :DiameterFrom , :DiameterTo'
      
        '          ,  :PersonID1DFrom , :PersonID1DTo  ,  :PersonID4From ' +
        ', :PersonID4To'
      
        '          ,  :PersonID1From , :PersonID1To  ,  :PersonID2From , ' +
        ':PersonID2To'
      ') AS Cardex LEFT OUTER JOIN'
      
        '   LookUps ON Cardex.SecondTypeItem = LookUps.LookUpID CROSS JOI' +
        'N'
      '     Fitful'
      ''
      
        'where SellsEmporium between :SellsEmporiumFrom and :SellsEmporiu' +
        'mTo'
      ''
      ''
      
        'ORDER BY Cardex.ReciptDate, CASE WHEN n_ValuationType = 6 THEN R' +
        'eciptID ELSE 0 END ,Cardex.EffectType, Cardex.ReciptNumber, Card' +
        'ex.ReciptType, Cardex.ControlCode, Cardex.ReciptItemID')
