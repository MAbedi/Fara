        Value = Null
      end>
    SQL.Strings = (
      'SELECT DISTINCT ReciptItems.StuffCode'
      ',Sum(ReciptItems.InputEntity+ReciptItems.OutputEntity) AS Entity'
      ',Sum(ReciptItems.InputWeight+ReciptItems.OutputWeight) AS Weight'
      ',Sum(ReciptItems.Wage) AS Wage'
      ',Sum(ReciptItems.Scoria) AS Scoria'
      ''
      'FROM Recipts INNER JOIN'
      
        'ReciptItems ON Recipts.ReciptID = ReciptItems.ReciptID AND Recip' +
        'ts.ServerID = ReciptItems.ServerID AND'
      'Recipts.YearID = ReciptItems.YearID INNER JOIN'
      'ReciptTypes ON Recipts.ReciptType = ReciptTypes.ReciptType'
      ''
      'AND ReciptItems.YearID = Recipts.YearID'
      'WHERE (Recipts.StoreID BETWEEN :StoreIDFrom AND :StoreIDTo )'
      'AND (Recipts.ReciptType = :ReciptType )'
      
        'AND (Recipts.ReciptNumber BETWEEN :ReciptNumberFrom AND :ReciptN' +
        'umberTo )'
      
        'AND (Recipts.ReciptDate BETWEEN :ReciptDateFrom AND :ReciptDateT' +
        'o )'
      'AND (Recipts.ReciptState < 3)'
      'AND ( Recipts.DocNo = 0 )'
      'AND (Recipts.YearID BETWEEN :YearIDFrom AND :YearIDTo)'
      
        'AND (Recipts.PersonID1 BETWEEN :CustIDFrom AND :CustIDTo OR Reci' +
        'pts.PersonID1=0 )'
      
        'AND (Recipts.SellsEmporium BETWEEN :SellsEmporiumFrom AND :Sells' +
        'EmporiumTo)'
      ''
      'GROUP BY ReciptItems.StuffCode')
    Left = 64
    Top = 304
  end
