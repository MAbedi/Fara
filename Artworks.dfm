  object qryLastBuy: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'StuffCode'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end>
    SQL.Strings = (
      'SELECT        Recipts.ReciptDate'
      'FROM            ReciptItems INNER JOIN'
      
        '                         Recipts ON ReciptItems.ReciptID = Recip' +
        'ts.ReciptID AND ReciptItems.ServerID = Recipts.ServerID AND Reci' +
        'ptItems.YearID = Recipts.YearID'
      
        'WHERE        (Recipts.ReciptType = 5) AND (ReciptItems.StuffCode' +
        ' = :StuffCode )'
      'ORDER BY Recipts.ReciptDate')
    Left = 474
    Top = 363
  end
