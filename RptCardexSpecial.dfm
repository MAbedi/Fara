      item
        Name = 'StoreIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'StoreIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end>
    SQL.Strings = (
      'SELECT      dbo.Recipts.StoreID, dbo.Stores.c_StoreName'
      'FROM         dbo.Stores INNER JOIN'
      '                      dbo.Recipts INNER JOIN'
      
        '                      dbo.ReciptTypes ON dbo.Recipts.ReciptType ' +
        '= dbo.ReciptTypes.ReciptType ON dbo.Stores.n_StoreID = dbo.Recip' +
        'ts.StoreID'
      
        ' LEFT OUTER JOIN   UsersStore ON Stores.n_StoreID = UsersStore.n' +
        '_StoreID'
      
        'WHERE ( (UsersStore.n_UserID = :UserID )or ( :UserIDAdmin = 127)' +
        ')'
      'AND        (dbo.ReciptTypes.EffectType in(2,4,8) )'
      
        '                      AND (dbo.Recipts.ReciptDate BETWEEN  :Date' +
        'From AND :DateTo)'
      
        'AND        (dbo.Recipts.StoreID BETWEEN :StoreIDFrom AND :StoreI' +
        'DTo)'
      ''
      'GROUP BY dbo.Recipts.StoreID, dbo.Stores.c_StoreName'
      'ORDER BY dbo.Recipts.StoreID')
    Left = 432
    Top = 8
    object qryStoreStoreID: TSmallintField
      FieldName = 'StoreID'
    end
    object qryStorec_StoreName: TStringField
      FieldName = 'c_StoreName'
      Size = 70
    end
  end
