    SQL.Strings = (
      
        'SELECT     CustomerID1, CustomerID1_1, OutputEntity, OutputWeigh' +
        't, TotalOutputPrice, TotalSellsPrice, Profit, ItemNote, ReciptNu' +
        'mber, ReciptDate,'
      
        '                      ReciptCaption, ReciptItemID, ReciptID, Rec' +
        'iptType, StoreID, UnitSellPrice, UnitSellPriceOut, TotalSellsPri' +
        'ceNew, UnitSellPriceOutNew, ProfitNew'
      ',ServerID, YearID ,Entity'
      'FROM         ('
      ''
      
        'SELECT  Recipts.PersonID1 AS CustomerID1, Customers.CustName AS ' +
        'CustomerID1_1, ReciptItems.OutputEntity,'
      
        '        ReciptItems.OutputWeight, ReciptItems.TotalOutputPrice, ' +
        'ReciptItems_1.TotalOutputPrice AS TotalSellsPrice,'
      
        '        ReciptItems_1.TotalOutputPrice - ReciptItems.TotalOutput' +
        'Price AS Profit, ReciptItems.ItemNote, Recipts.ReciptNumber,'
      
        '        Recipts.ReciptDate, ReciptTypes.ReciptCaption, ReciptIte' +
        'ms.ReciptItemID,'
      '        ReciptItems.ReciptID, Recipts.ReciptType,'
      ''
      
        '        CASE dbo.ReciptTypes.IncreasingInventoryStore WHEN 2 THE' +
        'N Recipts.StoreID'
      '            ELSE Recipts.StoreID2 END AS StoreID,'
      ''
      '         ReciptItems.UnitSellPrice,'
      
        '                      ReciptItems_1.UnitSellPrice AS UnitSellPri' +
        'ceOut , ReciptItems.ServerID, ReciptItems.YearID ,'
      '(SELECT     TOP 1   a.TotalOutputPrice'
      '                        FROM         Recipts r INNER JOIN'
      
        '                                              ReciptItems a ON r' +
        '.ReciptID = a.ReciptID  AND r.ServerID = a.ServerID AND r.YearID' +
        ' = a.YearID'
      
        '                        WHERE     (r.ReciptID = Recipts.ParentRe' +
        'ciptID) AND ((a.preReciptItemID = ReciptItems.preReciptItemID) O' +
        'R'
      
        '                                              (a.preReciptItemID' +
        ' = ReciptItems.ReciptItemID))) AS TotalSellsPriceNew,'
      '                          (SELECT    TOP 1    a.UnitSellPrice'
      '                             FROM         Recipts r INNER JOIN'
      
        '                                                   ReciptItems a' +
        ' ON r.ReciptID = a.ReciptID  AND r.ServerID = a.ServerID AND r.Y' +
        'earID = a.YearID'
      
        '                             WHERE     (r.ReciptID = Recipts.Par' +
        'entReciptID) AND ((a.preReciptItemID = ReciptItems.preReciptItem' +
        'ID) OR'
      
        '                                                   (a.preReciptI' +
        'temID = ReciptItems.ReciptItemID))) AS UnitSellPriceOutNew,'
      '                          (SELECT     TOP 1   a.TotalOutputPrice'
      '                             FROM         Recipts r INNER JOIN'
      
        '                                                   ReciptItems a' +
        ' ON r.ReciptID = a.ReciptID  AND r.ServerID = a.ServerID AND r.Y' +
        'earID = a.YearID'
      
        '                             WHERE     (r.ReciptID = Recipts.Par' +
        'entReciptID) AND ((a.preReciptItemID = ReciptItems.preReciptItem' +
        'ID) OR'
      
        '                                                   (a.preReciptI' +
        'temID = ReciptItems.ReciptItemID))) - ReciptItems.TotalOutputPri' +
        'ce AS ProfitNew'
      #9#9#9#9#9#9#9#9#9#9#9#9'   ,'
      
        '                          (SELECT     sum(  a.InputEntity +a.Out' +
        'putEntity )'
      '                             FROM         Recipts r INNER JOIN'
      
        '                                                   ReciptItems a' +
        ' ON r.ReciptID = a.ReciptID  AND r.ServerID = a.ServerID AND r.Y' +
        'earID = a.YearID'
      
        '                             WHERE     (r.ReciptID = Recipts.Par' +
        'entReciptID) AND ((a.preReciptItemID = ReciptItems.preReciptItem' +
        'ID) OR'
      
        '                                                   (a.preReciptI' +
        'temID = ReciptItems.ReciptItemID))) - ReciptItems.TotalOutputPri' +
        'ce AS Entity'
      ''
      ''
      'FROM    Recipts INNER JOIN'
      
        '        ReciptTypes ON Recipts.ReciptType = ReciptTypes.ReciptTy' +
        'pe INNER JOIN'
      
        '        ReciptItems ON Recipts.ReciptID = ReciptItems.ReciptID A' +
        'ND Recipts.ServerID = ReciptItems.ServerID AND Recipts.YearID = ' +
        'ReciptItems.YearID'
      ' LEFT OUTER JOIN'
      '        ('#9'select ReciptItems.*'
      #9#9#9'FROM'#9'ReciptItems INNER JOIN'
      #9#9#9#9#9'Recipts ON ReciptItems.ReciptID = Recipts.ReciptID AND'
      #9#9#9#9#9#9'ReciptItems.ServerID = Recipts.ServerID AND'
      #9#9#9#9#9#9'ReciptItems.YearID = Recipts.YearID INNER JOIN'
      
        '                    ReciptTypes1 ON Recipts.ReciptType = ReciptT' +
        'ypes1.ReciptType'
      #9#9#9'where SellEffect <>0'
      
        #9#9#9#9#9#9' ) ReciptItems_1 ON ReciptItems.ReciptItemID = ReciptItems' +
        '_1.preReciptItemID'
      
        '              AND ReciptItems.ServerID = ReciptItems_1.ServerID ' +
        'AND ReciptItems.YearID = ReciptItems_1.YearID'
      '              LEFT OUTER JOIN'
      '        Customers ON Recipts.PersonID1 = Customers.CustID'
      'WHERE   (ReciptTypes.EffectType in(4,8)) AND'
      '        (ReciptItems.preReciptItemID = :ReciptItemID) and'
      '        (Recipts.ReciptDate between :Datefrom and :DateTo) and'
      
        '        (ReciptItems.StuffCode between :StuffCodeFrom and :Stuff' +
        'CodeTo) and'
      
        '        (ReciptItems.ControlCode between :ControlCodeFrom and :C' +
        'ontrolCodeTo)  '
      ''
      '        AND( (dbo.ReciptTypes.IncreasingInventoryStore=2)'
      
        '        AND ((Recipts.StoreID between :storeFrom and :storeTo)or' +
        '(Recipts.StoreID2 between :store1From and :store1To)) '
      '        '
      '        OR( (dbo.ReciptTypes.IncreasingInventoryStore<2)'
      
        '        AND (Recipts.StoreID between :store2From and :store2To) ' +
        '  )'
      '        '
      '            )'
      '              AND '
      ''
      ''
      
        '        (ReciptItems.StuffDiameter between :DiameterFrom and :Di' +
        'ameterTo)'
      
        'and     ( ReciptItems.PersonID1 between :PersonIDItemFrom and  :' +
        'PersonIDItemTo)'
      
        'and     ( Recipts.PersonID1 between :OutPutPersonID1From and  :O' +
        'utPutPersonID1To)'
      
        'AND (Recipts.SellsEmporium BETWEEN :SellsEmporiumFrom AND :Sells' +
        'EmporiumTo)'
      ''
      ''
      ''
      ') AS derivedtbl_1'
      
        'GROUP BY CustomerID1, CustomerID1_1, OutputEntity, OutputWeight,' +
        ' TotalOutputPrice, TotalSellsPrice, Profit, ItemNote, ReciptNumb' +
        'er, ReciptDate, '
      
        '                      ReciptCaption, ReciptItemID, ReciptID, Rec' +
        'iptType, StoreID, UnitSellPrice, UnitSellPriceOut, TotalSellsPri' +
        'ceNew, UnitSellPriceOutNew, ProfitNew'
      '                      , ServerID,YearID ,Entity'
      '  -- ORDER BY Recipts.StoreID, ReciptItems.StuffCode'
      '')
    Left = 423
    Top = 325
