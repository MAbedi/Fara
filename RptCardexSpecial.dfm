      end>
    SQL.Strings = (
      
        'SELECT  ReciptItems.StuffCode, StuffCoding.c_StuffName, Units.Un' +
        'itName, ReciptItems.StuffSize,'
      
        '        ReciptItems.StuffDiameter, ReciptItems.StuffAlloy, Recip' +
        'tItems.ControlCode,'
      
        '        ReciptItems.InputEntity + ReciptItems.OutputEntity AS In' +
        'putEntity,'
      
        '        ReciptItems.InputWeight + ReciptItems.OutputWeight AS In' +
        'putWeight ,'
      
        '        ReciptItems.TotalInputPrice, ReciptItems.PersonID1 AS Pa' +
        'kingNo, Customers.CustName AS PakingName,'
      '         Recipts.ReciptNumber,'
      
        '        Recipts.ReciptDate, ReciptTypes.ReciptCaption, ReciptIte' +
        'ms.ReciptItemID,'
      '        ReciptItems.ReciptID, Recipts.ReciptType,'
      ''
      
        '        CASE dbo.ReciptTypes.IncreasingInventoryStore WHEN 2 THE' +
        'N Recipts.StoreID2      ELSE Recipts.StoreID END AS StoreID,'
      ''
      '        ReciptItems.UnitSellPrice'
      
        '        , ReciptItems.ItemNote, Customers_1.CustName, ReciptItem' +
        's.ServerID, ReciptItems.YearID'
      'FROM         StuffCoding INNER JOIN'
      '                      Recipts INNER JOIN'
      
        '                      ReciptItems ON Recipts.ReciptID = ReciptIt' +
        'ems.ReciptID AND Recipts.ServerID = ReciptItems.ServerID AND Rec' +
        'ipts.YearID = ReciptItems.YearID INNER JOIN'
      
        '                      ReciptTypes ON Recipts.ReciptType = Recipt' +
        'Types.ReciptType ON StuffCoding.c_StuffCode = ReciptItems.StuffC' +
        'ode INNER JOIN'
      
        '                      Units ON StuffCoding.n_UnitCode = Units.Un' +
        'itCode LEFT OUTER JOIN'
      
        '                      Customers AS Customers_1 ON Recipts.Person' +
        'ID1 = Customers_1.CustID LEFT OUTER JOIN'
      
        '                      Customers ON ReciptItems.PersonID1 = Custo' +
        'mers.CustID'
      ''
      'WHERE   (ReciptTypes.EffectType in (2,8) ) and'
      '        (Recipts.ReciptDate between :Datefrom and :DateTo) and'
      
        '        (ReciptItems.StuffCode between :StuffCodeFrom and :Stuff' +
        'CodeTo) and'
      
        '        (ReciptItems.ControlCode between :ControlCodeFrom and :C' +
        'ontrolCodeTo)  and'
      
        '        (CASE dbo.ReciptTypes.IncreasingInventoryStore WHEN 2 TH' +
        'EN Recipts.StoreID2'
      
        '            ELSE Recipts.StoreID END between :StoreFrom and :Sto' +
        'reTo) and'
      
        '        (ReciptItems.StuffDiameter between :DiameterFrom and :Di' +
        'ameterTo) '
      
        'and  ( ReciptItems.PersonID1 between :PersonIDItemFrom and  :Per' +
        'sonIDItemTo)'
      
        'and     ( Recipts.PersonID1 between :InPutPersonID1From and  :In' +
        'PutPersonID1To)'
      
        'AND (Recipts.SellsEmporium BETWEEN :SellsEmporiumFrom AND :Sells' +
        'EmporiumTo)'
      ''
      
        'ORDER BY CASE dbo.ReciptTypes.IncreasingInventoryStore WHEN 2 TH' +
        'EN Recipts.StoreID2   ELSE Recipts.StoreID END , ReciptItems.Stu' +
        'ffCode')
    Left = 248
    Top = 125
