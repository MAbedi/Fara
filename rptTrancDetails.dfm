        '                         StuffCoding.c_StuffName, Units.UnitName' +
        ', Ri.StuffSize, Ri.StuffDiameter, Ri.StuffAlloy, Ri.ControlCode,'
      
        '                         (CASE WHEN SellEffect > 0 THEN - 1 ELSE' +
        ' 1 END) * Ri.InputEntity + Ri.OutputEntity AS entity, (CASE WHEN' +
        ' SellEffect > 0 THEN - 1 ELSE 1 END)'
      
        '                         * Ri.InputWeight + Ri.OutputWeight AS w' +
        'eight, Ri.UnitSellPrice,'
      ''
      
        '                         CASE ReciptTypes.BedType WHEN 1 THEN Ri' +
        '.TotalInputPrice'
      
        '                             + Ri.TotalOutputPrice/*+ ISNULL(All' +
        'Deficits_ForR.DeficitAdd_Dec,0)*/ ELSE 0 END  AS bed,'
      
        '                         CASE ReciptTypes.BesType WHEN 1 THEN Ri' +
        '.TotalInputPrice'
      
        '                             + Ri.TotalOutputPrice/*+ ISNULL(All' +
        'Deficits_ForR.DeficitAdd_Dec,0)*/ ELSE 0 END  AS bes,'
      ''
      
        '                       3 AS kind, R.StoreID, Ri.ItemNote, Ri.Per' +
        'sonID1 AS ItemPersonID, R.ServerID, R.YearID,'
      
        '                         Customers.CustName AS custname, Custome' +
        'rs_1.CustName AS ItemPersonName, LookUps_SecondType.Name AS Seco' +
        'ndName'
      
        ', R.PersonID2, Customers_2.CustName AS CustName2, R.PersonID3, C' +
        'ustomers_3.CustName AS CustName3, R.SellsMethod, SellsMethods.Se' +
        'llsMethodName'
      
        ', SellsEmporiums.SellsEmporium, SellsEmporiums.SellsEmporiumName' +
        ','
      'DeficitValue,DeficitValue2,DeficitValue3,DeficitValue4 ,'
      '  (TotalInputPrice + TotalOutputPrice)'
      
        '  +  (InputEntity + OutputEntity) * Ri.UnitCommission +ROUND((In' +
        'putWeight + OutputWeight) * Ri.Commission,0)- DeficitValue - Def' +
        'icitValue2 - DeficitValue4 AS TotalDeficient'
      
        '  ,Ri.TaxValue ,ABS(Ri.TotalInputPrice-Ri.TotalOutputPrice) Tota' +
        'lPrice,Ri.TotallSellPrice'
      ''
      'FROM            ReciptItems Ri INNER JOIN'
      
        '                         Recipts R ON R.ReciptID = Ri.ReciptID A' +
        'ND R.ServerID = Ri.ServerID AND R.YearID = Ri.YearID INNER JOIN'
      
        '                         ReciptTypes ON R.ReciptType = ReciptTyp' +
        'es.ReciptType INNER JOIN'
      '                         Units INNER JOIN'
      
        '                         StuffCoding ON Units.UnitCode = StuffCo' +
        'ding.n_UnitCode ON Ri.StuffCode = StuffCoding.c_StuffCode /*LEFT' +
        ' OUTER JOIN'
      
        '                         AllDeficits_ForRecipts ON R.ReciptID = ' +
        'AllDeficits_ForR.ReciptID AND R.ServerID = AllDeficits_ForR.Serv' +
        'erID AND'
      
        '                         R.YearID = AllDeficits_ForR.YearID*/ LE' +
        'FT OUTER JOIN'
      
        '                         Customers AS Customers_1 ON Ri.PersonID' +
        '1 = Customers_1.CustID LEFT OUTER JOIN'
      
        '                         Customers ON R.PersonID1 = Customers.Cu' +
        'stID LEFT OUTER JOIN'
      
        '                         LookUps AS LookUps_SecondType ON R.Seco' +
        'ndType = LookUps_SecondType.LookUpID LEFT OUTER JOIN'
      
        '                         Customers AS Customers_2 ON R.PersonID2' +
        ' = Customers_2.CustID LEFT OUTER JOIN'
      
        '                         Customers AS Customers_3 ON R.PersonID3' +
        ' = Customers_3.CustID LEFT OUTER JOIN'
      
        #9#9'SellsMethods  ON R.SellsMethod  = SellsMethods.SellsMethod    ' +
        '   INNER JOIN'
      
        '                         SellsEmporiums ON R.SellsEmporium = Sel' +
        'lsEmporiums.SellsEmporium'
      ''
      ''
      'WHERE  ( (ReciptTypes.BedType = 1) OR (ReciptTypes.BesType = 1))'
      
        'AND (R.ReciptState < 3) AND (StuffCoding.OwnerShipKind IN (  :St' +
        'uffKindActive  ))'
      'AND (R.ReciptDate BETWEEN :DateFrom AND  :DateTo)'
      'AND (Ri.StuffCode BETWEEN :StuffCodeFrom AND :StuffCodeTo)'
      
        'And ((:NotStuffCode1 ='#39'-1'#39') or Not exists( Select part From Spli' +
        'tString( :NotStuffCode2 ,'#39','#39') where part = Ri.StuffCode))'
      
        'And ((:INStuffCode1 ='#39'-1'#39') or exists( Select part From SplitStri' +
        'ng( :INStuffCode2 ,'#39','#39') where part = Ri.StuffCode ))'
      ''
      ''
      'AND (Ri.StuffDiameter BETWEEN :DiameterFrom AND :DiameterTo)'
      
        'AND (Ri.PersonID1 BETWEEN :ItemPersonIDFrom AND :ItemPersonIDTo ' +
        'OR Ri.PersonID1 IS NULL)'
      'AND (R.PersonID1 BETWEEN :PersonIDFrom AND :PersonIDTo)'
      'AND (R.PersonID2 BETWEEN :PersonID2From AND :PersonID2To)'
      
        'AND (Ri.ControlCode BETWEEN  :ControlcodeFrom AND :ControlcodeTo' +
        ')'
      'AND (R.ReciptType IN (  :Recipt__Type ))'
      
        'AND (LookUps_SecondType.Code BETWEEN :SecondTypeFrom AND :Second' +
        'TypeTo )'
      'AND (R.SellsMethod BETWEEN :SellsMethodFrom AND :SellsMethodTo)'
      
        'AND (R.SellsEmporium BETWEEN :SellsEmporiumFrom AND :SellsEmpori' +
        'umTo)'
      ''
      ''
      'ORDER BY R.ReciptDate')
