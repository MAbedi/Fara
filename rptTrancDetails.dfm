  object qry4backup: TADOQuery
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     AccTran.*, dbo.Customers.CustName AS custname, Custom' +
        'ers_1.CustName AS ItemPersonName'
      'FROM         ('
      
        'SELECT     dbo.Recipts.PersonID1, dbo.Recipts.ReciptID, dbo.Reci' +
        'pts.ReciptNumber, dbo.Recipts.ReciptDate, dbo.ReciptTypes.Recipt' +
        'Type,'
      
        '                      dbo.ReciptTypes.ReciptCaption, dbo.ReciptI' +
        'tems.StuffCode, dbo.StuffCoding.c_StuffName, dbo.Units.UnitName,' +
        ' dbo.ReciptItems.StuffSize, '
      
        '                      dbo.ReciptItems.StuffDiameter, dbo.ReciptI' +
        'tems.StuffAlloy, dbo.ReciptItems.ControlCode, '
      
        '                      dbo.ReciptItems.InputEntity + dbo.ReciptIt' +
        'ems.OutputEntity AS entity, dbo.ReciptItems.InputWeight + dbo.Re' +
        'ciptItems.OutputWeight AS weight,'
      
        '                      dbo.ReciptItems.UnitSellPrice, dbo.ReciptI' +
        'tems.TotalInputPrice + dbo.ReciptItems.TotalOutputPrice AS bed, '
      
        'dbo.ReciptItems.TotalOutputPrice - dbo.ReciptItems.TotalOutputPr' +
        'ice AS bes, 3 AS kind,'
      
        '                      dbo.Recipts.StoreID, dbo.ReciptItems.ItemN' +
        'ote, dbo.ReciptItems.PersonID1 AS ItemPersonID'
      ' ,Recipts.ServerID, Recipts.YearID'
      'FROM         dbo.ReciptItems INNER JOIN'
      
        '                      dbo.Recipts ON Recipts.ReciptID = ReciptIt' +
        'ems.ReciptID AND Recipts.ServerID = ReciptItems.ServerID AND Rec' +
        'ipts.YearID = ReciptItems.YearID INNER JOIN'
      
        '                      dbo.ReciptTypes ON dbo.Recipts.ReciptType ' +
        '= dbo.ReciptTypes.ReciptType INNER JOIN'
      '                      dbo.Units INNER JOIN'
      
        '                      dbo.StuffCoding ON dbo.Units.UnitCode = db' +
        'o.StuffCoding.n_UnitCode ON dbo.ReciptItems.StuffCode = dbo.Stuf' +
        'fCoding.c_StuffCode'
      
        'WHERE     (dbo.ReciptTypes.BedType = 1)AND (dbo.Recipts.ReciptSt' +
        'ate < 3)'
      ' AND (dbo.StuffCoding.OwnerShipKind  in (:StuffKindActive))'
      'UNION ALL'
      
        'SELECT     dbo.Recipts.PersonID1, dbo.Recipts.ReciptID, dbo.Reci' +
        'pts.ReciptNumber, dbo.Recipts.ReciptDate, dbo.ReciptTypes.Recipt' +
        'Type, '
      
        '                      dbo.ReciptTypes.ReciptCaption, dbo.ReciptI' +
        'tems.StuffCode, dbo.StuffCoding.c_StuffName, dbo.Units.UnitName,' +
        ' dbo.ReciptItems.StuffSize,'
      
        '                      dbo.ReciptItems.StuffDiameter, dbo.ReciptI' +
        'tems.StuffAlloy, dbo.ReciptItems.ControlCode,'
      
        '                      Manfi (dbo.ReciptItems.InputEntity + dbo.R' +
        'eciptItems.OutputEntity) AS entity, Manfi (dbo.ReciptItems.Input' +
        'Weight + dbo.ReciptItems.OutputWeight) AS weight,'
      
        '                      dbo.ReciptItems.UnitSellPrice, 0 AS bed, d' +
        'bo.ReciptItems.TotalInputPrice + dbo.ReciptItems.TotalOutputPric' +
        'e AS bes, 3 AS kind, dbo.Recipts.StoreID, dbo.ReciptItems.ItemNo' +
        'te,'
      '                      dbo.ReciptItems.PersonID1 AS ItemPersonID'
      ' ,Recipts.ServerID, Recipts.YearID'
      'FROM         dbo.ReciptItems INNER JOIN'
      
        '                      dbo.Recipts ON Recipts.ReciptID = ReciptIt' +
        'ems.ReciptID AND Recipts.ServerID = ReciptItems.ServerID AND Rec' +
        'ipts.YearID = ReciptItems.YearID INNER JOIN'
      
        '                      dbo.ReciptTypes ON dbo.Recipts.ReciptType ' +
        '= dbo.ReciptTypes.ReciptType INNER JOIN'
      '                      dbo.Units INNER JOIN'
      
        '                      dbo.StuffCoding ON dbo.Units.UnitCode = db' +
        'o.StuffCoding.n_UnitCode ON dbo.ReciptItems.StuffCode = dbo.Stuf' +
        'fCoding.c_StuffCode'
      
        'WHERE     (dbo.ReciptTypes.BesType = 1) AND (dbo.Recipts.ReciptS' +
        'tate < 3)'
      ' AND (dbo.StuffCoding.OwnerShipKind  in (:StuffKindActive))'
      '  ) AccTran LEFT OUTER JOIN'
      
        '  dbo.Customers Customers_1 ON AccTran.ItemPersonID = Customers_' +
        '1.CustID LEFT OUTER JOIN'
      '  dbo.Customers ON AccTran.PersonID1 = dbo.Customers.CustID'
      'WHERE'
      ' (ReciptDate BETWEEN :DateFrom AND :DateTo)'
      'AND (StuffCode BETWEEN :StuffCodeFrom AND :StuffCodeTo)'
      'AND (StuffDiameter BETWEEN :DiameterFrom AND :DiameterTo)'
      
        'and (ItemPersonID BETWEEN :ItemPersonIDFrom AND :ItemPersonIDTo ' +
        'OR AccTran.ItemPersonID IS NULL)'
      'and (AccTran.PersonID1 BETWEEN :PersonIDFrom AND :PersonIDTo)'
      'AND(ControlCode BETWEEN :ControlcodeFrom AND :ControlcodeTo)'
      'and ReciptType in(:Recipt__Type)'
      'order by ReciptDate')
    Left = 424
    Top = 280
  end
