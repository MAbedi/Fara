  object qryFunction: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'DateFrom'
        DataType = ftWideString
        Size = 10
        Value = '0000/00/00'
      end
      item
        Name = 'DateTo'
        DataType = ftWideString
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'PERNOFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PERNOTo'
        DataType = ftWideString
        Size = 6
        Value = '999999'
      end
      item
        Name = 'UserID'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      
        'SELECT        FunctionId, Minid, Maxid , AllPERNO, PERName, Work' +
        'ShopId, CustName, AllDATE, StartHour, EndHour, FunctionHour, Sta' +
        'rtCLOCKTIME, EndCLOCKTIME, CLOCKTIMEFun, '
      
        '                         DefStart, DefEnd, CASE WHEN CONVERT(var' +
        'char(5), DATEADD(MINUTE, DATEDIFF(MINUTE, CLOCKTIMEFun, Function' +
        'Hour), 0),108) < '#39'12:00:00'#39' THEN CONVERT(varchar(5), '
      
        '                         DATEADD(MINUTE, DATEDIFF(MINUTE, CLOCKT' +
        'IMEFun, FunctionHour), 0),108) ELSE '
      
        #9#9#9#9#9#9' CONVERT(varchar(5), DATEADD(MINUTE, DATEDIFF(MINUTE, Func' +
        'tionHour, '
      
        '                         CLOCKTIMEFun), 0),108) END AS DefFuncti' +
        'on,Shift'
      
        'FROM            (SELECT        Functions_1.FunctionId, Tbl_CLOCK' +
        '.Minid, Tbl_CLOCK.Maxid, AllTime.AllPERNO, Customers__PER.CustNa' +
        'me AS PERName, Functions_1.WorkShopId, Customers.CustName, '
      
        '                                                    AllTime.AllD' +
        'ATE, CONVERT(varchar(5), Functions_1.StartHour,108) AS StartHour' +
        ', CONVERT(varchar(5), Functions_1.EndHour,108) AS EndHour, '
      #9#9#9#9#9#9#9#9#9#9#9#9#9'CONVERT(varchar(5), '
      
        '                                                    Functions_1.' +
        'FunctionHour,108) AS FunctionHour, Tbl_CLOCK.StartCLOCKTIME, Tbl' +
        '_CLOCK.EndCLOCKTIME, '
      #9#9#9#9#9#9#9#9#9#9#9#9#9'CONVERT(varchar(5), DATEADD(MINUTE, '
      
        '                                                    DATEDIFF(MIN' +
        'UTE, Tbl_CLOCK.StartCLOCKTIME, Tbl_CLOCK.EndCLOCKTIME), 0),108) ' +
        'AS CLOCKTIMEFun, '
      #9#9#9#9#9#9#9#9#9#9#9#9#9'CASE WHEN CONVERT(varchar(5), '
      
        '                                                    DATEADD(MINU' +
        'TE, DATEDIFF(MINUTE, Tbl_CLOCK.StartCLOCKTIME, Functions_1.Start' +
        'Hour), 0),108) < '#39'12:00:00'#39' THEN CONVERT(varchar(5), '
      
        '                                                    DATEADD(MINU' +
        'TE, DATEDIFF(MINUTE, Tbl_CLOCK.StartCLOCKTIME, Functions_1.Start' +
        'Hour), 0),108) ELSE'
      #9#9#9#9#9#9#9#9#9#9#9#9#9' CONVERT(varchar(5), DATEADD(MINUTE, '
      
        '                                                    DATEDIFF(MIN' +
        'UTE, Functions_1.StartHour, Tbl_CLOCK.StartCLOCKTIME), 0),108) E' +
        'ND AS DefStart,'
      #9#9#9#9#9#9#9#9#9#9#9#9#9' CASE WHEN CONVERT(varchar(5), DATEADD(MINUTE, '
      
        '                                                    DATEDIFF(MIN' +
        'UTE, Tbl_CLOCK.EndCLOCKTIME, Functions_1.EndHour), 0),108) < '#39'12' +
        ':00:00'#39' THEN '
      #9#9#9#9#9#9#9#9#9#9#9#9#9'CONVERT(varchar(5), DATEADD(MINUTE, '
      
        '                                                    DATEDIFF(MIN' +
        'UTE, Tbl_CLOCK.EndCLOCKTIME, Functions_1.EndHour), 0),108) ELSE '
      
        #9#9#9#9#9#9#9#9#9#9#9#9#9'CONVERT(varchar(5), DATEADD(MINUTE, DATEDIFF(MINUTE' +
        ', '
      
        '                                                    Functions_1.' +
        'EndHour, Tbl_CLOCK.EndCLOCKTIME), 0),108) END AS DefEnd'
      
        '                                                      ,Functions' +
        '_1.Shift'
      
        '                           FROM            (SELECT       MIN(ID)' +
        ' AS Minid,  MAX(ID) AS Maxid, KARTNO, CLOCKDATE, MAX(CASE WHEN I' +
        'O_TYPE = 1 THEN CLOCKTIME ELSE NULL END) AS StartCLOCKTIME, '
      
        '                                                                ' +
        '               MAX(CASE WHEN IO_TYPE = 2 THEN CLOCKTIME ELSE NUL' +
        'L END) AS EndCLOCKTIME'
      
        '                                                      FROM      ' +
        '      Tsh.ClockDmp AS ClockDmp_1'
      
        '                                                      GROUP BY K' +
        'ARTNO, CLOCKDATE) AS Tbl_CLOCK RIGHT OUTER JOIN'
      
        '                                                        (SELECT ' +
        'DISTINCT CLOCKDATE AS AllDATE, KARTNO AS AllPERNO'
      
        '                                                           FROM ' +
        '           (SELECT DISTINCT CLOCKDATE, KARTNO'
      
        '                                                                ' +
        '                      FROM            Tsh.ClockDmp'
      
        '                                                                ' +
        '                      UNION ALL'
      
        '                                                                ' +
        '                      SELECT DISTINCT FunctionDate, PersonId'
      
        '                                                                ' +
        '                      FROM            Tsh.Functions) AS abcd) AS' +
        ' AllTime INNER JOIN'
      
        '                                                    Customers AS' +
        ' Customers__PER ON AllTime.AllPERNO = Customers__PER.CustID ON T' +
        'bl_CLOCK.CLOCKDATE = AllTime.AllDATE AND '
      
        '                                                    Tbl_CLOCK.KA' +
        'RTNO = AllTime.AllPERNO LEFT OUTER JOIN'
      
        '                                                    Customers IN' +
        'NER JOIN'
      
        '                                                    Tsh.Function' +
        's AS Functions_1 ON Customers.CustID = Functions_1.WorkShopId ON' +
        ' AllTime.AllDATE = Functions_1.FunctionDate AND '
      
        '                                                    AllTime.AllP' +
        'ERNO = Functions_1.PersonId'
      
        '                           WHERE        (AllTime.AllDATE BETWEEN' +
        ' :DateFrom AND :DateTo ) AND (AllTime.AllPERNO BETWEEN :PERNOFro' +
        'm AND :PERNOTo)'
      
        #9#9'                           AND dbo.ChkUser(Customers.OperatorI' +
        'D, :UserID)=1'
      #9#9#9#9'  ) AS dcbe')
    Left = 226
    Top = 163
