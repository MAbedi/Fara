  object qryFormList: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryFormListAfterOpen
    AfterScroll = qryFormListAfterScroll
    Parameters = <
      item
        Name = 'NumberFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'NumberTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 9999999
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '0'
      end
      item
        Name = 'DateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'StateFrom'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end
      item
        Name = 'StateTo'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 999
      end
      item
        Name = 'SellsMethodFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SellsMethodTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 999999
      end
      item
        Name = 'SellsEmporiumFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SellsEmporiumTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 999999
      end
      item
        Name = 'YearIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'YearIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CustomerGrpIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CustomerGrpIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      'SELECT        F.ID,'
      
        '  CASE WHEN CASE WHEN Fsum.ItemAmount IS NULL THEN F.Amount ELSE' +
        ' Fsum.ItemAmount END > 0 THEN N'#39'$'#39' ELSE '#39#39' END +'
      '  CASE WHEN F.DocNo <> 0 THEN N'#39#174#39' ELSE '#39#39' END +'
      '  CASE WHEN F.FormState = 1 THEN N'#39#248#39' ELSE '#39#39' END +'
      
        '  CASE WHEN Fp.FormNumber IS NOT NULL THEN N'#39#169#39' ELSE '#39#39' END AS F' +
        'ormFlag'
      
        ', F.FormID, F.FormNumber, F.FormDate, F.FormType, F.CustomerID1,' +
        ' '
      
        '                         CASE WHEN C1.CustName LIKE N'#39'%'#39' + ISNUL' +
        'L(C1.CustFirstName, '#39#39') + '#39'%'#39' THEN C1.CustName ELSE ISNULL(C1.Cu' +
        'stFirstName, '#39#39') + '#39' '#39' + C1.CustName END AS custname1, '
      
        '                         F.CustomerID2, CASE F.customerid2 WHEN ' +
        '0 THEN F.customername2 ELSE CASE WHEN C2.CustName LIKE N'#39'%'#39' + IS' +
        'NULL(C2.CustFirstName, '#39#39') '
      
        '                         + '#39'%'#39' THEN C2.CustName ELSE ISNULL(C2.C' +
        'ustFirstName, '#39#39') + '#39' '#39' + C2.CustName END END AS custname2, CASE' +
        ' WHEN Fsum.ItemAmount IS NULL '
      
        '                         THEN F.Amount ELSE Fsum.ItemAmount END ' +
        'AS amount, Fsum.CashWage, Fsum.ItemNote, F.FomNote, F.FormState,' +
        ' FormTypes.FormCaption, F.BudgetCode, F.ProjectID, '
      
        '                         F.DocNo, F.DocDate, F.FirstUser, F.Last' +
        'User, F.AidInfoNo, F.AidInfoDate, lookupspaytypes.Name AS paytyp' +
        'esname, lookupstopictypes.Name AS topictypesname, F.SellsMethod,' +
        ' '
      
        '                         SellsMethods.SellsMethodName, F.SellsEm' +
        'porium, SellsEmporiums.SellsEmporiumName, F.ServerID, F.YearID, ' +
        'FormTypes.DisplayFormType, F.TopicCode, F.DetailCode, F.CTopicCo' +
        'de, '
      
        '                         F.CTopicCode2, F.UserRegistrationDoc, F' +
        '.DefaultDate, F.DefaultDuration'
      ', F.CustomerID3,'
      
        'CASE WHEN customers_3.CustName LIKE N'#39'%'#39' + ISNULL(customers_3.Cu' +
        'stFirstName, '#39#39')+ '#39'%'#39' THEN customers_3.CustName'
      
        '                            ELSE ISNULL(customers_3.CustFirstNam' +
        'e, '#39#39') + '#39' '#39' + customers_3.CustName END AS custname3'
      ', F.CustomerID4,'
      
        'CASE WHEN customers_4.CustName LIKE N'#39'%'#39' + ISNULL(customers_4.Cu' +
        'stFirstName, '#39#39')+ '#39'%'#39' THEN customers_4.CustName'
      
        '                            ELSE ISNULL(customers_4.CustFirstNam' +
        'e, '#39#39') + '#39' '#39' + customers_4.CustName END AS custname4'
      ''
      ', CustomersGroup1.CustomerGrpID AS CustomerGrpID1,'
      
        '                         CustomersGroup1.CustomerGrpName AS Cust' +
        'omerGrpName1, F.MachineNo, F.AidInfoNo2, CAST(CASE WHEN Fsum.Ite' +
        'mAmount IS NULL THEN F.Amount ELSE Fsum.ItemAmount END AS bigint' +
        ')'
      
        '                          AS FAmount, F.TruckNumber, Fitful.Deta' +
        'ilCode AS Appendix, F.RelatedRecipts, F.ModifyDate, F.InsertDate'
      'FROM            Customers AS C1 RIGHT OUTER JOIN'
      '                         FormTypes INNER JOIN'
      
        '                         Forms F ON FormTypes.FormType = F.FormT' +
        'ype LEFT OUTER JOIN'
      
        '                         SellsEmporiums ON F.SellsEmporium = Sel' +
        'lsEmporiums.SellsEmporium LEFT OUTER JOIN'
      
        '                         Customers AS C2 ON F.CustomerID2 = C2.C' +
        'ustID ON C1.CustID = F.CustomerID1 LEFT OUTER JOIN'
      
        '                         SellsMethods ON F.SellsMethod = SellsMe' +
        'thods.SellsMethod LEFT OUTER JOIN'
      
        '                         LookUps AS lookupstopictypes ON F.Topic' +
        'Types = lookupstopictypes.LookUpID LEFT OUTER JOIN'
      
        '                         LookUps AS lookupspaytypes ON F.PayType' +
        's = lookupspaytypes.LookUpID LEFT OUTER JOIN'
      
        '                         FormItemsSum Fsum ON F.ServerID = Fsum.' +
        'ServerID AND F.YearID = Fsum.YearID AND F.FormID = Fsum.FormID I' +
        'NNER JOIN'
      
        '                         CustomersGroup AS CustomersGroup2 ON C2' +
        '.CustomerGrpID = CustomersGroup2.CustomerGrpID LEFT OUTER JOIN'
      
        '                         Customers AS customers_3 ON F.CustomerI' +
        'D3 = customers_3.CustID INNER JOIN'
      
        '                         CustomersGroup AS CustomersGroup1 ON C1' +
        '.CustomerGrpID = CustomersGroup1.CustomerGrpID CROSS JOIN'
      '                         Fitful LEFT OUTER JOIN'
      
        '                         Forms AS Fp ON F.ServerID = Fp.ServerID' +
        ' AND F.YearID = Fp.YearID AND F.FormID = Fp.ParentFormID LEFT OU' +
        'TER JOIN'
      
        '                         Customers AS customers_4 ON F.CustomerI' +
        'D4 = customers_4.CustID'
      'WHERE (F.FormNumber BETWEEN :numberfrom AND :numberto)'
      'AND (F.FormDate BETWEEN :datefrom AND :dateto)'
      'AND (F.FormState BETWEEN :statefrom AND :stateto)'
      'AND (F.SellsMethod BETWEEN :SellsMethodfrom AND :SellsMethodto)'
      
        'AND (F.SellsEmporium BETWEEN :SellsEmporiumfrom AND :SellsEmpori' +
        'umto)'
      'AND (F.YearID BETWEEN :YearIDfrom AND :YearIDto)'
      
        'AND (CASE WHEN CUSTOMERSGROUP2.CUSTOMERGRPID IS NULL THEN 0 ELSE' +
        ' CUSTOMERSGROUP2.CUSTOMERGRPID END BETWEEN :CustomerGrpIDFrom AN' +
        'D :CustomerGrpIDTo)')
    Left = 224
    Top = 165
