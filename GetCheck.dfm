    Connection = DmF.adcBSell
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      'SELECT DISTINCT  top 1   CustID, CustName, AccountKind,'
      
        '           BankName, AccountNumber, BankId,BankReports, Mobile,C' +
        'ustomerActive,NationalID'
      'FROM      Vu_CustomersGroups')
    Left = 707
    Top = 21
  end
