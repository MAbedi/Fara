    SQL.Strings = (
      
        'SELECT        Severable.CustID, Severable.TopicCode, Severable.D' +
        'etailCode, Severable.CTopicCode, Severable.CTopicCode2, Severabl' +
        'e.BudgetCode, Severable.Amount, Severable.SeverableNote, Severab' +
        'le.DeficitAmount, '
      
        '                         Severable.ArzAmount, Customers.CustName' +
        ', Customers.Address, Customers.Tel, Customers.Fax, Customers.ema' +
        'il, Customers.EconomicNumber, Customers.CustomerNote, Customers.' +
        'BankName, Customers.ManageName, '
      
        '                         Customers.NationalID, Customers.Mobile,' +
        ' Customers.Tel2, Customers.Tel3, Customers.CustAccountNumber, Cu' +
        'stomers.RegisterNumber, Customers.CustFirstName'
      'FROM            Severable INNER JOIN'
      
        '                         Customers ON Severable.CustID = Custome' +
        'rs.CustID'
      
        'WHERE        (Severable.FormItemID = :FormItemID) AND (Severable' +
        '.YearID = :YearID) AND (Severable.ServerID = :ServerID) AND (Sev' +
        'erable.FormID = :FormID)')
