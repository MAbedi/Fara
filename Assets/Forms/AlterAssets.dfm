      FieldName = 'StuffDesc'
      Size = 150
    end
    object qryAmvalSerialNum: TIntegerField
      Tag = 3
      DisplayLabel = #1587#1585#1610#1575#1604
      FieldName = 'SerialNum'
    end
    object qryAmvalDecDate: TStringField
