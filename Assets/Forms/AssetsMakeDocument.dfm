  object qryExportDoc: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    BeforeOpen = qryExportDocBeforeOpen
    AfterOpen = qryExportDocAfterOpen
    Parameters = <
      item
        Name = 'TopicCodeFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'TopicCodeTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SellsEmporiumFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SellsEmporiumTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      
        'SELECT     ISNULL(topiccode, 0) AS topiccode, ISNULL(detailcode,' +
        ' 0) AS detailcode, ISNULL(ctopiccode, 0) AS ctopiccode, ISNULL(c' +
        'topiccode2, 0) AS ctopiccode2, '
      
        '                      ISNULL(ctopiccode3, 0) AS ctopiccode3, %S ' +
        ' as Comment,Debt, Credit'
      
        'FROM     %S(   :TopicCodeFrom  ,  :TopicCodeTo , %S  , :SellsEmp' +
        'oriumFrom , :SellsEmporiumTo  )'
      'ORDER BY CASE WHEN Debt <>0 THEN 0 ELSE 1 END')
    Left = 477
    Top = 177
