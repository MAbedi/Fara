  object qryAmval: TADOQuery
    Active = True
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     Amval.PelakNum, Amval.StuffDesc, Amval.SerialNum, Dec' +
        'rease.DecDate, Amval.FirstDepValue, Amval.AssetsValue'
      'FROM         assets.Amval as Amval LEFT OUTER JOIN'
      
        '                      assets.Decrease as Decrease ON Amval.Seria' +
        'lNum = Decrease.SerialNum'
      
        'GROUP BY Amval.PelakNum, Amval.StuffDesc, Amval.SerialNum, Decre' +
        'ase.DecDate, Amval.FirstDepValue, Amval.AssetsValue')
    Left = 176
    Top = 1
  end
