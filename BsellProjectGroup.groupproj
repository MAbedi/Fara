	<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
		<PropertyGroup>
			<ProjectGuid>{679543C4-144F-40B2-A1B6-746587DE96D7}</ProjectGuid>
		</PropertyGroup>
		<ItemGroup>
			<Projects Include="BSell.dproj">
				<Dependencies/>
			</Projects>
			<Projects Include="Test\BSellTests.dproj">
				<Dependencies/>
			</Projects>
		</ItemGroup>
		<ProjectExtensions>
			<Borland.Personality>Default.Personality.12</Borland.Personality>
			<Borland.ProjectType/>
			<BorlandProject>
				<Default.Personality/>
			</BorlandProject>
		</ProjectExtensions>
		<Target Name="BSell">
			<MSBuild Projects="BSell.dproj"/>
		</Target>
		<Target Name="BSell:Clean">
			<MSBuild Projects="BSell.dproj" Targets="Clean"/>
		</Target>
		<Target Name="BSell:Make">
			<MSBuild Projects="BSell.dproj" Targets="Make"/>
		</Target>
		<Target Name="BSellTests">
			<MSBuild Projects="Test\BSellTests.dproj"/>
		</Target>
		<Target Name="BSellTests:Clean">
			<MSBuild Projects="Test\BSellTests.dproj" Targets="Clean"/>
		</Target>
		<Target Name="BSellTests:Make">
			<MSBuild Projects="Test\BSellTests.dproj" Targets="Make"/>
		</Target>
		<Target Name="Build">
			<CallTarget Targets="BSell;BSellTests"/>
		</Target>
		<Target Name="Clean">
			<CallTarget Targets="BSell:Clean;BSellTests:Clean"/>
		</Target>
		<Target Name="Make">
			<CallTarget Targets="BSell:Make;BSellTests:Make"/>
		</Target>
		<Import Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')" Project="$(BDS)\Bin\CodeGear.Group.Targets"/>
	</Project>
