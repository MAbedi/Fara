  object qryRptTransactions: TADOQuery
    AutoCalcFields = False
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryRptTransactionsAfterOpen
    CommandTimeout = 0
    Parameters = <
      item
