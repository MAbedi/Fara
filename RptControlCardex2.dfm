      end
      item
        Name = 'PersonID1DTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PersonID4From'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PersonID4To'
        DataType = ftWideString
        Size = 1
