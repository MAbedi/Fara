      end
      item
        Name = 'PersonID2To'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      'SELECT Fitful.FitfulIDc AS UnitSellPriceBackLog , 0 AS Row,'
      
        '      StoreID, n_ValuationType, c_StoreName, ReciptType, ReciptC' +
        'aption, ReciptDate, ReciptNumber, SUM(InputEntity) AS'
      
        '      InputEntity, SUM(InputWeight) AS InputWeight, SUM(TotalInp' +
        'utPrice) AS TotalInputPrice, SUM(OutputEntity)'
      
        '      AS OutputEntity, SUM(OutputWeight) AS OutputWeight, SUM(To' +
        'talOutputPrice) AS TotalOutputPrice, SUM'
      
        '      (BackLogEntity) AS BackLogEntity, SUM(BackLogWeight) AS Ba' +
        'ckLogWeight, SUM(BacklogPrice) AS BacklogPrice,'
      
        '      ReciptID, PersonID1, CustName, PersonID2, CustName2, Perso' +
        'nID3, CustName3, EffectType, SUM'
      
        '      (InTotallSellPrice) AS InTotallSellPrice, SUM(OutTotallSel' +
        'lPrice) AS OutTotallSellPrice, SUM(InvTotallSellPrice)'
      
        '      AS InvTotallSellPrice, AidNumber, AidDate, MAX(UnitSellPri' +
        'ceIn) AS UnitSellPriceIn, MAX(UnitSellPriceOut) AS'
      
        '      UnitSellPriceOut, MAX(UnitSellPriceBackLog1) AS UnitSellPr' +
        'iceBackLog1, ServerID, YearID, StoreID2,'
      '      c_StoreName2, ReciptNote'
      
        '      , Fitful.FitfulID AS CalcuBackLogEntity, Fitful.FitfulID A' +
        'S CalcuBackLogWeight, Fitful.FitfulIDc AS CalcuBacklogPrice ,'
      '      Fitful.FitfulIDc AS CalcuBacklogSellPrice'
      ''
      ''
      ''
      
        '      FROM dbo.Cardex (:StoreIdFrom ,:StoreIdTo , :StuffCode , :' +
        'StuffCode1 , :ControlCodeFrom , :ControlCodeTo ,'
      
        '      :DateFrom , :DateTo ,:DateFromRemain , :YearIDFrom , :Year' +
        'IDTo , :DiameterFrom , :DiameterTo'
      
        '      , :PersonID1DFrom , :PersonID1DTo , :PersonID4From , :Pers' +
        'onID4To'
      
        '          ,  :PersonID1From , :PersonID1To  ,  :PersonID2From , ' +
        ':PersonID2To'
      ''
      '      ) as cardex'
      '      CROSS JOIN Fitful'
      ''
      
        '      GROUP BY StoreID, n_ValuationType, c_StoreName, ReciptType' +
        ', ReciptCaption, ReciptDate, ReciptNumber, ReciptID,'
      
        '      PersonID1, CustName, PersonID2, CustName2, PersonID3, Cust' +
        'Name3, EffectType, AidNumber, AidDate, ServerID,'
      
        '      YearID, StoreID2, c_StoreName2, ReciptNote,Fitful.FitfulID' +
        'c,Fitful.FitfulID'
      
        '      ORDER BY ReciptDate, case when n_ValuationType=6 then Reci' +
        'ptID else 0 end , EffectType, ReciptNumber,ReciptType'
      '')
    Left = 320
    Top = 264
