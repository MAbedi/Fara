  object qryItemsReturnPrn: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qryItemsReturnPrnAfterOpen
    Parameters = <
      item
        Name = 'irTAXID'
        Size = -1
        Value = Null
      end
      item
        Name = 'TAXID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT  RI.ReciptItemID, RI.ReciptID, R.ReciptDate, R.ReciptNumb' +
        'er, R.ReciptType,'
      
        #9' '#9' ri.OutputEntity,ri.OutputWeight,ri.TotalOutputPrice,ri.Total' +
        'lSellPrice,'
      #9' '#9' bar.*,'
      #9' '#9' ri.OutputEntity-bar.InputEntity balance_Entity'
      'FROM'#9' ReciptItems AS RI '
      
        #9' '#9' INNER JOIN  Recipts AS R ON RI.ReciptID = R.ReciptID AND RI.' +
        'ServerID = R.ServerID AND RI.YearID = R.YearID'
      #9' '#9' INNER JOIN '
      #9' '#9' '#9' ('
      #9' '#9' '#9' '#9' SELECT  rib.preReciptItemID,rib.PrvYearID,'
      
        #9' '#9' '#9' '#9' '#9' '#9' SUM(rib.InputEntity) InputEntity, SUM(rib.InputWeigh' +
        't) InputWeight, '
      
        #9' '#9' '#9' '#9' '#9' '#9' SUM(rib.TotalInputPrice) TotalInputPrice, SUM(rib.To' +
        'tallSellPrice) TotallSellPrice'
      #9' '#9' '#9' '#9' FROM'#9' ReciptItems AS RIb '
      
        #9' '#9' '#9' '#9' '#9' '#9' INNER JOIN  Recipts AS Rb ON RIb.ReciptID = Rb.Recip' +
        'tID AND RIb.ServerID = Rb.ServerID AND RIb.YearID = Rb.YearID'
      #9' '#9' '#9' '#9' WHERE (Rb.ReciptType = 6)'
      #9' '#9' '#9' '#9' '#9' '#9' --and rb.YearID = 1404 -- param '
      #9' '#9' '#9' '#9' '#9' '#9' --and rb.ReciptNumber <= 14049531  -- param'
      #9#9'                 and Rb.irTAXID = :irTAXID'
      #9#9' Group by rib.preReciptItemID,rib.PrvYearID'
      #9' '#9' '#9' ) Bar on ri.ReciptItemID = bar.preReciptItemID'
      'WHERE (R.ReciptType = 12)'
      #9' '#9' --and r.ReciptNumber = 2847 -- param'
      #9#9' and r.TAXID = :TAXID ')
    Left = 358
    Top = 513
  end
