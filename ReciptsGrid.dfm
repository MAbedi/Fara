      end
      item
        Name = 'PersonID4To'
        DataType = ftWideString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'ReciptDateFrom'
        DataType = ftWideString
        Size = 10
        Value = '0000/00/00'
      end
      item
        Name = 'ReciptDateTo'
        DataType = ftWideString
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'SellsEmporiumFrom'
        DataType = ftWideString
        Size = 11
        Value = '-2147483646'
      end
      item
        Name = 'SellsEmporiumTo'
        DataType = ftWideString
        Size = 10
        Value = '2147483647'
      end>
    SQL.Strings = (
      'SELECT *, '
      
        '(SELECT TOP (1) P.ReciptNumber FROM Recipts P WHERE Recipts.Pare' +
        'ntReciptID = P.ReciptID'
      
        #9#9' AND Recipts.ServerID = P.ServerID AND Recipts.YearID = P.Year' +
        'ID  ORDER BY P.ReciptNumber) AS ParentReciptNumber,'
      
        '(SELECT TOP (1) C.ReciptNumber FROM Recipts C WHERE'#9'C.ParentReci' +
        'ptID = Recipts.ReciptID'
      
        #9#9' AND C.ServerID = Recipts.ServerID AND C.YearID = Recipts.Year' +
        'ID ORDER BY C.ReciptNumber) AS ChildReciptNumber'
      '     , REPLACE(RIGHT(ReciptDate, 5), '#39'/'#39', '#39#39') AS _ReciptDayMoon,'
      
        '(SELECT TOP (1) Pc.ReciptNumber FROM Recipts Pc WHERE Recipts.Pa' +
        'rentCoReciptID = Pc.ReciptID'
      
        #9#9' AND Recipts.ServerID = Pc.ServerID AND Recipts.YearID = Pc.Ye' +
        'arID  ORDER BY Pc.ReciptNumber) AS ParentCoReciptNumber'
      
        '---,(SELECT TOP (1) L.LookUpNote2 FROM LookUps L WHERE Recipts.A' +
        'rzTypeID = L.LookUpID) AS _CurrencySymbol'
      
        ',(SELECT TOP (1) c.CurrencySymbol FROM Currencies c WHERE Recipt' +
        's.ArzTypeID = c.CurrenciesID) AS _CurrencySymbol'
      
        ',(SELECT TOP (1) c.CurrencyCode FROM Currencies c WHERE Recipts.' +
        'ArzTypeID = c.CurrenciesID) AS CurrencyCode'
      
        ',CONVERT(VARCHAR(8),CONVERT(VARBINARY(4), ReciptNumber),2) AS Re' +
        'ciptNumberHex'
      '   FROM    Recipts'
      ''
      'WHERE     (ReciptID BetWeen :ReciptIDFrom and :ReciptIDTo )'
      'and ( YearID = :YearID )'
      'and ( ServerID  BetWeen :ServerIDFrom and :ServerIDTo )'
      'And (ReciptType = :ReciptType)'
      
        'And   ( ReciptNumber  BetWeen :ReciptNumberFrom and :ReciptNumbe' +
        'rTo )'
      'And   ( StoreID  BetWeen :StoreIDFrom and :StoreIDTo )  '
      'And   ( PersonID1  BetWeen :PersonID1From and :PersonID1To )'
      'And   ( PersonID2  BetWeen :PersonID2From and :PersonID2To )'
      'And   ( PersonID3  BetWeen :PersonID3From and :PersonID3To )'
      'And   ( PersonID4  BetWeen :PersonID4From and :PersonID4To )'
      'And ( ReciptDate  BetWeen :ReciptDateFrom and :ReciptDateTo )'
      
        'And(SellsEmporium BetWeen :SellsEmporiumFrom and :SellsEmporiumT' +
        'o)'
      'ORDER BY ReciptNumber'
      'OPTION (RECOMPILE);')
    Left = 485
    Top = 155
