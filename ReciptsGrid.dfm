    Parameters = <
      item
        Name = 'VATCo1'
        DataType = ftFloat
        Size = 3
        Value = 0.000000000000000000
      end
      item
        Name = 'VATCo2'
        DataType = ftFloat
        Size = 3
        Value = 0.000000000000000000
      end
      item
        Name = 'StoreID'
        DataType = ftWideString
        Size = 1
        Value = '1'
      end
      item
        Name = 'ReciptNumber'
        DataType = ftWideString
        Size = 1
        Value = '2'
      end
      item
        Name = 'PersonID1'
        DataType = ftWideString
        Size = 1
        Value = '3'
      end
      item
        Name = 'ReciptDate'
        DataType = ftWideString
        Size = 10
        Value = '1404/07/12'
      end
      item
        Name = 'ReciptID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 1
      end
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 1402
      end
      item
        Name = 'ServerID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT * , '#39#39' AS SyntheticCode , CAST(StuffCode AS varchar(50)) ' +
        'AS BarcodeField'
      
        ',(TotalInputPrice + TotalOutputPrice) * (1 + :VATCo1 * 0.01) AS ' +
        'VATCoTotalPrice'
      
        ',(TotalInputPrice + TotalOutputPrice) * (:VATCo2 * 0.01) AS VATC' +
        'oPrice,TotallSellPrice - (InvEntity+InvWeight) AS TotallSellPric' +
        'e_InvWeight'
      
        ',LTRIM(StuffCode) + RIGHT('#39'0'#39' + LTRIM(:StoreID), 2) + LTRIM(:Rec' +
        'iptNumber) + LTRIM(:PersonID1) + LTRIM(:ReciptDate)+ LTRIM(Perso' +
        'nID1) AS BarCodeSSRPR'
      'FROM Vu_ReciptsGrid'
      
        'WHERE        (ReciptID = :ReciptID ) AND (YearID = :YearID) AND ' +
        '(ServerID = :ServerID)')
