  object qryRIDEntity: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'ID'
        Attributes = [paSigned, paNullable]
        DataType = ftLargeint
        Precision = 19
        Size = 8
        Value = Null
      end
      item
        Name = 'StuffCode'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 8
        Value = Null
      end
      item
        Name = 'StoreID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        ReciptItemsDetails.DetailCaption, SUM(CASE WHEN R.' +
        'EffectType IN (2, 6, 8) THEN 1 ELSE - 1 END) AS Entity'
      'FROM            ReciptItemsDetails INNER JOIN'
      
        '                         ReciptItems_Stock R ON ReciptItemsDetai' +
        'ls.ReciptItemID = R.ReciptItemID AND ReciptItemsDetails.ReciptID' +
        ' = R.ReciptID AND ReciptItemsDetails.ServerID = R.ServerID AND'
      '                         ReciptItemsDetails.YearID = R.YearID'
      
        'WHERE        (R.EffectType IN (2, 4, 6, 7, 8)) AND (R.ID <> :ID ' +
        ') AND (R.StuffCode = :StuffCode  )'
      'AND (R.StoreID = :StoreID )'
      'GROUP BY ReciptItemsDetails.DetailCaption'
      
        'HAVING        (SUM(CASE WHEN R.EffectType IN (2, 6, 8) THEN 1 EL' +
        'SE - 1 END) >= 1)')
    Left = 504
    Top = 84
    object qryRIDEntityDetailCaption: TStringField
      FieldName = 'DetailCaption'
      Size = 40
    end
    object qryRIDEntityEntity: TIntegerField
      FieldName = 'Entity'
      ReadOnly = True
    end
  end
