  object qryLookUP: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'Kind'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      'SELECT LookUpID,Name '
      ',(SELECT TOP (1) L1.Name FROM LookUps AS L1'
      
        'WHERE (L1.LookUpID = LookUps.Kind) AND (L1.Kind = 0)) AS LookUpN' +
        'ame     '
      ''
      ''
      ''
      ' FROM LookUps '
      'WHERE(Kind = :Kind )')
    Left = 842
    Top = 154
  end
