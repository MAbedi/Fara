  object qryTozinStuffCode: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      'SELECT        StuffCoding.c_StuffCode'
      'FROM            Units INNER JOIN'
      
        '                         StuffCoding ON Units.UnitCode = StuffCo' +
        'ding.n_UnitCode'
      'WHERE        (Units.ChangeState = 1)')
    Left = 778
    Top = 138
  end
