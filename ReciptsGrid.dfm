  object qryEntityImages: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'EntityID'
        DataType = ftWideString
        NumericScale = 255
        Precision = 255
        Size = 100
        Value = Null
      end>
    SQL.Strings = (
      'WITH RankedData AS ('
      '    SELECT'
      '        ID,'
      '        EntityType,'
      '        EntityID,'
      '        ImageType,'
      '        ImageData,'
      '        FileName1,'
      '        FileSize,'
      '        CreatedAt,'
      '        ROW_NUMBER() OVER (ORDER BY CreatedAt) AS RowNum'
      '    FROM'
      '        EntityImages'
      '    WHERE'
      '        (EntityType = N'#39'ReciptsF'#39') '
      '        AND (EntityID = :EntityID)'
      ')'
      'SELECT'
      
        '    MAX(CASE WHEN RowNum =  1 THEN ImageData END) AS ImageData01' +
        ','
      
        '    MAX(CASE WHEN RowNum =  2 THEN ImageData END) AS ImageData02' +
        ','
      
        '    MAX(CASE WHEN RowNum =  3 THEN ImageData END) AS ImageData03' +
        ','
      
        '    MAX(CASE WHEN RowNum =  4 THEN ImageData END) AS ImageData04' +
        ','
      
        '    MAX(CASE WHEN RowNum =  5 THEN ImageData END) AS ImageData05' +
        ','
      
        '    MAX(CASE WHEN RowNum =  6 THEN ImageData END) AS ImageData06' +
        ','
      
        '    MAX(CASE WHEN RowNum =  7 THEN ImageData END) AS ImageData07' +
        ','
      
        '    MAX(CASE WHEN RowNum =  8 THEN ImageData END) AS ImageData08' +
        ','
      
        '    MAX(CASE WHEN RowNum =  9 THEN ImageData END) AS ImageData09' +
        ','
      
        '    MAX(CASE WHEN RowNum = 10 THEN ImageData END) AS ImageData10' +
        ','
      
        '    MAX(CASE WHEN RowNum = 11 THEN ImageData END) AS ImageData11' +
        ','
      
        '    MAX(CASE WHEN RowNum = 12 THEN ImageData END) AS ImageData12' +
        ','
      
        '    MAX(CASE WHEN RowNum = 13 THEN ImageData END) AS ImageData13' +
        ','
      
        '    MAX(CASE WHEN RowNum = 14 THEN ImageData END) AS ImageData14' +
        ','
      
        '    MAX(CASE WHEN RowNum = 15 THEN ImageData END) AS ImageData15' +
        ','
      
        '    MAX(CASE WHEN RowNum = 16 THEN ImageData END) AS ImageData16' +
        ','
      
        '    MAX(CASE WHEN RowNum = 17 THEN ImageData END) AS ImageData17' +
        ','
      
        '    MAX(CASE WHEN RowNum = 18 THEN ImageData END) AS ImageData18' +
        ','
      
        '    MAX(CASE WHEN RowNum = 19 THEN ImageData END) AS ImageData19' +
        ','
      '    MAX(CASE WHEN RowNum = 20 THEN ImageData END) AS ImageData20'
      'FROM'
      '    RankedData;')
    Left = 1048
    Top = 488
  end
