  object qryPerson: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'CustIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'CustIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonID1From'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonID1To'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        Fitful.FitfulID AS Checked, Customers.CustID, Cust' +
        'omers.CustName'
      'FROM            Customers INNER JOIN'
      
        '                         CustomersGroup ON Customers.CustomerGrp' +
        'ID = CustomersGroup.CustomerGrpID CROSS JOIN'
      '                         Fitful'
      
        'WHERE        (CustomersGroup.GroupType IN (11, 13, 14, 19)) AND ' +
        '(Customers.CustomerActive = 0) '
      'AND (Customers.CustID BETWEEN :CustIDFrom AND :CustIDTo) AND '
      
        '                         (Customers.PersonID1 BETWEEN :PersonID1' +
        'From AND :PersonID1To )')
    Left = 344
    Top = 208
    object qryPersonChecked: TFMTBCDField
      Tag = 3
      DisplayLabel = #1575#1606#1578#1582#1575#1576
      FieldName = 'Checked'
      Precision = 20
      Size = 4
    end
    object qryPersonCustID: TIntegerField
      Tag = 3
      DisplayLabel = #1603#1583' '#1662#1585#1587#1606#1604
      FieldName = 'CustID'
    end
    object qryPersonCustName: TStringField
      Tag = 3
      DisplayLabel = #1605#1588#1582#1589#1575#1578' '#1662#1585#1587#1606#1604
      FieldName = 'CustName'
      Size = 120
    end
  end
  object srcPerson: TDataSource
    DataSet = qryPerson
