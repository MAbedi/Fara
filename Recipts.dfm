  object qryCustomers2: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT   DISTINCT   Customers.CustID, Customers.CustName, Custom' +
        'ers.Discount'
      'FROM         Customers INNER JOIN'
      
        '                 CustomersGroup ON Customers.CustomerGrpID = Cus' +
        'tomersGroup.CustomerGrpID')
    Left = 397
    Top = 161
  end
  object qryCustomers1: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT    DISTINCT  Customers.CustID, Customers.CustName, Custom' +
        'ers.Address, Customers.Tel, Customers.PostalCode,'
      
        '                      Customers.EconomicNumber, Customers.Fax, C' +
        'ustomers.ValuationType'
      
        '            ,Customers.Discount  ,Customers.DiscountNote   ,Cust' +
        'omers.DayTime  ,Customers.NationalID, Customers.Mobile'
      
        ',Customers.InfoWeight,RegisterNumber, Customers.CustomerActive ,' +
        'HCKharidarTypeCode,HCTarafGaradadTypeCode   ,NationalCode'
      ''
      ''
      'FROM         Customers INNER JOIN'
      
        '                      CustomersGroup ON Customers.CustomerGrpID ' +
        '= CustomersGroup.CustomerGrpID')
    Left = 347
    Top = 57
  end
