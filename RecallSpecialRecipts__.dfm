  object qrySpecialRecall: TADOQuery
    Connection = DMF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qrySpecialRecallAfterOpen
    Parameters = <
      item
        Name = 'StuffCodeFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'StuffCodeTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'StoreIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'StoreIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'ControlcodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end
      item
        Name = 'ControlcodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end
      item
        Name = 'DiameterFrom'
        Attributes = [paSigned]
        DataType = ftFloat
        NumericScale = 255
        Precision = 15
        Size = 10
        Value = Null
      end
      item
        Name = 'DiameterTo'
        Attributes = [paSigned]
        DataType = ftFloat
        NumericScale = 255
        Precision = 15
        Size = 10
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     dbo.ReciptItems.ReciptItemID, dbo.ReciptItems.StuffCo' +
        'de, dbo.StuffCoding.c_StuffName, dbo.ReciptItems.ControlCode, db' +
        'o.ReciptItems.StuffSize,'
      
        '                      dbo.ReciptItems.StuffDiameter, dbo.ReciptI' +
        'tems.StuffAlloy, dbo.Recipts.PersonID1, dbo.Customers.CustName,'
      
        '                      Round(dbo.ReciptItems.InputEntity - dbo.Re' +
        'ciptItems.OutputEntity + ISNULL(dbo.RecallSpecial.Entity, 0),3) ' +
        ' AS Entity,'
      
        '                      Round(dbo.ReciptItems.InputWeight - dbo.Re' +
        'ciptItems.OutputWeight + ISNULL(dbo.RecallSpecial.Weight, 0) , 3' +
        ') AS Weight,'
      
        '                      dbo.ReciptItems.TotalInputPrice - dbo.Reci' +
        'ptItems.TotalOutputPrice + dbo.RecallSpecial.Price AS Price,'
      
        '                      dbo.ReciptItems.TotallSellPrice - dbo.Reca' +
        'llSpecial.TotallSellPrice AS TotallSellPrice, dbo.ReciptItems.St' +
        'uffGrade, dbo.Recipts.StoreID,'
      
        '                      dbo.Stores.c_StoreName, dbo.Units.UnitName' +
        ', dbo.Recipts.ReciptNumber, dbo.Recipts.ReciptDate, dbo.ReciptTy' +
        'pes.ReciptCaption'
      'FROM         dbo.Customers RIGHT OUTER JOIN'
      '                      dbo.ReciptItems INNER JOIN'
      
        '                      dbo.Recipts ON dbo.ReciptItems.ReciptID = ' +
        'dbo.Recipts.ReciptID INNER JOIN'
      
        '                      dbo.ReciptTypes ON dbo.Recipts.ReciptType ' +
        '= dbo.ReciptTypes.ReciptType INNER JOIN'
      
        '                      dbo.Stores ON dbo.Recipts.StoreID = dbo.St' +
        'ores.n_StoreID INNER JOIN'
      '                      dbo.Units INNER JOIN'
      
        '                      dbo.StuffCoding ON dbo.Units.UnitCode = db' +
        'o.StuffCoding.n_UnitCode ON dbo.ReciptItems.StuffCode = dbo.Stuf' +
        'fCoding.c_StuffCode ON'
      
        '                      dbo.Customers.CustID = dbo.Recipts.PersonI' +
        'D1 LEFT OUTER JOIN'
      
        '                      dbo.RecallSpecial ON dbo.ReciptItems.Recip' +
        'tItemID = dbo.RecallSpecial.preReciptItemID'
      ''
      'WHERE     (dbo.ReciptTypes.EffectType = 2) AND'
      
        '          (dbo.ReciptItems.InputEntity - dbo.ReciptItems.OutputE' +
        'ntity + ISNULL(dbo.RecallSpecial.Entity, 0)'
      '            not between   - 0.0001 and 0.0001  or'
      
        '          dbo.ReciptItems.InputWeight - dbo.ReciptItems.OutputWe' +
        'ight + ISNULL(dbo.RecallSpecial.Weight, 0)'
      '            not between   - 0.0001 and 0.0001 )'
      
        'AND (dbo.ReciptItems.StuffCode BETWEEN :StuffCodeFrom AND :Stuff' +
        'CodeTo)'
      
        ' AND (dbo.Recipts.StoreID BETWEEN :StoreIDFrom AND :StoreIDTo) A' +
        'ND'
      
        '       (dbo.ReciptItems.ControlCode BETWEEN :ControlcodeFrom AND' +
        ' :ControlcodeTo)'
      
        '       AND (dbo.ReciptItems.StuffDiameter BETWEEN :DiameterFrom ' +
        'AND :DiameterTo)'
      ''
      '')
    Left = 64
    Top = 160
