  object ADOQuery1: TADOQuery
    Connection = DMF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qrySpecialRecallAfterOpen
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     ReciptItems.ReciptItemID, Recipts.StoreID, Stores.c_S' +
        'toreName, ReciptItems.StuffCode, StuffCoding.c_StuffName,'
      
        '                      Units.UnitName, ReciptItems.StuffSize, Rec' +
        'iptItems.StuffDiameter, ReciptItems.StuffAlloy, ReciptItems.Stuf' +
        'fGrade,'
      
        '                      AvailableEntity.Entity, AvailableEntity.We' +
        'ight, AvailableEntity.Price, Recipts.PersonID1, Customers.CustNa' +
        'me,'
      
        '                      Recipts.ReciptNumber, Recipts.ReciptDate, ' +
        'ReciptTypes.ReciptCaption,ReciptItems.ControlCode'
      'FROM         ReciptItems INNER JOIN'
      
        '                      Recipts ON ReciptItems.ReciptID = Recipts.' +
        'ReciptID INNER JOIN'
      
        '                      StuffCoding ON ReciptItems.StuffCode = Stu' +
