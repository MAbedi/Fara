  object qryShowpreItems: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'preReciptItemID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     TOP 100 PERCENT dbo.Recipts.ReciptDate, dbo.ReciptTyp' +
        'es.ReciptCaption, dbo.Recipts.ReciptNumber, dbo.Customers.CustNa' +
        'me, '
      
        '                      dbo.ReciptItems.ControlCode, dbo.StuffCodi' +
        'ng.c_StuffName, dbo.ReciptItems.OutputEntity AS Entity, dbo.Reci' +
        'ptItems.OutputWeight AS Weight'
      
        ', ReciptItems.ReciptItemID, ReciptItems.ReciptID, ReciptItems.St' +
        'uffCode, ReciptItems.ServerID, ReciptItems.YearID'
      'FROM         dbo.ReciptItems INNER JOIN'
      
        '                                            Recipts ON dbo.Recip' +
        'ts.ReciptID = dbo.ReciptItems.ReciptID AND '
      
        '                      dbo.Recipts.ServerID = dbo.ReciptItems.Ser' +
        'verID AND dbo.Recipts.YearID = dbo.ReciptItems.YearID'
      ''
      ' LEFT OUTER JOIN'
      
        '                      dbo.Customers ON dbo.Recipts.PersonID1 = d' +
        'bo.Customers.CustID LEFT OUTER JOIN'
      
        '                      dbo.StuffCoding ON dbo.ReciptItems.StuffCo' +
        'de = dbo.StuffCoding.c_StuffCode LEFT OUTER JOIN'
      
        '                      dbo.ReciptTypes ON dbo.Recipts.ReciptType ' +
        '= dbo.ReciptTypes.ReciptType'
      
        'WHERE     (dbo.ReciptItems.preReciptItemID = :preReciptItemID)an' +
        'd (dbo.ReciptTypes.EffectType = 4)'
      'ORDER BY dbo.Recipts.ReciptNumber')
    Left = 240
    Top = 56
    object qryShowpreItemsReciptDate: TStringField
      DisplayLabel = #1578#1575#1585#1610#1582
      FieldName = 'ReciptDate'
      FixedChar = True
      Size = 10
    end
