      item
        Name = 'MasterPersonID1'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT    CAST(REPLACE(CLOCKDATE, '#39'/'#39', '#39#39') AS int) AS CLOCKDATEi' +
        'nt, Tsh.ClockDmp.*'
      'FROM            Tsh.ClockDmp '
      
        'WHERE       (Tsh.ClockDmp.PERNO  BETWEEN :PERNOFrom AND :PERNOTo' +
        '    )'
      'AND  (CAST(LEFT(Tsh.ClockDmp.CLOCKDATE, 2) AS int) = :Year ) '
      
        'AND (CAST(RIGHT(LEFT(Tsh.ClockDmp.CLOCKDATE, 5), 2) AS int) = :M' +
        'onth ) '
      
        'AND (CAST(RIGHT(Tsh.ClockDmp.CLOCKDATE, 2) AS int) BETWEEN :DayF' +
        'rom AND :DayTo ) '
      ''
      
        'AND  Tsh.ClockDmp.PERNO in (SELECT Customers.CustID FROM Custome' +
        'rs WHERE    Customers.PersonID1 =  :MasterPersonID1   )'
      ''
      'ORDER BY PERNO, CLOCKDATE')
