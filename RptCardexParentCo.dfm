  object qryOutPut: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'InputEntity1'
        Size = -1
        Value = Null
      end
      item
        Name = 'InputEntity2'
        Size = -1
        Value = Null
      end
      item
        Name = 'ParentCoReciptID'
        Size = -1
        Value = Null
      end
      item
        Name = 'Datefrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'DateTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCodeFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCodeTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'storeFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'storeTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'TransFormID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        ReciptItems.StuffCode, StuffCoding.c_StuffName, Un' +
        'its.UnitName, ReciptItems.OutputEntity, ReciptItems.UnitSellPric' +
        'e, ReciptItems.TotalOutputPrice, '
      
        '                         Recipts.ReciptNumber, Recipts.ReciptDat' +
        'e, ReciptTypes.ReciptCaption, Recipts.ReciptID, Recipts.ServerID' +
        ', Recipts.YearID, ReciptItems.TransFormID, '
      
        '                         ROUND(ReciptItems.OutputEntity / :Input' +
        'Entity1 , 3) AS ShareEntity, '
      
        'ROUND(ReciptItems.OutputEntity / :InputEntity2 * ReciptItems.Uni' +
        'tSellPrice, 3) AS SharePrice'
      ''
      'FROM            ReciptTypes INNER JOIN'
      
        '                         Recipts ON ReciptTypes.ReciptType = Rec' +
        'ipts.ReciptType INNER JOIN'
      
        '                         ReciptItems ON Recipts.ReciptID = Recip' +
        'tItems.ReciptID AND Recipts.ServerID = ReciptItems.ServerID AND ' +
        'Recipts.YearID = ReciptItems.YearID INNER JOIN'
      
        '                         StuffCoding ON ReciptItems.StuffCode = ' +
        'StuffCoding.c_StuffCode INNER JOIN'
      
        '                         Units ON StuffCoding.n_UnitCode = Units' +
        '.UnitCode'
      'WHERE   (Recipts.ParentCoReciptID = :ParentCoReciptID ) and'
      '        (Recipts.ReciptDate between :Datefrom and :DateTo) and'
      
        '        (ReciptItems.StuffCode between :StuffCodeFrom and :Stuff' +
        'CodeTo) and'
      '        (Recipts.StoreID between :storeFrom and :storeTo) '
      'and (ReciptItems.TransFormID = :TransFormID ) ')
    Left = 423
    Top = 325
