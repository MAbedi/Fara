        DataType = ftString
        Size = 5
        Value = '99999'
      end
      item
        Name = 'CompanyCodeFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyCodeTo'
        DataType = ftString
        Size = 6
        Value = '999999'
      end
      item
        Name = 'AccCodeFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'AccCodeTo'
        DataType = ftString
        Size = 9
        Value = '999999999'
      end
      item
        Name = 'DetailCodeFrom'
        DataType = ftString
        Size = 3
        Value = '0'
      end
      item
        Name = 'DetailCodeTo'
        DataType = ftString
        Size = 18
        Value = '9999999'
      end
      item
        Name = 'SecondaryDocNoFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SecondaryDocNoTo'
        DataType = ftString
        Size = 7
        Value = '9999999'
      end
      item
        Name = 'PrimaryDocNoFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PrimaryDocNoTo'
        DataType = ftString
        Size = 10
        Value = '99999999'
      end
      item
        Name = 'DocDateFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocDateTo'
        DataType = ftString
        Size = 10
        Value = '99/12/29'
      end
      item
        Name = 'Status1'
        DataType = ftString
        Size = 2
        Value = '-1'
      end
      item
        Name = 'Status2'
        DataType = ftString
        Size = 2
        Value = '-1'
      end
      item
        Name = 'FromYearId'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ToYearID'
        DataType = ftString
        Size = 5
        Value = '99999'
      end>
    SQL.Strings = (
      
        'SELECT   AccTrialDetailsBalance.*, MoeenName_L1 +'#39' - '#39'+ DetailNa' +
        'me_L1 AS CombineName,'
      
        '                      Credit as bes,debt as bed,balanceDebt as M' +
        'andehBed,balanceCredit as Mandehbes,AccTrialDetailsBalance.Topic' +
        'Code as row'
      ', Fitful.FitfulID AS _checked , Fitful.FitfulIDc'
      ''
      ''
      'FROM      Acc.AccTrialDetailsBalance('
      
        '               :DocTypeCode1_Not,:DocTypeCode2_Not,:DocTypeCode3' +
        '_Not, :DocTypeCodeFrom , :DocTypeCodeTo ,'
      '               :CompanyCodeFrom ,:CompanyCodeTo,'
      '               :AccCodeFrom ,:AccCodeTo,'
      '               :DetailCodeFrom ,:DetailCodeTo,'
      '               :SecondaryDocNoFrom  , :SecondaryDocNoTo ,'
      '               :PrimaryDocNoFrom , :PrimaryDocNoTo ,'
      '               :DocDateFrom , :DocDateTo,'
      
        '               :Status1,:Status2,:FromYearId,:ToYearID, DEFAULT,' +
        ' DEFAULT, DEFAULT , DEFAULT, DEFAULT, DEFAULT) AccTrialDetailsBa' +
        'lance'
      ' CROSS JOIN'
      '                         Fitful'
      ''
      'WHERE balanceDebt + balanceCredit >0')
    Left = 288
    Top = 253
