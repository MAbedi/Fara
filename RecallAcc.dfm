  object qry_TrialDetailsBalance: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Filter = '(Mandehbed <> 0) or (Mandehbes <> 0) '
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'DocTypeCode1_Not'
        DataType = ftString
        Size = 2
        Value = '-1'
      end
      item
        Name = 'DocTypeCode2_Not'
        DataType = ftString
        Size = 2
