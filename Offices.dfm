  object qryOffices: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryOfficesAfterOpen
    Parameters = <
      item
        Name = 'BaseParam'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 30
        Value = '1'
      end
      item
        Name = 'CirculationCode'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 30
        Value = '1'
      end
      item
        Name = 'Where'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 2000
        Value = 
          'WHERE (ISNULL(ReciptItems.ProductModel, 0) Between 0 And 40502)A' +
          'nd (ISNULL(ReciptItems.StuffCode, 0) Between 1100 And 26000933)A' +
          'nd (ISNULL(Recipts.UseUnitID, 0) Between 0 And 7)And (ISNULL(L_S' +
          'T.Code, 0) Between 0 And 2)And (ISNULL(Recipts.PersonID1, 0) Bet' +
          'ween 0 And 500008)And (ISNULL(Recipts.PersonID2, 0) Between 0 An' +
          'd 500008)And (ISNULL(Recipts.PersonID3, 0)  Between 0 And 500008' +
          ')And (Recipts.ReciptDate Between '#39'91/04/01'#39' And '#39'91/08/14'#39')And (' +
          'Recipts.ReciptNumber Between 0 And 11117)And (Recipts.StoreID Be' +
          'tween 10 And 90)And (Recipts.YearID Between 91 And 91)And (Recip' +
          'tTypes.ReciptType In ( 1,5,9,17,34,35,56 ))'
      end>
    SQL.Strings = (
      'dbo.FlowAccount  :BaseParam  , :CirculationCode , :Where '
      ''
      '')
    Left = 74
    Top = 88
  end
