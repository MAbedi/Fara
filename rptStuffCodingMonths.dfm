        ' M9Entity ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 9 then Re' +
        'ciptItems.InputWeight + ReciptItems.OutputWeight else 0 end ) as' +
        ' M9Weight ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 9 then Re' +
        'ciptItems.TotalInputPrice + ReciptItems.TotalOutputPrice else 0 ' +
        'end ) as M9Price ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 9 then To' +
        'tallSellPrice else 0 end ) as M9TotallSellPrice ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 10 then R' +
        'eciptItems.InputEntity + ReciptItems.OutputEntity else 0 end ) a' +
        's M10Entity ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 10 then R' +
        'eciptItems.InputWeight + ReciptItems.OutputWeight else 0 end ) a' +
        's M10Weight ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 10 then R' +
        'eciptItems.TotalInputPrice + ReciptItems.TotalOutputPrice else 0' +
        ' end ) as M10Price ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 10 then T' +
        'otallSellPrice else 0 end ) as M10TotallSellPrice ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 11 then R' +
        'eciptItems.InputEntity + ReciptItems.OutputEntity else 0 end ) a' +
        's M11Entity ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 11 then R' +
        'eciptItems.InputWeight + ReciptItems.OutputWeight else 0 end ) a' +
        's M11Weight ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 11 then R' +
        'eciptItems.TotalInputPrice + ReciptItems.TotalOutputPrice else 0' +
        ' end ) as M11Price ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 11 then T' +
        'otallSellPrice else 0 end ) as M11TotallSellPrice ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 12 then R' +
        'eciptItems.InputEntity + ReciptItems.OutputEntity else 0 end ) a' +
        's M12Entity ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 12 then R' +
        'eciptItems.InputWeight + ReciptItems.OutputWeight else 0 end ) a' +
        's M12Weight ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 12 then R' +
        'eciptItems.TotalInputPrice + ReciptItems.TotalOutputPrice else 0' +
        ' end ) as M12Price,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 12 then T' +
        'otallSellPrice else 0 end ) as M12TotallSellPrice ,'
      
        #9#9'     Sum( ReciptItems.InputEntity + ReciptItems.OutputEntity )' +
        ' as Entity ,'
      
        #9#9'     Sum( ReciptItems.InputWeight + ReciptItems.OutputWeight )' +
        ' as Weight ,'
      
        #9#9'     Sum( ReciptItems.TotalInputPrice + ReciptItems.TotalOutpu' +
        'tPrice ) as Price,'
      #9#9'     Sum( TotallSellPrice ) as TotallSellPrice ,'
      '                                     StuffCoding.c_StuffTecInfo'
      'FROM         StuffCoding INNER JOIN'
      
        '                      Units ON StuffCoding.n_UnitCode = Units.Un' +
        'itCode INNER JOIN                       ReciptItems INNER JOIN'
      
        '                                            Recipts AS R ON R.Re' +
        'ciptID = ReciptItems.ReciptID AND'
      
        '                      R.ServerID = ReciptItems.ServerID AND R.Ye' +
        'arID = ReciptItems.YearID INNER JOIN'
      
        '                      ReciptTypes ON R.ReciptType = ReciptTypes.' +
        'ReciptType ON StuffCoding.c_StuffCode = ReciptItems.StuffCode IN' +
        'NER JOIN'
      
        '                      StuffGroups ON StuffCoding.GroupID = Stuff' +
        'Groups.GroupID'
      ' INNER JOIN       LookUps ON R.SecondType = LookUps.LookUpID'
      ' LEFT JOIN dbo.Customers C1 ON C1.CustID = r.PersonID1 '
      
        'WHERE     (LookUps.Code BETWEEN :SecondTypeCodeFrom AND :SecondT' +
        'ypeCodeTo ) '
      
        'AND  (R.StoreID BETWEEN :StoreIDFrom  AND :StoreIDTo) AND (R.Rec' +
        'iptNumber BETWEEN :ReciptNumberFrom  AND :ReciptNumberTo)'
      'AND (R.ReciptDate BETWEEN  :ReciptDateFrom AND :ReciptDateTo)'
      'AND (R.PersonID1 BETWEEN :custIdfrom AND :custIdto)'
      'AND (R.PersonID2 BETWEEN :custId2from AND :custId2to)'
      'AND (R.ReciptState < 3)'
      
        'AND (R.ReciptType IN (  :Recipt__Type )) AND (ReciptItems.StuffC' +
        'ode BETWEEN :StuffCodeFrom AND :StuffCodeTo)'
      'AND (R.YearID BETWEEN   :YearIDFrom AND :YearIDTo)'
      
        'AND (R.SellsEmporium BETWEEN :SellsEmporiumFrom AND :SellsEmpori' +
        'umTo)'
      'AND (R.SellsMethod BETWEEN :SellsMethodFrom AND :SellsMethodTo)'
      
        'AND ((:NotStoreID1 ='#39'-1'#39') OR R.StoreID not in (Select part From ' +
        'SplitString( :NotStoreID2 ,'#39','#39')))'
      'AND (c1.CityCode  BETWEEN :CityCodeFrom AND :CityCodeTo )'
      ''
      
        'GROUP BY R.ReciptType, ReciptItems.StuffCode, StuffCoding.c_Stuf' +
        'fName, Units.UnitName, ReciptTypes.ReciptCaption,'
      
        '                      StuffGroups.GroupID, StuffGroups.GroupName' +
        ',StuffCoding.c_StuffTecInfo'
      '')
