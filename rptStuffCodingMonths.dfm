        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 5 then To' +
        'tallSellPrice else 0 end ) as M5TotallSellPrice ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 6 then Re' +
