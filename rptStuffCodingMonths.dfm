        ' M8Weight ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 8 then Re' +
        'ciptItems.TotalInputPrice + ReciptItems.TotalOutputPrice else 0 ' +
        'end ) as M8Price ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 8 then To' +
        'tallSellPrice else 0 end ) as M8TotallSellPrice ,'
      
        #9#9'     Sum( CASE ABS(SUBSTRING(R.ReciptDATE,6,2)) when 9 then Re' +
