  object qryRunSchedules: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qryRunSchedulesAfterScroll
    Parameters = <>
    SQL.Strings = (
      
        'SELECT  Cnt.RunSchedules.*, Cnt.Contracts.Note, StuffCoding.c_St' +
        'uffName AS _StuffName, Units.UnitName AS _UnitName'
      'FROM         Cnt.RunSchedules INNER JOIN'
      
        '                      Cnt.Contracts ON Cnt.RunSchedules.CaseNo =' +
        ' Cnt.Contracts.CaseNo INNER JOIN'
      
        '                      StuffCoding ON Cnt.RunSchedules.OperationI' +
        'd = StuffCoding.c_StuffCode INNER JOIN'
      
        '                      Units ON StuffCoding.n_UnitCode = Units.Un' +
        'itCode AND StuffCoding.n_UnitCode = Units.UnitCode')
    Left = 613
    Top = 11
    object qryRunSchedulesRunScheduleId: TIntegerField
      FieldName = 'RunScheduleId'
    end
