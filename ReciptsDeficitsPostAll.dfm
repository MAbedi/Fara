  object qryTypesItems: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryTypesItemsAfterOpen
    Parameters = <
      item
        Name = 'Co'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptType'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end
      item
        Name = 'ReciptNumberFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'ReciptNumberTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'ReciptDateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'ReciptDateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'PersonID2From'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonID2To'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonID1From'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonID1To'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     ReciptID, ServerID, YearID, ReciptNumber, ReciptDate,' +
        ' PersonID1, CustName, ReciptState, ReciptValue, ROUND(ReciptValu' +
        'e * :Co / 100, 0) '
      '                      AS CalcDeficitAdd_Dec, DeficitAdd_Dec'
      'FROM         ('
      ''
      
        'SELECT     Recipts.ReciptID, Recipts.ServerID, Recipts.YearID, R' +
        'ecipts.ReciptNumber, Recipts.ReciptDate, Recipts.PersonID1, Cust' +
        'omers.CustName, '
      
        '                      Recipts.ReciptState, dbo.GetReciptValue(Re' +
        'cipts.ReciptID, Recipts.ServerID, Recipts.YearID) AS ReciptValue' +
        ', '
      
        '                                                        dbo.GetR' +
        'eciptsIdDeficits(Recipts.ReciptID, Recipts.ServerID, Recipts.Yea' +
        'rID) AS DeficitAdd_Dec'
      ''
      'FROM         Recipts INNER JOIN'
      
        '                      Customers ON Recipts.PersonID1 = Customers' +
        '.CustID'
      
        'WHERE     (Recipts.ReciptType = :ReciptType ) AND (Recipts.Recip' +
        'tNumber BETWEEN :ReciptNumberFrom AND :ReciptNumberTo ) '
      
        ' AND (Recipts.ReciptDate BETWEEN :ReciptDateFrom AND :ReciptDate' +
        'To )'
      
        '       AND   (isnull(Recipts.PersonID2,0)   BETWEEN :PersonID2Fr' +
        'om AND :PersonID2To )'
      
        ' AND (Recipts.PersonID1  BETWEEN :PersonID1From AND :PersonID1To' +
        ' )'
      ''
      'AND (Recipts.DocNo = 0) AND (Recipts.ReciptState < 3)'
      ''
      ') AS derivedtbl_1')
    Left = 202
    Top = 288
  end
