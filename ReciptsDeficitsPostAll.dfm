  object qryPersonID2: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterScroll = qryPersonID2AfterScroll
    Parameters = <
      item
        Name = 'ReciptType'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT DISTINCT ISNULL(Recipts.PersonID2, 0) AS PersonID2, Custo' +
        'mers.CustName'
      'FROM         Recipts INNER JOIN'
      
        '                      Customers ON ISNULL(Recipts.PersonID2, 0) ' +
        '= Customers.CustID'
      'WHERE   (Recipts.ReciptType = :ReciptType )')
    Left = 652
    Top = 222
