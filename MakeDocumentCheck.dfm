  object qryItems: TADOQuery
    AutoCalcFields = False
    Connection = DmF.adcBSell
    CursorType = ctOpenForwardOnly
    LockType = ltBatchOptimistic
    AfterOpen = qryItemsAfterOpen
    Parameters = <
      item
        Name = 'FormDateFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'FormDateTo'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'FormNumberFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'FormNumberTo'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CheckStateFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CheckStateTo'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SellsEmporiumFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'SellsEmporiumTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'PayTypesFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'PayTypesTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'AidDateFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'AidDateTo'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     0 AS FormItemID, 0 AS FormID,  0 AS ServerID,  0 AS Y' +
        'earID, 526800267651563.0000 AS CheckNumber, '#39#39' AS CheckDate, Top' +
        'icCode, DetailCode, CtopicCode, CtopicCode2,CtopicCode3,'
      
        '                      '#39' ????  '#39' + FormCaption + '#39' ?????? '#39' + For' +
        'mDate AS Comment,'
      
        '                      '#39' ????  '#39' + FormCaption + '#39' ?????? '#39' + For' +
        'mDate AS Comment2,'
      
        '                       SUM(debt) AS Debt, SUM(credit) AS Credit,' +
        ' BudgetCode'
      ''
      
        'FROM         dbo.MakeDocuments_Check(0,:FormDateFrom, :FormDateT' +
        'o,:FormNumberFrom, :FormNumberTo,  :CheckStateFrom, :CheckStateT' +
        'o'
      
        ', :SellsEmporiumFrom , :SellsEmporiumTo , :PayTypesFrom , :PayTy' +
        'pesTo ,1  , :AidDateFrom , :AidDateTo ) AS MakeDocuments_Check'
      'WHERE     (FormType IN (103, 104))'
      
        'GROUP BY FormNumber, FormDate, FormCaption, TopicCode, DetailCod' +
        'e, CtopicCode, CtopicCode2,CtopicCode3, bedbes, BudgetCode'
      '')
    Left = 300
    Top = 181
