  object qryFormList: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'FormType'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 1
      end
      item
        Name = 'NumberFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'NumberTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 9999999
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '0'
      end
      item
        Name = 'DateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'StateFrom'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end
      item
        Name = 'StateTo'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 999
      end
      item
        Name = 'SellsMethodFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SellsMethodTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 999999
      end
      item
        Name = 'SellsEmporiumFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SellsEmporiumTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 999999
      end
      item
        Name = 'YearIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'YearIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     Forms.FormID, Forms.FormNumber, Forms.FormDate, Forms' +
        '.FormType, Forms.CustomerID1, Customers_1.CustName AS CustName1,'
      
        '                      Forms.CustomerID2, CASE Forms.CustomerID2 ' +
        'WHEN 0 THEN Forms.CustomerName2 ELSE Customers_2.CustName END AS' +
        ' CustName2, '
      
        '                      dbo.FormItemsAmount(Forms.FormID,Forms.Ser' +
        'verID, Forms.YearID ) AS Amount, dbo.FormItemsCashWage(Forms.For' +
        'mID,Forms.ServerID, Forms.YearID ) AS CashWage, Forms.FomNote, F' +
        'orms.FormState, '
      
        '                      iner.FormCaption, Forms.BudgetCode, Forms.' +
        'ProjectID, Forms.DocNo, Forms.DocDate, Forms.FirstUser, Forms.La' +
        'stUser, Forms.AidInfoNo, '
      
        '                      Forms.AidInfoDate, LookUpsPayTypes.Name AS' +
        ' PayTypesName, LookUpsTopicTypes.Name AS TopicTypesName'
      
        '                      , Forms.SellsMethod,SellsMethods.SellsMeth' +
        'odName, Forms.SellsEmporium, SellsEmporiums.SellsEmporiumName'
      ', Forms.ServerID, Forms.YearID, iner.DisplayFormType'
      ', '
      
        '                      Forms.TopicCode, Forms.DetailCode, Forms.C' +
        'TopicCode, Forms.CTopicCode2'
      ''
      ''
      'FROM         Customers AS Customers_1 RIGHT OUTER JOIN'
      '                      FormTypes AS iner INNER JOIN'
      
        '                      Forms ON iner.FormType = Forms.FormType LE' +
        'FT OUTER JOIN'
      
        '                      SellsEmporiums ON Forms.SellsEmporium = Se' +
        'llsEmporiums.SellsEmporium LEFT OUTER JOIN'
      
        '                      Customers AS Customers_2 ON Forms.Customer' +
        'ID2 = Customers_2.CustID ON Customers_1.CustID = Forms.CustomerI' +
        'D1 LEFT OUTER JOIN'
      
        '                      SellsMethods ON Forms.SellsMethod = SellsM' +
        'ethods.SellsMethod LEFT OUTER JOIN'
      
        '                      LookUps AS LookUpsTopicTypes ON Forms.Topi' +
        'cTypes = LookUpsTopicTypes.LookUpID LEFT OUTER JOIN'
      
        '                      LookUps AS LookUpsPayTypes ON Forms.PayTyp' +
        'es = LookUpsPayTypes.LookUpID'
      ''
      ''
      
        'WHERE     (Forms.FormType = :FormType) AND (Forms.FormNumber BET' +
        'WEEN :NumberFrom AND :NumberTo)'
      ' AND (Forms.FormDate BETWEEN :DateFrom AND :DateTo)'
      ' AND (Forms.FormState BETWEEN :StateFrom AND :StateTo)'
      
        ' AND (Forms.SellsMethod  BETWEEN :SellsMethodFrom AND :SellsMeth' +
        'odTo)'
      
        ' AND (Forms.SellsEmporium  BETWEEN :SellsEmporiumFrom AND :Sells' +
        'EmporiumTo)'
      ' AND (Forms.YearID BETWEEN :YearIDFrom AND :YearIDTo )'
      ''
      ' '
      ' '
      ' ')
    Left = 104
    Top = 109
