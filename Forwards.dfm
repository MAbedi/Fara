  object qryMaster: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qryMasterAfterOpen
    AfterScroll = qryMasterAfterScroll
    Parameters = <
      item
        Name = 'UserID'
        Attributes = [paNullable]
        DataType = ftWideString
        NumericScale = 255
        Precision = 255
        Size = 102
        Value = Null
      end>
    SQL.Strings = (
      'SELECT      Customers.CustID, Customers.CustName'
      'FROM         Customers INNER JOIN'
      
        '                      CustomersGroup ON Customers.CustomerGrpID ' +
        '= CustomersGroup.CustomerGrpID'
      'WHERE     (CustomersGroup.GroupType = 5) '
      
        'AND  ('#39','#39'+Customers.OperatorID+'#39','#39' LIKE N'#39'%,'#39'+ltrim(str( :UserID' +
        ' ))+'#39',%'#39')'
      ''
      ''
      '')
    Left = 304
    Top = 17
