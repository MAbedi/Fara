  object qryStuffCoding: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qryStuffCodingAfterScroll
    Parameters = <
      item
        Name = 'DateFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'DateTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'PersonIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'PersonIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'StoreIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'StoreIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCodeFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCodeTo'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT ReciptItems.StuffCode as c_StuffCode , Vu_StuffCoding.c_S' +
        'tuffName'
      'FROM         ReciptItems INNER JOIN'
      
        '                      Vu_StuffCoding ON ReciptItems.StuffCode = ' +
        'Vu_StuffCoding.c_StuffCode INNER JOIN'
      
        '                      Recipts ON ReciptItems.ReciptID = Recipts.' +
        'ReciptID'
      
        'WHERE     (Recipts.ReciptDate BETWEEN :DateFrom AND :DateTo ) an' +
        'd (Recipts.PersonID1 BETWEEN :PersonIDFrom AND :PersonIDTo)'
      'and (Recipts.StoreID BETWEEN :StoreIDFrom  AND :StoreIDTo)'
      'GROUP BY ReciptItems.StuffCode, Vu_StuffCoding.c_StuffName'
      
        'HAVING ReciptItems.StuffCode BETWEEN :StuffCodeFrom AND :StuffCo' +
        'deTo'
      'ORDER BY ReciptItems.StuffCode')
    Left = 216
    Top = 165
    object qryStuffCodingc_StuffCode: TLargeintField
      FieldName = 'c_StuffCode'
    end
    object qryStuffCodingc_StuffName: TStringField
      FieldName = 'c_StuffName'
      Size = 70
    end
  end
  object SrcStuffCoding: TDataSource
    DataSet = qryStuffCoding
    Left = 112
    Top = 157
  end
  object qryCustStuff: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryCustStuffAfterOpen
    Parameters = <
      item
        Name = 'PersonIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonID2From'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonID2To'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'DateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'StuffCodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 8
        Value = Null
      end
      item
        Name = 'StuffCodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 8
        Value = Null
      end
      item
        Name = 'StoreIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'StoreIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'SellsEmporiumFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'SellsEmporiumTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'SellsMethodFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'SellsMethodTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     AccTran.*, Customers.CustName AS custname , Customers' +
        '.Address AS Address'
      'FROM         ('
      
        'SELECT     R.PersonID1, R.ReciptID, R.ReciptNumber, R.ReciptDate' +
        ', ReciptTypes.ReciptType,'
      
        '                      ReciptTypes.ReciptCaption, Ri.StuffCode, S' +
        'tuffCoding.c_StuffName, Units.UnitName, Ri.StuffSize, '
      
        '                      Ri.StuffDiameter, Ri.StuffAlloy, Ri.Contro' +
        'lCode, '
      
        '                      Ri.InputEntity + Ri.OutputEntity AS entity' +
        ', Ri.InputWeight + Ri.OutputWeight AS weight,'
      #9#9#9#9#9'  Ri.UnitSellPrice ,'
      
        '                      Ri.TotalInputPrice + Ri.TotalOutputPrice A' +
        'S bed,'
      
        '                       Ri.TotalOutputPrice - Ri.TotalOutputPrice' +
        ' AS bes, 3 AS kind,'
      
        '                      R.StoreID, Ri.ItemNote, R.ServerID, R.Year' +
        'ID'
      
        '                      ,R.SellsEmporium ,R.SellsMethod , R.Person' +
        'ID2'
      'FROM         ReciptItems Ri INNER JOIN'
      
        '                      Recipts R ON R.ReciptID = Ri.ReciptID AND ' +
        'R.ServerID = Ri.ServerID AND R.YearID = Ri.YearID INNER JOIN'
      
        '                      ReciptTypes ON R.ReciptType = ReciptTypes.' +
        'ReciptType INNER JOIN'
      '                      Units INNER JOIN'
      
        '                      StuffCoding ON Units.UnitCode = StuffCodin' +
        'g.n_UnitCode ON Ri.StuffCode = StuffCoding.c_StuffCode'
      'WHERE     (ReciptTypes.BedType = 1)'
      '  and (R.ReciptState < 3)'
      '         UNION ALL'
      
        'SELECT     R.PersonID1, R.ReciptID, R.ReciptNumber, R.ReciptDate' +
        ', ReciptTypes.ReciptType, ReciptTypes.ReciptCaption, '
      
        '                      Ri.StuffCode, StuffCoding.c_StuffName, Uni' +
        'ts.UnitName, Ri.StuffSize, Ri.StuffDiameter, Ri.StuffAlloy, '
      
        '                      Ri.ControlCode, Ri.InputEntity + Ri.Output' +
        'Entity AS entity, Ri.InputWeight + Ri.OutputWeight AS weight, '
      #9#9#9#9#9'  Ri.UnitSellPrice ,'
      
        '                      0 AS bed, Ri.TotalInputPrice + Ri.TotalOut' +
        'putPrice AS bes, 3 AS kind, R.StoreID, Ri.ItemNote, R.ServerID, '
      
        '                      R.YearID ,R.SellsEmporium ,R.SellsMethod, ' +
        'R.PersonID2'
      'FROM         ReciptItems Ri INNER JOIN'
      
        '                      Recipts R ON R.ReciptID = Ri.ReciptID AND ' +
        'R.ServerID = Ri.ServerID AND '
      '                      R.YearID = Ri.YearID INNER JOIN'
      
        '                      ReciptTypes ON R.ReciptType = ReciptTypes.' +
        'ReciptType INNER JOIN'
      '                      Units INNER JOIN'
      
        '                      StuffCoding ON Units.UnitCode = StuffCodin' +
        'g.n_UnitCode ON Ri.StuffCode = StuffCoding.c_StuffCode'
      'WHERE     (ReciptTypes.BesType = 1)'
      '  and (R.ReciptState < 3)'
      ') AccTran INNER JOIN'
      
        '                      Customers ON AccTran.PersonID1 = Customers' +
        '.CustID'
      'WHERE (AccTran.PersonID1 BETWEEN :PersonIDFrom AND :PersonIDTo)'
      'AND (AccTran.PersonID2 BETWEEN :PersonID2From AND :PersonID2To)'
      'AND (ReciptDate BETWEEN :DateFrom AND :DateTo)'
      'AND (StuffCode BETWEEN :StuffCodeFrom AND :StuffCodeTo)'
      'AND (StoreID BETWEEN :StoreIDFrom  AND :StoreIDTo)'
      
        'AND (AccTran.SellsEmporium BETWEEN :SellsEmporiumFrom AND :Sells' +
        'EmporiumTo)'
      
        'AND (AccTran.SellsMethod BETWEEN :SellsMethodFrom AND :SellsMeth' +
        'odTo)'
      ' '
      ' '
      ' ')
    Left = 91
    Top = 275
