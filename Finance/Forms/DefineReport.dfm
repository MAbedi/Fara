      FieldName = 'ID'
      ReadOnly = True
    end
    object qryAccCode_1MoeenName_L1: TStringField
      DisplayLabel = #1593#1606#1608#1575#1606
      FieldName = 'MoeenName_L1'
      Size = 100
    end
