    object qryAccCode_1Topic_CTopicCode: TStringField
      DisplayLabel = #1603#1583' '#1605#1593#1740#1606' - '#1578#1601#1589#1740#1604#1740'2'
      FieldName = 'Topic_CTopicCode'
