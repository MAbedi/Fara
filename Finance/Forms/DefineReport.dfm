      FieldName = 'G_TopicCode'
    end
    object qryAccCode_1Topic_DetailCode: TStringField
      DisplayLabel = #1603#1583' '#1605#1593#1740#1606' - '#1578#1601#1589#1610#1604#1610
      FieldName = 'Topic_DetailCode'
      ReadOnly = True
      Size = 23
