  object qryAccCode_2: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'RepCode'
        Attributes = [paNullable]
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'RowId'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      'SELECT [_ReportRowsOnDocs].G_TopicCode, '
      
        'Ltrim(str([G_TopicCode])) + '#39' - '#39' + Ltrim(str([G_DetailCode]))  ' +
        'AS Topic_DetailCode, '
      
        'Ltrim(str([G_TopicCode])) + '#39' - '#39' + Ltrim(str([G_CTopicCode] )) ' +
        'AS Topic_CTopicCode, '
      
        'Ltrim(str([G_TopicCode])) + '#39' - '#39' + Ltrim(str([G_DetailCode])) +' +
        ' '#39' - '#39' + Ltrim(str([G_CTopicCode] )) AS AccCode, '
      
        'Categories.MoeenName_L1, [MoeenName_l1] + '#39' - '#39' + [Details].[Det' +
        'ailName_L1] AS MoeenDetail, [MoeenName_L1] + '#39' - '#39' + [CenterTopi' +
        'cs].[CTopicName_L1] AS MoeenCtopic, [MoeenName_L1] + '#39' - '#39' + [De' +
        'tails].[DetailName_L1] + '#39' - '#39' + [CenterTopics].[CTopicName_L1] ' +
        'AS AccName, [_ReportRowsOnDocs].ID'
      
        'FROM ((acc._ReportRowsOnDocs  _ReportRowsOnDocs  INNER JOIN acc.' +
        'Categories Categories ON [_ReportRowsOnDocs].G_TopicCode = Categ' +
        'ories.TopicCode) INNER JOIN acc.Details Details ON [_ReportRowsO' +
        'nDocs].G_DetailCode = Details.DetailCode) INNER JOIN acc.CenterT' +
        'opics CenterTopics ON [_ReportRowsOnDocs].G_CTopicCode = CenterT' +
        'opics.CTopicCode'
      
        'WHERE ((([_ReportRowsOnDocs].repCode)=:RepCode)  AND ( YearID = ' +
        ':YearID ) AND (([_ReportRowsOnDocs].rowID)=:RowId) AND (([_Repor' +
        'tRowsOnDocs].ColNum)=2))')
    Left = 35
    Top = 344
