  object qryAccCode_1: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'RepCode'
        Attributes = [paNullable]
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'RowId'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      'SELECT [_ReportRowsOnDocs].G_TopicCode,'
      
        '      Ltrim(str( [G_DetailCode])) + '#39' - '#39' +ltrim(str( [G_TopicCo' +
        'de]) )  AS Topic_DetailCode,'
      
        '      Ltrim(str( [G_CTopicCode])) + '#39' - '#39' + Ltrim(str([G_TopicCo' +
        'de]))  AS Topic_CTopicCode,'
      
        '      Ltrim(str([G_CTopicCode])) + '#39' - '#39' +Ltrim(str( [G_DetailCo' +
        'de])) + '#39' - '#39' + Ltrim(str([G_TopicCode] )) AS AccCode,'
      
        '       Categories.MoeenName_L1, Categories.[MoeenName_L1] + '#39' - ' +
        #39' + [Details].[DetailName_L1] AS MoeenDetail,'
      
        '       [MoeenName_L1] +'#39' - '#39' + [CenterTopics].[CTopicName_L1] AS' +
        ' MoeenCtopic,'
      
        '       [MoeenName_L1] + '#39' - '#39' + [Details].[DetailName_L1] + '#39' - ' +
        #39' + [CenterTopics].[CTopicName_L1] AS AccName,'
      '       [_ReportRowsOnDocs].ID'
      
        'FROM ((acc._ReportRowsOnDocs _ReportRowsOnDocs INNER JOIN  acc.C' +
        'ategories Categories ON   [_ReportRowsOnDocs].G_TopicCode = Cate' +
        'gories.TopicCode) INNER JOIN acc.Details Details ON [_ReportRows' +
        'OnDocs].G_DetailCode = Details.DetailCode) INNER JOIN  acc.Cente' +
        'rTopics CenterTopics ON [_ReportRowsOnDocs].G_CTopicCode = Cente' +
        'rTopics.CTopicCode'
      
        'WHERE ((([_ReportRowsOnDocs].repCode)=:RepCode)  AND ( YearID = ' +
        ':YearID ) AND (([_ReportRowsOnDocs].rowID)=:RowId) AND (([_Repor' +
        'tRowsOnDocs].ColNum)=1))')
    Left = 51
    Top = 128
    object qryAccCode_1MoeenDetail: TWideStringField
      DisplayLabel = #1593#1606#1608#1575#1606
      FieldName = 'MoeenDetail'
      ReadOnly = True
      Size = 255
