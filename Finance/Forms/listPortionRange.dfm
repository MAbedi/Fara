  object qrylistPortion: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'PortionCunt'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 1
      end
      item
        Name = 'YearID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'DocDateFrom'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'DocDateTo'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'SecondaryDocNoFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'SecondaryDocNoTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PrimaryDocNoFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PrimaryDocNoTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT  acc.Documents.TopicCode, acc.Documents.DetailCode, acc.D' +
        'ocuments.CTopicCode, acc.Documents.CTopicCode2,'
      
        '        acc.FormsInfo.InfoID, acc.FormsInfo.InfoName_L1, SUM(acc' +
        '.Documents.Debt) - SUM(acc.Documents.Credit) AS remain'
      '        , acc.FormsInfo.InfoName_L1 as  accName'
      'FROM    Acc.DocGroups INNER JOIN'
      
        '                      Acc.Documents ON Acc.DocGroups.Serial = Ac' +
        'c.Documents.Serial AND Acc.DocGroups.YearID = Acc.Documents.Year' +
        'ID AND '
      
        '                      Acc.DocGroups.CompanyCode = Acc.Documents.' +
        'CompanyCode LEFT OUTER JOIN'
      '                      Acc.PortionTable INNER JOIN'
      
        '                      Acc.PortionRange ON Acc.PortionTable.YearI' +
        'D = Acc.PortionRange.YearID ON Acc.Documents.YearID = Acc.Portio' +
        'nRange.YearID AND '
      
        '                      Acc.Documents.TopicCode = Acc.PortionRange' +
        '.TopicCode AND Acc.Documents.DetailCode = Acc.PortionRange.Detai' +
        'lCode AND '
      
        '                      Acc.Documents.CTopicCode = Acc.PortionRang' +
        'e.CTopicCode AND Acc.Documents.CTopicCode2 = Acc.PortionRange.CT' +
        'opicCode2 FULL OUTER JOIN'
      
        '                      Acc.FormsInfo ON Acc.PortionRange.FormInfo' +
        'ID = Acc.FormsInfo.FormInfoID AND Acc.PortionTable.FormInfoID = ' +
        'Acc.FormsInfo.FormInfoID'
      ''
      
        'where  acc.PortionTable.PortionCunt=:PortionCunt And  acc.Docume' +
        'nts.YearID =:YearID  AND '
      
        '(Acc.DocGroups.DocDate BETWEEN :DocDateFrom  AND  :DocDateTo ) A' +
        'ND '
      
        '(Acc.DocGroups.SecondaryDocNo BETWEEN :SecondaryDocNoFrom    AND' +
        '  :SecondaryDocNoTo   ) AND '
      
        '(Acc.DocGroups.PrimaryDocNo BETWEEN :PrimaryDocNoFrom   AND :Pri' +
        'maryDocNoTo  )'
      ''
      
        'GROUP BY acc.Documents.TopicCode, acc.Documents.DetailCode, acc.' +
        'Documents.CTopicCode,'
      '         acc.Documents.CTopicCode2, acc.FormsInfo.InfoID,'
      '         acc.FormsInfo.InfoName_L1,acc.PortionTable.FormInfoID'
      'ORDER BY acc.Documents.TopicCode')
    Left = 531
    Top = 127
  end
  object srclistPortion: TDataSource
    DataSet = qrylistPortion
    Left = 451
    Top = 127
  end
  object qryFormsinfo: TADOQuery
    Connection = DmF.adcAccounting
    Parameters = <>
    SQL.Strings = (
      'SELECT      FormInfoID, InfoName_L1'
      'FROM         acc.FormsInfo'
      'WHERE     (FormType = 10)')
    Left = 496
    Top = 8
