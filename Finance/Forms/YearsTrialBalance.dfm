    SQL.Strings = (
      'SELECT   YearsTrialBalance.* '
      
        'FROM     Acc.YearsTrialBalance(  :DocTypeCode_Not , :DocTypeCode' +
        'From  , :DocTypeCodeTo , :CompanyCodeFrom  , :CompanyCodeTo  ,'
      
        '      '#9#9'                        :TopicCodeFrom ,  :TopicCodeTo  ' +
        ',  :DetailCodeFrom ,  :DetailCodeTo  ,  :CTopicCodeFrom ,  :CTop' +
        'icCodeTo  , '
      
        '                        '#9'                        :CTopicCode2Fro' +
        'm ,  :CTopicCode2To  , :CTopicCode3From ,  :CTopicCode3To ,  :Se' +
        'condaryDocNoFrom  , :SecondaryDocNoTo , '
      
        #9#9#9'        :PrimaryDocNoFrom  , :PrimaryDocNoTo , :DocDateFrom ,' +
        ' :DocDateTo  , :Status , '
      #9#9#9'        :FromYearID , :ToYearId ) YearsTrialBalance')
