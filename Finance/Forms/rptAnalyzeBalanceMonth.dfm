    SQL.Strings = (
      'select   YearID, w_Code as AccCode, w_Name as AccName,'
      ''
      
        '                      Categories_1.TopicCode AS TopicCode1, Cate' +
        'gories_2.TopicCode AS TopicCode2, Categories_3.TopicCode AS Topi' +
        'cCode3, '
      
        '                      Categories_4.TopicCode AS TopicCode4, Cate' +
        'gories_5.TopicCode AS TopicCode5, Categories_6.TopicCode AS Topi' +
        'cCode6, '
      
        '                      Categories_1.MoeenName_L1 AS AccName1, Cat' +
        'egories_2.MoeenName_L1 AS AccName2, Categories_3.MoeenName_L1 AS' +
        ' AccName3, '
      
        '                      Categories_4.MoeenName_L1 AS AccName4, Cat' +
        'egories_5.MoeenName_L1 AS AccName5, Categories_6.MoeenName_L1 AS' +
        ' AccName6, '
      
        '                      CenterTopics_1.CTopicCode AS CTopicCode1, ' +
        'CenterTopics_2.CTopicCode AS CTopicCode2, CenterTopics_3.CTopicC' +
        'ode AS CTopicCode3, '
      
        '                      CenterTopics_1.CTopicName_L1 AS CTopicName' +
        '1, CenterTopics_2.CTopicName_L1 AS CTopicName2, '
      
        '                      CenterTopics_3.CTopicName_L1 AS CTopicName' +
        '3, CenterTopics2_2.CTopicCode2 AS CTopicCode2_2, '
      
        '                      CenterTopics2_1.CTopicCode2 AS CTopicCode2' +
        '_1, CenterTopics2_1.CTopicName2_L1 AS CTopicName2_1, '
      
        '                      CenterTopics2_2.CTopicName2_L1 AS CTopicNa' +
        'me2_2, Companies_1.CompanyCode AS CompanyCode1, '
      
        '                      Companies_2.CompanyCode AS CompanyCode2, C' +
        'ompanies_3.CompanyCode AS CompanyCode3, '
      
        '                      Companies_1.CompanyName_L1 AS CompanyName1' +
        ', Companies_2.CompanyName_L1 AS CompanyName2, '
      
        '                      Companies_3.CompanyName_L1 AS CompanyName3' +
        ', 0 AS DetailCode, MIN(Acc.Details.DetailName_L1) AS DetailName_' +
        'L1, '
      
        '                      CASE WHEN SUM(Debt - Credit) > 0 THEN SUM(' +
        'Debt - Credit) ELSE 0 END AS sumBalanceDebt, CASE WHEN SUM(Credi' +
        't - Debt) '
      
        '                      > 0 THEN SUM(Credit - Debt) ELSE 0 END AS ' +
        'sumBalanceCredit, '
      
        '                     sum(AnalyzeCormparisonBalanceWithSelected.B' +
        'alanceLastYear) as BalanceLastYear,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM1) as BalanceM1, '
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM2) as BalanceM2,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM3) as BalanceM3,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM4) as BalanceM4,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM5) as BalanceM5,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM6) as BalanceM6,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM7) as BalanceM7,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM8) as BalanceM8,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM9) as BalanceM9,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM10) as BalanceM10,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM11) as BalanceM11,'
      
        '                     sum (AnalyzeCormparisonBalanceWithSelected.' +
        'BalanceM12) as BalanceM12'
      ''
      'FROM  ACC.Categories Categories_2 RIGHT OUTER JOIN'
      '      ACC.Categories Categories_5 RIGHT OUTER JOIN'
      '      ACC.Categories Categories_3 RIGHT OUTER JOIN'
      '      ACC.Categories Categories_6 RIGHT OUTER JOIN'
      '      ACC.CenterTopics2 CenterTopics2_2 RIGHT OUTER JOIN'
      '      ACC.Details INNER JOIN'
      '      ACC.AnalyzeCormparisonBalanceWithSelected('
      
        '            :DocTypeCode1_Not,:DocTypeCode2_Not,:DocTypeCode3_No' +
        't,'
      '            :DocTypeCodeFrom,:DocTypeCodeTo,'
      '            :CompanyCodeFrom,:CompanyCodeTo,'
      '            :AccCodeFrom,:AccCodeTo,'
      '            :DetailCodeFrom,:DetailCodeTo,'
      '            :SecondaryDocNoFrom,:SecondaryDocNoTo,'
      '            :PrimaryDocNoFrom,:PrimaryDocNoTo,'
      '            :DocDateFrom,:DocDateTo,'
      '            :CTopicCodeFrom,:CTopicCodeTo,'
      '            :CTopicCode2From,:CTopicCode2To,'
      
        '            :LenAcc1,:LenAcc2,:LenAcc3,:LenAcc4,:LenAcc5,:LenAcc' +
        '6,'
      '            :LenCompany1,:LenCompany2,:LenCompany3,'
      '            :LenCTopic1,:LenCTopic2, :LenCTopic3,'
      '            :LenCTopic2_1,:LenCTopic2_2'
      '           ,:Status1,:Status2,:FromYearId,:ToYearID )'
      '      AnalyzeCormparisonBalanceWithSelected ON'
      
        '      ACC.Details.DetailCode = AnalyzeCormparisonBalanceWithSele' +
        'cted.DetailCode LEFT OUTER JOIN'
      
        '      ACC.Companies Companies_3 ON AnalyzeCormparisonBalanceWith' +
        'Selected.CompanyCode3 = Companies_3.CompanyCode LEFT OUTER JOIN'
      
        '      ACC.Companies Companies_2 ON AnalyzeCormparisonBalanceWith' +
        'Selected.CompanyCode2 = Companies_2.CompanyCode LEFT OUTER JOIN'
      
        '      ACC.Companies Companies_1 ON AnalyzeCormparisonBalanceWith' +
        'Selected.CompanyCode1 = Companies_1.CompanyCode ON'
      
        '      CenterTopics2_2.CTopicCode2 = AnalyzeCormparisonBalanceWit' +
        'hSelected.CTopicCode2_2 LEFT OUTER JOIN'
      
        '      ACC.CenterTopics2 CenterTopics2_1 ON AnalyzeCormparisonBal' +
        'anceWithSelected.CTopicCode2_1 = CenterTopics2_1.CTopicCode2 LEF' +
        'T OUTER JOIN'
      
        '      ACC.CenterTopics CenterTopics_3 ON AnalyzeCormparisonBalan' +
        'ceWithSelected.CTopicCode3 = CenterTopics_3.CTopicCode LEFT OUTE' +
        'R JOIN'
      
        '      ACC.CenterTopics CenterTopics_2 ON AnalyzeCormparisonBalan' +
        'ceWithSelected.CTopicCode2 = CenterTopics_2.CTopicCode LEFT OUTE' +
        'R JOIN'
      
        '      ACC.CenterTopics CenterTopics_1 ON AnalyzeCormparisonBalan' +
        'ceWithSelected.CTopicCode1 = CenterTopics_1.CTopicCode ON'
      
        '      Categories_6.TopicCode = AnalyzeCormparisonBalanceWithSele' +
        'cted.TopicCode6 ON Categories_3.TopicCode = AnalyzeCormparisonBa' +
        'lanceWithSelected.TopicCode3 LEFT OUTER JOIN'
      
        '      ACC.Categories Categories_4 ON AnalyzeCormparisonBalanceWi' +
        'thSelected.TopicCode4 = Categories_4.TopicCode ON'
      
        '      Categories_5.TopicCode = AnalyzeCormparisonBalanceWithSele' +
        'cted.TopicCode5 ON Categories_2.TopicCode = AnalyzeCormparisonBa' +
        'lanceWithSelected.TopicCode2 LEFT OUTER JOIN'
      
        '      ACC.Categories Categories_1 ON AnalyzeCormparisonBalanceWi' +
        'thSelected.TopicCode1 = Categories_1.TopicCode'
      ''
      
        'GROUP BY Categories_1.TopicCode, Categories_2.TopicCode, Categor' +
        'ies_3.TopicCode, Categories_4.TopicCode, Categories_5.TopicCode,' +
        ' '
      
        '                      Categories_6.TopicCode, Categories_1.Moeen' +
        'Name_L1, Categories_2.MoeenName_L1, Categories_3.MoeenName_L1, C' +
        'ategories_4.MoeenName_L1, '
      
        '                      Categories_5.MoeenName_L1, Categories_6.Mo' +
        'eenName_L1, CenterTopics_1.CTopicCode, CenterTopics_2.CTopicCode' +
        ', CenterTopics_3.CTopicCode, '
      
        '                      CenterTopics_1.CTopicName_L1, CenterTopics' +
        '_2.CTopicName_L1, CenterTopics_3.CTopicName_L1, CenterTopics2_2.' +
        'CTopicCode2, '
      
        '                      CenterTopics2_1.CTopicCode2, CenterTopics2' +
        '_1.CTopicName2_L1, CenterTopics2_2.CTopicName2_L1, Companies_1.C' +
        'ompanyCode, '
      
        '                      Companies_2.CompanyCode, Companies_3.Compa' +
        'nyCode, Companies_1.CompanyName_L1, Companies_2.CompanyName_L1, '
      
        '                      Companies_3.CompanyName_L1, AnalyzeCormpar' +
        'isonBalanceWithSelected.YearId')
