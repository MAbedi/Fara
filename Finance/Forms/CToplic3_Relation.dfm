  object qry_CToplic2: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT  acc.CenterTopics2.CTopicCode2, acc.CenterTopics2.CTopicN' +
        'ame2_L1,'
      '        acc.CenterTopics2.CTopicName2_L2'
      'FROM    acc.CenterTopics2 LEFT OUTER JOIN'
      
        '        acc.CTopics2ForUse ON acc.CenterTopics2.CTopicCode2 = ac' +
        'c.CTopics2ForUse.PrvTopicCode'
      'WHERE   (acc.CTopics2ForUse.PrvTopicCode IS NULL) and'
      '        (acc.CenterTopics2.CTopicCode2<>0)'
      'order by acc.CenterTopics2.CTopicCode2')
    Left = 128
    Top = 136
