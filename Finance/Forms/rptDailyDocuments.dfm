  object qryDocs: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryDocsAfterOpen
    Parameters = <
      item
        Name = 'LenAccCode'
        DataType = ftString
        Size = 1
        Value = '2'
      end
      item
        Name = 'DocDateFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocDateTo'
        DataType = ftWideString
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'FromYearId'
        DataType = ftWideString
        Size = 2
        Value = '0'
      end
      item
        Name = 'ToYearID'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyTo'
        DataType = ftWideString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'ByDocSerial'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     rptDailyDocuments.*, Acc.Categories.MoeenName_L1 AS k' +
        'olName_L1,'
      '           Acc.Categories.MoeenName_L2 AS kolName_L2  ,'
      
        '           bed AS Sumbed,bes as sumbes  ,bed - Bes as Balance , ' +
        'DocNo as row'
      
        'FROM       Acc.rptDailyDocuments(:LenAccCode, :DocDateFrom, :Doc' +
        'DateTo,:FromYearId,:ToYearID, :CompanyFrom, :CompanyTo,:ByDocSer' +
        'ial) rptDailyDocuments LEFT OUTER JOIN'
      
        '           Acc.Categories ON rptDailyDocuments.CodeKol = Acc.Cat' +
        'egories.TopicCode'
      ''
      'ORDER BY      DocDate,B,CodeKol;'
      '')
    Left = 200
    Top = 117
