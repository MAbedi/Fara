  object qryPrint: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryPrintAfterOpen
    Parameters = <
      item
        Name = 'LenAccCode'
        DataType = ftString
        Size = 1
        Value = '2'
      end
      item
        Name = 'DocDateFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'DocDateTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'FromYearId'
        Size = -1
        Value = Null
      end
      item
        Name = 'ToYearID'
        Size = -1
        Value = Null
      end
      item
        Name = 'CompanyFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyTo'
        DataType = ftWideString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'ByDocSerial'
        Size = -1
        Value = Null
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        Size = 10
        Value = '0000/00/00'
      end
      item
        Name = 'DateTo'
        DataType = ftString
        Size = 10
        Value = '9999/99/99'
      end>
    SQL.Strings = (
      
        'SELECT    rptDailyDocuments.* , Acc.Categories.MoeenName_L1 AS k' +
        'olName_L1 , Acc.Categories.MoeenName_L2 AS kolName_L2  ,'
      
        '                       bed AS Sumbed, bes as sumbes  , bed - Bes' +
        ' as Balance , DocNo as row'
      ''
      ''
      
        'FROM    Acc.rptDailyDocuments(  :LenAccCode  , :DocDateFrom, :Do' +
        'cDateTo,   :FromYearId  ,  :ToYearID , :CompanyFrom, :CompanyTo ' +
        ',:ByDocSerial) rptDailyDocuments LEFT OUTER JOIN'
      ''
      
        '                   Acc.Categories ON rptDailyDocuments.CodeKol =' +
        ' Acc.Categories.TopicCode'
      
        'WHERE     (rptDailyDocuments.DocDate BETWEEN :DateFrom AND :Date' +
        'To)'
      'ORDER BY      DocDate,B,CodeKol;'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      '')
    Left = 416
    Top = 173
