  object qry_TrialBalance: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qry_TrialBalanceAfterOpen
    Parameters = <
      item
        Name = 'DocTypeCode1_Not'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocTypeCode2_Not'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocTypeCode3_Not'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocTypeCodeFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocTypeCodeTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyCodeFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyCodeTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'AccCodeFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'AccCodeTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SecondaryDocNoFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SecondaryDocNoTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PrimaryDocNoFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PrimaryDocNoTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocDateFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocDateTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'Status1'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'Status2'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'FromYearId'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ToYearId'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SellsEmporiumFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SellsEmporiumTo'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      'SELECT'
      'r.storeid ,s.c_StoreName, v.VarianceCode ,v.VarianceName ,'
      
        't.TopicCode ,v.TopicCode vTopicCode,c.MoeenName_L1 ,t.CTopicCode' +
        ' , v.CTopicCode vCTopicCode'
      ', max(t.Debt) Debt, max(t.Credit ) Credit'
      
        ',cast(sum(case when (r.effecttype in(2,6)) then TotallSellPrice ' +
        'else 0 end) as money) as InPutPrice'
      
        ',cast(sum(case when (r.effecttype in(4,7)) then TotallSellPrice ' +
        'else 0 end) as money) as OutPutPrice'
      
        ',cast(sum(case when (r.effecttype in(2,6)) then TotallSellPrice ' +
        'else 0.0 end)-max( t.debt) as money) as DifDebt'
      
        ',cast(sum(case when (r.effecttype in(4,7)) then TotallSellPrice ' +
        'else 0.0 end)-max(t.credit) as money) as DifCredit'
      ''
      
        ',cast(SUM(CASE WHEN( R.ReciptType = 5) THEN TotalInputPrice + To' +
        'talOutputPrice ELSE  0.0 END) as money) AS Cross5,cast(SUM(CASE ' +
        'WHEN( R.ReciptType = 9) THEN TotalInputPrice + TotalOutputPrice ' +
        'ELSE  0.0 END) as money) AS Cross9,cast(SUM(CASE WHEN( R.ReciptT' +
        'ype = 11) THEN TotalInputPrice + TotalOutputPrice ELSE  0.0 END)' +
        ' as money) AS Cross11,cast(SUM(CASE WHEN( R.ReciptType = 13) THE' +
        'N TotalInputPrice + TotalOutputPrice ELSE  0.0 END) as money) AS' +
        ' Cross13,cast(SUM(CASE WHEN( R.ReciptType = 18) THEN TotalInputP' +
        'rice + TotalOutputPrice ELSE  0.0 END) as money) AS Cross18,cast' +
        '(SUM(CASE WHEN( R.ReciptType = 46) THEN TotalInputPrice + TotalO' +
        'utputPrice ELSE  0.0 END) as money) AS Cross46,cast(SUM(CASE WHE' +
        'N( R.ReciptType = 66) THEN TotalInputPrice + TotalOutputPrice EL' +
        'SE  0.0 END) as money) AS Cross66,cast(SUM(CASE WHEN( R.ReciptTy' +
        'pe = 69) THEN TotalInputPrice + TotalOutputPrice ELSE  0.0 END) ' +
        'as money) AS Cross69'
      ''
      
        'FROM (SELECT DISTINCT Acc.VarianceRelations.TopicCode, Acc.Varia' +
        'nceRelations.VarianceCode, Acc.VarianceRelations.CTopicCode, Acc' +
        '.VarianceDefines.VarianceName'
      'FROM            Acc.VarianceRelations INNER JOIN'
      
        '                         Acc.VarianceDefines ON Acc.VarianceRela' +
        'tions.VarianceCode = Acc.VarianceDefines.VarianceCode ) as v'
      'full join'
      ' ACC.AccTrialCTopicsBalance('
      
        '               :DocTypeCode1_Not,:DocTypeCode2_Not,:DocTypeCode3' +
        '_Not, :DocTypeCodeFrom , :DocTypeCodeTo ,'
      '               :CompanyCodeFrom ,:CompanyCodeTo,'
      '               :AccCodeFrom ,:AccCodeTo,'
      '               0 ,99999999,'
      '               :SecondaryDocNoFrom  , :SecondaryDocNoTo ,'
      '               :PrimaryDocNoFrom , :PrimaryDocNoTo ,'
      '               :DocDateFrom , :DocDateTo'
      
        '               ,:Status1,:Status2,:FromYearId,:ToYearId , DEFAUL' +
        'T, DEFAULT, DEFAULT'
      '                    ) T'
      'LEFT JOIN'
      'Acc.Categories c ON t.TopicCode = c.TopicCode'
      'on t.topiccode = v.TopicCode  and t.CTopicCode = v.CTopicCode'
      'LEFT join'
      'reciptitems_stock as r on v.variancecode = r.storeid'
      'left join Stores s on s.n_StoreID = v.VarianceCode'
      ''
      
        ' WHERE NOT(v.VarianceCode  is null) and (ISnull(R.SellsEmporium,' +
        '0) BETWEEN :SellsEmporiumFrom AND :SellsEmporiumTo)'
      ''
      ''
      
        'GROUP BY  t.TopicCode,c.MoeenName_L1 ,r.storeid ,s.c_StoreName, ' +
        'v.VarianceCode,v.TopicCode,t.CTopicCode , v.CTopicCode,v.Varianc' +
        'eName'
      'order by v.VarianceCode ,t.TopicCode')
    Left = 456
    Top = 160
  end
