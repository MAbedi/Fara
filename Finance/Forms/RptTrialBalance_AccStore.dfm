  object qryCross: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'StoreIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'StoreIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'DateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end>
    SQL.Strings = (
      'SELECT    ReciptType AS CrossCode, ReciptCaption AS CrossName'
      'FROM         ReciptItems_Stock '
      ''
      'WHERE     (EffectType IN (2, 4, 6, 7))'
      
        '                        AND ( StoreID  BETWEEN :StoreIDFrom AND ' +
        ':StoreIDTo )'
      
        '                        AND ( ReciptDate BETWEEN  :DateFrom AND ' +
        ' :DateTo )'
      '      '
      'GROUP BY ReciptCaption, ReciptType'
      ''
      'HAVING ( SUM(TotalInputPrice + TotalOutputPrice)>0)'
      ''
      'ORDER BY ReciptType')
    Left = 736
    Top = 176
    object qryCrossCrossCode: TWordField
      FieldName = 'CrossCode'
    end
    object qryCrossCrossName: TStringField
      FieldName = 'CrossName'
      ReadOnly = True
      Size = 77
    end
  end
end
