    SQL.Strings = (
      
        'SELECT     AccComparisonMonthBalance.*,acc.Categories.MoeenName_' +
        'L1, acc.Categories.MoeenName_L2'
      'FROM         acc.AccComparisonMonthBalance'
      '(:LenPrvAccCode, :LenAccCode,  '
      ' :DocTypeCode1_Not, :DocTypeCode2_Not, :DocTypeCode3_Not,'
      
        ' :DocTypeCodeFrom,:DocTypeCodeTo, :CompanyCodeFrom, :CompanyCode' +
        'To,'
      ' :AccCodeFrom, :AccCodeTo, :CTopicCodeFrom,'
      ' :CTopicCodeTo, :SecondaryDocNoFrom, :SecondaryDocNoTo,'
      ' :PrimaryDocNoFrom, :PrimaryDocNoTo,'
      
        ':DocDateFrom,:DocDateTo,:miladiActive ,:FromYearID,:ToYearID) Ac' +
        'cComparisonMonthBalance INNER JOIN'
      
        '     acc.Categories ON AccComparisonMonthBalance.TopicCode = acc' +
        '.Categories.TopicCode')
    Left = 544
    Top = 142
