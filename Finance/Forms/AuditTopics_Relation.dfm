  object qry_TopicCode: TADOQuery
    Connection = Dmf.adcAccounting
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     acc.Categories.TopicCode, acc.Categories.MoeenName_L1' +
        ',acc.Categories.MoeenName_L2, acc.Categories.AuditID'
      'FROM         acc.Categories LEFT OUTER JOIN'
      
        '                      acc.CategoriesForUse ON acc.Categories.Top' +
        'icCode = acc.CategoriesForUse.PrvTopicCode'
      'WHERE     (acc.CategoriesForUse.PrvTopicCode IS NULL)'
      ''
      'Order By   Ltrim(Str(acc.Categories.TopicCode))')
    Left = 24
    Top = 96
    object qry_TopicCodeTopicCode: TLargeintField
      FieldName = 'TopicCode'
    end
    object qry_TopicCodeMoeenName_L1: TStringField
      FieldName = 'MoeenName_L1'
      Size = 100
    end
    object qry_TopicCodeMoeenName_L2: TStringField
      FieldName = 'MoeenName_L2'
      Size = 100
    end
    object qry_TopicCodeAuditID: TIntegerField
      FieldName = 'AuditID'
    end
  end
