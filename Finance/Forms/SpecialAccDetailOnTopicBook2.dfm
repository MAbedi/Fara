      end>
    SQL.Strings = (
      
        'SELECT  Fitful.FitfulID AS calcuBalance , Fitful.FitfulID AS bed' +
        ', Fitful.FitfulID AS bes, Fitful.FitfulID as Amount, Fitful.Fitf' +
        'ulID as _row , DetailsOnTopicBook.*'
      
        'FROM    acc.DetailsOnTopicBookSpecial(:CompanyCode , :TopicCodeF' +
        'rom, :TopicCodeTo , :DetailCodeFrom ,:DetailCodeTo,'
      
        '                                                                ' +
        ':SecondaryDocNoFrom ,:SecondaryDocNoTo , :PrimaryDocNoFrom , :Pr' +
        'imaryDocNoTo ,'
      
        '                                                                ' +
        ':DocDateFrom , :DocDateTo ,:Status1,:Status2,:FromYearId,:ToYear' +
        'Id  ,'
      
        ':CurrencyTypeFrom , :CurrencyTypeTo, :CurrencyKind  ) DetailsOnT' +
        'opicBook CROSS JOIN Fitful'
      'ORDER BY DocDate, SecondaryDocNo, PrimaryDocNo, bedbes, ID'
      '')
    Left = 440
    Top = 336
