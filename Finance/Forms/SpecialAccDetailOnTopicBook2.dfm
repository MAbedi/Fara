  object qry_Details: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qry_DetailsAfterScroll
    Parameters = <
      item
        Name = 'DetailFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'DetailTO'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'Company'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'SELECT    * FROM    acc.Details'
      
        'WHERE     (DetailCode BETWEEN :DetailFrom AND :DetailTO)  AND (C' +
        'ompanyCode = :Company)'
      'ORDER BY DetailCode')
    Left = 435
    Top = 131
    object qry_DetailsCompanyCode: TIntegerField
      FieldName = 'CompanyCode'
    end
    object qry_DetailsDetailCode: TIntegerField
      DisplayLabel = #1705#1583' '#1578#1601#1589#1610#1604#1610
