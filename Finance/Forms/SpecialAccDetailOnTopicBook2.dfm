      item
        Name = 'TopicCodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = '0'
      end
      item
        Name = 'TopicCodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = '0'
      end>
    SQL.Strings = (
      'SELECT acc.Categories.*  FROM acc.DetailRange INNER JOIN'
      
        '       acc.Categories ON acc.DetailRange.TopicCode =acc.Categori' +
        'es.TopicCode'
      'WHERE (acc.DetailRange.DetailCode = :Detail) AND'
      
        '      (acc.DetailRange.TopicCode BETWEEN :TopicCodeFrom AND :Top' +
        'icCodeTo)'
      'ORDER BY acc.Categories.TopicCode'
      ''
      ''
      ''
      ''
      ''
      ''
      '')
    Left = 40
    Top = 141
