  object qryContrastAccount: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    AfterInsert = qryContrastAccountAfterInsert
    BeforePost = qryContrastAccountBeforePost
    AfterPost = qryContrastAccountAfterPost
    AfterCancel = qryContrastAccountAfterCancel
    BeforeDelete = qryContrastAccountBeforeDelete
    AfterScroll = qryContrastAccountAfterScroll
    Parameters = <
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        MasterID, ParentID, DetailCode, TopicCode, DiffTyp' +
        'e, Value, ContrastDate, Description, Expense, CheckNo, DocNo, Do' +
        'cDate, Zinaf, YearID, Month, F1, F2, MojoodiTebgheDaftar, Mojood' +
        'iTebgheBank'
      'FROM            Acc.ContrastAccountSanama'
      'WHERE YearID = :YearID AND ParentID = 0')
    Left = 160
    object qryContrastAccountMasterID: TIntegerField
      FieldName = 'MasterID'
    end
    object qryContrastAccountParentID: TIntegerField
      FieldName = 'ParentID'
    end
    object qryContrastAccountDetailCode: TIntegerField
      FieldName = 'DetailCode'
    end
    object qryContrastAccountTopicCode: TIntegerField
      FieldName = 'TopicCode'
    end
    object qryContrastAccountDiffType: TWordField
      FieldName = 'DiffType'
    end
    object qryContrastAccountValue: TLargeintField
      DisplayLabel = #1605#1602#1583#1575#1585
      FieldName = 'Value'
    end
    object qryContrastAccountContrastDate: TStringField
      DisplayLabel = #1578#1575#1585#1740#1582
      FieldName = 'ContrastDate'
      EditMask = '9999/99/99;1;_'
      Size = 10
    end
    object qryContrastAccountDescription: TWideStringField
      DisplayLabel = #1588#1585#1581
      FieldName = 'Description'
      Size = 4000
    end
    object qryContrastAccountExpense: TLargeintField
      DisplayLabel = #1605#1576#1604#1594
      FieldName = 'Expense'
    end
    object qryContrastAccountCheckNo: TWideStringField
      DisplayLabel = #1588#1605#1575#1585#1607' '#1670#1705
      FieldName = 'CheckNo'
      Size = 50
    end
    object qryContrastAccountDocNo: TWideStringField
      DisplayLabel = #1588#1605#1575#1585#1607' '#1587#1606#1583
      FieldName = 'DocNo'
      Size = 50
    end
    object qryContrastAccountDocDate: TWideStringField
      DisplayLabel = #1578#1575#1585#1740#1582' '#1587#1606#1583
      FieldName = 'DocDate'
      Size = 10
    end
    object qryContrastAccountZinaf: TWideStringField
      DisplayLabel = #1584#1740#1606#1601#1593
      FieldName = 'Zinaf'
      Size = 4000
    end
    object qryContrastAccountYearID: TIntegerField
      FieldName = 'YearID'
    end
    object qryContrastAccountMonth: TWordField
      FieldName = 'Month'
    end
    object qryContrastAccountF1: TStringField
      FieldName = 'F1'
    end
    object qryContrastAccountF2: TStringField
      FieldName = 'F2'
    end
    object qryContrastAccount_DetailName: TStringField
      FieldKind = fkLookup
      FieldName = '_DetailName'
      LookupDataSet = qry_lookupDetails
      LookupKeyFields = 'DetailCode'
      LookupResultField = 'DetailName'
      KeyFields = 'DetailCode'
      Size = 150
      Lookup = True
    end
    object qryContrastAccount_TopicName: TStringField
      FieldKind = fkLookup
      FieldName = '_TopicName'
      LookupDataSet = qryCategories
      LookupKeyFields = 'TopicCode'
      LookupResultField = 'MoeenName_L1'
      KeyFields = 'TopicCode'
      Size = 150
      Lookup = True
    end
    object qryContrastAccount_Shaba: TStringField
      FieldKind = fkLookup
      FieldName = '_Shaba'
      LookupDataSet = qry_lookupDetails
      LookupKeyFields = 'DetailCode'
      LookupResultField = 'Shaba'
      KeyFields = 'DetailCode'
      Size = 50
      Lookup = True
    end
    object qryContrastAccount_BankTypeName: TStringField
      FieldKind = fkLookup
      FieldName = '_BankTypeName'
      LookupDataSet = qryFormsInfo
      LookupKeyFields = 'FormInfoID'
      LookupResultField = 'InfoName_L1'
      KeyFields = 'Value'
      Size = 100
      Lookup = True
    end
    object qryContrastAccountMojoodiTebgheDaftar: TLargeintField
      FieldName = 'MojoodiTebgheDaftar'
    end
    object qryContrastAccountMojoodiTebgheBank: TLargeintField
      FieldName = 'MojoodiTebgheBank'
    end
  end
