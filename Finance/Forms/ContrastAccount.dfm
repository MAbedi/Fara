  object qryDiffType: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterInsert = qryDiffTypeAfterInsert
    BeforePost = qryDiffTypeBeforePost
    AfterDelete = qryDiffTypeAfterDelete
    AfterScroll = qryDiffTypeAfterScroll
    Parameters = <
      item
        Name = 'ParentID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'DiffType'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        MasterID, ParentID, DetailCode, DiffType, Value, C' +
        'ontrastDate, Description, Expense, CheckNo, DocNo, DocDate, Zina' +
        'f, YearID, Month, F1, F2'
      'FROM            Acc.ContrastAccountSanama'
      'WHERE (  ParentID = :ParentID )  AND (  DiffType = :DiffType )')
    Left = 360
    Top = 360
    object qryDiffTypeMasterID: TIntegerField
      FieldName = 'MasterID'
    end
    object qryDiffTypeParentID: TIntegerField
      FieldName = 'ParentID'
    end
    object qryDiffTypeDetailCode: TIntegerField
      FieldName = 'DetailCode'
      Visible = False
    end
    object qryDiffTypeDiffType: TWordField
      FieldName = 'DiffType'
    end
    object qryDiffTypeValue: TLargeintField
      DisplayLabel = #1605#1602#1583#1575#1585
      FieldName = 'Value'
      Required = True
    end
    object qryDiffTypeContrastDate: TStringField
      DisplayLabel = #1578#1575#1585#1740#1582
      FieldName = 'ContrastDate'
      Required = True
      EditMask = '9999/99/99'
      Size = 10
    end
    object qryDiffTypeDescription: TWideStringField
