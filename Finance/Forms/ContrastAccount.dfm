      FieldName = 'Description'
      Size = 4000
    end
    object qryDiffTypeExpense: TLargeintField
      DisplayLabel = #1605#1576#1604#1594
      FieldName = 'Expense'
      Required = True
    end
    object qryDiffTypeCheckNo: TWideStringField
      DisplayLabel = #1588#1605#1575#1585#1607' '#1670#1705
      FieldName = 'CheckNo'
      Size = 50
    end
    object qryDiffTypeDocNo: TWideStringField
      DisplayLabel = #1588#1605#1575#1585#1607' '#1587#1606#1583
      FieldName = 'DocNo'
      Size = 50
    end
    object qryDiffTypeDocDate: TWideStringField
      DisplayLabel = #1578#1575#1585#1740#1582' '#1587#1606#1583
