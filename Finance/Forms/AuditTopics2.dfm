  end
  object qry_Detail: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    DataSource = srcAuditTopics
    Parameters = <
      item
        Name = 'AuditCode'
        Attributes = [paNullable]
        DataType = ftInteger
        NumericScale = 255
        Precision = 255
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     acc.AuditTopicForUse.*'
      'FROM         acc.AuditTopicForUse'
      'WHERE     (PrvAuditCode = :AuditCode)'
      'ORDER BY AuditCode')
    Left = 40
    Top = 312
    object qry_DetailAuditCode: TIntegerField
      Tag = 3
      DisplayLabel = #1603#1583
      FieldName = 'AuditCode'
    end
