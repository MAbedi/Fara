  object qry_Init: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'FormType'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      #13'SELECT     acc.AccTopicLevels.PrvLevelID ,'
      '                   AccTopicLevels_1.CodeLength AS prvCodeLength,'
      '                   acc.AccTopicLevels.CodeLength, '
      '                   acc.AccTopicLevels.LevelID'
      'FROM         acc.AccTopicLevels INNER JOIN'
      
        '                      acc.AccTopicLevels AccTopicLevels_1 ON acc' +
        '.AccTopicLevels.PrvLevelID = AccTopicLevels_1.LevelID'
      
        'Where (acc.AccTopicLevels.TopicType=4) And (acc.AccTopicLevels.L' +
        'evelId=:FormType)')
    Left = 616
    Top = 5
    object qry_InitPrvLevelID: TIntegerField
      FieldName = 'PrvLevelID'
    end
    object qry_InitprvCodeLength: TWordField
      FieldName = 'prvCodeLength'
    end
    object qry_InitCodeLength: TWordField
      FieldName = 'CodeLength'
    end
    object qry_InitLevelID: TIntegerField
      FieldName = 'LevelID'
    end
  end
