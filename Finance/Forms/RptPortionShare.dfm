  object qryDetailPortion: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'remain'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'subFormInfoID'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'subPortionCunt'
        DataType = ftString
        Size = 1
        Value = '1'
      end
      item
        Name = 'FormInfoID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'PortionCunt'
        DataType = ftString
        Size = 1
        Value = '1'
      end
      item
        Name = 'YearID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'SELECT'
      
        'acc.PortionTable.FormInfoID, acc.PortionTable.CTopicCode, ISNULL' +
        '(acc.CenterTopics2.CTopicCode2, 0) AS CenterTopics2,'
      
        '        ISNULL(acc.PortionTableItems.CofficientItem, acc.Portion' +
        'Table.Cofficient) AS CofficientItem, acc.CenterTopics.CTopicName' +
        '_L1,'
      
        '        acc.CenterTopics2.CTopicName2_L1, acc.CenterTopics.CTopi' +
        'cName_L1 + '#39' _ '#39' + ISNULL(acc.CenterTopics2.CTopicName2_L1, '#39#39') ' +
        'AS ExpName_L1'
      
        '        , round ( :remain * ISNULL(acc.PortionTableItems.Coffici' +
        'entItem, acc.PortionTable.Cofficient)/fun.sumCoff ,0 )as amount'
      'FROM  acc.CenterTopics RIGHT OUTER JOIN'
      '      acc.PortionTable inner JOIN'
      
        '     ( select acc.PortionTable.FormInfoID ,Acc.PortionTable.Year' +
        'ID ,'
      
        '              SUM(CASE WHEN (acc.PortionTable.FormInfoID =:subFo' +
        'rmInfoID ) THEN'
      
        '              ISNULL(CofficientItem, ISNULL(Cofficient,1)) ELSE ' +
        '- 1 END) as sumCoff'
      '       FROM   acc.PortionTable left JOIN'
      
        '              acc.PortionTableItems ON acc.PortionTable.Cofficie' +
        'ntID = acc.PortionTableItems.CofficientID INNER JOIN'
      
        '              acc.FormsInfo ON acc.PortionTable.FormInfoID = acc' +
        '.FormsInfo.FormInfoID'
      '      where  acc.PortionTable.PortionCunt=:subPortionCunt'
      
        '      group by acc.PortionTable.FormInfoID   , Acc.PortionTable.' +
        'YearID'
      '     ) fun'
      '     ON Acc.PortionTable.YearID = fun.YearID AND'
      '        acc.PortionTable.FormInfoID = fun.FormInfoID ON'
      
        '         acc.CenterTopics.CTopicCode = acc.PortionTable.CTopicCo' +
        'de LEFT OUTER JOIN'
      '         acc.CenterTopics2 RIGHT OUTER JOIN'
      
        '         acc.PortionTableItems ON acc.CenterTopics2.CTopicCode2 ' +
        '= acc.PortionTableItems.CTopicCode2 ON'
      
        '         acc.PortionTable.CofficientID = acc.PortionTableItems.C' +
        'officientID'
      ''
      'WHERE    (acc.PortionTable.FormInfoID = :FormInfoID) and'
      
        '          acc.PortionTable.PortionCunt<= :PortionCunt AND (Acc.P' +
        'ortionTable.YearID = :yearId )'
      ''
      
        'GROUP BY acc.PortionTable.FormInfoID, acc.PortionTable.CTopicCod' +
        'e, ISNULL(acc.CenterTopics2.CTopicCode2, 0),'
      
        '         acc.PortionTableItems.CofficientItem, acc.PortionTable.' +
        'Cofficient, acc.CenterTopics.CTopicName_L1, acc.CenterTopics2.CT' +
        'opicName2_L1,'
      
        '         acc.CenterTopics.CTopicName_L1 + '#39' _ '#39' + ISNULL(acc.Cen' +
        'terTopics2.CTopicName2_L1, '#39#39'),fun.sumCoff,acc.PortionTable.Port' +
        'ionCunt'
      '')
    Left = 138
    Top = 128
