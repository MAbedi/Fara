    SQL.Strings = (
      
        'SELECT     rptBalaceKollWithSomeColumn.*,Acc.Categories.MoeenNam' +
        'e_L1, Acc.Categories.MoeenName_L2'
      'FROM         Acc.rptBalaceKollWithSomeColumn'
      
        '(:LenPrvAccCode,:LenAccCode,:DocTypeCode1_Not, :DocTypeCode2_Not' +
        ',:DocTypeCode3_Not,'
      
        ':DocTypeCodeFrom,:DocTypeCodeTo,:AccCodeFrom, :AccCodeTo, :Secon' +
        'daryDocNoFrom, '
      ':SecondaryDocNoTo,:DocDateFrom, :DocDateTo'
      
        ',:PrimaryDocNoFrom,:PrimaryDocNoTo,:CompanyCodeFrom,:CompanyCode' +
        'To,:Status1,:Status2,:FromYearID,:ToYearID,'
      #9#9#9#9#9#9
      
        #9#9#9'            :CurrencyTypeFrom , :CurrencyTypeTo  , :CurrencyK' +
        'ind ) '
      ' rptBalaceKollWithSomeColumn INNER JOIN'
      
        '                      Acc.Categories ON rptBalaceKollWithSomeCol' +
        'umn.AccCode = Acc.Categories.TopicCode')
