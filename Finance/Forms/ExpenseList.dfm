      end
      item
        Name = 'AidNumberTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 15
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        Acc.Expense.ExpID, Acc.Expense.YearId, Acc.Expense' +
        '.FormNo, Acc.Expense.FormDate, Acc.Expense.TopicCode, Acc.Expens' +
        'e.DetailCode, Acc.Expense.CTopicCode, Acc.Expense.PayerTopicCode' +
        ', '
      
        '                         Acc.Expense.PayerDetailCode, Acc.Expens' +
        'e.PayerCTopicCode, MIN(Acc.Expense.Cacther) AS Cacther, Acc.Expe' +
        'nse.State, Acc.Expense.Kind, Acc.Expense.Preference, Acc.Expense' +
        '.Comments, '
      
        '                         Acc.Expense.CustDetailId, Acc.Expense.f' +
        'irstUser, Acc.Expense.lastUser, MIN(Acc.ExpenseItems.CatcherItem' +
        ') AS CatcherItem, SUM(Acc.ExpenseItems.Bed) AS Bed, SUM(Acc.Expe' +
        'nseItems.Bes) AS Bes, '
      
        '                         Acc.Details.DetailName_L1, SUM(Acc.Expe' +
        'nseItems.Bed) - SUM(Acc.ExpenseItems.Bes) AS Amount, Acc.Expense' +
        '.StateChangeDate, Acc.Expense.AidNumber, Acc.Expense.AidDate'
      'FROM            Acc.Expense INNER JOIN'
      
        '                         Acc.ExpenseItems ON Acc.Expense.ExpID =' +
        ' Acc.ExpenseItems.ExpID LEFT OUTER JOIN'
      
        '                         Acc.Details ON ISNULL(Acc.Expense.CustD' +
        'etailId, 0) = Acc.Details.DetailCode'
      
        'GROUP BY Acc.Expense.ExpID, Acc.Expense.YearId, Acc.Expense.Form' +
        'No, Acc.Expense.FormDate, Acc.Expense.TopicCode, Acc.Expense.Det' +
        'ailCode, Acc.Expense.CTopicCode, Acc.Expense.PayerTopicCode, '
      
        '                         Acc.Expense.PayerDetailCode, Acc.Expens' +
        'e.PayerCTopicCode, Acc.Expense.State, Acc.Expense.Kind, Acc.Expe' +
        'nse.Preference, Acc.Expense.Comments, Acc.Expense.CustDetailId, ' +
        'Acc.Expense.firstUser, '
      
        '                         Acc.Expense.lastUser, Acc.Details.Detai' +
        'lName_L1, Acc.Expense.StateChangeDate, Acc.Expense.AidNumber, Ac' +
        'c.Expense.AidDate'
      'HAVING        (Acc.Expense.YearId = :YearID ) '
      
        '                                                                ' +
        'AND (Acc.Expense.FormNo BETWEEN :FormNoFrom AND :FormNoTo ) '
      
        #9#9#9#9'AND (Acc.Expense.FormDate BETWEEN :FormDateFrom AND :FormDat' +
        'eTo ) '
      
        #9#9#9#9'AND (Acc.Expense.DetailCode BETWEEN :DetailCodeFrom AND :Det' +
        'ailCodeTo ) '
      
        #9#9#9#9'AND (Acc.Expense.CTopicCode BETWEEN :CTopicCodeFrom AND :CTo' +
        'picCodeTo ) '
      
        #9#9#9#9'AND (Acc.Expense.CustDetailId BETWEEN :CustDetailIdFrom AND ' +
        ':CustDetailIdTo )'
      
        #9#9#9#9'AND (Acc.Expense.TopicCode BETWEEN :TopicCodeFrom AND :Topic' +
        'CodeTo )'
      
        #9#9#9#9'AND (isnull(Acc.Expense.StateChangeDate,'#39'/  /'#39') BETWEEN :Sta' +
        'teChangeDateFrom AND :StateChangeDateTo )'
      
        '                                                                ' +
        'AND (isnull(Acc.Expense.AidDate,'#39'/  /'#39') BETWEEN :AidDateFrom AND' +
        ' :AidDateTo )'
      
        '                                                                ' +
        'AND (isnull(Acc.Expense.AidNumber,'#39#39') BETWEEN :AidNumberFrom AND' +
        ' :AidNumberTo ) '
      #9#9#9#9'AND (Acc.Expense.State IN (&&))')
    Left = 88
    Top = 229
