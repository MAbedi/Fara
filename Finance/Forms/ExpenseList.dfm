  object qryExpenseList: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    BeforeDelete = qryExpenseListBeforeDelete
    Parameters = <
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'FormNoFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
