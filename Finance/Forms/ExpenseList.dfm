        Value = Null
      end
      item
        Name = 'CustDetailIdFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'CustDetailIdTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
