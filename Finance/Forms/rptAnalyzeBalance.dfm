    SQL.Strings = (
      'select    YearID, w_Code as AccCode, w_Name as AccName,'
      
        '  Categories_1.TopicCode as TopicCode1, Categories_2.TopicCode A' +
        'S TopicCode2, Categories_3.TopicCode AS TopicCode3, Categories_4' +
        '.TopicCode AS TopicCode4,'
      
        '  Categories_5.TopicCode AS TopicCode5, Categories_6.TopicCode A' +
        'S TopicCode6, Categories_1.MoeenName_L1 as AccName1, Categories_' +
        '2.MoeenName_L1 AS AccName2,'
      
        '  Categories_3.MoeenName_L1 AS AccName3, Categories_4.MoeenName_' +
        'L1 AS AccName4, Categories_5.MoeenName_L1 AS AccName5,'
      '  Categories_6.MoeenName_L1 AS AccName6,'
      
        '   CenterTopics_1.CTopicCode as CTopicCode1 , CenterTopics_2.CTo' +
        'picCode AS CTopicCode2, CenterTopics_3.CTopicCode AS CTopicCode3' +
        ','
      
        '  CenterTopics_1.CTopicName_L1 as CTopicName1, CenterTopics_2.CT' +
        'opicName_L1 AS CTopicName2, CenterTopics_3.CTopicName_L1 AS CTop' +
        'icName3,'
      
        '  CenterTopics2_2.CTopicCode2 as CTopicCode2_2, CenterTopics2_1.' +
        'CTopicCode2 AS CTopicCode2_1, CenterTopics2_1.CTopicName2_L1 as ' +
        'CTopicName2_1,'
      '  CenterTopics2_2.CTopicName2_L1 AS CTopicName2_2,'
      
        '  Companies_1.CompanyCode as CompanyCode1, Companies_2.CompanyCo' +
        'de AS CompanyCode2,'
      
        '  Companies_3.CompanyCode AS CompanyCode3, Companies_1.CompanyNa' +
        'me_L1 as CompanyName1, Companies_2.CompanyName_L1 AS CompanyName' +
        '2,'
      '  Companies_3.CompanyName_L1 AS CompanyName3,'
      '  W_DetailCode AS DetailCode,'
      '  min(ACC.Details.DetailName_L1) AS DetailName_L1,'
      
        '  sum(AnalyzeTrialBalance.Debt) as sumDebt, sum(AnalyzeTrialBala' +
        'nce.Credit) as sumcredit'
      ''
      
        '  ,'#9'case when SUM(Debt - Credit)>0 then SUM(Debt -Credit) else 0' +
        ' end  AS  sumBalanceDebt'
      
        '  ,'#9'case when SUM( Credit - Debt)>0 then SUM(Credit - Debt ) els' +
        'e 0 end  AS  sumBalanceCredit'
      ''
      ''
      'FROM  ACC.Categories Categories_2 RIGHT OUTER JOIN'
      '      ACC.Categories Categories_5 RIGHT OUTER JOIN'
      '      ACC.Categories Categories_3 RIGHT OUTER JOIN'
      '      ACC.Categories Categories_6 RIGHT OUTER JOIN'
      '      ACC.CenterTopics2 CenterTopics2_2 RIGHT OUTER JOIN'
      '      ACC.Details INNER JOIN'
      '      ACC.AnalyzeTrialBalance('
      
        '            :DocTypeCode1_Not,:DocTypeCode2_Not,:DocTypeCode3_No' +
        't,'
      '            :DocTypeCodeFrom,:DocTypeCodeTo,'
      '            :CompanyCodeFrom,:CompanyCodeTo,'
      '            :AccCodeFrom,:AccCodeTo,'
      '            :DetailCodeFrom,:DetailCodeTo,'
      '            :SecondaryDocNoFrom,:SecondaryDocNoTo,'
      '            :PrimaryDocNoFrom,:PrimaryDocNoTo,'
      '            :DocDateFrom,:DocDateTo,'
      '            :CTopicCodeFrom,:CTopicCodeTo,'
      '            :CTopicCode2From,:CTopicCode2To,'
      
        '            :LenAcc1,:LenAcc2,:LenAcc3,:LenAcc4,:LenAcc5,:LenAcc' +
        '6,'
      '            :LenCompany1,:LenCompany2,:LenCompany3,'
      '            :LenCTopic1,:LenCTopic2, :LenCTopic3,'
      '            :LenCTopic2_1,:LenCTopic2_2'
      '           ,:Status1,:Status2,:FromYearId,:ToYearID'
      
        '                 , :CurrencyTypeFrom , :CurrencyTypeTo , :Curren' +
        'cyKind)'
      '      AnalyzeTrialBalance ON'
      
        '      ACC.Details.DetailCode = AnalyzeTrialBalance.DetailCode LE' +
        'FT OUTER JOIN'
      
        '      ACC.Companies Companies_3 ON AnalyzeTrialBalance.CompanyCo' +
        'de3 = Companies_3.CompanyCode LEFT OUTER JOIN'
      
        '      ACC.Companies Companies_2 ON AnalyzeTrialBalance.CompanyCo' +
        'de2 = Companies_2.CompanyCode LEFT OUTER JOIN'
      
        '      ACC.Companies Companies_1 ON AnalyzeTrialBalance.CompanyCo' +
        'de1 = Companies_1.CompanyCode ON'
      
        '      CenterTopics2_2.CTopicCode2 = AnalyzeTrialBalance.CTopicCo' +
        'de2_2 LEFT OUTER JOIN'
      
        '      ACC.CenterTopics2 CenterTopics2_1 ON AnalyzeTrialBalance.C' +
        'TopicCode2_1 = CenterTopics2_1.CTopicCode2 LEFT OUTER JOIN'
      
        '      ACC.CenterTopics CenterTopics_3 ON AnalyzeTrialBalance.CTo' +
        'picCode3 = CenterTopics_3.CTopicCode LEFT OUTER JOIN'
      
        '      ACC.CenterTopics CenterTopics_2 ON AnalyzeTrialBalance.CTo' +
        'picCode2 = CenterTopics_2.CTopicCode LEFT OUTER JOIN'
      
        '      ACC.CenterTopics CenterTopics_1 ON AnalyzeTrialBalance.CTo' +
        'picCode1 = CenterTopics_1.CTopicCode ON'
      
        '      Categories_6.TopicCode = AnalyzeTrialBalance.TopicCode6 ON' +
        ' Categories_3.TopicCode = AnalyzeTrialBalance.TopicCode3 LEFT OU' +
        'TER JOIN'
      
        '      ACC.Categories Categories_4 ON AnalyzeTrialBalance.TopicCo' +
        'de4 = Categories_4.TopicCode ON'
      
        '      Categories_5.TopicCode = AnalyzeTrialBalance.TopicCode5 ON' +
        ' Categories_2.TopicCode = AnalyzeTrialBalance.TopicCode2 LEFT OU' +
        'TER JOIN'
      
        '      ACC.Categories Categories_1 ON AnalyzeTrialBalance.TopicCo' +
        'de1 = Categories_1.TopicCode'
      ''
      ''
      ''
      'GROUP BY'
      
        '       YearID,Categories_1.TopicCode, Categories_2.TopicCode, Ca' +
        'tegories_3.TopicCode, Categories_4.TopicCode, Categories_5.Topic' +
        'Code,'
      
        '      Categories_6.TopicCode, Categories_1.MoeenName_L1, Categor' +
        'ies_2.MoeenName_L1, Categories_3.MoeenName_L1, Categories_4.Moee' +
        'nName_L1,'
      
        '      Categories_5.MoeenName_L1, Categories_6.MoeenName_L1, Cent' +
        'erTopics_1.CTopicCode, CenterTopics_2.CTopicCode, CenterTopics_3' +
        '.CTopicCode,'
      
        '      CenterTopics_1.CTopicName_L1, CenterTopics_2.CTopicName_L1' +
        ', CenterTopics_3.CTopicName_L1, CenterTopics2_2.CTopicCode2,'
      
        '      CenterTopics2_1.CTopicCode2, CenterTopics2_1.CTopicName2_L' +
        '1, CenterTopics2_2.CTopicName2_L1, Companies_1.CompanyCode,'
      
        '      Companies_2.CompanyCode, Companies_3.CompanyCode, Companie' +
        's_1.CompanyName_L1, Companies_2.CompanyName_L1,'
      '      Companies_3.CompanyName_L1  '
      '')
    Left = 592
    Top = 181
