  object qryReference: TADOQuery
    Connection = Dmf.adcAccounting
    CursorType = ctStatic
    AfterOpen = qryReferenceAfterOpen
    AfterScroll = qryReferenceAfterScroll
    Parameters = <
      item
        Name = 'UserID'
        DataType = ftWideString
        Size = 1
        Value = '1'
      end
      item
        Name = 'YearID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'DECLARE @UserID int, @YearId int'
      'SET @UserID = :UserID'
      'SET @YearId = :YearID'
      
        'SELECT        Acc.DocReference.ReferenceID, Acc.DocReference.Yea' +
        'rID, Acc.DocReference.CompanyCode, Acc.DocReference.Serial, Acc.' +
        'DocGroups.SecondaryDocNo, Acc.DocGroups.DocDate, SUM(Acc.Documen' +
        'ts.Credit) '
      
        '                         AS Amount, Acc.DocGroups.FirstUser, Acc' +
        '.DocReference.CountPage, Acc.DocReference.Note_L1, Acc.DocRefere' +
        'nce.Note_L2, dbo.MiladiToShamsi(Acc.DocReference.InsertDateTime)' +
        '+'#39' '#39'+LTRIM(CONVERT(CHAR(10), Acc.DocReference.InsertDateTime,108)' +
        ') as InsertDateTime, Acc.DocReference.AidNumber, '
      
        '                         Acc.DocReference.AidDate, Acc.DocRefere' +
        'nce.InsertUserID, Acc.DocReference.ReceiverUserID, Operators.nam' +
        'e, Acc.DocReference.PermitUserID, dbo.MiladiToShamsi(Acc.DocRefe' +
        'rence.ReceiverDateTime)+'#39' '#39'+LTRIM(CONVERT(CHAR(10), Acc.DocRefere' +
        'nce.ReceiverDateTime,108)) as ReceiverDateTime, Acc.DocReference' +
        '.ComputerName'
      'FROM            Acc.DocReference INNER JOIN'
      '                             (SELECT        r1.ReferenceID'
      
        '                                FROM            Acc.DocReference' +
        ' AS r1 INNER JOIN'
      
        '                                                             (SE' +
        'LECT        Serial, YearID, CompanyCode, MAX(InsertDateTime) AS ' +
        'lastDate'
      
        '                                                                ' +
        'FROM            Acc.DocReference AS r2'
      
        '                                                                ' +
        'GROUP BY Serial, YearID, CompanyCode) AS r3 ON r3.Serial = r1.Se' +
        'rial AND r3.YearID = r1.YearID AND r3.CompanyCode = r1.CompanyCo' +
        'de AND r3.lastDate = r1.InsertDateTime) '
      
        '                         AS lastReference ON lastReference.Refer' +
        'enceID = Acc.DocReference.ReferenceID LEFT OUTER JOIN'
      
        '                         Acc.DocGroups ON Acc.DocGroups.Serial =' +
        ' Acc.DocReference.Serial AND Acc.DocGroups.CompanyCode = Acc.Doc' +
        'Reference.CompanyCode AND Acc.DocGroups.YearID = Acc.DocReferenc' +
        'e.YearID INNER JOIN'
      
        '                         Acc.Documents ON Acc.Documents.Serial =' +
        ' Acc.DocGroups.Serial AND Acc.Documents.YearID = Acc.DocGroups.Y' +
        'earID AND Acc.Documents.CompanyCode = Acc.DocGroups.CompanyCode ' +
        'LEFT OUTER JOIN'
      
        '                         FaraSystems.dbo.Operators AS Operators ' +
        'ON Operators.UserID = Acc.DocReference.ReceiverUserID'
      
        'WHERE  (Acc.DocReference.InsertUserID = @UserID) OR (Acc.DocRefe' +
        'rence.ReceiverUserID = @UserID) OR (Acc.DocReference.PermitUserI' +
        'D = @UserID) and (Acc.DocReference.YearID = @YearId)'
      
        'GROUP BY Acc.DocReference.ReferenceID, Acc.DocReference.YearID, ' +
        'Acc.DocReference.CompanyCode, Acc.DocReference.Serial, Acc.DocGr' +
        'oups.SecondaryDocNo, Acc.DocGroups.DocDate, Acc.DocGroups.FirstU' +
        'ser, '
      
        '                         Acc.DocReference.CountPage, Acc.DocRefe' +
        'rence.Note_L1, Acc.DocReference.Note_L2, dbo.MiladiToShamsi(Acc.' +
        'DocReference.InsertDateTime)+'#39' '#39'+LTRIM(CONVERT(CHAR(10), Acc.DocR' +
        'eference.InsertDateTime,108)), Acc.DocReference.AidNumber, Acc.D' +
        'ocReference.AidDate, '
      
        '                         Acc.DocReference.InsertUserID, Acc.DocR' +
        'eference.ReceiverUserID, Acc.DocReference.PermitUserID, dbo.Mila' +
        'diToShamsi(Acc.DocReference.ReceiverDateTime)+'#39' '#39'+LTRIM(CONVERT(' +
        'CHAR(10), Acc.DocReference.ReceiverDateTime,108)), Acc.DocReferen' +
        'ce.ComputerName, Operators.name'
      ''
      'union all'
      ''
      
        'SELECT        0 AS ReferenceID, Acc.DocGroups.YearID, Acc.DocGro' +
        'ups.CompanyCode, Acc.DocGroups.Serial, Acc.DocGroups.SecondaryDo' +
        'cNo, Acc.DocGroups.DocDate, SUM(Acc.Documents.Credit) AS Amount,' +
        ' '
      
        '                         Acc.DocGroups.FirstUser, 0 AS CountPage' +
        ', CAST(Acc.DocGroups.DocNote_L1 AS varchar(1000)) AS DocNote_L1,' +
        ' CAST(Acc.DocGroups.DocNote_L2 AS varchar(1000)) AS DocNote_L2, ' +
        'dbo.MiladiToShamsi(Acc.DocGroups.MakeDate)+'#39' '#39'+LTRIM(CONVERT(cha' +
        'r(8), Acc.DocGroups.MakeDate,108)) as InsertDateTime, '
      
        '                         0 AS AidNumber, '#39#39' AS AidDate, Acc.DocG' +
        'roups.UserID, Acc.DocGroups.UserID AS ReceiverUserID, Operators.' +
        'name, Acc.DocGroups.UserID AS PermitUserID, dbo.MiladiToShamsi(A' +
        'cc.DocGroups.MakeDate)+'#39' '#39'+LTRIM(CONVERT(CHAR(10), Acc.DocGroups.' +
        'MakeDate,108)) as ReceiverDateTime, '#39#39' AS ComputerName'
      'FROM            Acc.DocGroups LEFT OUTER JOIN'
      
        '                         Acc.DocReference ON Acc.DocGroups.Seria' +
        'l = Acc.DocReference.Serial AND Acc.DocGroups.YearID = Acc.DocRe' +
        'ference.YearID AND Acc.DocGroups.CompanyCode = Acc.DocReference.' +
        'CompanyCode INNER JOIN'
      
        '                         Acc.Documents ON Acc.DocGroups.Serial =' +
        ' Acc.Documents.Serial AND Acc.DocGroups.YearID = Acc.Documents.Y' +
        'earID AND Acc.DocGroups.CompanyCode = Acc.Documents.CompanyCode ' +
        'LEFT OUTER JOIN'
      
        '                         FaraSystems.dbo.Operators AS Operators ' +
        'ON Operators.UserID = Acc.DocGroups.UserID'
      
        'WHERE        (Acc.DocReference.Serial IS NULL) AND (Acc.DocGroup' +
        's.UserID = @UserID) and (Acc.DocGroups.YearID = @YearId)'
      
        'GROUP BY Acc.DocGroups.YearID, Acc.DocGroups.CompanyCode, Acc.Do' +
        'cGroups.Serial, Acc.DocGroups.SecondaryDocNo, Acc.DocGroups.DocD' +
        'ate, Acc.DocGroups.FirstUser, dbo.MiladiToShamsi(Acc.DocGroups.M' +
        'akeDate)+'#39' '#39'+ltrim(CONVERT(CHAR(10), Acc.DocGroups.MakeDate,108))' +
        ', '
      
        '                         Acc.DocGroups.UserID, Acc.DocGroups.Doc' +
        'DateMiladi, CAST(Acc.DocGroups.DocNote_L1 AS varchar(1000)), CAS' +
        'T(Acc.DocGroups.DocNote_L2 AS varchar(1000)), Operators.name'
      'ORDER BY SecondaryDocNo'
      '')
    Left = 888
    Top = 255
    object qryReferenceReferenceID: TLargeintField
      FieldName = 'ReferenceID'
      ReadOnly = True
    end
    object qryReferenceYearID: TIntegerField
      FieldName = 'YearID'
      ReadOnly = True
    end
    object qryReferenceCompanyCode: TIntegerField
      FieldName = 'CompanyCode'
      ReadOnly = True
    end
    object qryReferenceSerial: TIntegerField
      DisplayLabel = #1587#1585#1740#1575#1604' '#1587#1606#1583
      FieldName = 'Serial'
      ReadOnly = True
    end
    object qryReferenceSecondaryDocNo: TIntegerField
      DisplayLabel = #1588#1605#1575#1585#1607' '#1605#1608#1602#1578
      FieldName = 'SecondaryDocNo'
      ReadOnly = True
    end
    object qryReferenceDocDate: TStringField
      DisplayLabel = #1578#1575#1585#1740#1582' '#1587#1606#1583
      FieldName = 'DocDate'
      ReadOnly = True
      FixedChar = True
      Size = 10
    end
    object qryReferenceAmount: TBCDField
      DisplayLabel = #1605#1576#1604#1594
      FieldName = 'Amount'
      ReadOnly = True
      Precision = 19
    end
    object qryReferenceFirstUser: TStringField
      DisplayLabel = #1705#1575#1585#1576#1585' '#1579#1576#1578' '#1705#1606#1606#1583#1607
      FieldName = 'FirstUser'
      ReadOnly = True
      Size = 50
    end
    object qryReferenceCountPage: TIntegerField
      DisplayLabel = #1578#1593#1583#1575#1583' '#1576#1585#1711#1607
      FieldName = 'CountPage'
      ReadOnly = True
    end
    object qryReferenceNote_L1: TStringField
      DisplayLabel = #1578#1608#1590#1740#1581#1575#1578
      FieldName = 'Note_L1'
      ReadOnly = True
      Size = 5000
    end
    object qryReferenceNote_L2: TStringField
      FieldName = 'Note_L2'
      ReadOnly = True
      Size = 5000
    end
    object qryReferenceInsertDateTime: TStringField
      DisplayLabel = #1586#1605#1575#1606' '#1575#1585#1580#1575#1593
      FieldName = 'InsertDateTime'
      ReadOnly = True
      Size = 51
    end
    object qryReferenceAidNumber: TStringField
      FieldName = 'AidNumber'
      ReadOnly = True
      Size = 40
    end
    object qryReferenceAidDate: TStringField
      FieldName = 'AidDate'
      ReadOnly = True
      Size = 10
    end
    object qryReferenceInsertUserID: TIntegerField
      FieldName = 'InsertUserID'
      ReadOnly = True
    end
    object qryReferenceReceiverUserID: TIntegerField
      FieldName = 'ReceiverUserID'
      ReadOnly = True
    end
    object qryReferencename: TStringField
      DisplayLabel = #1711#1740#1585#1606#1583#1607
      FieldName = 'name'
      ReadOnly = True
      Size = 50
    end
    object qryReferencePermitUserID: TIntegerField
      FieldName = 'PermitUserID'
      ReadOnly = True
    end
    object qryReferenceReceiverDateTime: TStringField
      DisplayLabel = #1586#1605#1575#1606' '#1583#1585#1740#1575#1601#1578
      FieldName = 'ReceiverDateTime'
      ReadOnly = True
      Size = 51
    end
    object qryReferenceComputerName: TStringField
      FieldName = 'ComputerName'
      ReadOnly = True
      Size = 50
    end
  end
  object qryHistory: TADOQuery
    Connection = Dmf.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'Serial'
        DataType = ftWideString
        Size = 2
        Value = '30'
      end
      item
        Name = 'YearId'
        DataType = ftWideString
        Size = 2
        Value = '94'
      end
      item
        Name = 'CompanyCode'
        DataType = ftWideString
        Size = 1
        Value = '1'
      end
      item
        Name = 'Serial2'
        DataType = ftWideString
        Size = 2
        Value = '30'
      end
      item
        Name = 'YearId2'
        DataType = ftWideString
        Size = 2
        Value = '94'
      end
      item
        Name = 'CompanyCode2'
        DataType = ftWideString
        Size = 1
        Value = '1'
      end>
    SQL.Strings = (
      
        'select dbo.MiladiToShamsi(dr.InsertDateTime)+'#39' '#39'+LTRIM(CONVERT(c' +
        'har(8), dr.InsertDateTime,108)) AS InsertDateTime, op.name, Note' +
        '_L1, Note_L2'
      
        'from Acc.DocReference dr left outer join FaraSystems.dbo.Operato' +
        'rs as op'
      'on dr.ReceiverUserID = op.UserID'
      
        'where (Serial = :Serial) and (YearID = :YearId) and (CompanyCode' +
        ' = :CompanyCode)'
      'union all'
      
        'select dbo.MiladiToShamsi(MakeDate)+'#39' '#39'+LTRIM(CONVERT(CHAR(10), M' +
        'akeDate,108)) AS MakeDate, FirstUser, cast(DocNote_L1 as varchar' +
        '(4000)) DocNote_L1, cast(DocNote_L2 as varchar(4000)) DocNote_L2'
      'from Acc.DocGroups'
      
        'where (Serial = :Serial2) and (YearID = :YearId2) and (CompanyCo' +
        'de = :CompanyCode2)'
      'order by InsertDateTime')
    Left = 80
    Top = 263
    object qryHistoryInsertDateTime: TStringField
      DisplayLabel = #1578#1575#1585#1740#1582' '#1608' '#1587#1575#1593#1578
      FieldName = 'InsertDateTime'
      ReadOnly = True
      Size = 19
    end
    object qryHistoryname: TStringField
      DisplayLabel = #1711#1740#1585#1606#1583#1607
      FieldName = 'name'
      ReadOnly = True
      Size = 50
    end
    object qryHistoryNote_L1: TStringField
      DisplayLabel = #1578#1608#1590#1740#1581#1575#1578
      FieldName = 'Note_L1'
      ReadOnly = True
      Size = 5000
    end
    object qryHistoryNote_L2: TStringField
      FieldName = 'Note_L2'
      ReadOnly = True
      Size = 5000
    end
  end
  object srcReference: TDataSource
    DataSet = qryReference
    Left = 800
    Top = 255
  end
  object srcHistory: TDataSource
    DataSet = qryHistory
    Left = 80
    Top = 327
  end
end
