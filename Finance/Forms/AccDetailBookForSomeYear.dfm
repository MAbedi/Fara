        Value = 1002
      end>
    SQL.Strings = (
      
        'SELECT    Fitful.FitfulID AS calcuBalance , AccDetailBookForSome' +
        'Year.*'
      
        'FROM         acc.AccDetailBookForSomeYear(:CompanyCode, :TopicCo' +
        'de,:DetailCode) AccDetailBookForSomeYear CROSS JOIN Fitful'
      ''
      '')
