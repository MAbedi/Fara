        '                      Acc.BudgetTopicLevels AS BudgetTopicLevels' +
        '_1 ON Acc.BudgetTopicLevels.prvLevelID = BudgetTopicLevels_1.Lev' +
        'elID'
      'WHERE     (acc.BudgetTopicLevels.LevelID =:IdLev )')
