        'LevelCaption_L1, Acc.BudgetTopicLevels.LevelCaption_L2, '
      
        '                      Acc.BudgetTopicLevels.prvLevelID, Acc.Budg' +
        'etTopicLevels.CodeLength, Acc.BudgetTopicLevels.EssenseSelectabl' +
        'e, '
      
        '                      Acc.BudgetTopicLevels.AccRelationType, Acc' +
        '.BudgetTopicLevels.TopicType, Acc.BudgetTopicLevels.AssignedForm' +
        ', '
      
        '                      Acc.BudgetTopicLevels.ReportFileName, Acc.' +
        'BudgetTopicLevels.NextYearSelectType, Acc.BudgetTopicLevels.Grou' +
        'pOnTopicsVisible, '
      
        '                      Acc.BudgetTopicLevels.SelectPercentType, A' +
        'cc.BudgetTopicLevels.HasRelateOnProjects, BudgetTopicLevels_1.Co' +
        'deLength AS PrvCodeLength'
