    SQL.Strings = (
      
        'SELECT   LEFT(rpt.TopicCode, 1) AS GroupCode,G.MoeenName_L1 Grou' +
        'pName, LEFT(rpt.TopicCode, 2) AS kolCode,k.MoeenName_L1 AS kolNa' +
        'me,c.MoeenName_L1,  rpt.*'
      'FROM         acc.rptBalaceDetaillWithSomeColumn'
      '(:DetailCodeFrom,:DetailCodeto,:AccCodeFrom,:AccCodeTo,'
      ':DocTypeCode1_Not, :DocTypeCode2_Not, :DocTypeCode3_Not,'
      
        ':DocTypeCodeFrom, :DocTypeCodeTo, :SecondaryDocNoFrom, :Secondar' +
        'yDocNoTo, :DocDateFrom,'
      
        ':DocDateTo, :PrimaryDocNoFrom, :PrimaryDocNoTo, :CompanyCodeFrom' +
        ', :CompanyCodeTo,:Status1,:Status2,:FromYearId,:ToYearID,'
      #9#9#9#9#9#9
      
        #9#9#9'            :CurrencyTypeFrom , :CurrencyTypeTo  , :CurrencyK' +
        'ind )'
      'rpt'
      'join Acc.CategoriesForUse C on c.TopicCode = rpt.TopicCode'
      
        'join Acc.CategoriesForUse K on K.TopicCode = LEFT(rpt.TopicCode,' +
        ' 2)'
      
        'join Acc.CategoriesForUse G on G.TopicCode = LEFT(rpt.TopicCode,' +
        ' 1)'
      '')
    Left = 88
    Top = 117
