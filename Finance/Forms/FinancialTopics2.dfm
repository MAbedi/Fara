  object qryInit: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'FormType'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 9
      end>
    SQL.Strings = (
      
        'SELECT     acc.AccTopicLevels.*, ISNULL(AccTopicLevels_1.LevelCa' +
        'ption_L1, '#39'0'#39') AS PrvLevelCaption_L1, ISNULL(AccTopicLevels_1.Co' +
        'deLength, 0)'
      '                      AS PrvCodeLength'
      'FROM         acc.AccTopicLevels LEFT OUTER JOIN'
      
        '                      acc.AccTopicLevels AccTopicLevels_1 ON acc' +
        '.AccTopicLevels.PrvLevelID = AccTopicLevels_1.LevelID'
      
        'WHERE     (acc.AccTopicLevels.TopicType = 3) AND (acc.AccTopicLe' +
        'vels.LevelID = :FormType)')
    Left = 504
    Top = 8
    object qryInitLevelID: TIntegerField
      FieldName = 'LevelID'
    end
