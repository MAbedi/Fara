  object qry_Documents: TADOQuery
    Tag = 15
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'LenCodeKol'
        DataType = ftString
        Size = 1
        Value = '2'
