  object qry_DocGroups: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'YearID2'
        DataType = ftWideString
        Size = 2
        Value = '95'
      end
      item
        Name = 'CompanyCodeFrom2'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyCodeTO2'
        DataType = ftWideString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'CompanyCodeFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CompanyCodeTO'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 2147483647
      end
      item
        Name = 'SecondaryDocNoFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'SecondaryDocNoTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 9999
      end
      item
        Name = 'PrimaryDocNoFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'PrimaryDocNoTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 9999
      end
      item
        Name = 'DocDateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '0'
      end
      item
        Name = 'DocDateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 95
      end
      item
        Name = 'UserID'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      
        'SELECT        Acc.DocGroups.YearID, Acc.DocGroups.CompanyCode, A' +
        'cc.DocGroups.Serial, Acc.DocGroups.SecondaryDocNo, Acc.DocGroups' +
        '.PrimaryDocNo, '
      
        #9#9#9'  Acc.DocGroups.DocDate, Acc.DocGroups.DocTopic_L1, Acc.DocGr' +
        'oups.DocTopic_L2, Acc.DocGroups.Status, ISNULL(fun.sumBed, 0) AS' +
        ' Debt,'
      
        #9#9#9'  Acc.DocGroups.DocTypeCode, Acc.DocTypes.DocTypeName_L1, Acc' +
        '.Companies.CompanyName_L1 as CompanyName, Acc.DocTypes.DocTypeNa' +
        'me_L2, '
      
        #9#9#9'  Acc.Companies.CompanyName_L2, Acc.DocGroups.FirstUser, Acc.' +
        'DocGroups.SecondUser, '
      
        '              CASE WHEN SourceDataBase LIKE '#39'%Forms%'#39' THEN '#39#1582#1586#1575#1606 +
        #1607' '#1583#1575#1585#1740#39' '
      
        #9#9#9#9'   WHEN SourceDataBase LIKE '#39'%DocExports%'#39' THEN '#39#1583#1575#1585#1575#1574#1740' '#1579#1575#1576#1578 +
        #39' '
      #9#9#9#9'   WHEN SourceDataBase LIKE '#39'%Recipts%'#39' THEN '#39#1582#1585#1740#1583#1608#1601#1585#1608#1588#39' '
      #9#9#9#9'   WHEN SourceDataBase LIKE '#39'%FixedCalculated%'#39' OR'
      
        '                        SourceDataBase LIKE '#39'%Mission%'#39' THEN '#39#1581#1602 +
        #1608#1602' '#1583#1587#1578#1605#1586#1583#39' '
      
        #9#9#9#9'   ELSE '#39#1581#1587#1575#1576#1583#1575#1585#1740#39' END AS SourceDataBase, Acc.DocGroups.Seri' +
        'al AS row, fun.sumBed, ISNULL(fun.Mandeh, 0) AS Mandeh'
      
        #9#9#9#9'   ,Fitful.DetailCode AS Appendix ,Acc.DocGroups.DocNote_L1 ' +
        '+'#39' '#39' +Acc.DocGroups.DocNote_L2 AS DocNote_L1'
      ''
      'FROM            Acc.Companies LEFT OUTER JOIN'
      
        '                Acc.DocGroups ON Acc.Companies.CompanyCode = Acc' +
        '.DocGroups.CompanyCode LEFT OUTER JOIN'
      
        '                Acc.DocTypes ON Acc.DocGroups.DocTypeCode = Acc.' +
        'DocTypes.DocTypeCode LEFT OUTER JOIN'
      
        '                (SELECT        SUM(Debt) AS sumBed, Serial, Comp' +
        'anyCode, YearID, SUM(Debt - Credit) AS Mandeh'
      '                 FROM            Acc.Documents'
      
        '                 WHERE        (YearID = :YearID2 ) AND (CompanyC' +
        'ode BETWEEN :CompanyCodeFrom2 AND :CompanyCodeTO2 )'
      '                 GROUP BY Serial, CompanyCode, YearID) AS fun '
      
        #9#9#9#9' ON fun.Serial = Acc.DocGroups.Serial AND fun.CompanyCode = ' +
        'Acc.DocGroups.CompanyCode AND fun.YearID = Acc.DocGroups.YearID'
      #9#9#9#9' cross join Fitful'
      ''
      
        'WHERE'#9#9'(Acc.DocGroups.CompanyCode BETWEEN :CompanyCodeFrom AND :' +
        'CompanyCodeTO )AND'
      
        #9#9#9'(Acc.DocGroups.SecondaryDocNo BETWEEN :SecondaryDocNoFrom AND' +
        ' :SecondaryDocNoTo) AND'
      
        #9#9#9'(Acc.DocGroups.PrimaryDocNo BETWEEN :PrimaryDocNoFrom AND :Pr' +
        'imaryDocNoTo) AND'
      
        #9#9#9'(Acc.DocGroups.DocDate BETWEEN :DocDateFrom AND :DocDateTo) A' +
        'ND'
      #9#9#9'(Acc.DocGroups.Status in (@@T)) AND'
      #9#9#9'( Acc.DocGroups.DocTypeCode in (@@P)) AND'
      #9#9#9'(Acc.DocGroups.YearId = :YearID)'
      '                                            :UserID'
      ''
      
        'ORDER BY Acc.DocGroups.DocDate, Acc.DocTypes.SORtID, Acc.DocGrou' +
        'ps.PrimaryDocNo, Acc.DocGroups.SecondaryDocNo, Acc.DocGroups.Ser' +
        'ial'
      ',Acc.DocGroups.DocNote_L1,Acc.DocGroups.DocNote_L2')
    Left = 120
    Top = 112
