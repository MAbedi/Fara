    SQL.Strings = (
      
        'SELECT     FormID, FormType, FormNumber, FormDate, CustomerID1, ' +
        'CustomerID2, CustomerID3, Amount, FomNote, FormState, FirstUser,' +
        ' LastUser, ModifyDate, ServerID, YearID, SellsEmporium, '
      '                      CostFactorsType, CostFactorsCode'
      'FROM         Forms'
      
