  object qry_Forms: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    AfterInsert = qry_FormsAfterInsert
    AfterEdit = qry_FormsAfterEdit
    BeforePost = qry_FormsBeforePost
