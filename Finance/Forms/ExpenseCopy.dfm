  object qryDocs: TADOQuery
    Tag = 1
    Connection = adcYears
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qryDocsAfterOpen
    BeforeScroll = qryDocsBeforeScroll
    Parameters = <
      item
        Name = 'ExpID'
        DataType = ftWideString
        Size = 1
        Value = '1'
      end
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 95
      end>
    SQL.Strings = (
      'SELECT ExpenseItems .*'
      'FROM         acc.Expense as Expense INNER JOIN'
      
        '                      acc.ExpenseItems as ExpenseItems  ON Expen' +
        'se.ExpID = ExpenseItems.ExpID'
      
        'WHERE        (Expense.ExpID = :ExpID) AND (Expense.YearID = :Yea' +
        'rID)')
    Left = 664
    Top = 217
  end
