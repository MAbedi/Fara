    SQL.Strings = (
      'SELECT    acc.Budgets.*'
      'FROM         acc.Budgets  inner join  acc.Interfaces'
      'ON  acc.Interfaces.InterfaceID=acc.Budgets.InterfaceID'
      'WHERE  (acc.Interfaces.BudgetEffect=:budgeteffect)'
      
        '              and ( acc.Budgets.companyCode between :CompanyFrom' +
        ' and :CompanyTo) and( acc.Budgets.BudgetSerial Between :SerialFr' +
        'om and :SerialTo)'
      
        '              and ( acc.Budgets.BudgetDate between :DateFrom and' +
        ' :DateTo) and ( acc.Budgets.YearID Between :YearFrom and :YearTo' +
        ')'
      
        '              and (acc.Budgets.Status in (Select part From [Acc]' +
        '.[SplitString] (:Status1,'#39','#39')))'
      
        'AND ((:UserAdmin = 1) OR (Acc.Budgets.CompanyCode in(select n_su' +
        'bcompany from farasystems.dbo.operatorcompanies where (userid = ' +
        ':UserID))))')
    Left = 128
    Top = 136
