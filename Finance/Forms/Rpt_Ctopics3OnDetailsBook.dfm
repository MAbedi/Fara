    SQL.Strings = (
      'SELECT   CTopics2OnDetailCode.*'
      ''
      
        'FROM         ACC.CTopics3OnDetailCode(:CompanyCodeFrom,:CompanyC' +
        'odeTo,:AccCode ,:CTopicCode2 ,:DetailCode,'
      
        ' :SecondaryDocNoFrom ,:SecondaryDocNoTo , :PrimaryDocNoFrom ,:Pr' +
        'imaryDocNoTo  ,'
      
        '  :DocDateFrom ,:DocDateTo ,:Status1 , :Status2, :FromYearID, :T' +
        'oYearID , :DocTypeCodeFrom ,'
      ':CurrencyTypeFrom , :CurrencyTypeTo, :CurrencyKind'
      ', '
      '  :CTopicCode2From  ,'
      '  :CTopicCode2To , '
