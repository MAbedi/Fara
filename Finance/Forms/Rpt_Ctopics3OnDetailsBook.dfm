      end
      item
        Name = 'CTopicCode3From'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CTopicCode3To'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 2147483647
      end>
    SQL.Strings = (
      
        'SELECT   ACC.Categories.AidInfoType,KindInsertBudgetCode,ACC.Doc' +
        'Groups.CompanyCode, ACC.Documents.TopicCode, ACC.Documents.Detai' +
        'lCode, ACC.Documents.CTopicCode3,'
      
        '          LTRIM(rTRIM(STR(ACC.Documents.CTopicCode3))) + '#39' - '#39' +' +
        ' LTRIM(RTRIM(STR(ACC.Documents.DetailCode))) + '#39' - '#39' + RTRIM(LTR' +
        'IM(STR(ACC.Documents.TopicCode)))'
      '              AS accCode,'
      
        '          ACC.Categories.MoeenName_l1+ '#39' - '#39' +ACC.Details.Detail' +
        'Name_L1+ '#39' - '#39' +ACC.CenterTopics3.CTopicName3_l1'
      '             AS AccName'
      'FROM      ACC.Documents INNER JOIN'
      
        '          ACC.DocGroups ON ACC.Documents.Serial = ACC.DocGroups.' +
        'Serial INNER JOIN'
      
        '          ACC.CenterTopics3 ON ACC.Documents.CTopicCode3 = ACC.C' +
        'enterTopics3.CTopicCode3 INNER JOIN'
      
        '          ACC.Categories ON ACC.Documents.TopicCode = ACC.Catego' +
        'ries.TopicCode INNER JOIN'
      
        '          ACC.Details ON ACC.Documents.DetailCode = ACC.Details.' +
        'DetailCode  '
      
        'WHERE    (ACC.DocGroups.SecondaryDocNo <= :SecondaryDocNoTo ) AN' +
        'D'
      
        '         (ACC.DocGroups.PrimaryDocNo <= :PrimaryDocNoTo) AND (AC' +
        'C.DocGroups.DocDate <= :DocDateTo )and'
      
        '         (ACC.Documents.TopicCode  BETWEEN :TopicCodeFrom  AND :' +
        'TopicCodeTo ) AND'
      
        '         (ACC.Documents.CTopicCode2  BETWEEN :CTopicCode2From AN' +
        'D :CTopicCode2To ) AND'
      
        '         (ACC.DocGroups.CompanyCode Between :CompanyCodeFrom And' +
        '   :CompanyCodeTO) And'
      
        '         (ACC.Documents.DetailCode Between :DetailCodeFrom  And ' +
        ':DetailCodeTo ) AND'
      
        '         (ACC.Documents.CTopicCode  BETWEEN :CTopicCodeFrom AND ' +
        ':CTopicCodeTo ) AND'
      
        '         (ACC.Documents.CTopicCode3  BETWEEN :CTopicCode3From AN' +
        'D :CTopicCode3To )'
      ''
      
        'GROUP BY  ACC.DocGroups.CompanyCode, ACC.Documents.TopicCode, AC' +
        'C.Documents.CTopicCode3, '
      'ACC.Categories.MoeenName_L1,ACC.Categories.AidInfoType,'
      
        '          ACC.CenterTopics3.CTopicName3_L1, ACC.Documents.Detail' +
        'Code, ACC.Details.DetailName_L1,'
      
        '          LTRIM(RTRIM(STR(ACC.Documents.TopicCode))) + '#39' - '#39' + L' +
        'TRIM(STR(ACC.Documents.DetailCode)) + '#39' - '#39' + LTRIM(STR(ACC.Docu' +
        'ments.CTopicCode3)),'
      '          KindInsertBudgetCode'
      
        'ORDER by ACC.DocGroups.CompanyCode, ACC.Documents.TopicCode, ACC' +
        '.Documents.DetailCode, ACC.Documents.CTopicCode3'
      ''
      '')
    Left = 184
    Top = 109
