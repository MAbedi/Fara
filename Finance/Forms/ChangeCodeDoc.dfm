  object qryCategories: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT      acc.Categories.TopicCode, acc. Categories.MoeenName_' +
        'L1,  acc.Categories.MoeenName_L2,  acc.Categories.AidInfoType, I' +
        'SNULL( acc.FormsInfo.InfoID, 0) AS InfoID , KindInsertBudgetCode'
      'FROM          acc.Categories LEFT OUTER JOIN'
      
        '                       acc.FormsInfo ON  acc.Categories.AidInfoT' +
        'ype =  acc.FormsInfo.FormInfoID LEFT OUTER JOIN'
      
        '                       acc.CategoriesForUse ON  acc.Categories.T' +
        'opicCode =  acc.CategoriesForUse.PrvTopicCode'
      
        'WHERE     ( acc.CategoriesForUse.PrvTopicCode IS NULL) and  acc.' +
        'Categories.LevelID>2'
      'UNION'
      
        'select distinct acc.Documents.TopicCode, Categories.MoeenName_L1' +
        ',  Categories.MoeenName_L2,  Categories.AidInfoType, ISNULL( acc' +
        '.FormsInfo.InfoID, 0) AS InfoID , KindInsertBudgetCode'
      
        ' from acc.Documents inner join Acc.Categories as Categories LEFT' +
        ' OUTER JOIN'
      
        '                       acc.FormsInfo ON  Categories.AidInfoType ' +
        '=  acc.FormsInfo.FormInfoID'
      'on acc.Documents.TopicCode=Categories.TopicCode')
    Left = 25
    Top = 429
  end
