  object qry_AccCode: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qry_AccCodeAfterOpen
    Parameters = <>
    SQL.Strings = (
      
        'SELECT cast(Categories.TopicCode as int ) as TopicCode, Categori' +
        'es.MoeenName_L1'
      ',Categories.MoeenName_L2'
      'FROM Categories LEFT OUTER JOIN'
      
        'CategoriesForUse ON Categories.TopicCode = CategoriesForUse.PrvT' +
        'opicCode'
      'WHERE (CategoriesForUse.PrvTopicCode IS NULL)'
      '')
    Left = 48
    Top = 80
  end
