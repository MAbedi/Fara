  object qryDocument: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qryDocumentAfterOpen
    OnCalcFields = qryDocumentCalcFields
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'CompanyCode'
