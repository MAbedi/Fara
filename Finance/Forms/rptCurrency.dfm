  object qryRptCurrency: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryRptCurrencyAfterOpen
    Parameters = <>
    SQL.Strings = (
      
        'SELECT Acc.Documents.TopicCode AS '#1705#1583#1581#1587#1575#1576', Acc.Categories.MoeenNa' +
        'me_L1 AS ['#1606#1575#1605' '#1581#1587#1575#1576'], SUM(Acc.Documents.Debt) AS Debt,SUM(Acc.Doc' +
        'uments.Credit) AS Credit, FitfulIDC AS Remain, SUM(CASE WHEN (Cu' +
        'rrencyType = 0) AND (Acc.Documents.Debt > 0) THEN Acc.Documents.' +
        'AidAmount ELSE 0 END) AS Debt0 , SUM(CASE WHEN (CurrencyType = 0' +
        ') AND (Acc.Documents.Credit > 0) THEN Acc.Documents.AidAmount EL' +
        'SE 0 END) AS Credit0,  FitfulIDC AS Remain0, SUM(CASE WHEN (Curr' +
        'encyType = 1) AND (Acc.Documents.Debt > 0) THEN Acc.Documents.Ai' +
        'dAmount ELSE 0 END) AS Debt1 , SUM(CASE WHEN (CurrencyType = 1) ' +
        'AND (Acc.Documents.Credit > 0) THEN Acc.Documents.AidAmount ELSE' +
        ' 0 END) AS Credit1,  FitfulIDC AS Remain1, SUM(CASE WHEN (Curren' +
        'cyType = 2) AND (Acc.Documents.Debt > 0) THEN Acc.Documents.AidA' +
        'mount ELSE 0 END) AS Debt2 , SUM(CASE WHEN (CurrencyType = 2) AN' +
        'D (Acc.Documents.Credit > 0) THEN Acc.Documents.AidAmount ELSE 0' +
        ' END) AS Credit2,  FitfulIDC AS Remain2, SUM(CASE WHEN (Currency' +
        'Type = 3) AND '
      
        '(Acc.Documents.Debt > 0) THEN Acc.Documents.AidAmount ELSE 0 END' +
        ') AS Debt3 , SUM(CASE WHEN (CurrencyType = 3) AND (Acc.Documents' +
        '.Credit > 0) THEN Acc.Documents.AidAmount ELSE 0 END) AS Credit3' +
        ',  FitfulIDC AS Remain3'
      'FROM Acc.DocGroups INNER JOIN'
      
        'Acc.Documents ON Acc.DocGroups.Serial = Acc.Documents.Serial AND' +
        ' Acc.DocGroups.YearID = Acc.Documents.YearID AND'
      'Acc.DocGroups.CompanyCode = Acc.Documents.CompanyCode INNER JOIN'
      
        'Acc.Categories ON Acc.Documents.TopicCode = Acc.Categories.Topic' +
        'Code CROSS JOIN dbo.Fitful'
      
        'GROUP BY Acc.Documents.TopicCode, Acc.Categories.MoeenName_L1, F' +
        'itfulIDC')
    Left = 576
    Top = 144
  end
