  object qryPrint: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     acc.Categories.TopicCode, dbo.Categories.MoeenName_L1' +
        ', dbo.Categories.AuditID, dbo.AuditTopics.AuditName_L1'
      ',dbo.Categories.MoeenName_L2, acc.AuditTopics.AuditName_L2'
      'FROM         acc.Categories INNER JOIN'
      
        '                      acc.AuditTopics ON acc.Categories.AuditID ' +
        '= acc.AuditTopics.AuditCode LEFT OUTER JOIN'
      
        '                      acc.CategoriesForUse ON acc.Categories.Top' +
        'icCode = acc.CategoriesForUse.PrvTopicCode'
      'WHERE     (acc.CategoriesForUse.PrvTopicCode IS NULL)'
      'Order  By acc.Categories.AuditID'
      ''
      ' ')
    Left = 737
    Top = 263
    object qryPrintTopicCode: TLargeintField
      FieldName = 'TopicCode'
    end
    object qryPrintMoeenName_L1: TStringField
      FieldName = 'MoeenName_L1'
      Size = 100
    end
    object qryPrintAuditID: TIntegerField
      FieldName = 'AuditID'
    end
    object qryPrintAuditName_L1: TStringField
      FieldName = 'AuditName_L1'
      Size = 150
    end
    object qryPrintMoeenName_L2: TStringField
      FieldName = 'MoeenName_L2'
      Size = 100
    end
    object qryPrintAuditName_L2: TStringField
      FieldName = 'AuditName_L2'
      Size = 150
    end
  end
