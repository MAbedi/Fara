    Parameters = <
      item
        Name = 'FormType'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 9
      end>
    SQL.Strings = (
      'SELECT     *'
      'FROM         acc.AuditTopics'
      'WHERE     (LevelID= :FormType)'
      'Order By  AuditCode')
