  object qryAuditTopics: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    AfterInsert = qryAuditTopicsAfterInsert
    BeforePost = qryAuditTopicsBeforePost
    AfterPost = qryAuditTopicsAfterPost
