    SQL.Strings = (
      ''
      'SELECT    w_Code as accCode,w_Name as accName,'
      
        '          Categories_1.TopicCode as TopicCode1, Categories_3.Top' +
        'icCode AS TopicCode3,'
      
        '          Categories_4.TopicCode AS TopicCode4, Categories_5.Top' +
        'icCode AS TopicCode5,'
      
        '          Categories_6.TopicCode AS TopicCode6, Categories_2.Top' +
        'icCode as TopicCode2,'
      
        '          Categories_1.MoeenName_L1 as MoeenName1,Categories_2.M' +
        'oeenName_L1 AS MoeenName2,'
      '          Categories_3.MoeenName_L1 AS MoeenName3,'
      
        '          Categories_4.MoeenName_L1 AS MoeenName4, Categories_5.' +
        'MoeenName_L1 AS MoeenName5,'
      '          Categories_6.MoeenName_L1 AS MoeenName6,'
      
        '          CenterTopics_1.CTopicCode as CTopicCode1, CenterTopics' +
        '_2.CTopicCode AS CTopicCode2,'
      '          CenterTopics_3.CTopicCode AS CTopicCode3,'
      
        '          CenterTopics_1.CTopicName_L1 AS CTopicName1, CenterTop' +
        'ics_2.CTopicName_L1 as CTopicName2,'
      '          CenterTopics_3.CTopicName_L1 AS CTopicName3,'
      
        '          CenterTopics2_1.CTopicCode2 as CTopicCode2_1, CenterTo' +
        'pics2_2.CTopicCode2 AS CTopicCode2_2,'
      '          CenterTopics2_1.CTopicName2_L1 as CTopicName2_1,'
      
        '          CenterTopics2_2.CTopicName2_L1 AS CTopicName2_2, Compa' +
        'nies_1.CompanyCode as CompanyCode1, Companies_2.CompanyCode AS C' +
        'ompanyCode2,'
      
        '          Companies_3.CompanyCode AS CompanyCode3, Companies_1.C' +
        'ompanyName_L1 as CompanyName1,'
      '           Companies_2.CompanyName_L1 AS CompanyName2,'
      '          Companies_3.CompanyName_L1 AS CompanyName3'
      
        '        ,  Acc.Details.DetailCode ,min(Acc.Details.DetailName_L1' +
        ') as DetailName_L1'
      'FROM      Acc.Categories Categories_2 RIGHT OUTER JOIN'
      '          Acc.Categories Categories_1 RIGHT OUTER JOIN'
      '          Acc.Categories Categories_5 RIGHT OUTER JOIN'
      '          Acc.Categories Categories_4 RIGHT OUTER JOIN'
      '          Acc.Categories Categories_3 RIGHT OUTER JOIN'
      '          Acc.CenterTopics CenterTopics_2 RIGHT OUTER JOIN'
      '          Acc.CenterTopics2 CenterTopics2_2 RIGHT OUTER JOIN'
      '          Acc.CenterTopics2 CenterTopics2_1 RIGHT OUTER JOIN'
      '          Acc.AnalyzeAccBooks'
      
        '(:DocTypeCode1_Not,:DocTypeCode2_Not,:DocTypeCode3_Not,:DocTypeC' +
        'odeFrom,:DocTypeCodeTo,'
      ':CompanyCodeFrom,:CompanyCodeTo,:DetailCodeFrom,:DetailCodeTo,'
      
        ':SecondaryDocNoFrom,:SecondaryDocNoTo,:PrimaryDocNoFrom,:Primary' +
        'DocNoTo,:DocDateFrom,:DocDateTo,'
      
        ':TopicCodeFrom,:TopicCodeTo,:CTopicCodeFrom,:CTopicCodeTo,:CTopi' +
        'cCode2From,:CTopicCode2To,'
      ':LenAcc1,:LenAcc2,:LenAcc3,:LenAcc4,:LenAcc5,:LenAcc6,'
      ':LenCompany1,:LenCompany2,:LenCompany3,'
      ':LenCTopic_1,:LenCTopic_2,:LenCTopic_3,'
      ':LenCTopic2_1,:LenCTopic2_2,:LenDetailCode,'
      
        ':TopicCode1From,:TopicCode1To,:TopicCode2From,:TopicCode2To,:Top' +
        'icCode3From,:TopicCode3To,'
      
        ':TopicCode4From,:TopicCode4To,:TopicCode5From,:TopicCode5To,:Top' +
        'icCode6From,:TopicCode6To,'
      
        ':CompanyCode1From,:CompanyCode1To,:CompanyCode2From,:CompanyCode' +
        '2To,:CompanyCode3From,:CompanyCode3To ,'
      
        ':DetailCode1From,:DetailCode1To,:CTopicCode_1From,:CTopicCode_1T' +
        'o,'
      
        ':CTopicCode_2From,:CTopicCode_2To,:CTopicCode_3From,:CTopicCode_' +
        '3To,'
      
        ':CTopicCode2_1From,:CTopicCode2_1To,:CTopicCode2_2From, :CTopicC' +
        'ode2_2To,:Status1,:Status2,:FromYearId,:ToYearID,'
      
        #9#9#9'           :CurrencyTypeFrom  , :CurrencyTypeTo , :CurrencyKi' +
        'nd  )'
      '                      AnalyzeAccBooks  LEFT OUTER JOIN'
      
        '                      Acc.Details ON AnalyzeAccBooks.DetailCode ' +
        '= Acc.Details.DetailCode  on'
      
        '                      CenterTopics2_1.CTopicCode2 = AnalyzeAccBo' +
        'oks.CTopicCode2_1 LEFT OUTER JOIN'
      
        '                      Acc.Companies Companies_3 ON AnalyzeAccBoo' +
        'ks.CompanyCode3 = Companies_3.CompanyCode LEFT OUTER JOIN'
      
        '                      Acc.Companies Companies_2 ON AnalyzeAccBoo' +
        'ks.CompanyCode2 = Companies_2.CompanyCode LEFT OUTER JOIN'
      
        '                      Acc.Companies Companies_1 ON AnalyzeAccBoo' +
        'ks.CompanyCode1 = Companies_1.CompanyCode ON'
      
        '                      CenterTopics2_2.CTopicCode2 = AnalyzeAccBo' +
        'oks.CTopicCode2_2 LEFT OUTER JOIN'
      
        '                      Acc.CenterTopics CenterTopics_3 ON Analyze' +
        'AccBooks.CTopicCode3 = CenterTopics_3.CTopicCode ON'
      
        '                      CenterTopics_2.CTopicCode = AnalyzeAccBook' +
        's.CTopicCode2 LEFT OUTER JOIN'
      
        '                      Acc.CenterTopics CenterTopics_1 ON Analyze' +
        'AccBooks.CTopicCode1 = CenterTopics_1.CTopicCode ON'
      
        '                      Categories_3.TopicCode = AnalyzeAccBooks.T' +
        'opicCode3 ON Categories_4.TopicCode = AnalyzeAccBooks.TopicCode4' +
        ' ON'
      
        '                      Categories_5.TopicCode = AnalyzeAccBooks.T' +
        'opicCode5 LEFT OUTER JOIN'
      
        '                      Acc.Categories Categories_6 ON AnalyzeAccB' +
        'ooks.TopicCode6 = Categories_6.TopicCode ON'
      
        '                      Categories_1.TopicCode = AnalyzeAccBooks.T' +
        'opicCode1 ON Categories_2.TopicCode = AnalyzeAccBooks.TopicCode2'
      '                       CROSS JOIN acc.Config'
      
        'WHERE  (( :UserAdmin = 1 ) OR ( UserIDFilter=0) OR( Categories_1' +
        '.LevelID<>3) OR (((CHARINDEX('#39','#39'+ltrim(:UserID)+'#39','#39', '#39','#39' + Categ' +
        'ories_1.UserRelated + '#39','#39') <> 0) ) ))'
      ''
      
        'GROUP BY Categories_1.TopicCode, Categories_3.TopicCode, Categor' +
        'ies_4.TopicCode, Categories_5.TopicCode, Categories_6.TopicCode,'
      
        '         Categories_2.TopicCode, Categories_1.MoeenName_L1, Cate' +
        'gories_2.MoeenName_L1, Categories_3.MoeenName_L1, Categories_4.M' +
        'oeenName_L1,'
      
        '                      Categories_5.MoeenName_L1, Categories_6.Mo' +
        'eenName_L1, CenterTopics_1.CTopicCode, CenterTopics_2.CTopicCode' +
        ', CenterTopics_3.CTopicCode, '
      
        '                      CenterTopics_1.CTopicName_L1, CenterTopics' +
        '_2.CTopicName_L1, CenterTopics_3.CTopicName_L1, CenterTopics2_1.' +
        'CTopicCode2, '
      
        '                      CenterTopics2_2.CTopicCode2, CenterTopics2' +
        '_1.CTopicName2_L1, CenterTopics2_2.CTopicName2_L1, Companies_1.C' +
        'ompanyCode,'
      
        '                      Companies_2.CompanyCode, Companies_3.Compa' +
        'nyCode, Companies_1.CompanyName_L1, Companies_2.CompanyName_L1, '
      
        '                      Companies_3.CompanyName_L1        ,  Acc.D' +
        'etails.DetailCode'
      ''
      '')
    Left = 456
    Top = 5
