    SQL.Strings = (
      'SELECT    w_accCode as accCode,w_accName as accName'
      
        'FROM      Acc.Categories Categories_2 RIGHT OUTER JOIN Acc.Categ' +
        'ories Categories_1 RIGHT OUTER JOIN'
      
        '          Acc.Categories Categories_5 RIGHT OUTER JOIN Acc.Categ' +
        'ories Categories_4 RIGHT OUTER JOIN'
      
        '          Acc.Categories Categories_3 RIGHT OUTER JOIN Acc.Cente' +
        'rTopics CenterTopics_2 RIGHT OUTER JOIN'
      
        '          Acc.CenterTopics2 CenterTopics2_2 RIGHT OUTER JOIN Acc' +
        '.CenterTopics2 CenterTopics2_1 RIGHT OUTER JOIN'
      '          Acc.AnalyzeAccBooks'
      ''
      '          (DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,'
      '          DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,'
      '          DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,'
      '          DEFAULT,DEFAULT,DEFAULT,DEFAULT,'
      '          :LenAcc1,:LenAcc2,:LenAcc3,:LenAcc4,:LenAcc5,:LenAcc6,'
      '          :LenCompany1,:LenCompany2,:LenCompany3,'
      '          :LenCTopic_1,:LenCTopic_2,:LenCTopic_3,'
      '          :LenCTopic2_1,:LenCTopic2_2 ,:LenDetailCode,'
      '          DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,'
      '          DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,'
      '          DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,'
      
        '          DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAUL' +
        'T,DEFAULT,'
      
        '          DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,DEFAULT,:FromY' +
        'earID,:ToYearID )'
      ''
      '          AnalyzeAccBooks  LEFT OUTER JOIN'
      
        '          Acc.Details ON AnalyzeAccBooks.DetailCode = Acc.Detail' +
        's.DetailCode  on'
      
        '          CenterTopics2_1.CTopicCode2 = AnalyzeAccBooks.CTopicCo' +
        'de2_1 LEFT OUTER JOIN'
      
        '          Acc.Companies Companies_3 ON AnalyzeAccBooks.CompanyCo' +
        'de3 = Companies_3.CompanyCode LEFT OUTER JOIN'
      
        '          Acc.Companies Companies_2 ON AnalyzeAccBooks.CompanyCo' +
        'de2 = Companies_2.CompanyCode LEFT OUTER JOIN'
      
        '          Acc.Companies Companies_1 ON AnalyzeAccBooks.CompanyCo' +
        'de1 = Companies_1.CompanyCode ON'
      
        '          CenterTopics2_2.CTopicCode2 = AnalyzeAccBooks.CTopicCo' +
        'de2_2 LEFT OUTER JOIN'
      
        '          Acc.CenterTopics CenterTopics_3 ON AnalyzeAccBooks.CTo' +
        'picCode3 = CenterTopics_3.CTopicCode ON'
      
        '          CenterTopics_2.CTopicCode = AnalyzeAccBooks.CTopicCode' +
        '2 LEFT OUTER JOIN'
      
        '          Acc.CenterTopics CenterTopics_1 ON AnalyzeAccBooks.CTo' +
        'picCode1 = CenterTopics_1.CTopicCode ON'
      
        '          Categories_3.TopicCode = AnalyzeAccBooks.TopicCode3 ON' +
        ' Categories_4.TopicCode = AnalyzeAccBooks.TopicCode4 ON'
      
        '          Categories_5.TopicCode = AnalyzeAccBooks.TopicCode5 LE' +
        'FT OUTER JOIN'
      
        '          Acc.Categories Categories_6 ON AnalyzeAccBooks.TopicCo' +
        'de6 = Categories_6.TopicCode ON'
      
        '          Categories_1.TopicCode = AnalyzeAccBooks.TopicCode1 ON' +
        ' Categories_2.TopicCode = AnalyzeAccBooks.TopicCode2'
      ''
      
        'GROUP BY  Categories_1.TopicCode, Categories_3.TopicCode, Catego' +
        'ries_4.TopicCode, Categories_5.TopicCode, Categories_6.TopicCode' +
        ','
      
        '          Categories_2.TopicCode, Categories_1.MoeenName_L1, Cat' +
        'egories_2.MoeenName_L1, Categories_3.MoeenName_L1, Categories_4.' +
        'MoeenName_L1,'
      
        '          Categories_5.MoeenName_L1, Categories_6.MoeenName_L1, ' +
        'CenterTopics_1.CTopicCode, CenterTopics_2.CTopicCode, CenterTopi' +
        'cs_3.CTopicCode,'
      
        '          CenterTopics_1.CTopicName_L1, CenterTopics_2.CTopicNam' +
        'e_L1, CenterTopics_3.CTopicName_L1, CenterTopics2_1.CTopicCode2,'
      
        '          CenterTopics2_2.CTopicCode2, CenterTopics2_1.CTopicNam' +
        'e2_L1, CenterTopics2_2.CTopicName2_L1, Companies_1.CompanyCode,'
      
        '          Companies_2.CompanyCode, Companies_3.CompanyCode, Comp' +
        'anies_1.CompanyName_L1, Companies_2.CompanyName_L1,'
      '          Companies_3.CompanyName_L1 ,  Acc.Details.DetailCode'
      '')
    Left = 216
    Top = 137
  end
