    SQL.Strings = (
      'SELECT   *'
      'FROM  Acc.AnalyzeAccBooks('
      '      :DocTypeCode1_Not,:DocTypeCode2_Not,:DocTypeCode3_Not,'
      '      :DocTypeCodeFrom,:DocTypeCodeTo,'
      '      :CompanyCodeFrom,:CompanyCodeTo,'
      '      :DetailCodeFrom,:DetailCodeTo,'
      '      :SecondaryDocNoFrom,:SecondaryDocNoTo,'
      '      :PrimaryDocNoFrom,:PrimaryDocNoTo,'
      '      :DocDateFrom,:DocDateTo,'
      '      :TopicCodeFrom,:TopicCodeTo,'
      '      :CTopicCodeFrom,:CTopicCodeTo,'
      '      :CTopicCode2From,:CTopicCode2To,'
      '      :LenAcc1,:LenAcc2,:LenAcc3,:LenAcc4,:LenAcc5,:LenAcc6,'
      '      :LenCompany1,:LenCompany2,:LenCompany3,'
      '      :LenCTopic_1,:LenCTopic_2, :LenCTopic_3,'
      '      :LenCTopic2_1,:LenCTopic2_2,:LenDetailCode,'
      '      :TopicCode1From,:TopicCode1To,'
      #9#9#9':TopicCode2From,:TopicCode2To ,'
      #9#9#9':TopicCode3From,:TopicCode3To,'
      '      :TopicCode4From,:TopicCode4To,'
      #9#9#9':TopicCode5From,:TopicCode5To,'
      #9#9#9':TopicCode6From,:TopicCode6To,'
      '      :CompanyCode1From,:CompanyCode1To ,'
      '      :CompanyCode2From,:CompanyCode2To ,'
      #9#9#9':CompanyCode3From,:CompanyCode3To ,'
      '      :DetailCode1From,:DetailCode1To,'
      #9#9#9':CTopicCode_1From,:CTopicCode_1To,'
      #9#9#9':CTopicCode_2From,:CTopicCode_2To ,'
      #9#9#9':CTopicCode_3From,:CTopicCode_3To ,'
      #9#9#9':CTopicCode2_1From,:CTopicCode2_1To ,'
      #9#9#9':CTopicCode2_2From, :CTopicCode2_2To'
      '      ,:Status1,:Status2,:FromYearId,:ToYearId ,'
      ':CurrencyTypeFrom , :CurrencyTypeTo, :CurrencyKind  '
      '      )'
      '      AAB'
      ''
      'Order by  DocDate , PrimaryDocNo ,SecondaryDocNo '
      ''
      ''
      ''
      ''
      '')
    Left = 696
    Top = 121
