  object qryBudgect: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'TopicCodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end
      item
        Name = 'TopicCodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'DateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'YearId'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'SELECT Acc.Categories.TopicCode, Acc.Categories.MoeenName_L1, '
      
        #9'ABS(SUM(CASE WHEN Acc.DocGroups.CompanyCode = 99 THEN Acc.Docum' +
        'ents.Debt - Acc.Documents.Credit ELSE 0 END)) AS BudgetBalance,'
      
        #9'ABS(SUM(CASE WHEN Acc.DocGroups.CompanyCode <> 99 THEN Acc.Docu' +
        'ments.Debt - Acc.Documents.Credit ELSE 0 END)) AS AccBalance, '
      
        '                ABS(SUM(CASE WHEN Acc.DocGroups.CompanyCode = 99' +
        ' THEN Acc.Documents.Debt - Acc.Documents.Credit ELSE 0 END)) - '
      
        #9'ABS(SUM(CASE WHEN Acc.DocGroups.CompanyCode <> 99 THEN Acc.Docu' +
        'ments.Debt - Acc.Documents.Credit ELSE 0 END)) AS Remain'
      'FROM Acc.DocGroups INNER JOIN'
      
        '              Acc.Documents ON Acc.DocGroups.Serial = Acc.Docume' +
        'nts.Serial AND Acc.DocGroups.CompanyCode = Acc.Documents.Company' +
        'Code AND '
      
        '              Acc.DocGroups.YearID = Acc.Documents.YearID INNER ' +
        'JOIN'
      
        '              Acc.Categories ON Acc.Documents.TopicCode = Acc.Ca' +
        'tegories.TopicCode '
      
        'WHERE ( Acc.Categories.TopicCode BETWEEN :TopicCodeFrom AND :Top' +
        'icCodeTo ) '
      
        '            AND ( Acc.DocGroups.DocDate BETWEEN :DateFrom AND :D' +
        'ateTo )'
      '            AND ( Acc.DocGroups.YearID = :YearId )'
      'GROUP BY Acc.Categories.TopicCode, Acc.Categories.MoeenName_L1'
      'ORDER BY Acc.Categories.TopicCode;')
    Left = 40
    Top = 77
    object lrgntfldBudgectTopicCode: TLargeintField
      DisplayLabel = #1581#1587#1575#1576' '#1605#1593#1740#1606
      FieldName = 'TopicCode'
    end
    object qryBudgectMoeenName_L1: TStringField
      DisplayLabel = #1593#1606#1608#1575#1606' '#1581#1587#1575#1576
      FieldName = 'MoeenName_L1'
      Size = 100
    end
    object qryBudgectBudgetBalance: TFloatField
      DisplayLabel = #1576#1608#1583#1580#1607' '#1605#1589#1608#1576
      DisplayWidth = 12
      FieldName = 'BudgetBalance'
      currency = True
    end
    object qryBudgectAccBalance: TFloatField
      DisplayLabel = #1593#1605#1604#1603#1585#1583
      DisplayWidth = 12
      FieldName = 'AccBalance'
      currency = True
    end
    object bcdfldBudgectRemain: TBCDField
      DisplayLabel = #1576#1575#1602#1740#1605#1575#1606#1583#1607
      FieldName = 'Remain'
      ReadOnly = True
      Precision = 19
    end
  end
