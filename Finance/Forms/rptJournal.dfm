    SQL.Strings = (
      
        'SELECT      Serial, SecondaryDocNo, PrimaryDocNo, DocDate, DocTo' +
        'pic_L1'
      ',AccCode, KolName_L1'
      
        ', TopicCode, MoeenName_L1, DetailCode, DetailName_L1, CTopicCode' +
        ', CTopicName_L1, '
      
        '                         CTopicCode2, CTopicName2_L1,  ctopiccod' +
        'e3, CTopicName3_L1, Comment_L1, BudgetID, ProjectID, '
      
        '                   CAST(AidDocNo AS float) AS AidDocNo      , Ai' +
        'dAmount, AidDocdate, Debt, Credit'
      ',ArzDebt,ArzCredit ,CurrencyType , CurrenciesName,ID'
      ''
      
        'FROM Acc.Rptjournal(:LenAccCode ,  :DocTypeCodes , :CompanyCodeF' +
        'rom, :CompanyCodeTo , :SecondaryDocNoFrom, :SecondaryDocNoTo , :' +
        'PrimaryDocNoFrom, :PrimaryDocNoTo, :DocDateFrom , :DocDateTo,'
      
        '                 '#9#9':TopicCodeFrom , :TopicCodeTo , :DetailCodeFr' +
        'om, :DetailCodeTo, :CTopicCodeFrom, :CTopicCodeTo, :CTopicCode2F' +
        'rom, :CTopicCode2To,'
      
        '                                                :CTopicCode3From' +
        ', :CTopicCode3To, :DocStatus, :YearIDFrom , :YearIDTo ) AS Rptjo' +
        'urnal_1'
      ''
      'ORDER BY DocDate, SecondaryDocNo, PrimaryDocNo'
      ''
      ''
      '')
    Left = 312
    Top = 133
