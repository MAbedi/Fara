  object qry1: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <>
    SQL.Strings = (
      'SELECT        Serial, CAST(AidDocNo AS float) AS AidDocNo'
      'FROM            Acc.Documents'
      'ORDER BY AidDocNo'
      '')
    Left = 568
    Top = 213
    object qry1AidDocNo: TFloatField
      FieldName = 'AidDocNo'
      ReadOnly = True
    end
  end
