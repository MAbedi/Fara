  object qry_Init: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'Type'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     Acc.AccTopicLevels.LevelID, Acc.AccTopicLevels.LevelC' +
        'aption_L1, Acc.AccTopicLevels.PrvLevelID, Acc.AccTopicLevels.Cod' +
        'eLength, '
      
        '                      ISNULL(AccTopicLevels_1.LevelCaption_L1, '#39 +
        '0'#39') AS PrvLevelCaption_L1, ISNULL(AccTopicLevels_1.CodeLength, 0' +
        ') AS PrvCodeLength,'
      '                      Acc.AccTopicLevels.TopicType'
      'FROM         Acc.AccTopicLevels LEFT OUTER JOIN'
      
        '                      Acc.AccTopicLevels AccTopicLevels_1 ON Acc' +
        '.AccTopicLevels.PrvLevelID = AccTopicLevels_1.LevelID'
      
        'WHERE     (Acc.AccTopicLevels.TopicType = 0) AND (Acc.AccTopicLe' +
        'vels.LevelID =:Type )')
    Left = 608
    Top = 88
    object qry_InitLevelID: TIntegerField
      FieldName = 'LevelID'
    end
    object qry_InitLevelCaption: TStringField
      FieldName = 'LevelCaption_L1'
      Size = 50
    end
    object qry_InitPrvLevelID: TIntegerField
      FieldName = 'PrvLevelID'
    end
    object qry_InitCodeLength: TWordField
      FieldName = 'CodeLength'
    end
    object qry_InitPrvLevelCaption: TStringField
      FieldName = 'PrvLevelCaption_L1'
      ReadOnly = True
      Size = 50
    end
    object qry_InitPrvCodeLength: TWordField
      FieldName = 'PrvCodeLength'
      ReadOnly = True
    end
    object qry_InitTopicType: TWordField
      FieldName = 'TopicType'
    end
  end
  object qry_AccCode: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    AfterScroll = qry_AccCodeAfterScroll
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     AccountCode.AccCode, Acc.Categories.MoeenName_L1, Acc' +
        '.Categories.MoeenName_L2'
      'FROM'
      '    ( SELECT  LEFT(TopicCode, 2) AS AccCode'
      '      FROM     Acc.Documents INNER JOIN'
      
        '               Acc.DocGroups ON Acc.Documents.Serial = Acc.DocGr' +
        'oups.Serial'
      '      WHERE   (Acc.DocGroups.Status >= 1)'
      
        '              AND (Acc.DocGroups.DocDate BETWEEN '#39'0'#39' AND '#39'999999' +
        #39')'
      
        '              AND (Acc.DocGroups.PrimaryDocNo BETWEEN 0 AND 9999' +
        '99)'
      
        '              AND (Acc.DocGroups.SecondaryDocNo BETWEEN 0 AND 99' +
        '9999)'
      '      GROUP BY LEFT(TopicCode, 2)'
      ''
      ')AccountCode   LEFT OUTER JOIN'
      'Acc.Categories ON AccountCode.AccCode = Acc.Categories.TopicCode'
      'Order By   AccountCode.AccCode')
    Left = 128
    Top = 72
    object qry_AccCodeAccCode: TLargeintField
      DisplayLabel = #1603#1583' '#1605#1593#1740#1606
      FieldName = 'AccCode'
    end
    object qry_AccCodeMoeenName: TStringField
      DisplayLabel = #1593#1606#1608#1575#1606' '#1581#1587#1575#1576
      FieldName = 'MoeenName_L1'
      Size = 100
    end
    object qry_AccCodeMoeenName_L2: TStringField
      FieldName = 'MoeenName_L2'
      Size = 100
    end
  end
  object src_AccCode: TDataSource
    DataSet = qry_AccCode
    Left = 48
    Top = 120
  end
