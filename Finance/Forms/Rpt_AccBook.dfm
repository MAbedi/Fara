  object qry_Companies: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    AfterScroll = qry_CompaniesAfterScroll
    Parameters = <
      item
        Name = 'CompanyCodeFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CompanyCodeTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 2147483647
      end>
    SQL.Strings = (
      
        'SELECT DISTINCT Acc.Companies.CompanyCode, Acc.Companies.Company' +
        'Name_L1, Acc.Companies.CompanyName_L2'
      'FROM         Acc.Companies INNER JOIN'
      
        '                      Acc.DocGroups ON Acc.Companies.CompanyCode' +
        ' = Acc.DocGroups.CompanyCode'
      
        'WHERE    Acc.Companies.CompanyCode  between :CompanyCodeFrom and' +
        ' :CompanyCodeTo'
      'order by Acc.Companies.CompanyCode')
    Left = 514
    Top = 139
    object qry_CompaniesCompanyCode: TIntegerField
      DisplayLabel = #1603#1583' '#1588#1585#1603#1578' '
      FieldName = 'CompanyCode'
    end
    object qry_CompaniesCompanyName: TStringField
      DisplayLabel = #1606#1575#1605' '#1588#1585#1603#1578' '
      FieldName = 'CompanyName_L1'
      Size = 150
    end
    object qry_CompaniesCompanyName_L2: TStringField
      FieldName = 'CompanyName_L2'
      Size = 150
    end
  end
  object qry_AccCode: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    BeforeOpen = qry_AccCodeBeforeOpen
    AfterScroll = qry_AccCodeAfterScroll
    Parameters = <
      item
        Name = 'AccCodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = '0'
      end
      item
        Name = 'AccCodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'FormType'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 3
      end
      item
        Name = 'UserAdmin'
        Size = -1
        Value = Null
      end
      item
        Name = 'UserID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT   Acc.Categories.TopicCode  as AccCode, Acc.Categories.Mo' +
        'eenName_L1,    '
      '         Acc.Categories.MoeenName_L2, Acc.Categories.AidInfoType'
      '         ,Acc.Categories.KindInsertBudgetCode'
      '      FROM     Acc.Categories    '#9'  CROSS JOIN acc.Config   '
      
        'WHERE   (Acc.Categories.TopicCode  between  :AccCodeFrom  And  :' +
        'AccCodeTo ) and'
      '        (Acc.Categories.LevelID= :FormType)'
      
        #9#9'AND (( :UserAdmin = 1 ) OR ( UserIDFilter=0) OR( LevelID<>3) O' +
        'R (((CHARINDEX('#39','#39'+ltrim(:UserID)+'#39','#39', '#39','#39' + Acc.Categories.User' +
        'Related + '#39','#39') <> 0) ) ))'
      ''
      
        '        GROUP BY Acc.Categories.TopicCode, Acc.Categories.MoeenN' +
        'ame_L1,'
      '       Acc.Categories.MoeenName_L2,'
      
        '                 Acc.Categories.AidInfoType ,Acc.Categories.Leve' +
        'lID ,Acc.Categories.KindInsertBudgetCode'
      'ORDER BY Acc.Categories.TopicCode')
    Left = 30
    Top = 175
    object qry_AccCodeAccCode: TLargeintField
      DisplayLabel = #1603#1583' '#1605#1593#1740#1606
      FieldName = 'AccCode'
    end
    object qry_AccCodeMoeenName: TStringField
      DisplayLabel = #1593#1606#1608#1575#1606' '#1581#1587#1575#1576
      FieldName = 'MoeenName_L1'
      Size = 100
    end
    object qry_AccCodeAidInfoType: TWordField
      FieldName = 'AidInfoType'
    end
    object qry_AccCodeMoeenName_L2: TStringField
      FieldName = 'MoeenName_L2'
      Size = 100
    end
    object qry_AccCodeKindInsertBudgetCode: TIntegerField
      FieldName = 'KindInsertBudgetCode'
    end
  end
