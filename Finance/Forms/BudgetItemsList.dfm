  object srcDetails: TDataSource
    DataSet = qryItems
    Left = 24
    Top = 232
  end
  object qryItems: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qryItemsAfterOpen
    AfterScroll = qryItemsAfterScroll
    Parameters = <
      item
        Name = 'Cashtype1'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearID1'
        Size = -1
        Value = Null
      end
      item
        Name = 'Cashtype3'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearID3'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'select Fitful.FitfulID as _select, Fitful.FitfulID as tempCredit' +
        ' ,BudgetItems.*,(SUMBujects.SumB-SUMBujects.SumC) as CreditBalan' +
        'ce '
      'from acc.BudgetItems as BudgetItems'
      
        ' inner join (select BI.BudgetTopicID, case when CType=0 then isn' +
        'ull(SUM(BI.Bes*BI.Bed),0) else 0 end as SumB, '
      
        '                    case when CType=1 then isnull(SUM(BI.Bes*BI.' +
        'Bed),0) else 0 end as Sumc  from acc.BudgetItems as BI'
      
        '               inner join acc.Budgets as B on B.BudgetID=BI.Budg' +
        'etID'
      
        '               where BI.CType in(0,1) and BI.Cashtype=:Cashtype1' +
        '  and B.YearID=:YearID1 '
      '               group by BI.BudgetTopicID,CType) as SUMBujects '
      '        on SUMBujects.BudgetTopicID=BudgetItems.BudgetTopicID'
      ' inner join acc.Budgets as Budgets'
      '        on Budgets.BudgetID=BudgetItems.BudgetID'
