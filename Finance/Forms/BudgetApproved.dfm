  object qryCustomers: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'CustomerGrps'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 14
        Value = Null
      end>
    SQL.Strings = (
      'select CustID,CustName  from dbo.Customers '
      
        'where (CustID<>0) and ('#39','#39'+ltrim(CustomerGrpID)+'#39','#39' like :Custom' +
        'erGrps)')
    Left = 440
  end
