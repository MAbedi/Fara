  object qryManifest: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'AccCode'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 23
        Value = Null
      end
      item
        Name = 'AccCode1'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'ReferenceNo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     Acc.DocGroups.YearID, Acc.Documents.CompanyCode, Acc.' +
        'Documents.Serial, Acc.Documents.ID, Fitful.FitfulID, LTRIM(RTRIM' +
        '(STR(Acc.Documents.DetailCode))) '
      
        '                      + '#39' - '#39' + RTRIM(LTRIM(STR(Acc.Documents.To' +
        'picCode))) AS acccode, Acc.Documents.Comment_L1, Acc.Documents.D' +
        'ebt, Acc.Documents.Credit, '
      
        '                      Acc.DocGroups.SecondaryDocNo, Acc.DocGroup' +
        's.PrimaryDocNo, Acc.DocGroups.DocDate, Acc.Documents.AidDocNo, A' +
        'cc.Documents.AidDocdate, '
      
        '                      Acc.Documents.AidAmount, Acc.Documents.Ref' +
        'erenceNo, Acc.Documents.ReferenceDate'
      'FROM         Acc.Documents INNER JOIN'
      
        '                      Acc.DocGroups ON Acc.Documents.Serial = Ac' +
        'c.DocGroups.Serial AND Acc.Documents.YearID = Acc.DocGroups.Year' +
        'ID AND '
      
        '                      Acc.Documents.CompanyCode = Acc.DocGroups.' +
        'CompanyCode INNER JOIN'
      
        '                      Acc.Details ON Acc.Documents.DetailCode = ' +
        'Acc.Details.DetailCode  INNER JOIN'
      
        '                      Acc.Categories ON Acc.Documents.TopicCode ' +
        '= Acc.Categories.TopicCode CROSS JOIN'
      '                      Fitful'
      
        'WHERE     (Acc.Documents.DetailCode <> 0) AND (Acc.DocGroups.Yea' +
        'rID = :YearID ) AND (LTRIM(RTRIM(STR(Acc.Documents.DetailCode)))' +
        ' '
      
        '                      + '#39' - '#39' + RTRIM(LTRIM(STR(Acc.Documents.To' +
        'picCode))) = :AccCode OR :AccCode1 = 1 ) AND ( ISNULL( Acc.Docum' +
        'ents.ReferenceNo,0)  = :ReferenceNo  )')
    Left = 388
    Top = 208
