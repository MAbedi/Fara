  object qry_Doc: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qry_DocAfterOpen
    Parameters = <>
    SQL.Strings = (
      'SELECT   Fitful.FitfulID AS calcuBalance , AccBookForSomeYear.*'
      
