      FieldName = 'CompanyName_L2'
      Size = 150
    end
  end
  object qry_AccCode: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qry_AccCodeAfterScroll
    Parameters = <
      item
        Name = 'AccCodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = '0'
      end
      item
        Name = 'AccCodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'FormType'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 2
      end>
    SQL.Strings = (
      
        'SELECT   acc.Categories.TopicCode  as AccCode, acc.Categories.Mo' +
        'eenName_L1,'
      
        '         acc.Categories.MoeenName_L2, acc.Categories.AidInfoType' +
        ' ,acc.Categories.KindInsertBudgetCode'
      'FROM     acc.Categories '
      
        'GROUP BY acc.Categories.TopicCode, acc.Categories.MoeenName_L1, ' +
        'acc.Categories.MoeenName_L2,'
      
        '         acc.Categories.AidInfoType ,acc.Categories.LevelID ,acc' +
        '.Categories.KindInsertBudgetCode'
      
        'HAVING   (acc.Categories.TopicCode  between  :AccCodeFrom  And  ' +
        ':AccCodeTo ) and'
      '         acc.Categories.LevelID=:FormType'
      'ORDER BY acc.Categories.TopicCode')
    Left = 144
    Top = 77
    object qry_AccCodeAccCode: TLargeintField
      DisplayLabel = #1603#1583' '#1605#1593#1740#1606
      FieldName = 'AccCode'
    end
    object qry_AccCodeMoeenName: TStringField
      DisplayLabel = #1593#1606#1608#1575#1606' '#1581#1587#1575#1576
      FieldName = 'MoeenName_L1'
      Size = 100
    end
    object qry_AccCodeAidInfoType: TWordField
      FieldName = 'AidInfoType'
    end
    object qry_AccCodeMoeenName_L2: TStringField
      FieldName = 'MoeenName_L2'
      Size = 100
    end
    object qry_AccCodeKindInsertBudgetCode: TIntegerField
      FieldName = 'KindInsertBudgetCode'
    end
  end
