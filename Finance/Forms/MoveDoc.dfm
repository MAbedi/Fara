  end
  object qryDocument: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterScroll = qryDocumentAfterScroll
    DataSource = srcDoc
    Parameters = <
      item
        Name = 'Serial'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'CompanyCode'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     TopicCode, DetailCode, CTopicCode, CTopicCode2, Comme' +
        'nt_L1, Credit, Debt'
      'FROM         acc.Documents'
      'WHERE     (acc.Documents.Serial = :Serial)'
      '    AND  ( Acc.Documents.CompanyCode = :CompanyCode )    '
      ' AND  (Acc.Documents.YearID = :YearID)')
    Left = 46
    Top = 363
