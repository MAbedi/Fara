  object qrySerchDoc: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qrySerchDocAfterScroll
    Parameters = <
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'CompanyCode'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     Acc.DocGroups.Serial, Acc.DocGroups.SecondaryDocNo, A' +
        'cc.DocGroups.DocDate, Acc.DocTypes.DocTypeName_L1, '
      
        '                      CAST(Acc.DocGroups.DocNote_L1 AS nvarchar(' +
        '4000)) AS DocNote_L1, MAX(Acc.Documents.Row) AS MaxRow'
      'FROM         Acc.DocGroups INNER JOIN'
      
        '                      Acc.DocTypes ON Acc.DocGroups.DocTypeCode ' +
        '= Acc.DocTypes.DocTypeCode INNER JOIN'
      
        '                      Acc.Documents ON Acc.DocGroups.Serial = Ac' +
        'c.Documents.Serial AND Acc.DocGroups.YearID = Acc.Documents.Year' +
        'ID AND '
      
        '                      Acc.DocGroups.CompanyCode = Acc.Documents.' +
        'CompanyCode'
      
        'WHERE   (acc.DocGroups.YearId= :YearID)  AND  (acc.DocGroups.Sta' +
        'tus in (0,1))'
      ' '
      '    AND  ( Acc.DocGroups.CompanyCode = :CompanyCode )    '
      ''
      
        'GROUP BY Acc.DocGroups.Serial, Acc.DocGroups.SecondaryDocNo, Acc' +
        '.DocGroups.DocDate, Acc.DocTypes.DocTypeName_L1, '
      
        '                      CAST(Acc.DocGroups.DocNote_L1 AS nvarchar(' +
        '4000))'
      '')
    Left = 672
    Top = 248
    object qrySerchDocSecondaryDocNo: TIntegerField
      DisplayLabel = #1588#1605#1575#1585#1607' '#1587#1606#1583
      FieldName = 'SecondaryDocNo'
    end
    object qrySerchDocDocDate: TStringField
      DisplayLabel = #1578#1575#1585#1610#1582' '#1587#1606#1583
      FieldName = 'DocDate'
      FixedChar = True
      Size = 10
    end
    object qrySerchDocDocTypeName_L1: TStringField
      DisplayLabel = #1606#1608#1593' '#1587#1606#1583
      FieldName = 'DocTypeName_L1'
      Size = 150
    end
    object qrySerchDocSerial: TIntegerField
      FieldName = 'Serial'
    end
    object qrySerchDocMaxRow: TIntegerField
      FieldName = 'MaxRow'
    end
    object qrySerchDocDocNote_L1: TWideStringField
      FieldName = 'DocNote_L1'
      ReadOnly = True
      Size = 4000
    end
  end
