  object qry_Remain: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    BeforeOpen = qry_RemainBeforeOpen
    Parameters = <
      item
        Name = 'VarianceCode'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'FromYearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'ToYearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT'#9#9'SUM(CASE WHEN kind = 0 THEN Debt-Credit ELSE 0 END) AS H' +
        'esab, SUM(CASE WHEN kind = 1 THEN Debt-Credit ELSE 0 END) AS Tar' +
        'af'
      
        'FROM            (SELECT        0 AS kind, Acc.Documents.YearID, ' +
        'Acc.Documents.Debt, Acc.Documents.Credit, '
      
        '                                     Acc.VarianceRelations.Varia' +
        'nceCode'
      
        '                           FROM            Acc.Documents INNER J' +
        'OIN'
      
        '                                                    Acc.Variance' +
        'Relations ON Acc.Documents.TopicCode = Acc.VarianceRelations.Top' +
        'icCode AND '
      
        '                                                    Acc.Document' +
        's.DetailCode = Acc.VarianceRelations.DetailCode AND Acc.Document' +
        's.CTopicCode = Acc.VarianceRelations.CTopicCode AND '
      
        '                                                    Acc.Document' +
        's.CTopicCode2 = Acc.VarianceRelations.CTopicCode2 AND '
      
        '                                                    Acc.Document' +
        's.ctopiccode3 = Acc.VarianceRelations.CTopicCode3 LEFT OUTER JOI' +
        'N'
      
        '                                                    Acc.Variance' +
        ' ON Acc.Documents.ID = Acc.Variance.DocumentId'
      '                           UNION ALL'
      
        '                           SELECT        1 AS kind, yearID, Debt' +
        ', Credit, VarianceCode'
      
        '                           FROM            Acc.Variance AS Varia' +
        'nce_1 ) AS Temp'
      
        'WHERE        ( VarianceCode = :VarianceCode ) AND ( YearID BETWE' +
        'EN :FromYearID AND :ToYearID  ) ')
    Left = 751
    Top = 186
  end
