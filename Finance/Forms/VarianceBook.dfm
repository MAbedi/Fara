  object qry_AccCode: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qry_AccCodeAfterScroll
    Parameters = <
      item
        Name = 'VarianceCodeFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'VarianceCodeTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     VarianceCode, VarianceName'
      'FROM         Acc.VarianceDefines'
      
        'WHERE   ( VarianceCode BETWEEN :VarianceCodeFrom  AND :VarianceC' +
        'odeTo )')
    Left = 68
    Top = 8
