  object qry_Doc: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    BeforeOpen = qry_DocBeforeOpen
    AfterOpen = qry_DocAfterOpen
    Parameters = <
      item
        Name = 'CompanyCodeFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'CompanyCodeTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'VarianceCode'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'FromYearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'ToYearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT  DISTINCT   kind, Serial, CompanyCode, YearID, ID, Second' +
        'aryDocNo, PrimaryDocNo, DocDate, Row, TopicCode, MoeenName_L1, D' +
        'etailCode, DetailName_L1, CTopicCode, CTopicName_L1,'
      
        '                         Comment_L1, Debt, Credit, AidDocNo, Aid' +
        'Docdate,ISNULL( DocumentId,0) AS DocumentId, Debt+ Credit AS Sor' +
        't'
      ''
      
        'FROM            (SELECT        0 AS kind, Acc.DocGroups.Serial, ' +
        'Acc.DocGroups.CompanyCode, Acc.DocGroups.YearID, Acc.Documents.I' +
        'D, Acc.DocGroups.SecondaryDocNo, Acc.DocGroups.PrimaryDocNo, Acc' +
        '.DocGroups.DocDate, '
      
        '                                                    Acc.Document' +
        's.Row, Acc.Documents.TopicCode, Acc.Categories.MoeenName_L1, Acc' +
        '.Documents.DetailCode, Acc.Details.DetailName_L1, '
      
        '                                                    Acc.Document' +
        's.CTopicCode, Acc.CenterTopics.CTopicName_L1, Acc.Documents.Comm' +
        'ent_L1, Acc.Documents.Debt, Acc.Documents.Credit, '
      
        '                                                    Acc.Document' +
        's.AidDocNo, Acc.Documents.AidDocdate, Acc.Variance.DocumentId, A' +
        'cc.VarianceRelations.VarianceCode'
      
        '                           FROM            Acc.Documents INNER J' +
        'OIN'
      
        '                                                    Acc.DocGroup' +
        's ON Acc.Documents.Serial = Acc.DocGroups.Serial AND Acc.Documen' +
        'ts.CompanyCode = Acc.DocGroups.CompanyCode AND '
      
        '                                                    Acc.Document' +
        's.YearID = Acc.DocGroups.YearID INNER JOIN'
      
        '                                                    Acc.Categori' +
        'es ON Acc.Documents.TopicCode = Acc.Categories.TopicCode INNER J' +
        'OIN'
      
        '                                                    Acc.Details ' +
        'ON Acc.Documents.DetailCode = Acc.Details.DetailCode INNER JOIN'
      
        '                                                    Acc.CenterTo' +
        'pics ON Acc.Documents.CTopicCode = Acc.CenterTopics.CTopicCode I' +
        'NNER JOIN'
      
        '                                                    Acc.Variance' +
        'Relations ON Acc.Documents.TopicCode = Acc.VarianceRelations.Top' +
        'icCode AND '
      
        '                                                    Acc.Document' +
        's.DetailCode = Acc.VarianceRelations.DetailCode AND Acc.Document' +
        's.CTopicCode = Acc.VarianceRelations.CTopicCode AND '
      
        '                                                    Acc.Document' +
        's.CTopicCode2 = Acc.VarianceRelations.CTopicCode2 AND '
      
        '                                                    Acc.Document' +
        's.ctopiccode3 = Acc.VarianceRelations.CTopicCode3 LEFT OUTER JOI' +
        'N'
      
        '                                                    Acc.Variance' +
        ' ON Acc.Documents.ID = Acc.Variance.DocumentId'
      
        '                               WHERE   (Acc.DocGroups.CompanyCod' +
        'e BETWEEN :CompanyCodeFrom AND :CompanyCodeTo )'
      '                           UNION ALL'
      
        '                           SELECT        1 AS kind, 0, 0, yearID' +
        ', VarianceId, VarianceNo, VarianceNo AS aa, VarianceDate, Row, A' +
        'ccCode1, AccName1, AccCode2, AccName2, AccCode3, AccName3, '
      
        '                                                    Comment, Deb' +
        't, Credit, AidNo, AidDate, DocumentId, VarianceCode'
      
        '                           FROM            Acc.Variance AS Varia' +
        'nce_1 ) AS Temp'
      ''
      
        'WHERE        ( VarianceCode = :VarianceCode ) AND ( YearID BETWE' +
        'EN :FromYearID AND :ToYearID  )  RadioGroup'
      ''
      'ORDER BY  Sort, DocDate'
      '')
    Left = 479
    Top = 290
    object qry_Dockind: TIntegerField
      Tag = 3
      DisplayLabel = #1606#1608#1593' '#1575#1591#1604#1575#1593#1575#1578
      FieldName = 'kind'
      ReadOnly = True
    end
