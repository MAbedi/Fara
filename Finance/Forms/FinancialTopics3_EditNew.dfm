    SQL.Strings = (
      'SELECT  acc.FinancialTopicsForUse.PrvFinancialCode, '
      '         acc.FinancialTopicsForUse.LevelID,'
      '         acc.FinancialTopicsForUse.PrvLevelID,'
      '         acc.FinancialTopicsForUse.PrvCodeLength,'
      
        '         acc.FinancialTopics.FinancialName_L1 AS prvFinancialNam' +
        'e_L1,'
      
        '         acc.FinancialTopics.FinancialName_L2 AS prvFinancialNam' +
        'e_L2'
      '                      '
      'FROM         acc.FinancialTopics INNER JOIN'
      
        '                      acc.FinancialTopicsForUse ON acc.Financial' +
        'Topics.FinancialCode = acc.FinancialTopicsForUse.PrvFinancialCod' +
        'e'
      
