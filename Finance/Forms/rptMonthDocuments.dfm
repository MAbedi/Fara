      item
        Name = 'CompanyTo'
        DataType = ftWideString
        Size = 4
        Value = '9999'
      end
      item
        Name = 'SecondaryDocNoFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'SecondaryDocNoTo'
        Size = -1
        Value = Null
