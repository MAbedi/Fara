        Size = -1
        Value = Null
      end
      item
        Name = 'PrimaryDocNoTo'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT   Fitful.FitfulID AS doc_no , rpt.*, C.MoeenName_L1 AS ko' +
        'lName_L1, C.MoeenName_L2 AS kolName_L2,'
      '         F.InfoName_L1 AS Mount,'
      #9#9' bed AS Sumbed,bes as sumbes  ,Fitful.FitfulID as row ,SortID'
      'FROM     acc.rptMonthDocuments'
      '                 ('
      
        '  :LenAccCode, :MonthFrom,:MonthTo, :DateFrom, :DateTo,:FromYear' +
        'ID,:ToYearID, :CompanyFrom, :CompanyTo'
      
        ', :SecondaryDocNoFrom , :SecondaryDocNoTo ,:PrimaryDocNoFrom ,:P' +
        'rimaryDocNoTo'
      '                 )'
      '                 rpt'
      #9#9#9#9'INNER JOIN'
      '                 acc.FormsInfo F ON rpt.DocNo= F.InfoID'
      #9#9#9#9' LEFT OUTER JOIN'
      '                 acc.Categories C ON rpt.CodeKol = C.TopicCode'
      '                 CROSS JOIN Fitful'
      'WHERE     (F.FormType = 11)'
      'ORDER BY f.SortID ,rpt.docdate, rpt.b, rpt.CodeKol'
      '')
    Left = 456
    Top = 157
