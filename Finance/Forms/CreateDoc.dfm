  object qryPrimary: TADOQuery
    Connection = DmF.adcAccounting
    Parameters = <
      item
        Name = 'Secondary'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     PrimaryDocNo'
      'FROM         DocGroups'
      'WHERE     (SecondaryDocNo >= :Secondary)'
      'GROUP BY PrimaryDocNo'
      'ORDER BY PrimaryDocNo DESC')
