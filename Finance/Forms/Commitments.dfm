    end
  end
  object _qryCost: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'YearId'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'recipttype'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end>
    SQL.Strings = (
      
        'select recipts.reciptnumber, stores.c_storename, customers.custn' +
        'ame,'
      
        ' Ltrim(recipts.yearid) +'#39'_'#39'+ Ltrim(recipts.serverid) +'#39'_'#39'+ Ltrim' +
        '(recipts.reciptid) as KeyID,'
      
        ' stores.c_storename +'#39'__'#39'+ customers.custname + case when ((look' +
        'ups.name is not null) and (lookups.name<>'#39#39'))'
      ' then '#39'__'#39'+ lookups.name else '#39#39' end as Caption'
      
        ' from customers inner join recipts on customers.custid = recipts' +
        '.personid1 inner join stores'
      ' on recipts.storeid = stores.n_storeid left outer join lookups'
      
        'on recipts.secondtype = lookups.lookupid where (recipts.yearid =' +
        ' :YearId)and(recipts.recipttype = :recipttype)')
    Left = 424
    Top = 304
    object _qryCostKeyID: TStringField
      FieldName = 'KeyID'
      ReadOnly = True
      Size = 44
    end
    object _qryCostreciptnumber: TIntegerField
      FieldName = 'reciptnumber'
    end
    object _qryCostCaption: TStringField
      FieldName = 'Caption'
      ReadOnly = True
      Size = 274
    end
  end
  object qryHistory: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'ID'
        DataType = ftWideString
        Size = 4
        Value = '1101'
      end
      item
        Name = 'ID2'
        DataType = ftWideString
        Size = 4
        Value = '1101'
      end
      item
        Name = 'ID3'
        DataType = ftWideString
        Size = 4
        Value = '1101'
      end
      item
        Name = 'ID4'
        DataType = ftWideString
        Size = 4
        Value = '1101'
      end
      item
        Name = 'ID5'
        DataType = ftWideString
        Size = 4
        Value = '1101'
      end>
    SQL.Strings = (
      
        'select id,status,SUM(cash)as Cash,SUM(chashout) as CashOut,SUM(s' +
        'umbed) as SumCash from ('
      
        'select 1 as id,'#39#1575#1593#1578#1576#1575#1585#1740#39' as status,isnull(case Cashtype when 1 t' +
        'hen SUM(bed) end,0) as cash,'
      'isnull(case Cashtype when 2 then SUM(bed) end,0) as chashout,'
      'isnull(case Cashtype when 1 then SUM(bed) end,0)+'
      'isnull(case Cashtype when 2 then SUM(bed) end,0) as sumbed'
      'from acc.BudgetItems'
      'where (BudgetTopicID=:ID)and(Ctype=1)'
      'group by Cashtype'
      ''
      'union all'
      ''
      
        'select 2 as id,'#39#1601#1575#1602#1583' '#1575#1593#1578#1576#1575#1585#39' as status,isnull(case Cashtype when' +
        ' 1 then SUM(bed) end,0) as cash,'
      'isnull(case Cashtype when 2 then SUM(bed) end,0) as chashout,'
      'isnull(case Cashtype when 1 then SUM(bed) end,0)+'
      'isnull(case Cashtype when 2 then SUM(bed) end,0) as sumbed'
      'from acc.BudgetItems'
      'where (BudgetTopicID=:ID2)and(Ctype=2)'
      'group by Cashtype'
      ''
      'union All'
      ''
      
        'select 3 as id,'#39#1576#1585#1585#1587#1740' '#1588#1583#1607#39' as status,isnull(case BI.Cashtype whe' +
        'n 1 then SUM(BI.bed) end,0) as cash,'
      
        'isnull(case BI.Cashtype when 2 then SUM(BI.bed) end,0) as chasho' +
        'ut,'
      'isnull(case BI.Cashtype when 1 then SUM(BI.bed) end,0)+'
      'isnull(case BI.Cashtype when 2 then SUM(BI.bed) end,0) as sumbed'
      'from acc.BudgetItems BI inner join acc.Budgets B'
      'on BI.BudgetID=b.BudgetID'
      'where ((BI.BudgetTopicID=:ID3) and (B.Status=1))'
      'group by Cashtype'
      ''
      'union All'
      ''
      
        'select 4 as id,'#39#1576#1585#1585#1587#1740' '#1606#1588#1583#1607#39' as status,isnull(case BI.Cashtype wh' +
        'en 1 then SUM(BI.bed) end,0) as cash,'
      
        'isnull(case BI.Cashtype when 2 then SUM(BI.bed) end,0) as chasho' +
        'ut,'
      'isnull(case BI.Cashtype when 1 then SUM(BI.bed) end,0)+'
      'isnull(case BI.Cashtype when 2 then SUM(BI.bed) end,0) as sumbed'
      'from acc.BudgetItems BI inner join acc.Budgets B'
      'on BI.BudgetID=b.BudgetID'
      'where ((BI.BudgetTopicID=:ID4) and (B.Status=2))'
      'group by Cashtype'
      ''
      'union All'
      ''
      
        'select 5 as id,'#39#1578#1575#1740#1740#1583' '#1588#1583#1607#39' as status,isnull(case BI.Cashtype whe' +
        'n 1 then SUM(BI.bed) end,0) as cash,'
      
        'isnull(case BI.Cashtype when 2 then SUM(BI.bed) end,0) as chasho' +
        'ut,'
      'isnull(case BI.Cashtype when 1 then SUM(BI.bed) end,0)+'
      'isnull(case BI.Cashtype when 2 then SUM(BI.bed) end,0) as sumbed'
      'from acc.BudgetItems BI inner join acc.Budgets B'
      'on BI.BudgetID=b.BudgetID'
      'where ((BI.BudgetTopicID=:ID5) and (B.Status=3))'
      'group by Cashtype'
      ''
      ') as temp'
      'group by status,id'
      'order by id')
