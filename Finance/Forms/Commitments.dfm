  object _qryCustomers: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'CustomerGrps'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 14
        Value = #39'2,3'#39
      end>
    SQL.Strings = (
      'select CustID,CustName  from dbo.Customers '
      
        'where (CustID<>0) and ('#39','#39'+ltrim(CustomerGrpID)+'#39','#39' like :Custom' +
        'erGrps)')
    Left = 552
    Top = 280
    object _qryCustomersCustID: TIntegerField
      FieldName = 'CustID'
    end
    object _qryCustomersCustName: TStringField
      FieldName = 'CustName'
