  object qry_TrialBalance: TADOQuery
    Connection = Dmf.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qry_TrialBalanceAfterOpen
    AfterScroll = qry_TrialBalanceAfterScroll
    Parameters = <
      item
        Name = 'LenPrvAccCode'
        DataType = ftString
        Size = 1
        Value = '6'
      end
      item
        Name = 'DocTypeCode1_Not'
        DataType = ftString
        Size = 2
        Value = '-1'
      end
      item
        Name = 'DocTypeCode2_Not'
        DataType = ftString
        Size = 2
        Value = '-1'
      end
      item
        Name = 'DocTypeCode3_Not'
        DataType = ftString
        Size = 2
        Value = '-1'
      end
      item
        Name = 'DocTypeCodeFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocTypeCodeTo'
        DataType = ftString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'CompanyCodeFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyCodeTo'
        DataType = ftString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'LenAccCode'
        DataType = ftString
        Size = 2
        Value = '10'
      end
      item
        Name = 'AccCodeFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'AccCodeTo'
        DataType = ftString
        Size = 9
        Value = '2147483647'
      end
      item
        Name = 'SecondaryDocNoFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SecondaryDocNoTo'
        DataType = ftString
        Size = 7
        Value = '2147483647'
      end
      item
        Name = 'PrimaryDocNoFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'PrimaryDocNoTo'
        DataType = ftString
        Size = 7
        Value = '2147483647'
      end
      item
        Name = 'DocDateFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocDateTo'
        DataType = ftString
        Size = 10
        Value = '99/12/29'
      end
      item
        Name = 'Status1'
        DataType = ftString
        Size = 2
        Value = '-1'
      end
      item
        Name = 'Status2'
        DataType = ftString
        Size = 2
        Value = '-1'
      end>
    SQL.Strings = (
      
        'SELECT    AccTrialBalance.*, Categories_2.MoeenName_L1 AS PrvMoe' +
        'enName_L1,'
      
        '          Categories_2.MoeenName_L2 AS PrvMoeenName_L2, Categori' +
        'es_1.MoeenName_L1 AS MoeenName_L1,'
      '          Categories_1.MoeenName_L2 AS MoeenName_L2'
      
        '          ,Credit as bes,debt as bed,balanceDebt as MandehBed,ba' +
        'lanceCredit as Mandehbes,AccTrialBalance.TopicCode as _row'
      'FROM      dbo.AccTrialBalance(:LenPrvAccCode,'
      
        '               :DocTypeCode1_Not,:DocTypeCode2_Not,:DocTypeCode3' +
        '_Not, :DocTypeCodeFrom , :DocTypeCodeTo ,'
      '               :CompanyCodeFrom ,:CompanyCodeTo,'
      '               :LenAccCode,:AccCodeFrom ,:AccCodeTo,'
      '               :SecondaryDocNoFrom  , :SecondaryDocNoTo ,'
      '               :PrimaryDocNoFrom , :PrimaryDocNoTo ,'
      '               :DocDateFrom , :DocDateTo,'
      '               :Status1,:Status2) AccTrialBalance INNER JOIN'
      
        '          dbo.Categories Categories_1 ON AccTrialBalance.TopicCo' +
        'de = Categories_1.TopicCode LEFT OUTER JOIN'
      
        '          dbo.Categories Categories_2 ON AccTrialBalance.PrvTopi' +
        'cCode = Categories_2.TopicCode'
      'order by AccTrialBalance.TopicCode'
      ''
      ''
      '')
    Left = 352
    Top = 144
