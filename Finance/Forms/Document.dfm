  object qry_Details: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'CompanyCode'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT  acc.Details.DetailCode, acc.Details.DetailName_l1,acc.De' +
        'tails.DetailName_l2,acc.Details.MaxCredit, CurrencyType, Currenc' +
        'iesName'
      
        'FROM acc.Details  INNER JOIN Acc.Currencies ON acc.Details.Curre' +
        'ncyType =  Acc.Currencies.CurrenciesID'
      'WHERE  ((CompanyCode=:CompanyCode ) OR (UseKindInCo =0))')
    Left = 585
    Top = 175
  end
  object qry_CTopics: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     acc.CenterTopics.CTopicCode, acc.CenterTopics.CTopicN' +
        'ame_l1,acc.CenterTopics.CTopicName_l2'
      'FROM        acc.CenterTopics ')
    Left = 666
    Top = 165
  end
  object qry_CTopics2: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     acc.CenterTopics2.CTopicCode2, acc.CenterTopics2.CTop' +
        'icName2_l1,acc.CenterTopics2.CTopicName2_l2'
      'FROM        acc.CenterTopics2 ')
    Left = 730
    Top = 181
  end
  object qry_Categories: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT    acc.Categories.TopicCode, acc.Categories.MoeenName_L1,' +
        ' acc.Categories.MoeenName_L2, acc.Categories.AidInfoType, ISNULL' +
        '(acc.FormsInfo.InfoID, 0) AS InfoID , KindInsertBudgetCode'
      'FROM         acc.Categories LEFT OUTER JOIN'
      
        '                      acc.FormsInfo ON acc.Categories.AidInfoTyp' +
        'e = acc.FormsInfo.FormInfoID LEFT OUTER JOIN'
      
        '                      acc.CategoriesForUse ON acc.Categories.Top' +
        'icCode = acc.CategoriesForUse.PrvTopicCode'
      
        'WHERE     (acc.CategoriesForUse.PrvTopicCode IS NULL)  and (acc.' +
        'Categories.Active=1)')
    Left = 824
    Top = 96
  end
