  object qry_CategorieLookup: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     Acc.CategoriesForUse.TopicCode, CASE WHEN ((Acc.Categ' +
        'oriesForUse.MoeenName_L1 IS NULL) AND (Acc.Categories.MoeenName_' +
        'L1 IS NOT NULL)) '
      
        '                      THEN Acc.Categories.MoeenName_L1 WHEN ((Ac' +
        'c.CategoriesForUse.MoeenName_L1 IS NOT NULL) AND (Acc.Categories' +
        '.MoeenName_L1 IS NULL)) '
      
        '                      THEN Acc.CategoriesForUse.MoeenName_L1 ELS' +
        'E Acc.CategoriesForUse.MoeenName_L1 + '#39' _ '#39' + Acc.Categories.Moe' +
        'enName_L1 END AS MoeenName, Acc.CategoriesForUse.PrvTopicCode, '
      
        '                      CASE WHEN ((Acc.CategoriesForUse.MoeenName' +
        '_L2 IS NULL) AND (Acc.Categories.MoeenName_L2 IS NOT NULL)) '
      
        '                      THEN Acc.Categories.MoeenName_L2 WHEN ((Ac' +
        'c.CategoriesForUse.MoeenName_L2 IS NOT NULL) AND (Acc.Categories' +
        '.MoeenName_L2 IS NULL)) '
      
        '                      THEN Acc.CategoriesForUse.MoeenName_L2 ELS' +
        'E Acc.CategoriesForUse.MoeenName_L2 + '#39' _ '#39' + Acc.Categories.Moe' +
        'enName_L2 END AS MoeenName_L2'
      'FROM         Acc.CategoriesForUse LEFT OUTER JOIN'
      
        '                      Acc.Categories ON Acc.CategoriesForUse.Prv' +
        'TopicCode = Acc.Categories.TopicCode'
      'WHERE     (Acc.CategoriesForUse.PrvTopicCode IS NOT NULL)')
    Left = 712
    Top = 104
    object qry_CategorieLookupTopicCode: TLargeintField
      FieldName = 'TopicCode'
    end
    object qry_CategorieLookupMoeenName: TStringField
      FieldName = 'MoeenName'
      ReadOnly = True
      Size = 203
    end
    object qry_CategorieLookupPrvTopicCode: TStringField
      FieldName = 'PrvTopicCode'
      ReadOnly = True
      Size = 24
    end
    object qry_CategorieLookupMoeenName_L2: TStringField
      FieldName = 'MoeenName_L2'
      ReadOnly = True
      Size = 203
    end
  end
