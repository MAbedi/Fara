      item
        Name = 'LenCodeKol'
        DataType = ftString
        Size = 1
        Value = '2'
      end
      item
        Name = 'Serial'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 141
      end
      item
        Name = 'YearID'
        DataType = ftString
        Size = 4
        Value = '1401'
      end
      item
        Name = 'CompanyCode'
        DataType = ftString
        Size = 4
        Value = '1145'
      end>
    SQL.Strings = (
      
        'SELECT *, CASE WHEN Debt <> 0 THEN 1 ELSE 2 END AS BedBes , LEFT' +
        '(topicCode,:LenCodeKol) AS codeKol ,(Debt +Credit) AS SumBedBes'
      ',CurrencyDebit AS AidAmountBed'
      ',CurrencyCredit AS AidAmountBes'
      ''
      'FROM  Acc.Documents '
      
        'WHERE     (Serial = :Serial) and (Yearid = :YearID) and (Company' +
        'Code = :CompanyCode)'
      
        'ORDER BY CASE WHEN Debt <>0THEN 1 ELSE 2 END ,TopicCode,DetailCo' +
        'de,CTopicCode')
    Left = 270
    Top = 160
