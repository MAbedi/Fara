  object qryAccCode: TADOQuery
    AutoCalcFields = False
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qryAccCodeAfterScroll
    Parameters = <
      item
        Name = 'TopicCode'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DetailCode'
        DataType = ftString
        Size = 10
        Value = '0'
      end
      item
        Name = 'CTopic'
        DataType = ftString
        Size = 10
        Value = '0'
      end
      item
        Name = 'Ctopic2'
        DataType = ftString
        Size = 10
        Value = '0'
      end
      item
        Name = 'Ctopic3'
        DataType = ftString
        Size = 10
        Value = '0'
      end
      item
        Name = 'CompanyCode'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'Declare @TopicCode bigint'
      'Declare @DetailCode int'
      'Declare @CTopic int'
      'Declare @Ctopic2 int '
      'Declare @Ctopic3 int '
      'Declare @CurrencyType nvarchar(50)'
      'Declare @CompanyCode int '
      'set @TopicCode =:TopicCode'
      'set @DetailCode =:DetailCode'
      'set @CTopic =:CTopic'
      'set @Ctopic2 =:Ctopic2'
      'set @Ctopic3 =:Ctopic3'
      'set @CompanyCode  = :CompanyCode    '
      ''
      ''
      
        'SELECT  distinct   DERIVEDTBL.LevelID, DERIVEDTBL.LevelCaption_l' +
        '1, DERIVEDTBL.LevelCaption_l2, DERIVEDTBL.PrvLevelID, DERIVEDTBL' +
        '.CodeLength, '
      
        '                      acc.Categories.MoeenName_L1    , acc.Categ' +
        'ories.MoeenName_L2'
      
        'FROM         (SELECT     LevelID AS LevelID, LevelCaption_L1,Lev' +
        'elCaption_L2 , PrvLevelID, CodeLength, LEFT(@TopicCode, CodeLeng' +
        'th) AS TopicCode'
      '                        FROM         acc.AccTopicLevels'
      
        '                        WHERE     (TopicType = 0)  AND ( {fn len' +
        'gth(@TopicCode )}  >= CodeLength)'
      '                        ) DERIVEDTBL LEFT OUTER JOIN'
      
        '                      acc.Categories ON DERIVEDTBL.TopicCode = a' +
        'cc.Categories.TopicCode'
      'union all'
      ''
      
        'SELECT     distinct 0 ,  '#39#1578#1601#1589#1610#1604#1610' '#39'   ,'#39'Details '#39' , 0, 0, DetailN' +
        'ame_L1 ,DetailName_L2'
      'FROM   acc.Details'
      
        'WHERE     (acc.Details.DetailCode =  @DetailCode) and (acc.Detai' +
        'ls.DetailCode <> 0)'
      ' AND (( acc.Details.CompanyCode =  @CompanyCode ) )'
      ''
      'union all'
      ''
      
        'SELECT   0 ,  '#39#1578#1601#1589#1610#1604#1610'2'#39' ,'#39'Center Topic '#39' ,0,0, CTopicName_L1 ,CT' +
        'opicName_L2'
      'FROM       acc.CenterTopics'
      
        'WHERE     (acc.CenterTopics.CTopicCode =  @CTopic) and (acc.Cent' +
        'erTopics.CTopicCode <> 0)'
      ''
      'union all'
      ''
      
        'SELECT   0 ,  '#39#1578#1601#1589#1740#1604#1740'3'#39' , '#39'Center Topic 2'#39' , 0,0, CTopicName2_L1' +
        ' ,CTopicName2_L2'
      'FROM         acc.CenterTopics2'
      'WHERE'
      
        #9#9'( acc.CenterTopics2.CTopicCode2 =@Ctopic2) AND ( acc.CenterTop' +
        'ics2.CTopicCode2 <> 0)'
      ''
      'union all'
      ''
      
        'SELECT   0 ,  '#39#1578#1601#1589#1610#1604#1610'4 '#39' , '#39'Center Topic 3'#39' ,0,0 ,CTopicName3_L1' +
        ' , CTopicName3_L2'
      'FROM         acc.CTopicCode3'
      
        'WHERE     ( acc.CTopicCode3.CTopicCode3 = @Ctopic3)  and ( acc.C' +
        'TopicCode3.CTopicCode3 <> 0)'
      '')
    Left = 898
    Top = 389
