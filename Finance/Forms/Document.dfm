  object qryAccTopicLevels: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     acc.AccTopicLevels.LevelID, acc.AccTopicLevels.LevelC' +
        'aption_L1, acc.Categories.TopicCode, acc.AccTopicLevels.BudgetRe' +
        'lationType, '
      
        '                      ISNULL(acc.Categories.BudgetTopicID, 0) AS' +
        ' BudgetTopicID, ISNULL(acc.Categories.ProjectID, 0) AS ProjectID' +
        ', acc.FormsInfo.InfoID AS Essence, '
      
        '                      FormsInfo_1.InfoID AS ReactionForRepEssenc' +
        'e, acc.AccTopicLevels.CodeLength'
      'FROM        acc.AccTopicLevels INNER JOIN'
      
        '                      acc.Categories ON acc.AccTopicLevels.Level' +
        'ID = acc.Categories.LevelID LEFT OUTER JOIN'
      
        '                      acc.FormsInfo ON acc.Categories.Essence = ' +
        'acc.FormsInfo.FormInfoID LEFT OUTER JOIN'
      
        '                      acc.FormsInfo FormsInfo_1 ON acc.Categorie' +
        's.ReactionForRepEssence = FormsInfo_1.FormInfoID'
      'WHERE     (acc.AccTopicLevels.TopicType = 0)')
    Left = 640
    Top = 64
  end
  object qryKindInsertBudget: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     Acc.Categories.TopicCode, Acc.Categories.MoeenName_L1' +
        ', Acc.Categories.MoeenName_L2, ISNULL(Acc.FormsInfo.InfoID, 0) A' +
        'S InfoID, '
      
        '                      Acc.Categories.KindInsertBudgetCode, Acc.F' +
        'ormsInfo.InfoName_L1, Acc.AccTopicLevels.BudgetRelationType'
      'FROM         Acc.Categories INNER JOIN'
      
        '                      Acc.FormsInfo ON Acc.Categories.KindInsert' +
        'BudgetCode = Acc.FormsInfo.FormInfoID INNER JOIN'
      
        '                      Acc.AccTopicLevels ON Acc.Categories.Level' +
        'ID = Acc.AccTopicLevels.LevelID LEFT OUTER JOIN'
      
        '                      Acc.CategoriesForUse ON Acc.Categories.Top' +
        'icCode = Acc.CategoriesForUse.PrvTopicCode'
      
        'WHERE     (Acc.CategoriesForUse.PrvTopicCode IS NULL) AND (Acc.A' +
        'ccTopicLevels.BudgetRelationType <> 0)')
    Left = 421
    Top = 195
  end
