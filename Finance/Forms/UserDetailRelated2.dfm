  object qryDetails: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'UserID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT     cast(details.DetailCode as bigint) as Code,details.De' +
        'tailName_L1 AS Name'
      
        'FROM        acc.Details as details inner join dbo.customers as C' +
        'ust '
      #9'ON details.DetailCode = Cust.CustID'
      'where '
      
        '(((CHARINDEX('#39','#39'+ltrim(:UserID)+'#39','#39', '#39','#39' + Cust.OperatorID + '#39','#39 +
        ') <> 0) ) )'
      'order by DetailCode')
    Left = 160
    Top = 288
    object qryDetailsCode: TLargeintField
      Tag = 3
      DisplayLabel = #1705#1583' '#1578#1601#1589#1740#1604#1740
      FieldName = 'Code'
      ReadOnly = True
    end
    object qryDetailsName: TStringField
      Tag = 3
      DisplayLabel = #1606#1575#1605' '#1578#1601#1589#1740#1604#1740
      FieldName = 'Name'
      Size = 150
    end
  end
