  object qryportion: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    AfterInsert = qryportionAfterInsert
    Parameters = <
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     Acc.PortionRange.ID, Acc.PortionRange.FormInfoID, Acc' +
        '.PortionRange.CompanyCode, Acc.PortionRange.TopicCode, Acc.Porti' +
        'onRange.DetailCode, '
      
        '                      Acc.PortionRange.CTopicCode, Acc.PortionRa' +
        'nge.CTopicCode2, Acc.CenterTopics.CTopicName_L1, Acc.Details.Det' +
        'ailName_L1, Acc.CenterTopics2.CTopicName2_L1, '
      
        '                      Acc.Categories.MoeenName_L1, ISNULL(Acc.Ca' +
        'tegories.MoeenName_L1, '#39' '#39') + '#39' _ '#39' + ISNULL(Acc.Details.DetailN' +
        'ame_L1, '#39' '#39') '
      
        '                      + '#39' _ '#39' + ISNULL(Acc.CenterTopics.CTopicNa' +
        'me_L1, '#39' '#39') + '#39' _ '#39' + ISNULL(Acc.CenterTopics2.CTopicName2_L1, '#39 +
        ' '#39') + '#39' _ '#39' + ISNULL(Acc.CTopicCode3.CTopicName3_L1, '
      
        '                      '#39' '#39') AS accName, Acc.PortionRange.YearID, ' +
        'Acc.PortionRange.CTopicCode3, Acc.CTopicCode3.CTopicName3_L1'
      'FROM         Acc.PortionRange INNER JOIN'
      
        '                      Acc.Categories ON Acc.PortionRange.TopicCo' +
        'de = Acc.Categories.TopicCode INNER JOIN'
      
        '                      Acc.CenterTopics ON Acc.PortionRange.CTopi' +
        'cCode = Acc.CenterTopics.CTopicCode INNER JOIN'
      
        '                      Acc.CenterTopics2 ON Acc.PortionRange.CTop' +
        'icCode2 = Acc.CenterTopics2.CTopicCode2 INNER JOIN'
      
        '                      Acc.Details ON Acc.PortionRange.DetailCode' +
        ' = Acc.Details.DetailCode AND Acc.PortionRange.CompanyCode = Acc' +
        '.Details.CompanyCode INNER JOIN'
      
        '                      Acc.CTopicCode3 ON Acc.PortionRange.CTopic' +
        'Code3 = Acc.CTopicCode3.CTopicCode3'
      'where YearID =  :YearID')
    Left = 320
    Top = 85
