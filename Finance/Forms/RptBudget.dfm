    SQL.Strings = (
      
        'select BI.BudgetID,B.BudgetSerial,B.BudgetDate,BI.BudgetTopicID,' +
        'BI.Bed,BI.Bes,BI.CustomerID,B.Status,'
      
        '       BI.Cashtype,BI.CompanyCode,BI.Ctype,BI.CostType,BI.CostCo' +
        'de from acc.BudgetItems as BI'
      ' inner join'
      'acc.Budgets as B on B.BudgetID=BI.BudgetID'
      'where (B.YearID between :yearidFrom and :yearidTo)and'
      '      (B.BudgetDate between :dateFrom and :dateTo)and'
      '      (BI.CustomerID between :custidFrom and :custidTo)and'
      '      (BI.CompanyCode between :companyFrom and :companyTo)and'
      
        '      (BI.BudgetTopicID between :budgetidFrom and :budgetidTo)an' +
        'd'
      
        '      (BI.CostType in (Select part From [Acc].[SplitString] (:Co' +
        'stType,'#39','#39')))')
