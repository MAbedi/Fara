  object _qryCost: TADOQuery
    Connection = Dmf.adcAccounting
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      'select '
      
        'recipts.reciptnumber, stores.c_storename, customers.custname, '#39'Y' +
        '='#39' + Ltrim(recipts.yearid) + '#39',S='#39' + Ltrim(recipts.serverid) + '#39 +
        ',R='#39' + Ltrim(recipts.reciptid) as KeyID, '
      
        'stores.c_storename + '#39'__'#39' + customers.custname + case when ((loo' +
        'kups.name is not null) and (lookups.name<>'#39#39')) '
      'then '#39'__'#39'+lookups.name else '#39#39' end as Caption '
      'from         '
      
        'customers inner join recipts on customers.custid = recipts.perso' +
        'nid1 inner join stores '
      'on recipts.storeid = stores.n_storeid left outer join lookups '
      
        'on recipts.secondtype = lookups.lookupid where (recipts.yearid =' +
        '93)and(recipts.recipttype = 20)')
    Left = 60
    Top = 350
    object _qryCostKeyID: TStringField
      FieldName = 'KeyID'
      ReadOnly = True
      Size = 44
    end
    object _qryCostreciptnumber: TIntegerField
      FieldName = 'reciptnumber'
    end
    object _qryCostCaption: TStringField
      FieldName = 'Caption'
      ReadOnly = True
      Size = 274
    end
  end
