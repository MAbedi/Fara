      end
      item
        Name = 'CTopicCode2From'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CTopicCode2To'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 2147483647
      end
      item
        Name = 'CTopicCode3From'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CTopicCode3To'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 2147483647
      end>
    SQL.Strings = (
      
        'SELECT     DocGroups.CompanyCode, Documents.TopicCode, Documents' +
        '.DetailCode, Documents.CTopicCode'
      ', Documents.CTopicCode2,Documents.CTopicCode3,'
      
        '                      MAX(Categories.MoeenName_L1 + '#39'-'#39' + ISNULL' +
        '(Details.DetailName_L1, '#39'-'#39')'
      
        '                      + '#39'-'#39' + ISNULL(CenterTopics3.CTopicName3_L' +
        '1, '#39'-'#39')'
      
        '                      + '#39'-'#39' + ISNULL(CenterTopics2.CTopicName2_L' +
        '1, '#39'-'#39')'
      
        '                      + '#39'-'#39' + ISNULL(CenterTopics.CTopicName_L1,' +
        ' '#39'-'#39')) AS AccName'
      
        ',case when SUM(Documents.Debt - Documents.Credit) <0 then -SUM(D' +
        'ocuments.Debt - Documents.Credit) else 0 end  AS Debt'
      
        ',case when SUM(Documents.Debt - Documents.Credit) >= 0 then SUM(' +
        'Documents.Debt - Documents.Credit) else 0 end  AS credit'
      
        ',CASE WHEN SUM(Documents.CurrencyDebit - Documents.CurrencyCredi' +
        't) <  0 THEN -SUM(Documents.CurrencyDebit - Documents.CurrencyCr' +
        'edit) ELSE 0 END  AS CurrencyDebit'
      
        ',CASE WHEN SUM(Documents.CurrencyDebit - Documents.CurrencyCredi' +
        't) >= 0 THEN  SUM(Documents.CurrencyDebit - Documents.CurrencyCr' +
        'edit) ELSE 0 END  AS CurrencyCredit'
      
        ',MAX(Documents.CurrencyRate) AS CurrencyRate,ISNULL(Documents.Cu' +
        'rrencyType,0) AS CurrencyType'
      'FROM         acc.Documents  as Documents INNER JOIN'
      
        '      acc.Details as Details ON Documents.DetailCode = Details.D' +
        'etailCode INNER JOIN'
      
        '                      Acc.DocGroups AS DocGroups ON Documents.Se' +
        'rial = DocGroups.Serial AND Documents.CompanyCode = DocGroups.Co' +
        'mpanyCode AND '
      
        '                      Documents.YearID = DocGroups.YearID INNER ' +
        'JOIN'
      
        '                      acc.Categories as Categories ON Documents.' +
        'TopicCode = Categories.TopicCode LEFT OUTER JOIN'
      
        '                      acc.CenterTopics as CenterTopics ON Docume' +
        'nts.CTopicCode = CenterTopics.CTopicCode'
      '                      LEFT OUTER JOIN'
      
        '                      acc.CenterTopics2 as CenterTopics2  ON Doc' +
        'uments.CTopicCode2 = CenterTopics2.CTopicCode2'
      '                      LEFT OUTER JOIN'
      
        '                      acc.CenterTopics3 as CenterTopics3  ON Doc' +
        'uments.CTopicCode3 = CenterTopics3.CTopicCode3'
      ''
      'where    DocGroups.CompanyCode=:CompanyCode and'
      
        '     '#9#9'(DocGroups.SecondaryDocNo BETWEEN :SecondaryDocNoFrom AND' +
        ' :SecondaryDocNoTo ) AND'
      
        #9'                (DocGroups.PrimaryDocNo BETWEEN :PrimaryDocNoFr' +
        'om AND :PrimaryDocNoTo) AND'
      
        '                                (DocGroups.DocDate BETWEEN :DocD' +
        'ateFrom AND :DocDateTo ) AND'
      '                                (DocGroups.YearID =:YearID)'
      ''
      
        'GROUP BY DocGroups.CompanyCode, Documents.TopicCode, Documents.D' +
        'etailCode, Documents.CTopicCode,'
      
        '         Documents.CTopicCode2,Documents.CTopicCode3,ISNULL(Docu' +
        'ments.CurrencyType,0)'
      ''
      'HAVING   SUM(Documents.Debt - Documents.Credit) <> 0  AND'
      
        '        (Documents.DetailCode BETWEEN :DetailCodeFrom AND :Detai' +
        'lCodeTo )  AND'
      
        '        (DocGroups.CompanyCode BETWEEN :CompanyCodeFrom AND :Com' +
        'panyCodeTo) AND'
      
        '        (Documents.TopicCode BETWEEN :TopicCodeFrom AND :TopicCo' +
        'deTo ) AND'
      
        '        (Documents.CTopicCode BETWEEN :CTopicCodeFrom AND :CTopi' +
        'cCodeTo ) AND'
      
        '        (Documents.CTopicCode2 BETWEEN :CTopicCode2From AND :CTo' +
        'picCode2To ) AND'
      
        '        (Documents.CTopicCode3 BETWEEN :CTopicCode3From AND :CTo' +
        'picCode3To )'
      '')
    Left = 128
    Top = 192
