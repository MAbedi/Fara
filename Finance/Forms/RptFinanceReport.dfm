  object qryFinance: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    CommandTimeout = 0
    Parameters = <
      item
        Name = 'DocDateOldFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocDateOldTo'
        DataType = ftWideString
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'DocDateNewFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'DocDateNewTo'
        DataType = ftWideString
        Size = 10
        Value = '9999/99/99'
      end
      item
        Name = 'RepCode'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 0
      end
      item
        Name = 'CompanyCodeFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CompanyCodeTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CTopicCode3From'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'CTopicCode3TO'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 2147483647
      end>
    SQL.Strings = (
      'DECLARE @DocDateOldFrom char(10)'
      'DECLARE @DocDateOldTo char(10)'
      'DECLARE @DocDateNewFrom char(10)'
      'DECLARE @DocDateNewTo char(10)'
      ''
      'SET @DocDateOldFrom= :DocDateOldFrom'
      'SET @DocDateOldTo= :DocDateOldTo'
      'SET @DocDateNewFrom= :DocDateNewFrom'
      'SET @DocDateNewTo= :DocDateNewTo'
      ''
      
        'SELECT _FinanceReports.repCode, [_ReportRows].rowID, [_ReportRow' +
        's].rowTopic1 , [_ReportRows].cType1  , [_ReportRows].link1, [_Re' +
        'portRows].ColNum1'
      ','
      
        'Sum(case when  (DocGroups.DocDate BETWEEN @DocDateNewFrom AND @D' +
        'ocDateNewTo ) then'
      '  case when [colnum]=1 then '#9'('
      
        #9'case when [ColNum1]=1 then case when [CTYPE1]=1 then Documents.' +
        'Debt-Documents.Credit'
      #9#9'else case when [CTYPE1]=2 then Documents.Debt'
      #9#9#9'else case when [CTYPE1]=3 then Documents.Credit'
      
        #9#9#9#9'else '#9'case when [CTYPE1]=4 then Documents.Credit -Documents.' +
        'Debt else 0 end'
      #9#9#9#9'end'
      #9#9#9'end'
      #9#9'end'
      #9'else 0 end'
      #9')'
      'else 0 end'
      'else 0 end'
      ') AS Amount1 ,'
      
        'Sum(case when  (DocGroups.DocDate BETWEEN @DocDateOldFrom AND @D' +
        'ocDateOldTo ) then'
      '  case when [colnum]=1 then '#9'('
      
        #9'case when [ColNum1]=1 then case when [CTYPE1]=1 then Documents.' +
        'Debt-Documents.Credit'
      #9#9'else case when [CTYPE1]=2 then Documents.Debt'
      #9#9#9'else case when [CTYPE1]=3 then Documents.Credit'
      
        #9#9#9#9'else '#9'case when [CTYPE1]=4 then Documents.Credit -Documents.' +
        'Debt else 0 end'
      #9#9#9#9'end'
      #9#9#9'end'
      #9#9'end'
      #9'else 0 end'
      #9')'
      'else 0 end'
      'else 0 end'
      ') AS AmountO1,'
      'Sum('
      
        'case when  (DocGroups.DocDate BETWEEN @DocDateNewFrom AND @DocDa' +
        'teNewTo ) then'
      'case when [colnum]=1   then ('
      'case when [ColNum1]=2 then'
      #9'case when [CTYPE1]=1 then Documents.Debt-Documents.Credit'
      #9'else  case when [CTYPE1]=2 then Documents.Debt'
      #9#9'else case when [CTYPE1]=3 then Documents.Credit'
      
        #9#9#9'else case when [CTYPE1]=4 then Documents.Credit -Documents.De' +
        'bt else 0 end'
      #9#9#9'end'
      #9#9'end'
      #9'end'
      'else 0'
      'end'
      ')'
      'else 0 end'
      'else 0 end'
      ''
      ') AS Amount2,'
      'Sum('
      
        'case when  (DocGroups.DocDate BETWEEN @DocDateOldFrom AND @DocDa' +
        'teOldTo ) then'
      'case when [colnum]=1   then ('
      'case when [ColNum1]=2 then'
      #9'case when [CTYPE1]=1 then Documents.Debt-Documents.Credit'
      #9'else  case when [CTYPE1]=2 then Documents.Debt'
      #9#9'else case when [CTYPE1]=3 then Documents.Credit'
      
        #9#9#9'else case when [CTYPE1]=4 then Documents.Credit -Documents.De' +
        'bt else 0 end'
      #9#9#9'end'
      #9#9'end'
      #9'end'
      'else 0'
      'end'
      ')'
      'else 0 end'
      'else 0 end'
      ''
      ') AS AmountO2,'
      
        ' [_ReportRows].rowTopic2, [_ReportRows].cType2, [_ReportRows].li' +
        'nk2, [_ReportRows].ColNum2,'
      ''
      'Sum('
      
        'case when  (DocGroups.DocDate BETWEEN @DocDateNewFrom AND @DocDa' +
        'teNewTo ) then'
      'case when [colnum]=2   then '#9'('#9'case when [ColNum2]=1 then'
      #9#9'case when [CTYPE2]=1then Documents.Debt-Documents.Credit'
      #9#9'else case when [CTYPE2]=2 then Documents.Debt'
      #9#9#9'else case when [CTYPE2]=3 then Documents.Credit'
      
        #9#9#9#9'else  case when [CTYPE2]=4 then Documents.Credit -Documents.' +
        'Debt else 0 end'
      #9#9#9#9'end'
      #9#9#9'end'
      #9#9'end'
      #9'else 0 end'
      #9')else 0 end'
      'else 0 end'
      '  ) AS Amount11,'
      ''
      'Sum('
      
        'case when  (DocGroups.DocDate BETWEEN @DocDateOldFrom AND @DocDa' +
        'teOldTo ) then'
      'case when [colnum]=2   then '#9'('#9'case when [ColNum2]=1 then'
      #9#9'case when [CTYPE2]=1then Documents.Debt-Documents.Credit'
      #9#9'else case when [CTYPE2]=2 then Documents.Debt'
      #9#9#9'else case when [CTYPE2]=3 then Documents.Credit'
      
        #9#9#9#9'else  case when [CTYPE2]=4 then Documents.Credit -Documents.' +
        'Debt else 0 end'
      #9#9#9#9'end'
      #9#9#9'end'
      #9#9'end'
      #9'else 0 end'
      #9')else 0 end'
      'else 0 end'
      '  ) AS AmountO11,'
      ''
      'Sum('
      
        'case when  (DocGroups.DocDate BETWEEN @DocDateNewFrom AND @DocDa' +
        'teNewTo ) then'
      'case when [colnum]=2   then '#9'('
      #9'case when [ColNum2]=2 then'
      #9#9'case when [CTYPE2]=1 then Documents.Debt-Documents.Credit'
      #9#9'else'#9'case when [CTYPE2]=2 then Documents.Debt'
      #9#9#9'else'#9'case when [CTYPE2]=3 then Documents.Credit'
      #9#9#9#9'else'
      
        #9#9#9#9#9'case when [CTYPE2]=4 then Documents.Credit -Documents.Debt ' +
        'else 0 end'
      #9#9#9#9'end'
      #9#9#9'end'
      #9#9'end'
      #9'else 0 end'
      #9')'
      'else 0 end'
      'else 0 end'
      ') AS Amount12,'
      ''
      'Sum('
      
        'case when  (DocGroups.DocDate BETWEEN @DocDateOldFrom AND @DocDa' +
        'teOldTo ) then'
      'case when [colnum]=2   then '#9'('
      #9'case when [ColNum2]=2 then'
      #9#9'case when [CTYPE2]=1 then Documents.Debt-Documents.Credit'
      #9#9'else'#9'case when [CTYPE2]=2 then Documents.Debt'
      #9#9#9'else'#9'case when [CTYPE2]=3 then Documents.Credit'
      #9#9#9#9'else'
      
        #9#9#9#9#9'case when [CTYPE2]=4 then Documents.Credit -Documents.Debt ' +
        'else 0 end'
      #9#9#9#9'end'
      #9#9#9'end'
      #9#9'end'
      #9'else 0 end'
      #9')'
      'else 0 end'
      'else 0 end'
      ') AS AmountO12,'
      ''
      ''
      ' min( case when [CTYPE1]=6 then '#39'_______________'#39
      
        ' else case when [CTYPE1]=7 then '#39'==============='#39' else '#39#39' end   ' +
        'end  ) AS LineRpt'
      ''
      'FROM         Acc._FinanceReports AS _FinanceReports INNER JOIN'
      
        '                      Acc._ReportRows AS _ReportRows ON _Finance' +
        'Reports.repCode = _ReportRows.repCode LEFT OUTER JOIN'
      
        '                      Acc._ReportRowsOnDocs AS _ReportRowsOnDocs' +
        ' ON'
      
        '                      /*_ReportRows.YearID = _ReportRowsOnDocs.Y' +
        'earID AND*/'
      
        '                      _ReportRows.rowID = _ReportRowsOnDocs.rowI' +
        'D AND'
      
        '                      _ReportRows.repCode = _ReportRowsOnDocs.re' +
        'pCode LEFT OUTER JOIN'
      '                      Acc.Documents AS Documents LEFT OUTER JOIN'
      
        '                      Acc.DocGroups AS DocGroups ON Documents.Ye' +
        'arID = DocGroups.YearID AND Documents.CompanyCode = DocGroups.Co' +
        'mpanyCode AND'
      '                      Documents.Serial = DocGroups.Serial ON'
      
        '                            (_ReportRowsOnDocs.G_TopicCode = Doc' +
        'uments.TopicCode)'
      '                      '
      '--2'#9#9#9
      '--3'#9#9#9
      ''
      ''
      'WHERE  (([_FinanceReports].repCode)= :RepCode )  --4'
      ''
      ''
      
        '                 AND ((DocGroups.CompanyCode  between :CompanyCo' +
        'deFrom And :CompanyCodeTo) OR (DocGroups.CompanyCode IS NULL))'
      
        '                 And (Documents.ctopiccode3   between :CTopicCod' +
        'e3From   and :CTopicCode3TO  OR Documents.ctopiccode3 is null)'
      ''
      
        ' GROUP BY [_FinanceReports].repCode, [_ReportRows].rowID, [_Repo' +
        'rtRows].rowTopic1, [_ReportRows].cType1,'
      #9'                [_ReportRows].link1, [_ReportRows].ColNum1, '
      
        #9#9'[_ReportRows].rowTopic2, [_ReportRows].cType2, [_ReportRows].l' +
        'ink2, [_ReportRows].ColNum2'
      'order  by  [_ReportRows].rowID')
