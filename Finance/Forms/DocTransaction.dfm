      end
      item
        Name = 'DocNoFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'DocNoTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'TransDateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'TransDateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     Serial , SecondaryDocNo '
      'FROM         acc.DocsTransaction'
      
        'where (DocDate between :DocDateFrom and :DocDateTo) and (Seconda' +
        'ryDocNo between :DocNoFrom and :DocNoTo)'
      '       and (TransDate between :TransDateFrom and :TransDateTo)'
      'GROUP BY Serial, SecondaryDocNo')
    Left = 656
    Top = 125
