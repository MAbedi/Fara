  object qryMaster: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    AfterScroll = qryMasterAfterScroll
    Parameters = <
      item
        Name = 'DocDateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'DocDateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
