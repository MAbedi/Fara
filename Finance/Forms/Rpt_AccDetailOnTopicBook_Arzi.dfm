    SQL.Strings = (
      
        'SELECT  Fitful.FitfulID AS calcuBalance , Fitful.FitfulIDc AS ca' +
        'lcuRate ,  Fitful.FitfulID AS bed , Fitful.FitfulID AS bes , Fit' +
        'ful.FitfulID as Amount , Fitful.FitfulID as _row  ,  DocDate as ' +
        'CalDate ,'
      
        '                    Fitful.FitfulID as Rate , DetailsOnTopicBook' +
        '_arzi.*  ,  Debt + Credit  as  Sort'
      '                     ,AidAmountBed,  AidAmountBes'
      
        'FROM   Acc.DetailsOnTopicBook_arzi (:CompanyCodeFrom,:CompanyCod' +
        'eTO , :TopicCode , :DetailCode ,'
      
        '         :SecondaryDocNoFrom ,:SecondaryDocNoTo , :PrimaryDocNoF' +
        'rom , :PrimaryDocNoTo ,'
      
        '         :DocDateFrom , :DocDateTo ,:Status1,:FromYearID,:ToYear' +
        'ID,:DocTypeCodeFrom, :CurrencyTypeFrom, :CurrencyTypeTo) Details' +
        'OnTopicBook_arzi CROSS JOIN Fitful'
      'ORDER BY DocDate, SortID,SecondaryDocNo, PrimaryDocNo,bedbes, ID'
      '')
    Left = 543
    Top = 274
