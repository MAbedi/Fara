    SQL.Strings = (
      
        'SELECT     acc.PortionTableItems.ID, acc. PortionTableItems.Coff' +
        'icientID, acc. PortionTableItems.CTopicCode2,  acc.PortionTableI' +
        'tems.CofficientItem, '
      
        '                      acc. CenterTopics2.CTopicName2_L1,  acc.Ce' +
        'nterTopics2.CTopicName2_L2'
      'FROM          acc.PortionTableItems INNER JOIN'
      
        '                       acc.CenterTopics2 ON  acc.PortionTableIte' +
        'ms.CTopicCode2 =  acc.CenterTopics2.CTopicCode2'
      'WHERE     ( acc.PortionTableItems.CofficientID =:CofficientID )'
      '')
