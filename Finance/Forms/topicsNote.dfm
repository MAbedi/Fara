      item
        Name = 'TopicCode'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = '1'
      end>
    SQL.Strings = (
      'SELECT     acc.CategoriesNote.*'
      'FROM         acc.CategoriesNote'
      'Where TopicCode = :TopicCode  '#10
