  object qryDetails: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    Filtered = True
    BeforeInsert = qryDetailsBeforeInsert
    AfterInsert = qryDetailsAfterInsert
    BeforeEdit = qryDetailsBeforeEdit
    AfterEdit = qryDetailsAfterEdit
    BeforePost = qryDetailsBeforePost
    AfterPost = qryDetailsAfterPost
    BeforeDelete = qryDetailsBeforeDelete
    AfterDelete = qryDetailsAfterDelete
    AfterScroll = qryDetailsAfterScroll
    Parameters = <
      item
        Name = 'DGIDfrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'DGIDto'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 2147483647
      end>
    SQL.Strings = (
      
        'SELECT     1 AS CompanyCode, CustID AS DetailCode, isnull(CustFi' +
        'rstName,'#39#39') +'#39' '#39'+ isnull(CustName,'#39' '#39') AS DetailName_L1, CustNam' +
        'e_L2 AS DetailName_L2, CustomerGrpID AS DetailGroup, ModifyDate ' +
        'AS MakeDate, 0 AS UseKindInCo, '
      
        '                      NationalID, MaxCredit, Mobile, AccountKind' +
        ' AS CurrencyType, NULL AS AidNumber, NULL AS AidDate, 0 AS Porti' +
        'onCode, NULL AS AidQty,'
      
        #9#9#9#9#9'  BankName, ManageName, CustAccountNumber ,PaymentCode,Cust' +
        'FirstName, CustName as FirstName,OperatorID'
      ',FirstUser ,LastUser ,  InfoDate,CustomerState'
      ''
      'FROM         dbo.Customers'
      ''
      ''
      'WHERE (CustomerGrpID  between  :DGIDfrom  and  :DGIDto)'
      ' AND  (CustID <>0) ')
    Left = 560
    Top = 257
