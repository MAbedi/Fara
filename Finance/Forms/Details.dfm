  object qryMaster: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    AfterOpen = qryMasterAfterOpen
    AfterScroll = qryMasterAfterScroll
    Parameters = <
      item
        Name = 'CompanyCode'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     acc.DetailGroups.DGID, acc.DetailGroups.DGName_L1, ac' +
        'c.DetailGroups.DGName_L2,'
      '                   acc.DetailGroups.DGName_L1 AS DGName1,'
      '                   acc.DetailGroups.UseKindInCo,'
      
        '                   acc.DetailGroups.StartRange, acc.DetailGroups' +
        '.EndRange, acc.DetailGroups.DetailType'
      'FROM         acc.DetailGroups LEFT OUTER JOIN'
      
        '                      acc.DGCompaniesRange ON acc.DetailGroups.D' +
        'GID = acc.DGCompaniesRange.DGIDCompanies'
      'WHERE     (acc.DGCompaniesRange.CompanyCode = :CompanyCode) OR'
      '                      (acc.DetailGroups.UseKindInCo = 0)'
      
        'group by acc.DetailGroups.DGID, acc.DetailGroups.DGName_L1, acc.' +
        'DetailGroups.DGName_L2,'
      '                   acc.DetailGroups.UseKindInCo,'
      
        '                   acc.DetailGroups.StartRange, acc.DetailGroups' +
        '.EndRange, acc.DetailGroups.DetailType                      '
      'ORDER BY acc.DetailGroups.StartRange')
    Left = 556
    Top = 112
