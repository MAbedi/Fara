  object qry_CToplic: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'TopicCodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end
      item
        Name = 'TopicCodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end
      item
        Name = 'cTopicCodeFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'cTopicCodeTo'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'cTopicCode2From'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'cTopicCode2To'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'cTopicCode3From'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'cTopicCode3To'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'DetailCodeFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'DetailCodeto'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     Acc.Documents.TopicCode, Acc.Documents.DetailCode, Ac' +
        'c.Documents.CTopicCode, Acc.Documents.CTopicCode2, Acc.Documents' +
        '.CompanyCode, '
      
        '                      Acc.Categories.MoeenName_L1, Acc.Details.D' +
        'etailName_L1, Acc.CenterTopics.CTopicName_L1, Acc.CenterTopics2.' +
        'CTopicName2_L1, '
      
        '                      ISNULL(Acc.Categories.MoeenName_L1, '#39' '#39') +' +
        ' '#39' _ '#39' + ISNULL(Acc.Details.DetailName_L1, '#39' '#39') + '#39' _ '#39' + ISNULL' +
        '(Acc.CenterTopics.CTopicName_L1, '#39' '#39') '
      
        '                      + '#39' _ '#39' + ISNULL(Acc.CenterTopics2.CTopicN' +
        'ame2_L1, '#39' '#39')+ '#39' _ '#39' + ISNULL(Acc.CTopicCode3.CTopicName3_L1, '#39' ' +
        #39') AS accName, Acc.Categories.TopicCode AS Checked, Acc.Document' +
        's.ctopiccode3, '
      '                      Acc.CTopicCode3.CTopicName3_L1'
      'FROM         Acc.Categories INNER JOIN'
      
        '                      Acc.Documents ON Acc.Categories.TopicCode ' +
        '= Acc.Documents.TopicCode INNER JOIN'
      
        '                      Acc.Details ON Acc.Documents.CompanyCode =' +
        ' Acc.Details.CompanyCode AND Acc.Documents.DetailCode = Acc.Deta' +
        'ils.DetailCode INNER JOIN'
      
        '                      Acc.CenterTopics ON Acc.Documents.CTopicCo' +
        'de = Acc.CenterTopics.CTopicCode INNER JOIN'
      
        '                      Acc.CenterTopics2 ON Acc.Documents.CTopicC' +
        'ode2 = Acc.CenterTopics2.CTopicCode2 INNER JOIN'
      
        '                      Acc.CTopicCode3 ON Acc.Documents.ctopiccod' +
        'e3 = Acc.CTopicCode3.CTopicCode3'
      
        'WHERE  ( Acc.Documents.TopicCode BETWEEN :TopicCodeFrom and :Top' +
        'icCodeTo) '
      
        '                       AND ( Acc.Documents.CTopicCode BETWEEN :c' +
        'TopicCodeFrom AND :cTopicCodeTo)'
      
        '                       AND ( Acc.Documents.CTopicCode2 BETWEEN :' +
        'cTopicCode2From AND :cTopicCode2To)'
      
        '                       AND ( Acc.Documents.CTopicCode3 BETWEEN :' +
        'cTopicCode3From AND :cTopicCode3To) '
      
        '                       AND ( Acc.Documents.DetailCode BETWEEN :D' +
        'etailCodeFrom AND :DetailCodeto)'
      '                       AND ( Acc.Documents.YearID = :YearID)'
      
        'GROUP BY Acc.Documents.TopicCode, Acc.Documents.DetailCode, Acc.' +
        'Documents.CTopicCode, Acc.Documents.CTopicCode2, Acc.Documents.C' +
        'ompanyCode, '
      
        '                      Acc.Categories.MoeenName_L1, Acc.Details.D' +
        'etailName_L1, Acc.CenterTopics.CTopicName_L1, Acc.CenterTopics2.' +
        'CTopicName2_L1, '
      
        '                      ISNULL(Acc.Categories.MoeenName_L1, '#39' '#39') +' +
        ' '#39' _ '#39' + ISNULL(Acc.Details.DetailName_L1, '#39' '#39') + '#39' _ '#39' + ISNULL' +
        '(Acc.CenterTopics.CTopicName_L1, '#39' '#39') '
      
        '                      + '#39' _ '#39' + ISNULL(Acc.CenterTopics2.CTopicN' +
        'ame2_L1, '#39' '#39')+ '#39' _ '#39' + ISNULL(Acc.CTopicCode3.CTopicName3_L1, '#39' ' +
        #39'), Acc.Categories.TopicCode, Acc.Documents.ctopiccode3, Acc.CTo' +
        'picCode3.CTopicName3_L1'
      
        'ORDER BY Acc.Documents.TopicCode, Acc.Documents.DetailCode, Acc.' +
        'Documents.CTopicCode, Acc.Documents.CTopicCode2'
      '')
    Left = 32
    Top = 120
