  object qry_GeneralJournal: TADOQuery
    Connection = DmF.adcAccounting
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterOpen = qry_GeneralJournalAfterOpen
    Parameters = <
      item
        Name = 'CodeLength'
        DataType = ftInteger
        Size = 1
        Value = 2
      end
      item
        Name = 'SecondaryDocNoFrom'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'SecondaryDocNoTo'
        DataType = ftString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'PrimaryDocNoFrom'
        DataType = ftString
        Size = 6
        Value = '0'
      end
      item
        Name = 'PrimaryDocNoTo'
        DataType = ftString
        Size = 10
        Value = '2147483647'
      end
      item
        Name = 'DocDateFrom'
        DataType = ftString
        Size = 10
        Value = '84/01/01'
      end
      item
        Name = 'DocDateTo'
        DataType = ftString
        Size = 10
        Value = '84/12/29'
      end
      item
        Name = 'FromYearId'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ToYearID'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyCodeFrom'
        DataType = ftWideString
        Size = 1
        Value = '0'
      end
      item
        Name = 'CompanyCodeTo'
        DataType = ftWideString
        Size = 3
        Value = '999'
      end>
    SQL.Strings = (
      
        'SELECT     GeneralJournal.*,debt as bed ,credit as bes,serial as' +
        ' _row'
      'FROM         acc.GeneralJournal'
      
        '                       (:CodeLength, :SecondaryDocNoFrom, :Secon' +
        'daryDocNoTo ,'
      
        '                        :PrimaryDocNoFrom, :PrimaryDocNoTo, :Doc' +
        'DateFrom , :DocDateTo,:FromYearId,:ToYearID, :CompanyCodeFrom , ' +
        ':CompanyCodeTo ) '
      '                    GeneralJournal'
      'WHERE    Credit + Debt >0'
      
        'ORDER BY   CASE WHEN PrimaryDocNo = 0 THEN REPLACE(DocDate, '#39'/'#39',' +
        ' '#39#39') ELSE PrimaryDocNo END, DocDate, SecondaryDocNo, SortID, CAS' +
        'E WHEN [debt]>0 THEN 0 ELSE 1 END , AccCode')
    Left = 488
    Top = 165
