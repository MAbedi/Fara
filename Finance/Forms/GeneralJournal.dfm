  object qry_Init: TADOQuery
    Connection = DmF.adcAccounting
    Parameters = <
      item
        Name = 'FormType'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 2
      end>
    SQL.Strings = (
      'SELECT     CodeLength'
      'FROM        acc.AccTopicLevels'
      'WHERE     (LevelID =:FormType)')
