    AfterInsert = qryFormItemsAfterInsert
    BeforeEdit = qryFormItemsBeforeEdit
    AfterEdit = qryFormItemsAfterEdit
    BeforePost = qryFormItemsBeforePost
    AfterPost = qryFormItemsAfterPost
    BeforeDelete = qryFormItemsBeforeDelete
    AfterDelete = qryFormItemsAfterDelete
    AfterScroll = qryFormItemsAfterScroll
    Parameters = <
      item
        Name = 'FormID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'YearID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'ServerID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'SELECT      ID,  FormItemID, FormID, Row, CheckNumber, CheckDate' +
        ', CheckType, ItemNote, BankName, AccountNumber, City, CustomerID' +
        '2, TopicCode, DetailCode,'
      
        '                         CTopicCode, CTopicCode2, BudgetCode, Pr' +
        'ojectID, preFormItemID, AidInfoNo, AidInfoDate, FirstUser, LastU' +
        'ser, AccountNumberNew, AmountArz, CheckState, '
      
        '                         CheckFor, AccState, ItemState, ItemStat' +
        'eComment, SeverableAmount, RelatedID, ServerID, YearID, VAT, Top' +
        'icTypesI, AccountNumberNew1, '
      
        '                         CTopicCode3, ArzTypeID, ArzAmount, ArzR' +
        'ate, DayDelay,AmountDelay'
      
        ', ItemAmount, CashWage, ItemAmount + CashWage AS ItemAmount_Cash' +
        'Wage'
      'FROM            FormItems'
      'where (FormID=:FormID)'
      'AND ( YearID = :YearID ) AND ( ServerID = :ServerID )')
