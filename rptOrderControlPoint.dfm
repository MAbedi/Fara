  object qryOrderControlPoint: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'StuffCodeFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCodeTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCode1From'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCode1To'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCode2From'
        Size = -1
        Value = Null
      end
      item
        Name = 'StuffCode2To'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     derivedtbl_1.StuffCode, StuffCoding.c_StuffName, Unit' +
        's.UnitName, derivedtbl_1.StuffSize, derivedtbl_1.StuffDiameter, ' +
        'derivedtbl_1.StuffAlloy, '
      
        '                    ROUND(SUM(derivedtbl_1.InvWeight), 2) AS Inv' +
        'Weight , SUM(derivedtbl_1.OrderWeight) AS OrderWeight, SUM(deriv' +
        'edtbl_1.minOrder) AS minOrder, '
      
        '                      SUM(derivedtbl_1.maxOrder) AS maxOrder, SU' +
        'M(derivedtbl_1.orderPoint) AS orderPoint, SUM(derivedtbl_1.order' +
        'Entity) AS orderEntity'
      'FROM         Units INNER JOIN'
      
        '                      StuffCoding ON Units.UnitCode = StuffCodin' +
        'g.n_UnitCode INNER JOIN'
      
        '                          (SELECT     StuffCode, StuffSize, Stuf' +
        'fDiameter, StuffAlloy, minOrder - minOrder AS InvWeight, minOrde' +
        'r - minOrder AS OrderWeight, minOrder, maxOrder, '
      
        '                                                   orderPoint, o' +
        'rderEntity'
      '                             FROM         StuffCodingSpecial'
      
        '                             WHERE     (StuffCode BETWEEN :Stuff' +
        'CodeFrom  AND :StuffCodeTo)'
      '                             UNION ALL'
      
        '                             SELECT     ReciptItems.StuffCode, R' +
        'eciptItems.StuffSize, ReciptItems.StuffDiameter, ReciptItems.Stu' +
        'ffAlloy, 0 AS InvWeight, '
      
        '                                                   SUM(ReciptIte' +
        'ms.InputWeight + ReciptItems.OutputWeight - ISNULL(ReciptItems_1' +
        '.InputWeight + ReciptItems_1.OutputWeight, 0)) AS OrderWeight, '
      
        '                                                   0 AS minOrder' +
        ', 0 AS maxOrder, 0 AS orderPoint, 0 AS orderEntity'
      '                             FROM         ReciptItems INNER JOIN'
      
        '                                                   Recipts ON Re' +
        'ciptItems.ReciptID = Recipts.ReciptID AND ReciptItems.ServerID =' +
        ' Recipts.ServerID AND '
      
        '                                                   ReciptItems.Y' +
        'earID = Recipts.YearID LEFT OUTER JOIN'
      
        '                                                       (SELECT  ' +
        '   preReciptItemID, ServerID, YearID, SUM(InputEntity) AS InputE' +
        'ntity, SUM(OutputEntity) AS OutputEntity, SUM(InputWeight) AS In' +
        'putWeight, '
      
        '                                                                ' +
        '                SUM(OutputWeight) AS OutputWeight'
      
        '                                                          FROM  ' +
        '       ReciptItems AS ReciptItems_3'
      
        '                                                          GROUP ' +
        'BY preReciptItemID, ServerID, YearID) AS ReciptItems_1 ON Recipt' +
        'Items.ReciptItemID = ReciptItems_1.preReciptItemID AND '
      
        '                                                   ReciptItems.S' +
        'erverID = ReciptItems_1.ServerID AND ReciptItems.YearID = Recipt' +
        'Items_1.YearID'
      
        '                             WHERE     (Recipts.ReciptState IN (' +
        '0, 1)) AND (Recipts.ReciptType IN (22, 60,61))'
      
        '                             and   (StuffCode BETWEEN :StuffCode' +
        '1From  AND :StuffCode1To)'
      
        '                             GROUP BY ReciptItems.StuffCode, Rec' +
        'iptItems.StuffSize, ReciptItems.StuffDiameter, ReciptItems.Stuff' +
        'Alloy'
      '                             UNION ALL'
      
        '                             SELECT     ReciptItems_2.StuffCode,' +
        ' ReciptItems_2.StuffSize, ReciptItems_2.StuffDiameter, ReciptIte' +
        'ms_2.StuffAlloy, '
      
        '                                                   SUM(ReciptIte' +
        'ms_2.InputWeight - ReciptItems_2.OutputWeight) AS InvWeight, 0 A' +
        'S OrderWeight, 0 AS minOrder, 0 AS maxOrder, 0 AS orderPoint, '
      
        '                                                   0 AS orderEnt' +
        'ity'
      
        '                             FROM         ReciptItems AS ReciptI' +
        'tems_2 INNER JOIN'
      
        '                                                   Recipts AS Re' +
        'cipts_1 ON ReciptItems_2.ReciptID = Recipts_1.ReciptID AND Recip' +
        'tItems_2.ServerID = Recipts_1.ServerID AND '
      
        '                                                   ReciptItems_2' +
        '.YearID = Recipts_1.YearID INNER JOIN'
      
        '                                                   ReciptTypes O' +
        'N Recipts_1.ReciptType = ReciptTypes.ReciptType'
      
        '                             WHERE     (ReciptTypes.EffectType I' +
        'N (2, 4)) AND (Recipts_1.ReciptState IN (0, 1, 2))'
      
        '                             and (StuffCode BETWEEN :StuffCode2F' +
        'rom  AND :StuffCode2To)'
      ''
      
        '                             GROUP BY ReciptItems_2.StuffCode, R' +
        'eciptItems_2.StuffSize, ReciptItems_2.StuffDiameter, ReciptItems' +
        '_2.StuffAlloy) AS derivedtbl_1 ON '
      
        '                      StuffCoding.c_StuffCode = derivedtbl_1.Stu' +
        'ffCode'
      
        'GROUP BY derivedtbl_1.StuffCode, StuffCoding.c_StuffName, Units.' +
        'UnitName, derivedtbl_1.StuffSize, derivedtbl_1.StuffDiameter, de' +
        'rivedtbl_1.StuffAlloy'
      'HAVING      (SUM(derivedtbl_1.orderEntity) > 0)')
    Left = 128
    Top = 93
