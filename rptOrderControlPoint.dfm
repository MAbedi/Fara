  object qryinit: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'ReciptType'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = 22
      end>
    SQL.Strings = (
      
        'SELECT  RestartFormNumberOnStore,ReciptType,FormKindSerial,Secon' +
        'dTypeActive,ReciptCaption,EffectType'
      '  FROM    ReciptTypes'
      #13'where ReciptType=:ReciptType'
      #13#13'ORDER BY ReciptType')
    Left = 620
    Top = 106
  end
