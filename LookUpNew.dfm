  object qryMaster: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qryMasterAfterScroll
    Parameters = <>
    SQL.Strings = (
      'SELECT     LookUpID, Name, StartCode, FinishCode'
      'FROM         LookUps'
      'WHERE     (Kind = 0) AND (LookUpID > 0)')
