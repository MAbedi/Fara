  object QryStore: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    AfterScroll = QryStoreAfterScroll
    Parameters = <
      item
        Name = 'UserID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'UserIDAdmin'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'StoreIDForm'
        Attributes = [paSigned]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'StoreIDTo'
        Attributes = [paSigned]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end>
    SQL.Strings = (
      'SELECT DISTINCT     Stores.n_StoreID , c_StoreName'
      'FROM         dbo.Stores'
      
        ' LEFT OUTER JOIN   UsersStore ON Stores.n_StoreID = UsersStore.n' +
        '_StoreID'
      
        'WHERE ( (UsersStore.n_UserID = :UserID )or ( :UserIDAdmin = 127)' +
        ')  AND         ( Stores.n_StoreID  BETWEEN :StoreIDForm AND :Sto' +
        'reIDTo)')
    Left = 568
    Top = 16
    object QryStoren_StoreID: TSmallintField
      FieldName = 'n_StoreID'
    end
    object QryStorec_StoreName: TStringField
      FieldName = 'c_StoreName'
      Size = 70
    end
  end
