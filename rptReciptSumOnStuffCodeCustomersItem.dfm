      end
      item
        Name = 'ReciptNumberTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'StuffCodeFrom'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end
      item
        Name = 'StuffCodeTo'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end
      item
        Name = 'StoreIDFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'StoreIDTo'
        Attributes = [paSigned, paNullable]
        DataType = ftSmallint
        Precision = 5
        Size = 2
        Value = Null
      end
      item
        Name = 'ReciptDateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'ReciptDateTo'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end
      item
        Name = 'ReciptType'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end
      item
        Name = 'YearIDFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'YearIDTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'SellsEmporiumFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'SellsEmporiumTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'SellsMethodFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'SellsMethodTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'NotStoreID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT     ReciptItems.PersonID1, CASE WHEN Customers.CustName L' +
        'IKE N'#39'%'#39'+ ISNULL(Customers.CustFirstName, '#39#39') +'#39'%'#39' THEN Customer' +
        's.CustName'
      
        ' ELSE Customers.CustName + '#39' '#39' + ISNULL(Customers.CustFirstName,' +
        ' '#39#39') END AS CustName,'
      
        '          sum( ReciptItems.InputEntity + ReciptItems.OutputEntit' +
        'y) AS Entity,'
      
        '          sum( ReciptItems.InputWeight + ReciptItems.OutputWeigh' +
        't) AS Weight,'
      
        '          sum( ReciptItems.TotalInputPrice + ReciptItems.TotalOu' +
        'tputPrice) AS Price'
      ',ReciptItems.StuffCode, StuffCoding.c_StuffName'
      ''
      ''
      'FROM         Customers INNER JOIN'
      
        '                      ReciptItems ON Customers.CustID = ReciptIt' +
        'ems.PersonID1 INNER JOIN'
      
        '                      Recipts ON ReciptItems.ReciptID = Recipts.' +
        'ReciptID AND ReciptItems.ServerID = Recipts.ServerID AND'
      
        '                      ReciptItems.YearID = Recipts.YearID INNER ' +
        'JOIN'
      
        '                      Stores ON Recipts.StoreID = Stores.n_Store' +
        'ID INNER JOIN'
      
        '                      StuffCoding ON ReciptItems.StuffCode = Stu' +
        'ffCoding.c_StuffCode'
      ''
      ''
      ''
      ''
      ' INNER JOIN'
      
        '                      LookUps ON Recipts.SecondType = LookUps.Lo' +
        'okUpID'
      
        'WHERE     (LookUps.Code BETWEEN :SecondTypeCodeFrom AND :SecondT' +
        'ypeCodeTo ) AND '
      ''
      
        '    (Recipts.ReciptNumber BETWEEN :ReciptNumberFrom AND :ReciptN' +
        'umberTo) AND'
      
        '          (ReciptItems.StuffCode BETWEEN :StuffCodeFrom AND :Stu' +
        'ffCodeTo) AND'
      
        '          (Recipts.StoreID BETWEEN :StoreIDFrom AND  :StoreIDTo)' +
        ' AND'
      
        '          (Recipts.ReciptDate BETWEEN :ReciptDateFrom AND :Recip' +
        'tDateTo) AND'
      '          ( Recipts.ReciptType in (:ReciptType) )'
      ' AND (Recipts.ReciptState < 3)'
      'AND (Recipts.YearID BETWEEN   :YearIDFrom AND :YearIDTo)'
      
        '     AND (Recipts.SellsEmporium BETWEEN :SellsEmporiumFrom AND :' +
        'SellsEmporiumTo)'
      
        'AND (Recipts.SellsMethod BETWEEN :SellsMethodFrom AND :SellsMeth' +
        'odTo)'
      
        'And (Recipts.StoreID not in (Select part From dbo.SplitString(:N' +
        'otStoreID,'#39','#39')))'
      ''
      ''
      
        ' group by  ReciptItems.PersonID1,Customers.CustFirstName, Custom' +
        'ers.CustName,ReciptItems.StuffCode, StuffCoding.c_StuffName'
      ''
      ''
      ' ')
    Left = 216
    Top = 232
