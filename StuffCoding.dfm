  object qryGroups: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qryGroupsAfterScroll
    Parameters = <>
    SQL.Strings = (
      
        'SELECT        StuffGroups.GroupID, StuffGroups.GroupName, StuffG' +
        'roups.StartCode, StuffGroups.FinishCode, stuffcoding.cntGroupID'
      ',StuffGroups.VatExemptOn'
      ''
      'FROM            StuffGroups LEFT OUTER JOIN'
      '                             (SELECT DISTINCT UperGroupId'
      
        '                                FROM            StuffGroups AS S' +
        'tuffGroups_1) AS ChildGroup ON StuffGroups.GroupID = ChildGroup.' +
        'UperGroupId LEFT OUTER JOIN'
      
        '                             (SELECT        GroupID, COUNT(Group' +
        'ID) AS cntGroupID'
      
        '                                FROM            StuffCoding AS S' +
        'tuffCoding_1'
      
        '                                GROUP BY GroupID) AS stuffcoding' +
        ' ON stuffcoding.GroupID = StuffGroups.GroupID'
      
        'WHERE        (ChildGroup.UperGroupId IS NULL) AND (StuffGroups.L' +
        'evelID >='
      '                             (SELECT        LevelIdStuffGroup'
      '                                FROM            Config))')
    Left = 576
    Top = 7
    object qryGroupsGroupID: TIntegerField
      DisplayLabel = #1705#1583' '#1711#1585#1608#1607
      FieldName = 'GroupID'
    end
    object qryGroupsGroupName: TStringField
      DisplayLabel = #1593#1606#1608#1575#1606' '#1711#1585#1608#1607
      FieldName = 'GroupName'
      Size = 50
    end
    object qryGroupsStartCode: TLargeintField
      DisplayLabel = #1575#1586' '#1705#1583
      FieldName = 'StartCode'
    end
    object qryGroupsFinishCode: TLargeintField
      DisplayLabel = #1578#1575' '#1705#1583
      FieldName = 'FinishCode'
    end
    object qryGroupscntGroupID: TIntegerField
      DisplayLabel = #1578#1593#1583#1575#1583' '#1705#1575#1604#1575
      FieldName = 'cntGroupID'
      ReadOnly = True
    end
    object qryGroupsVatExemptOn: TWordField
      FieldName = 'VatExemptOn'
    end
  end
