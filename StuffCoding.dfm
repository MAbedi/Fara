    Parameters = <>
    SQL.Strings = (
      'select  *,ltrim(c_StuffCode) AS StuffCode'
      ',(SELECT    Count(*) FROM Unit2Stuffs'
      'WHERE        (StuffCode = c_StuffCode )) As CountUnit'
      
        ',(SELECT GroupName FROM StuffGroups WHERE(GroupID = Stuffcoding.' +
        'GroupID )) As GroupName'
      ''
      '  from Stuffcoding ')
