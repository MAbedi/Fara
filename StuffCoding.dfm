  object qryStores: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'c_StuffCode'
        Attributes = [paSigned]
        DataType = ftLargeint
        Precision = 19
        Size = 10
        Value = Null
      end>
    SQL.Strings = (
      'SELECT     StoreStuffs.n_StoreID, Stores.c_StoreName'
      'FROM         StoreStuffs INNER JOIN'
      
        '                      Stores ON StoreStuffs.n_StoreID = Stores.n' +
        '_StoreID'
      'WHERE     (StoreStuffs.c_StuffCode =:c_StuffCode)')
    Left = 295
    Top = 188
