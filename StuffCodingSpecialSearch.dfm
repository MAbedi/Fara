  object qrySpecialSearch: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    AfterOpen = qrySpecialSearchAfterOpen
    AfterScroll = qrySpecialSearchAfterScroll
    Parameters = <>
    SQL.Strings = (
      'SELECT *   FROM('
      ''
      
        'SELECT min(ReciptItems.ReciptItemID)*0 as checked , ReciptItems.' +
        'StuffCode, StuffCoding.c_StuffName,'
      
        'ReciptItems.StuffSize, ReciptItems.StuffDiameter,ReciptItems.Stu' +
        'ffAlloy'
      ''
      ''
      
        'FROM ReciptItems INNER JOIN StuffCoding ON ReciptItems.StuffCode' +
        ' = StuffCoding.c_StuffCode'
      
        'GROUP BY ReciptItems.StuffCode, StuffCoding.c_StuffName, ReciptI' +
        'tems.StuffSize,'
      'ReciptItems.StuffDiameter,ReciptItems.StuffAlloy'
      ')a')
    Left = 584
    Top = 192
    object qrySpecialSearchchecked: TIntegerField
      Tag = 3
      DisplayLabel = #1575#1606#1578#1582#1575#1576
      FieldName = 'checked'
    end
    object qrySpecialSearchStuffCode: TLargeintField
      Tag = 3
      DisplayLabel = #1603#1583' '#1603#1575#1604#1575
      FieldName = 'StuffCode'
    end
    object qrySpecialSearchc_StuffName: TStringField
      Tag = 3
      DisplayLabel = #1588#1585#1581' '#1603#1575#1604#1575
      FieldName = 'c_StuffName'
      Size = 150
    end
    object qrySpecialSearchStuffSize: TStringField
      Tag = 3
      DisplayLabel = #1575#1576#1593#1575#1583
      FieldName = 'StuffSize'
      Size = 12
    end
    object qrySpecialSearchStuffDiameter: TFloatField
      Tag = 3
      DisplayLabel = #1590#1582#1575#1605#1578
      FieldName = 'StuffDiameter'
    end
    object qrySpecialSearchStuffAlloy: TStringField
      Tag = 3
      DisplayLabel = #1570#1604#1610#1575#1688
      FieldName = 'StuffAlloy'
      Size = 12
    end
  end
