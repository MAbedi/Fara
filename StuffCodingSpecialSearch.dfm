    SQL.Strings = (
      'SELECT    '#39#1580#1605#1593' '#1603#1604' '#39' as Name,'
      
        '          round(SUM(ReciptItems.InputEntity - ReciptItems.Output' +
        'Entity),3) AS Entity,'
      
        '          round(SUM(ReciptItems.InputWeight - ReciptItems.Output' +
        'Weight),3) AS Weight,'
      
        '          round(  AVG(ReciptItems.UnitSellPrice) ,3)AS UnitSellP' +
        'rice'
      'FROM      ReciptItems INNER JOIN'
      
        '          StuffCoding ON ReciptItems.StuffCode = StuffCoding.c_S' +
        'tuffCode INNER JOIN'
      
        '                                Recipts ON dbo.Recipts.ReciptID ' +
        '= dbo.ReciptItems.ReciptID AND '
      
        '                      dbo.Recipts.ServerID = dbo.ReciptItems.Ser' +
        'verID AND dbo.Recipts.YearID = dbo.ReciptItems.YearID INNER JOIN'
      
        '          ReciptTypes ON Recipts.ReciptType = ReciptTypes.Recipt' +
        'Type'
      
        'WHERE     (Recipts.ReciptState < 2) AND (ReciptTypes.EffectType ' +
        'IN (2, 4))'
      '     AND  (ReciptItems.StuffCode =     :StuffCode )'
      '     AND  (StuffCoding.c_StuffName =     :c_StuffName )'
      '     AND  (ReciptItems.StuffSize =     :StuffSize )'
      '     AND  (ReciptItems.StuffDiameter = :StuffDiameter )'
      '     AND  (ReciptItems.StuffAlloy  =   :StuffAlloy )'
      'union all'
      'SELECT    '#39#1662#1610#1588' '#1601#1575#1603#1578#1608#1585#1607#1575#1610' '#1601#1593#1575#1604#39' as Name,'
      
        '          round( SUM(ReciptItems.InputEntity - ReciptItems.Outpu' +
        'tEntity),3) AS Entity,'
      
        '          round( SUM(ReciptItems.InputWeight -  ReciptItems.Outp' +
        'utWeight),3) AS Weight,'
      
        '          round( AVG(-ReciptItems.UnitSellPrice),3) AS UnitSellP' +
        'rice'
      'FROM      ReciptItems INNER JOIN'
      
        '          StuffCoding ON ReciptItems.StuffCode = StuffCoding.c_S' +
        'tuffCode INNER JOIN'
      
        '                                Recipts ON dbo.Recipts.ReciptID ' +
        '= dbo.ReciptItems.ReciptID AND '
      
        '                      dbo.Recipts.ServerID = dbo.ReciptItems.Ser' +
        'verID AND dbo.Recipts.YearID = dbo.ReciptItems.YearID INNER JOIN'
      
        '          ReciptTypes ON Recipts.ReciptType = ReciptTypes.Recipt' +
        'Type'
      
        'WHERE     (Recipts.ReciptState < 2) AND (ReciptTypes.ReciptType ' +
        'IN (10))'
      '     AND  (ReciptItems.StuffCode =     :StuffCode2 )'
      '     AND  (StuffCoding.c_StuffName =     :c_StuffName2 )'
      '     AND  (ReciptItems.StuffSize =     :StuffSize2 )'
      '     AND  (ReciptItems.StuffDiameter = :StuffDiameter2 )'
      '     AND  (ReciptItems.StuffAlloy  =   :StuffAlloy2 )'
      '     AND  (Recipts.AidDate <= :AidDate )'
      ''
      'union all'
      ''
      'SELECT    '#39#1576#1575#1602#1610#1605#1575#1606#1583#1607' '#39' as Name,round(SUM(Entity),3)as Entity,'
      
        '          round(SUM(Weight),3)as Weight,round(AVG(UnitSellPrice)' +
        ',3)as UnitSellPrice'
      'FROM'
      
        '( SELECT  round(SUM(ReciptItems.InputEntity - ReciptItems.Output' +
        'Entity),3) AS Entity, '
      
        '          round(SUM(ReciptItems.InputWeight - ReciptItems.Output' +
        'Weight),3) AS Weight, '
      
        '          round(  AVG(ReciptItems.UnitSellPrice) ,3)AS UnitSellP' +
        'rice'
      'FROM      ReciptItems INNER JOIN'
      
        '          StuffCoding ON ReciptItems.StuffCode = StuffCoding.c_S' +
        'tuffCode INNER JOIN'
      
        '                                Recipts ON dbo.Recipts.ReciptID ' +
        '= dbo.ReciptItems.ReciptID AND '
      
        '                      dbo.Recipts.ServerID = dbo.ReciptItems.Ser' +
        'verID AND dbo.Recipts.YearID = dbo.ReciptItems.YearID  INNER JOI' +
        'N'
      
        '          ReciptTypes ON Recipts.ReciptType = ReciptTypes.Recipt' +
        'Type'
      
        'WHERE     (Recipts.ReciptState < 2) AND (ReciptTypes.EffectType ' +
        'IN (2, 4))'
      '     AND  (ReciptItems.StuffCode =     :StuffCode3 )'
      '     AND  (StuffCoding.c_StuffName =     :c_StuffName3 )'
      '     AND  (ReciptItems.StuffSize =     :StuffSize3 )'
      '     AND  (ReciptItems.StuffDiameter = :StuffDiameter3 )'
      '     AND  (ReciptItems.StuffAlloy  =   :StuffAlloy3 )'
      'union all'
      
        'SELECT    round( SUM(ReciptItems.InputEntity - ReciptItems.Outpu' +
        'tEntity),3) AS Entity,'
      
        '          round( SUM(ReciptItems.InputWeight -  ReciptItems.Outp' +
        'utWeight),3) AS Weight,'
      
        '          round( AVG(-ReciptItems.UnitSellPrice),3) AS UnitSellP' +
        'rice'
      'FROM      ReciptItems INNER JOIN'
      
        '          StuffCoding ON ReciptItems.StuffCode = StuffCoding.c_S' +
        'tuffCode INNER JOIN'
      
        '                                Recipts ON dbo.Recipts.ReciptID ' +
        '= dbo.ReciptItems.ReciptID AND '
      
        '                      dbo.Recipts.ServerID = dbo.ReciptItems.Ser' +
        'verID AND dbo.Recipts.YearID = dbo.ReciptItems.YearID INNER JOIN'
      
        '          ReciptTypes ON Recipts.ReciptType = ReciptTypes.Recipt' +
        'Type'
      
        'WHERE     (Recipts.ReciptState < 2) AND (ReciptTypes.ReciptType ' +
        'IN (10))'
      '     AND  (ReciptItems.StuffCode =     :StuffCode4 )'
      '     AND  (StuffCoding.c_StuffName =     :c_StuffName4 )'
      '     AND  (ReciptItems.StuffSize =     :StuffSize4 )'
      '     AND  (ReciptItems.StuffDiameter = :StuffDiameter4 )'
      '     AND  (ReciptItems.StuffAlloy  =   :StuffAlloy4 )'
      ')remain'
      '')
