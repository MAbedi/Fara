    DataSet = qrySpecialSearch
    Left = 576
    Top = 288
  end
  object qryRecipts: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'StuffCode'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'c_StuffName'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 150
        Value = Null
      end
      item
        Name = 'StuffSize'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 12
        Value = Null
      end
      item
        Name = 'StuffDiameter'
        Attributes = [paSigned]
        DataType = ftFloat
        NumericScale = 255
        Precision = 15
        Size = 10
        Value = Null
      end
      item
        Name = 'StuffAlloy'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 12
        Value = Null
      end>
    SQL.Strings = (
      'SELECT   Recipts.StoreID, Stores.c_StoreName,'
      
        '   SUM(ReciptItems.InputEntity -  ReciptItems.OutputEntity ) AS ' +
        'Entity,'
      
        '   SUM(ReciptItems.InputWeight  - ReciptItems.OutputWeight ) AS ' +
        'Weight,'
      '   AVG(ReciptItems.UnitSellPrice) AS UnitSellPrice'
      'FROM ReciptItems INNER JOIN'
      
        '    StuffCoding ON ReciptItems.StuffCode = StuffCoding.c_StuffCo' +
        'de INNER JOIN'
      
        '                          Recipts ON dbo.Recipts.ReciptID = dbo.' +
        'ReciptItems.ReciptID AND '
      
        '                      dbo.Recipts.ServerID = dbo.ReciptItems.Ser' +
        'verID AND dbo.Recipts.YearID = dbo.ReciptItems.YearID INNER JOIN'
      '    Stores ON Recipts.StoreID = Stores.n_StoreID INNER JOIN'
      '    ReciptTypes ON Recipts.ReciptType = ReciptTypes.ReciptType'
      ''
      
        'WHERE     (Recipts.ReciptState < 2) AND (ReciptTypes.EffectType ' +
        'in (2,4) )'
      '     AND  (ReciptItems.StuffCode =     :StuffCode )'
      '     AND  (StuffCoding.c_StuffName =     :c_StuffName )'
      '     AND  (ReciptItems.StuffSize =     :StuffSize )'
      '     AND  (ReciptItems.StuffDiameter = :StuffDiameter )'
      '     AND  (ReciptItems.StuffAlloy  =   :StuffAlloy )'
      'GROUP BY Recipts.StoreID, Stores.c_StoreName')
    Left = 88
    Top = 176
    object qryReciptsStoreID: TSmallintField
      DisplayLabel = #1603#1583#1575#1606#1576#1575#1585
      FieldName = 'StoreID'
    end
    object qryReciptsc_StoreName: TStringField
      DisplayLabel = #1606#1575#1605' '#1575#1606#1576#1575#1585
      FieldName = 'c_StoreName'
      Size = 70
    end
    object qryReciptsEntity: TFloatField
      DisplayLabel = #1605#1602#1583#1575#1585
      FieldName = 'Entity'
      ReadOnly = True
    end
    object qryReciptsWeight: TFloatField
      DisplayLabel = #1608#1586#1606
      FieldName = 'Weight'
      ReadOnly = True
    end
    object qryReciptsUnitSellPrice: TFMTBCDField
      DisplayLabel = #1601#1610
      FieldName = 'UnitSellPrice'
      ReadOnly = True
      currency = True
      Precision = 19
    end
  end
