  object qryCheckCycle: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'CheckNumberfrom'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 15
        Value = '1'
      end
      item
        Name = 'CheckNumberTo'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 15
        Value = '999999999'
      end
      item
        Name = 'ItemAmountFrom'
        Attributes = [paSigned, paNullable]
        DataType = ftBCD
        NumericScale = 4
        Precision = 19
        Size = 10
        Value = 0c
      end
      item
        Name = 'ItemAmountTo'
        Attributes = [paSigned, paNullable]
        DataType = ftBCD
        NumericScale = 4
        Precision = 19
        Size = 10
        Value = 99999999990000c
      end
      item
        Name = 'CheckDateFrom'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '0'
      end
      item
        Name = 'CheckDateTo'
        Attributes = [paNullable]
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = '9999/99/99'
      end>
    SQL.Strings = (
      
        'SELECT  FormItems.CheckNumber, FormItems.CheckDate, FormTypes.Fo' +
        'rmCaption, FormItems.BankName, FormItems.ItemAmount,'
      
        '        FormItems.CustomerID2, Forms.CustomerID1, Forms.Customer' +
        'ID2 AS formsCustomerID2, Forms.FormNumber, Forms.FormDate,'
      
        '        Forms.FormState, FormItems.ItemNote, FormItems.AccountNu' +
        'mber, Customers_2.CustName, Customers_1.CustName AS CustName_1,'
      
        '        Customers.CustName AS CustName_2,FormTypes.FormType,Form' +
        's.FormID,'
      
        '        FormItems.ItemAmount as Amount,Forms.FormID as _row,Form' +
        's.FirstUser,Forms.LastUser ,FormItems.AidInfoNo'
      'FROM    FormItems LEFT OUTER JOIN'
      
        '        Forms ON FormItems.FormID = Forms.FormID AND FormItems.S' +
        'erverID = Forms.ServerID AND FormItems.YearID = Forms.YearID  LE' +
        'FT OUTER JOIN'
      
        '        FormTypes ON Forms.FormType = FormTypes.FormType  LEFT O' +
        'UTER JOIN'
      
        '        Customers ON FormItems.CustomerID2 = Customers.CustID  L' +
        'EFT OUTER JOIN'
      
        '        Customers Customers_1 ON Forms.CustomerID1 = Customers_1' +
        '.CustID  LEFT OUTER JOIN'
      
        '        Customers Customers_2 ON Forms.CustomerID2 = Customers_2' +
        '.CustID'
      
        'WHERE   (((FormItems.CheckNumber between  :CheckNumberfrom and :' +
        'CheckNumberTo)'
      
        '        AND (FormItems.ItemAmount between :ItemAmountFrom and :I' +
        'temAmountTo)) and'
      
        '        ((FormItems.CheckDate is null) OR ( FormItems.CheckDate ' +
        '= '#39#39' )OR'
      
        '        (FormItems.CheckDate between :CheckDateFrom and :CheckDa' +
        'teTo)))'
      '        and (FormTypes.FormType <> 103)'
      ' ')
    Left = 298
    Top = 71
