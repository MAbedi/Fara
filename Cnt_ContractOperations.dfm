  object qryContracts: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    BeforeScroll = qryContractsBeforeScroll
    AfterScroll = qryContractsAfterScroll
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     Cnt.Contracts.* , Customers.CustName AS _EmployerId, ' +
        'Customers_1.CustName AS _WorkShopId'
      'FROM         Cnt.Contracts INNER JOIN'
      
        '                      Customers ON Cnt.Contracts.EmployerId = Cu' +
        'stomers.CustID INNER JOIN'
      
        '                      Customers AS Customers_1 ON Cnt.Contracts.' +
        'WorkShopId = Customers_1.CustID')
