  object srcProforma: TDataSource
    DataSet = qryProforma
    OnStateChange = srcProformaStateChange
    Left = 40
    Top = 312
  end
  object qryRecipts: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    AfterScroll = qryReciptsAfterScroll
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     Recipts.ReciptID, Recipts.ServerID, Recipts.YearID, R' +
        'ecipts.ReciptNumber, Recipts.ReciptDate,'
      
        'Recipts.DocNo, Recipts.DocDate,Recipts.PersonID1, Customers.Cust' +
        'Name,'
      'Customers.Address, Customers.Tel,'
      '                      Recipts.ArzTypeID, LookUps.Name,'
      '                      Customers.Country,'
      ''
      '                      Currencies.CurrenciesName,'
      
        '                      Recipts.RialsEqual, SUM(ReciptItems.ArzAmo' +
        'unt) AS ArzAmount,'
      
        '                      SUM(ReciptItems.TotalInputPrice) + SUM(Rec' +
        'iptItems.TotalOutputPrice) AS TotalPrice,'
      
        '                      SUM(ReciptsDeficits.DeficitAdd) - SUM(Reci' +
        'ptsDeficits.DeficitDec) AS DeficitSum '
      
        ',SUM(ReciptItems.InputEntity) +  SUM(ReciptItems.OutputEntity) A' +
        'S Entity'
      
        ',SUM(ReciptItems.InputWeight)+ SUM(ReciptItems.OutputWeight) AS ' +
        'Weight, Recipts.AidNumber, Recipts.AidDate'
      ', Recipts.PersonID2, Customers_2.CustName AS CustName2'
      ''
      'FROM            Recipts INNER JOIN'
      
        '                         Customers ON Recipts.PersonID1 = Custom' +
        'ers.CustID INNER JOIN'
      
        '                         ReciptItems ON Recipts.ReciptID = Recip' +
        'tItems.ReciptID AND Recipts.ServerID = ReciptItems.ServerID AND ' +
        'Recipts.YearID = ReciptItems.YearID INNER JOIN'
      
        '                         Customers AS Customers_2 ON Recipts.Per' +
        'sonID2 = Customers_2.CustID LEFT OUTER JOIN'
      
        '                         LookUps ON Customers.ArzTypeID = LookUp' +
        's.LookUpID LEFT OUTER JOIN'
      
        '                         Currencies ON Recipts.ArzTypeID = Curre' +
        'ncies.CurrenciesID LEFT OUTER JOIN'
      
        '                         ReciptsDeficits ON Recipts.ReciptID = R' +
        'eciptsDeficits.ReciptID AND Recipts.ServerID = ReciptsDeficits.S' +
        'erverID AND Recipts.YearID = ReciptsDeficits.YearID'
      ''
      ''
      ''
      'WHERE     (Recipts.ReciptType = 59 )'
      ''
      
        'GROUP BY Recipts.ReciptID, Recipts.ReciptNumber, Recipts.ReciptD' +
        'ate, Recipts.PersonID1, Customers.CustName, Recipts.ServerID, Re' +
        'cipts.YearID,'
      
        '                        Currencies.CurrenciesName, Recipts.Rials' +
        'Equal'
      
        ',Recipts.DocNo,Recipts.DocDate,Customers.Address,Customers.Tel,R' +
