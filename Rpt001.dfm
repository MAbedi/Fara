  object qryItems: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    OnCalcFields = qryItemsCalcFields
    DataSource = srcRecipts
    Parameters = <
      item
        Name = 'ReciptID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end
      item
        Name = 'YearID'
        DataType = ftString
        Size = 1
        Value = '0'
      end
      item
        Name = 'ServerID'
        DataType = ftString
        Size = 1
        Value = '0'
      end>
    SQL.Strings = (
      
        'SELECT Ri.*, S.c_StuffName AS _StuffName, U.UnitName AS _UnitNam' +
        'e,  S.c_StuffTecInfo AS _StuffTecInfo,'
      'S.Carton AS _Carton, Us.UseUnitName AS _UseUnitName'
      ',  C1.CTopicName_L1 AS _CTopicCode'
      ',  C2.CTopicName2_L1 AS _CTopicCode2'
      ',  Ri.TotalStandardRate*3/100 as  __Tax'
      
        ',  Ri.TotalStandardRate +Ri.TotalStandardRate*3/100 as  _TotalSt' +
        'andardRate,InvEntity - RequestedEntity  as  Req_InvEntity ,'#39#39' as' +
        ' ____StuffTecInfo,'
      
        '(SELECT top 1 LookUps.Name FROM LookUps RIGHT OUTER JOIN StuffCo' +
        'ding ON LookUps.Code = StuffCoding.st13'
      
        ' WHERE (LookUps.Kind = 313) AND (StuffCoding.c_StuffCode = Ri.St' +
        'uffCode)) AS  _PakhashCompany'
      
        ' ,(SELECT c_StuffName FROM StuffCoding WHERE c_StuffCode = Ri.St' +
        'uffCode) as   c_StuffName'
      
        ',CASE WHEN InputEntity + OutputEntity <> 0 THEN TotallSellPrice ' +
        '/ (InputEntity + OutputEntity) ELSE 0 END AS UnitSellPrice3'
      
        ',c_KeepPlace as _c_KeepPlace ,  (TotalInputPrice + TotalOutputPr' +
        'ice) + (InputEntity + OutputEntity) * UnitCommission - DeficitVa' +
        'lue AS TotalDeficient'
      
        ',s.sd1 AS _SD1,s.sd2 AS _SD2,s.sd3 AS _SD3,s.sd4 AS _SD4,s.sd5 A' +
        'S _SD5,s.sd6 AS _SD6,s.sd7 AS _SD7,s.sd8 AS _SD8,s.sd9 AS _SD9'
      ',S.NationalStuffCode _NationalStuffCode,U.Tax_mu _Tax_mu '
      'FROM         UseUnits Us RIGHT OUTER JOIN'
      'ReciptItems Ri ON Us.UseUnitID = Ri.UseUnitID LEFT OUTER JOIN'
      
        'Accounting.ACC.CenterTopics C1 ON Ri.acc_CTopicCode = C1.CTopicC' +
        'ode LEFT OUTER JOIN'
      
        'Accounting.ACC.CenterTopics2 C2 ON Ri.acc_CTopicCode2 = C2.CTopi' +
        'cCode2 LEFT OUTER JOIN'
      'Units U RIGHT OUTER JOIN'
      
        'StuffCoding S ON U.UnitCode = S.n_UnitCode ON Ri.StuffCode = S.c' +
        '_StuffCode'
      ''
      'WHERE(Ri.ReciptID = :ReciptID)'
      'and ( Ri.YearID = :YearID )'
      'and ( Ri.ServerID = :ServerID )'
      'ORDER BY _PakhashCompany, _StuffName, Ri.ReciptItemID')
    Left = 219
    Top = 143
