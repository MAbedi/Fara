  object qryUpDate: TADOQuery
    Connection = DmF.adcBSell
    Parameters = <
      item
        Name = 'PersonID1From'
        Size = -1
        Value = Null
      end
      item
        Name = 'PersonID1To'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptTypeFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptTypeTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'NumberFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'NumberTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'DateFrom'
        DataType = ftString
        Size = -1
        Value = Null
      end
      item
        Name = 'DateTo'
        DataType = ftString
        Size = -1
        Value = Null
      end
      item
        Name = 'StoreFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'StoreTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'States'
        Size = -1
        Value = Null
      end
      item
        Name = 'LookUpsCodeFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'LookUpsCodeTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'UseUnitIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'UseUnitIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'PersonID3From'
        Size = -1
        Value = Null
      end
      item
        Name = 'PersonID3To'
        Size = -1
        Value = Null
      end
      item
        Name = 'SellsMethodFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'SellsMethodTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'SellsEmporiumFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'SellsEmporiumTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptsRowFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'ReciptsRowTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'AidNumberFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'AidNumberTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'PersonID2From'
        Size = -1
        Value = Null
      end
      item
        Name = 'PersonID2To'
        Size = -1
        Value = Null
      end
      item
        Name = 'MasirIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'MasirIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearIDFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'YearIDTo'
        Size = -1
        Value = Null
      end
      item
        Name = 'AidDateFrom'
        Size = -1
        Value = Null
      end
      item
        Name = 'AidDateTo'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'UPDATE Recipts SET ReciptState = 1'
      'FROM Recipts AS R LEFT OUTER JOIN'
      'LookUps ON R.SecondType = LookUps.LookUpID'
      'WHERE (R.PersonID1 BETWEEN :PersonID1From AND :PersonID1To)'
      'AND (R.ReciptType BETWEEN :ReciptTypeFrom AND :ReciptTypeTo)'
      'AND (R.ReciptNumber BETWEEN :NumberFrom AND :NumberTo)'
      'AND (R.ReciptDate BETWEEN :DateFrom AND :DateTo)'
      'AND (R.StoreID BETWEEN :StoreFrom AND :StoreTo)'
      'AND('#39','#39'+ltrim(str(R.ReciptState))+'#39','#39' LIKE N'#39'%,'#39'+ :States +'#39',%'#39')'
      'AND (LookUps.Code BETWEEN :LookUpsCodeFrom AND :LookUpsCodeTo)'
      
        'AND (R.UseUnitID BETWEEN :UseUnitIDFrom AND :UseUnitIDTo OR R.Us' +
        'eUnitID IS NULL)'
      'AND (R.PersonID3 BETWEEN :PersonID3From AND :PersonID3To)'
      'AND (R.SellsMethod BETWEEN :SellsMethodFrom AND :SellsMethodTo)'
      
        'AND (R.SellsEmporium BETWEEN :SellsEmporiumFrom AND :SellsEmpori' +
        'umTo)'
      
        'AND (ISNULL(R.ReciptsRow, 0) BETWEEN :ReciptsRowFrom AND :Recipt' +
        'sRowTo)'
      ''
      
        'AND (isnull(R.AidNumber,0) BETWEEN :AidNumberFrom AND :AidNumber' +
        'To)'
      ''
      'AND (R.PersonID2 BETWEEN :PersonID2From AND :PersonID2To)'
      
        'AND (R.MasirID BETWEEN :MasirIDFrom AND :MasirIDTo OR R.MasirID ' +
        'IS NULL)'
      'AND (R.YearID BETWEEN :YearIDFrom AND :YearIDTo )'
      'AND (R.ReciptState = 0 )'
      
        'AND ((ISNULL(R.AidDate,'#39'0000/00/00'#39') BETWEEN :AidDateFrom AND :A' +
        'idDateTo)OR(LTRIM(R.AidDate)='#39#39'))')
    Left = 456
    Top = 224
  end
