  object qryIndent: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltBatchOptimistic
    Parameters = <
      item
        Name = 'FunctionInfoType'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end
      item
        Name = 'PersonIdFrom'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'PersonIdTo'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'StuffId'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'FunctionTypeFrom'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end
      item
        Name = 'FunctionTypeTo'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end
      item
        Name = 'FunctionDateFrom'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 10
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        Fitful.FitfulID AS Checked, Tsh.Functions.Function' +
        'Id, Tsh.Functions.FunctionInfoType, Tsh.Functions.WorkShopId, Ts' +
        'h.Functions.MachineId, '
      
        '                         Tsh.Functions.PersonId, Tsh.Functions.S' +
        'tuffId, Tsh.Functions.Productionprocess, Tsh.Functions.EarthFiel' +
        'd, Tsh.Functions.Gate, Tsh.Functions.Ratio, '
      
        '                         Tsh.Functions.FunctionAmount, Tsh.Funct' +
        'ions.FunctionDate, Tsh.Functions.StartHour, Tsh.Functions.EndHou' +
        'r, Tsh.Functions.FunctionHour, '
      
        '                         Tsh.Functions.FunctionNote, Tsh.Functio' +
        'ns.CaseId, Tsh.Functions.FunctionType, Tsh.Functions.FunctionSta' +
        'tus, Tsh.Functions.Amount1, Tsh.Functions.Amount2, '
      
        '                         Tsh.Functions.Amount3, Tsh.Functions.Ma' +
        'intenanceID, Tsh.Functions.StuffCode2, Tsh.Functions.StuffCode3,' +
        ' Tsh.Functions.ShiftWork, Tsh.Functions.Shift, '
      
        '                         Tsh.Functions.ShiftWorkTime, Tsh.Functi' +
        'ons.OverTime, Customers_Person.CustName AS PersonName, Customers' +
        '_WorkShop.CustName AS WorkShopName'
      'FROM            Tsh.Functions LEFT OUTER JOIN'
      
        '                         Customers AS Customers_Person ON Tsh.Fu' +
        'nctions.PersonId = Customers_Person.CustID LEFT OUTER JOIN'
      
        '                         Customers AS Customers_WorkShop ON Tsh.' +
        'Functions.WorkShopId = Customers_WorkShop.CustID CROSS JOIN'
      '                         Fitful'
      ''
      
        'WHERE     (FunctionInfoType = :FunctionInfoType) AND  (PersonId ' +
        'BETWEEN :PersonIdFrom AND :PersonIdTo) '
      
        'AND (WorkShopId = :StuffId) AND ( isnull(FunctionType,0)  BETWEE' +
        'N :FunctionTypeFrom AND :FunctionTypeTo) AND'
      ' (FunctionDate = :FunctionDateFrom ) ')
    Left = 152
    Top = 216
