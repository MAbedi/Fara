  object qryInitForm: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <
      item
        Name = 'Type'
        DataType = ftWord
        Precision = 3
        Size = 1
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT        FormTypes.*, FormTypes_1.FormCaption AS _PostOvera' +
        'llTypeCaption'
      'FROM            FormTypes LEFT OUTER JOIN'
      
        '                         FormTypes AS FormTypes_1 ON FormTypes.P' +
        'ostOverallType = FormTypes_1.FormType'
      'WHERE        (FormTypes.FormType = :Type )')
    Left = 573
    Top = 6
  end
