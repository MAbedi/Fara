  object qryRelatedRecipts: TADOQuery
    Connection = DmF.adcBSell
    CursorType = ctStatic
    LockType = ltReadOnly
    Parameters = <>
    SQL.Strings = (
      
        'SELECT     LTRIM(Recipts.ServerID) + '#39'-'#39' + LTRIM(Recipts.YearID)' +
        ' + '#39'-'#39' + LTRIM(Recipts.ReciptID) AS RelatedNo, '
      
        '                      ReciptTypes.ReciptCaption + '#39'-'#39' + LTRIM(Re' +
        'cipts.ReciptNumber) + '#39' - '#39' + Recipts.ReciptDate + '#39'-'#39' + ISNULL(' +
        'Recipts.ReciptNote, '#39#39') '
      '                      + '#39'-'#39' + Customers.CustName AS RelatedName'
      'FROM         Recipts INNER JOIN'
      
        '                      Customers ON Recipts.PersonID1 = Customers' +
        '.CustID INNER JOIN'
      
        '                      ReciptTypes ON Recipts.ReciptType = Recipt' +
        'Types.ReciptType'
      
        'WHERE     (Recipts.ReciptType IN ( 60, 61)) AND (Recipts.ReciptS' +
        'tate <> 3)')
    Left = 488
    Top = 8
  end
